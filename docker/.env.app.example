# Tim3 — env za app deploy na dijeljenom VPS-u.
# Kopiraj u `docker/.env.app` i popuni stvarnim vrijednostima. NE commitovati pravi .env.app!
# Pokretanje: docker compose -f docker/docker-compose.app.yml --env-file docker/.env.app up -d --build

# Zajednički domen (npr. 167-233-59-205.nip.io dok ne pređemo na pravi DNS)
BASE_DOMAIN=<domen>

# Naša baza/korisnik na DIJELJENOM Postgresu (dao vlasnik servera)
TEAM_DB_NAME=tim3_db
TEAM_DB_USER=tim3_user
TEAM_DB_PASSWORD=<lozinka-od-vlasnika-servera>

# Keycloak client secreti iz realma "tim3" — STVARNI prod secreti, NE placeholder!
KEYCLOAK_WEB_CLIENT_SECRET=<praksa-web client secret>
KEYCLOAK_API_CLIENT_SECRET=<praksa-api client secret>
