# ─────────────────────────────────────────────
#  Keycloak
# ─────────────────────────────────────────────
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=changeme_admin

# ─────────────────────────────────────────────
#  Research Agent
# ─────────────────────────────────────────────
RESEARCH_MODE=active

# Upload logova na GitHub (sve tri vrijednosti dobiješ od mentora)
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxx
GITHUB_REPO=mirzazukanovic1990/logovi-praksa
# STUDENT_ID=12345                             <- tvoj studentski ID (dodijelio mentor)

# ─────────────────────────────────────────────
#  Anthropic / Claude API
# ─────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-...

# ─────────────────────────────────────────────
#  Baza podataka (Docker)
# ─────────────────────────────────────────────
POSTGRES_USER=student
POSTGRES_PASSWORD=changeme
POSTGRES_DB=studentskapraksa

# ─────────────────────────────────────────────
#  URL-ovi servisa
# ─────────────────────────────────────────────
# API URL kojeg Web projekt koristi unutar Docker mreže
# Lokalno razvoj: http://localhost:5000 (default u appsettings.json)
API_URL=http://api:5000
