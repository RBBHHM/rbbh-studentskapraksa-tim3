# Lokalni Development radi i sa svim praznim vrijednostima.
ASPNETCORE_ENVIRONMENT=Development

# Prazno koristi EF Core in-memory bazu.
ConnectionStrings__Default=
COLLATERAL_APPRAISAL_SERVER_NAME=
COLLATERAL_APPRAISAL_DATABASE=rbbh_collateral_appraisal
COLLATERAL_APPRAISAL_TRUSTED_CONNECTION=true
COLLATERAL_APPRAISAL_TRUST_SERVER_CERTIFICATE=true
COLLATERAL_APPRAISAL_DB_USER=
COLLATERAL_APPRAISAL_DB_PASSWORD=

# Prazno/false koristi lokalni Development administrator.
Keycloak__Enabled=false
Keycloak__Authority=
Keycloak__Audience=
Keycloak__Realm=
KeycloakAdmin__BaseUrl=
KeycloakAdmin__Realm=
KeycloakAdmin__ClientId=
KeycloakAdmin__ClientSecret=

# React preskače OIDC kada bilo koja vrijednost nedostaje.
VITE_API_BASE_URL=http://127.0.0.1:5000
VITE_KEYCLOAK_URL=
VITE_KEYCLOAK_REALM=
VITE_KEYCLOAK_CLIENT_ID=
