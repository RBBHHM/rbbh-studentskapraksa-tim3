<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Praksa.Infrastructure</RootNamespace>
    <AssemblyName>Praksa.Infrastructure</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- ASP.NET Core framework reference — daje pristup IHttpContextAccessor, ClaimsPrincipal, itd. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- EF Core za PostgreSQL -->
    <!-- Napomena: Npgsql 9.x zahtijeva EF Core < 10.0.0. Koristimo 9.0.x dok Npgsql 10.x ne bude dostupan. -->
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.5" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- Seed podaci za šifarnike — ugrađeni u assembly da budu dostupni i u Docker image-u. -->
    <EmbeddedResource Include="Seed\codebooks.json" />
    <Content Include="Templates\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Application\Application.csproj" />
    <ProjectReference Include="..\Domain\Domain.csproj" />
  </ItemGroup>

</Project>
