@inject NavigationManager Nav

<div class="page-header">
    <div class="page-header-left">
        <div class="page-title">Dobrodošli, @DisplayName</div>
        <div class="page-subtitle">Protokol narudžbi i obrada faktura.</div>
    </div>
</div>

<div class="section-title" style="margin-bottom:14px;">Brze akcije</div>
<MudGrid Spacing="3" Style="margin-bottom:28px;">
    <MudItem xs="12" sm="6" md="4">
        <AppQuickActionCard Title="Protokol narudžbi"
                             Description="Pregledajte protokol narudžbi i obradite fakture za plaćanje."
                             Icon="@Icons.Material.Outlined.MenuBook"
                             IconBg="#FFF9D6" IconColor="#2B2D33"
                             OnClick="@(() => Nav.NavigateTo("/protokol"))" />
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <AppQuickActionCard Title="Pregled narudžbi"
                             Description="Pregledajte sve narudžbe procjene u sistemu i njihov status."
                             Icon="@Icons.Material.Outlined.ListAlt"
                             IconBg="#F8F6F2" IconColor="#2B2D33"
                             OnClick="@(() => Nav.NavigateTo("/narudzbe"))" />
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <AppQuickActionCard Title="Izvještaji"
                             Description="Generišite izvještaje: koncentracija vještaka, timeline analize."
                             Icon="@Icons.Material.Outlined.BarChart"
                             IconBg="#F8F6F2" IconColor="#2B2D33"
                             OnClick="@(() => Nav.NavigateTo("/izvjestaji"))" />
    </MudItem>
</MudGrid>

@code {
    [Parameter] public string DisplayName { get; set; } = "";
}
