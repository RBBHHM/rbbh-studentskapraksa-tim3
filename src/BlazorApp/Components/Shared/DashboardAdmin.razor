@inject NavigationManager Nav

<div class="page-header">
    <div class="page-header-left">
        <div class="page-title">Dobrodošli, @DisplayName</div>
        <div class="page-subtitle">Administrativni portal za upravljanje pristupom, korisničkim rolama i šifarnicima.</div>
    </div>
</div>

<MudGrid Spacing="3" Style="margin-bottom:28px;">
    <MudItem xs="12" sm="6" md="4">
        <AppQuickActionCard Title="Upravljanje korisnickim rolama"
                             Description="Dodijelite i uklonite role korisnicima. Pratite ko ima pristup čemu."
                             Icon="@Icons.Material.Outlined.ManageAccounts"
                             IconBg="#F8F6F2" IconColor="#2B2D33"
                             OnClick="@(() => Nav.NavigateTo("/admin/upravljanje-rolama"))" />
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <AppQuickActionCard Title="Upravljanje sifarnicima"
                             Description="Administrirajte referentne podatke koji se koriste u formama i procesima."
                             Icon="@Icons.Material.Outlined.LibraryBooks"
                             IconBg="#F8F6F2" IconColor="#2B2D33"
                             OnClick="@(() => Nav.NavigateTo("/admin/sifarnici"))" />
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <AppQuickActionCard Title="Administracija pristupa"
                             Description="Upravljajte definicijama rola, permissionima i audit logom sistema."
                             Icon="@Icons.Material.Outlined.AdminPanelSettings"
                             IconBg="#F8F6F2" IconColor="#2B2D33"
                             OnClick="@(() => Nav.NavigateTo("/admin/pristup"))" />
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <AppQuickActionCard Title="Izvještaji"
                             Description="Generišite izvještaje: koncentracija vještaka i vremenske analize narudžbi."
                             Icon="@Icons.Material.Outlined.BarChart"
                             IconBg="#F8F6F2" IconColor="#2B2D33"
                             OnClick="@(() => Nav.NavigateTo("/izvjestaji"))" />
    </MudItem>
</MudGrid>

<MudGrid Spacing="3">
    <MudItem xs="12" md="6">
        <div class="card" style="height:100%;">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;">
                <div class="section-title" style="margin:0;">Status sistema</div>
                <span style="display:inline-flex;align-items:center;gap:5px;font-size:11.5px;color:var(--text-muted);">
                    <span class="status-dot @(Checking ? "dot-unknown" : "dot-ok")" style="width:7px;height:7px;"></span>
                    @(Checking ? "Provjera..." : "Svi servisi aktivni")
                </span>
            </div>
            @foreach (var svc in Services)
            {
                <div class="service-row">
                    <div class="status-dot @(svc.Status == "Aktivan" ? "dot-ok" : svc.Status == "Greška" ? "dot-error" : "dot-unknown")"></div>
                    <span style="flex:1;font-size:14px;color:var(--rbi-off-black);">@svc.Name</span>
                    <span style="font-size:13px;font-weight:600;color:@(svc.Status == "Aktivan" ? "var(--rbi-green-deep)" : svc.Status == "Greška" ? "var(--rbi-coral-deep)" : "var(--text-muted)");">
                        @svc.Status
                    </span>
                </div>
            }
            <div style="font-size:11px;color:var(--text-faint);margin-top:12px;">
                Posljednja provjera: @LastCheck.ToLocalTime().ToString("HH:mm:ss")
            </div>
        </div>
    </MudItem>
    <MudItem xs="12" md="6">
        <div class="card" style="height:100%;">
            <div class="section-title" style="margin-bottom:16px;">Dostupne funkcionalnosti</div>
            @foreach (var f in new[] {
                ("Narudžbe procjene — FL i PL workflow",    Icons.Material.Outlined.Assignment),
                ("Zadaci i radni tok (CA, CO, vještak)",    Icons.Material.Outlined.AccountTree),
                ("Upravljanje vještacima i dodjelama",      Icons.Material.Outlined.Engineering),
                ("In-app notifikacije i protokol narudžbi", Icons.Material.Outlined.Notifications),
                ("Upravljanje rolama i šifarnicima",        Icons.Material.Outlined.ManageAccounts),
                ("Centralni audit log",                     Icons.Material.Outlined.History),
            })
            {
                <div style="display:flex;align-items:center;gap:10px;padding:7px 0;border-bottom:1px solid var(--rbi-warm-grey-50);font-size:13.5px;color:var(--text-secondary);">
                    <MudIcon Icon="@f.Item2" Style="font-size:17px;color:var(--rbi-off-black);flex-shrink:0;" /> @f.Item1
                </div>
            }
        </div>
    </MudItem>
</MudGrid>

@code {
    [Parameter] public string DisplayName { get; set; } = "";
    [Parameter] public bool Checking { get; set; }
    [Parameter] public DateTime LastCheck { get; set; }
    [Parameter] public IReadOnlyList<(string Name, string Status)> Services { get; set; } = [];
}
