@using MudBlazor
<MudDialog>
    <DialogContent>
        <div style="display:flex; gap:14px; align-items:flex-start;">
            @if (IsDanger)
            {
                <div style="width:40px;height:40px;border-radius:10px;background:var(--rbi-error-light);
                            display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                    <MudIcon Icon="@Icons.Material.Outlined.Warning" Style="font-size:22px;color:var(--rbi-coral-deep);" />
                </div>
            }
            else
            {
                <div style="width:40px;height:40px;border-radius:10px;background:var(--rbi-info-bg);
                            display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                    <MudIcon Icon="@(Icon ?? Icons.Material.Outlined.HelpOutline)" Style="font-size:22px;color:var(--rbi-off-black);" />
                </div>
            }
            <div>
                <MudText Style="font-size:14px; color:var(--rbi-off-black); line-height:1.6;">
                    @((MarkupString)(ContentText ?? ""))
                </MudText>
                @if (IsDanger)
                {
                    <div style="margin-top:10px;padding:8px 12px;background:#FFF0EC;border:1px solid #FFB9A5;
                                border-radius:6px;font-size:12px;color:var(--rbi-coral-deep);display:flex;align-items:center;gap:6px;">
                        <MudIcon Icon="@Icons.Material.Outlined.ErrorOutline" Style="font-size:14px;" />
                        Ova radnja se ne može poništiti.
                    </div>
                }
            </div>
        </div>
    </DialogContent>
    <DialogActions>
        <div style="display:flex;align-items:center;gap:8px;width:100%;justify-content:space-between;">
            <span style="font-size:11px;color:var(--text-faint);">
                <span class="kbd-key" style="font-size:9px;">Esc</span> za odustajanje
            </span>
            <div style="display:flex;gap:8px;">
                <MudButton OnClick="Cancel" Variant="Variant.Text" Style="color:#6B7280;">Odustani</MudButton>
                <MudButton OnClick="Confirm" Variant="Variant.Filled"
                           Style="@(IsDanger ? "background:#C65C4A;color:#fff;font-weight:700;" : "background:#FEE600;color:var(--rbi-off-black);font-weight:700;")">
                    @(ConfirmText ?? "Potvrdi")
                </MudButton>
            </div>
        </div>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public string? ContentText { get; set; }
    [Parameter] public string? ConfirmText { get; set; }
    [Parameter] public bool    IsDanger    { get; set; }
    [Parameter] public string? Icon        { get; set; }

    private void Confirm() => MudDialog.Close(DialogResult.Ok(true));
    private void Cancel()  => MudDialog.Cancel();
}
