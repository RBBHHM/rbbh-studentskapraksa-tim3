@inject OpinionApiService OpinionApi
@inject MeService MeSvc

@*
    OpinionSubmitSection — US-94 (kućica CO / Pravna služba)
    Samostalna komponenta za import PDF mišljenja + komentar.
    Prima OrderId i Role (CO ili Pravna); prikazuje se samo korisniku koji ima
    odgovarajuću permisiju (opinions.submit-co / opinions.submit-legal).
*@

@if (_canSubmit)
{
    <MudPaper Class="pa-4 mb-4" Elevation="2" Style="border-radius:12px;">
        <MudStack Spacing="2">
            <MudText Typo="Typo.h6" Style="font-weight:700;">@Title</MudText>

            @if (_loading)
            {
                <div style="display:flex; justify-content:center; padding:12px;">
                    <MudProgressCircular Indeterminate="true" Color="Color.Warning" Size="Size.Small" />
                </div>
            }
            else if (_opinion is null)
            {
                <MudAlert Severity="Severity.Info" Dense="true">
                    Zahtjev za mišljenje još nije poslan od strane prodaje.
                </MudAlert>
            }
            else if (_opinion.Status == OpinionStatus.Imported)
            {
                <MudAlert Severity="Severity.Success" Dense="true">Mišljenje je dostavljeno.</MudAlert>
                @if (!string.IsNullOrWhiteSpace(_opinion.Comment))
                {
                    <MudText Typo="Typo.body2">@_opinion.Comment</MudText>
                }
                @if (_opinion.DownloadUrl is not null)
                {
                    <MudLink Href="@_opinion.DownloadUrl" Target="_blank">Preuzmi mišljenje</MudLink>
                }
            }
            else
            {
                <MudText Typo="Typo.body2">Unesite komentar i priložite PDF dokument sa mišljenjem.</MudText>

                <MudTextField @bind-Value="_comment"
                               Label="Komentar"
                               Placeholder="Unesite komentar..."
                               Lines="4"
                               Variant="Variant.Outlined"
                               FullWidth="true" />

                <MudFileUpload T="IBrowserFile" FilesChanged="OnFileSelected" Accept=".pdf">
                    <ActivatorContent>
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.UploadFile">
                            Odaberi PDF mišljenje
                        </MudButton>
                    </ActivatorContent>
                </MudFileUpload>

                @if (_selectedFile is not null)
                {
                    <MudAlert Severity="Severity.Info" Dense="true">Odabrani fajl: @_selectedFile.Name</MudAlert>
                }

                <MudButton Variant="Variant.Filled"
                           Disabled="@_isSubmitting"
                           OnClick="SubmitOpinionAsync"
                           Style="background-color:#FEE600; color:var(--rbi-off-black); font-weight:700;">
                    @if (_isSubmitting)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        <span>Slanje...</span>
                    }
                    else
                    {
                        <span>Pošalji mišljenje</span>
                    }
                </MudButton>
            }

            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
            }
        </MudStack>
    </MudPaper>
}

@code {
    [Parameter, EditorRequired] public int OrderId { get; set; }
    [Parameter, EditorRequired] public OpinionType Role { get; set; }

    private const long MaxFileSizeBytes = 10L * 1024 * 1024;

    private MeDto? _me;
    private OpinionDto? _opinion;
    private bool _loading = true;
    private bool _isSubmitting;
    private string? _comment;
    private IBrowserFile? _selectedFile;
    private string? _error;

    private string Title => Role == OpinionType.CO ? "Mišljenje CO" : "Mišljenje Pravne službe";

    private string RequiredPermission => Role == OpinionType.CO
        ? AppPermissions.OpinionsSubmitCo
        : AppPermissions.OpinionsSubmitLegal;

    private bool _canSubmit => _me?.Permissions.Contains(RequiredPermission, StringComparer.OrdinalIgnoreCase) == true;

    protected override async Task OnInitializedAsync()
    {
        var meResult = await MeSvc.GetMeAsync();
        if (meResult.IsSuccess) _me = meResult.Data;

        if (_canSubmit)
            await ReloadAsync();

        _loading = false;
    }

    private async Task ReloadAsync()
    {
        var result = await OpinionApi.GetOpinionsAsync(OrderId);
        if (result.IsSuccess)
            _opinion = result.Data?.FirstOrDefault(o => o.OpinionType == Role);
        else
            _error = result.ErrorMessage ?? "Greška pri učitavanju mišljenja.";
    }

    private void OnFileSelected(IBrowserFile file)
    {
        _selectedFile = file;
        _error = null;
    }

    private async Task SubmitOpinionAsync()
    {
        _error = null;

        if (_selectedFile is null)
        {
            _error = "Potrebno je odabrati PDF dokument.";
            return;
        }

        if (!Path.GetExtension(_selectedFile.Name).Equals(".pdf", StringComparison.OrdinalIgnoreCase))
        {
            _error = "Dozvoljen je samo PDF dokument.";
            return;
        }

        _isSubmitting = true;

        var result = await OpinionApi.SubmitOpinionAsync(OrderId, Role, _selectedFile, _comment);
        if (result.IsSuccess)
        {
            _comment      = null;
            _selectedFile = null;
            await ReloadAsync();
        }
        else
        {
            _error = result.ErrorMessage ?? "Greška pri slanju mišljenja.";
        }

        _isSubmitting = false;
    }
}
