@inject NavigationManager Nav

<nav class="breadcrumb-row" aria-label="Breadcrumb" role="navigation">
    @if (Items is { Count: > 1 })
    {
        <MudIconButton Icon="@Icons.Material.Outlined.ArrowBack"
                       Size="Size.Small"
                       OnClick="@(() => Nav.NavigateTo(Items[Items.Count - 2].Href))"
                       Style="color:var(--text-secondary); margin-right:2px;"
                       aria-label="Nazad" />
    }

    @if (Items is not null)
    {
        @for (var i = 0; i < Items.Count; i++)
        {
            var item = Items[i];
            var isLast = i == Items.Count - 1;

            @if (i > 0)
            {
                <MudIcon Icon="@Icons.Material.Outlined.ChevronRight"
                         Style="font-size:15px;"
                         aria-hidden="true" />
            }

            @if (isLast)
            {
                <span style="font-weight:600; color:var(--rbi-off-black);">@item.Label</span>
            }
            else
            {
                var href = item.Href;
                <span class="breadcrumb-link" @onclick="@(() => Nav.NavigateTo(href))">@item.Label</span>
            }
        }
    }
</nav>

@code {
    [Parameter, EditorRequired]
    public List<BreadcrumbItem> Items { get; set; } = new();

    public sealed record BreadcrumbItem(string Label, string Href);
}
