@inject Us93ApiService Api93
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JS

@* ── Kućica Prodaja — US-93 ────────────────────────────────────────────── *@
<div class="card" style="padding:0;overflow:hidden;">

    @* Zaglavlje kućice *@
    <div style="background:#2B2D33;padding:13px 18px;display:flex;align-items:center;gap:10px;">
        <MudIcon Icon="@Icons.Material.Outlined.Storefront"
                 Style="font-size:17px;color:#FEE600;" />
        <span style="font-size:12px;font-weight:700;text-transform:uppercase;
                     letter-spacing:.7px;color:#FEE600;">
            Prodaja
        </span>
    </div>

    <div style="padding:16px 18px;display:flex;flex-direction:column;gap:14px;">

        @* ─ 0. Dopuna podataka — CA je vratio narudžbu na dopunu ─────────── *@
        @if (CanSubmitCorrection)
        {
            <div style="display:flex;flex-direction:column;gap:10px;
                        padding:12px 14px;background:#FFFDE7;border-radius:8px;
                        border:1px solid #FFF176;">
                <div style="display:flex;align-items:flex-start;gap:12px;">
                    <MudIcon Icon="@Icons.Material.Outlined.WarningAmber"
                             Style="font-size:20px;color:var(--rbi-off-black);margin-top:1px;flex-shrink:0;" />
                    <div>
                        <div style="font-size:13.5px;font-weight:700;color:var(--rbi-off-black);">
                            Potrebna dopuna podataka
                        </div>
                        @if (!string.IsNullOrWhiteSpace(Order.CorrectionReason))
                        {
                            <div style="font-size:12px;color:var(--text-secondary);margin-top:3px;">
                                @Order.CorrectionReason
                            </div>
                        }
                    </div>
                </div>
                <MudTextField @bind-Value="_correctionComment"
                              Label="Komentar (opciono)"
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              Lines="2" Style="width:100%;" />
                <div style="display:flex;justify-content:flex-end;">
                    <MudButton Variant="Variant.Filled"
                               Size="Size.Small"
                               Disabled="_acting"
                               OnClick="SubmitCorrectionAsync"
                               Style="background:#225B45;color:#A3E2CC;font-weight:700;
                                      text-transform:none;white-space:nowrap;">
                        Podaci dopunjeni
                    </MudButton>
                </div>
            </div>
        }

        @* ─ 1. Preuzmi finalnu procjenu ──────────────────────────────────── *@
        @if (CanDownload)
        {
            <div style="display:flex;align-items:center;justify-content:space-between;
                        padding:10px 14px;background:#F8F6F2;border-radius:8px;gap:12px;">
                <div>
                    <div style="font-size:13.5px;font-weight:600;color:var(--rbi-off-black);">
                        Finalna procjena
                    </div>
                    <div style="font-size:12px;color:var(--text-muted);margin-top:1px;">
                        PDF dokument spreman za preuzimanje
                    </div>
                </div>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Warning"
                           Size="Size.Small"
                           Disabled="_acting"
                           StartIcon="@Icons.Material.Outlined.Download"
                           OnClick="DownloadFinalAsync"
                           Style="font-weight:700;color:var(--rbi-off-black);text-transform:none;white-space:nowrap;flex-shrink:0;">
                    Preuzmi
                </MudButton>
            </div>
        }

        @* ─ 2. Task: Preuzet original procjene ──────────────────────────── *@
        @if (Order.IsOriginalReceived)
        {
            @* Završeno — prikaži ko/kad *@
            <div style="display:flex;align-items:flex-start;gap:12px;
                        padding:10px 14px;background:#F0FBF6;border-radius:8px;
                        border:1px solid #A3E2CC;">
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                         Style="font-size:20px;color:var(--rbi-off-black);margin-top:1px;flex-shrink:0;" />
                <div>
                    <div style="font-size:13.5px;font-weight:700;color:var(--rbi-off-black);">
                        Original procjene preuzet
                    </div>
                    @if (Order.OriginalReceivedAt.HasValue)
                    {
                        <div style="font-size:12px;color:var(--text-secondary);margin-top:3px;">
                            @(Order.OriginalReceivedByName ?? "—") ·
                            @Order.OriginalReceivedAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                        </div>
                    }
                </div>
            </div>
        }
        else if (CanConfirmOriginal)
        {
            @* Task koji čeka akciju *@
            <div style="display:flex;align-items:center;justify-content:space-between;
                        padding:10px 14px;border:1.5px dashed #E5DDD2;border-radius:8px;gap:12px;">
                <div style="display:flex;align-items:center;gap:10px;">
                    <MudIcon Icon="@Icons.Material.Outlined.RadioButtonUnchecked"
                             Style="font-size:20px;color:var(--text-muted);flex-shrink:0;" />
                    <div>
                        <div style="font-size:13.5px;font-weight:600;color:var(--rbi-off-black);">
                            Preuzet original procjene
                        </div>
                        <div style="font-size:12px;color:var(--text-muted);margin-top:1px;">
                            Klik po prijemu fizičkog originala od vještaka
                        </div>
                    </div>
                </div>
                <MudButton Variant="Variant.Outlined"
                           Size="Size.Small"
                           Disabled="_acting"
                           OnClick="ConfirmOriginalAsync"
                           Style="color:var(--rbi-off-black);border-color:var(--rbi-off-black);font-weight:700;
                                  text-transform:none;white-space:nowrap;flex-shrink:0;">
                    Potvrdi prijem
                </MudButton>
            </div>
        }

        @* ─ 3. Reminder vještaku ─────────────────────────────────────────── *@
        @if (CanRemind)
        {
            <div style="display:flex;align-items:center;justify-content:space-between;
                        padding:10px 14px;background:#FFFDE7;border-radius:8px;
                        border:1px solid #FFF176;gap:12px;">
                <div>
                    <div style="font-size:13.5px;font-weight:600;color:var(--rbi-off-black);">
                        Reminder vještaku
                    </div>
                    @if (Order.AppraiserReminderCount > 0)
                    {
                        <div style="font-size:12px;color:var(--rbi-off-black);margin-top:2px;">
                            Poslano: @Order.AppraiserReminderCount
                            @(Order.AppraiserReminderCount == 1 ? "podsjetnik" :
                              Order.AppraiserReminderCount is 2 or 3 or 4 ? "podsjetnika" : "podsjetnika")
                            @if (Order.AppraiserReminderLastSentAt.HasValue)
                            {
                                <span>
                                    · zadnji @Order.AppraiserReminderLastSentAt.Value.ToLocalTime().ToString("dd.MM.")
                                </span>
                            }
                        </div>
                    }
                    else
                    {
                        <div style="font-size:12px;color:var(--text-muted);margin-top:1px;">
                            Podsjetnik za dostavu originala procjene
                        </div>
                    }
                </div>
                <MudButton Variant="Variant.Outlined"
                           Size="Size.Small"
                           Disabled="_acting"
                           StartIcon="@Icons.Material.Outlined.NotificationsActive"
                           OnClick="SendReminderAsync"
                           Style="color:var(--rbi-off-black);border-color:#D4BF00;font-weight:700;
                                  text-transform:none;white-space:nowrap;flex-shrink:0;">
                    Pošalji
                </MudButton>
            </div>
        }

        @* ─ 4. Saglasnost klijenta — samo PL narudžbe ───────────────────── *@
        @if (Order.SalesConsentSigned)
        {
            <div style="display:flex;align-items:flex-start;gap:12px;
                        padding:10px 14px;background:#F0FBF6;border-radius:8px;
                        border:1px solid #A3E2CC;">
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                         Style="font-size:20px;color:var(--rbi-off-black);margin-top:1px;flex-shrink:0;" />
                <div>
                    <div style="font-size:13.5px;font-weight:700;color:var(--rbi-off-black);">
                        Saglasnost klijenta evidentirana
                    </div>
                    @if (Order.SalesConsentSignedAt.HasValue)
                    {
                        <div style="font-size:12px;color:var(--text-secondary);margin-top:3px;">
                            @(Order.SalesConsentSignedByName ?? "—") ·
                            @Order.SalesConsentSignedAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                        </div>
                    }
                </div>
            </div>
        }
        else if (CanSignConsent)
        {
            <div style="display:flex;align-items:center;justify-content:space-between;
                        padding:10px 14px;border:1.5px dashed #E5DDD2;border-radius:8px;gap:12px;">
                <div style="display:flex;align-items:center;gap:10px;">
                    <MudIcon Icon="@Icons.Material.Outlined.AssignmentTurnedIn"
                             Style="font-size:20px;color:var(--text-muted);flex-shrink:0;" />
                    <div>
                        <div style="font-size:13.5px;font-weight:600;color:var(--rbi-off-black);">
                            Popuni saglasnost
                        </div>
                        <div style="font-size:12px;color:var(--text-muted);margin-top:1px;">
                            Evidentiranje potpisane saglasnosti klijenta
                        </div>
                    </div>
                </div>
                <MudButton Variant="Variant.Outlined"
                           Size="Size.Small"
                           Disabled="_acting"
                           OnClick="SignConsentAsync"
                           Style="color:var(--rbi-off-black);border-color:var(--rbi-off-black);font-weight:700;
                                  text-transform:none;white-space:nowrap;flex-shrink:0;">
                    Potvrdi saglasnost
                </MudButton>
            </div>
        }

        @* Poruka ako nema dostupnih akcija *@
        @if (!CanDownload && !CanConfirmOriginal && !Order.IsOriginalReceived && !CanRemind && !CanSubmitCorrection && !CanSignConsent && !Order.SalesConsentSigned)
        {
            <div style="text-align:center;padding:16px 8px;color:var(--text-muted);font-size:13px;">
                Nema dostupnih akcija za trenutni status narudžbe.
            </div>
        }

    </div>
</div>

@code {
    [Parameter, EditorRequired] public AppraisalOrderDetailDto Order { get; set; } = default!;
    [Parameter] public EventCallback OnRefresh { get; set; }

    private bool _acting;

    // Vidljivost dugmadi: koristi capabilities (T4/T5) uz status fallback
    private bool CanDownload =>
        Order.Capabilities.CanDownloadFinal ||
        Order.Status is "ReadyForProcedure" or "OriginalReceived" or "Completed";

    private bool CanConfirmOriginal =>
        Order.Capabilities.CanConfirmOriginal ||
        (Order.Status == "ReadyForProcedure" && !Order.IsOriginalReceived);

    private bool CanRemind =>
        Order.Capabilities.CanRemindAppraiser ||
        (Order.Status == "ReadyForProcedure" && !Order.IsOriginalReceived);

    // US-91/92: CA je vratio narudžbu na dopunu — Prodaja dostavlja dopunu
    private bool CanSubmitCorrection =>
        Order.Capabilities.CanSubmitCorrection ||
        Order.IsReturnedForCorrection;

    // Saglasnost klijenta — PL-specifičan korak
    private bool CanSignConsent => Order.Capabilities.CanSignConsent;

    private string? _correctionComment;

    private async Task DownloadFinalAsync()
    {
        _acting = true;
        var r = await Api93.GetFinalAppraisalAsync(Order.Id);
        _acting = false;

        if (!r.IsSuccess)
        {
            Snackbar.Add(r.ErrorMessage ?? "Greška pri dohvatu dokumenta.", Severity.Error);
            return;
        }

        await JS.InvokeVoidAsync("open", $"/files/documents/{r.Data!.DocumentId}", "_blank");
    }

    private async Task ConfirmOriginalAsync()
    {
        var dialog = await DialogService.ShowAsync<ConfirmDialog>(
            "Potvrda prijema originala",
            new DialogParameters
            {
                ["ContentText"] = "Potvrđujete da ste fizički primili original procjene od vještaka? " +
                                  "Akcija bilježi vaše ime i trenutno vrijeme.",
                ["ConfirmText"] = "Potvrdi prijem"
            });

        if (await dialog.Result is { Canceled: false })
        {
            _acting = true;
            var r = await Api93.ConfirmOriginalAsync(Order.Id);
            _acting = false;

            if (r.IsSuccess)
            {
                Snackbar.Add("Original procjene potvrđen. Notifikacija poslana na CA i CO.", Severity.Success);
                await OnRefresh.InvokeAsync();
            }
            else
            {
                Snackbar.Add(r.ErrorMessage ?? "Greška pri potvrdi prijema.", Severity.Error);
            }
        }
    }

    private async Task SubmitCorrectionAsync()
    {
        _acting = true;
        var r = await Api93.SubmitCorrectionAsync(Order.Id, _correctionComment);
        _acting = false;

        if (r.IsSuccess)
        {
            Snackbar.Add("Dopuna podataka dostavljena. Kolateral administrator je obaviješten.", Severity.Success);
            _correctionComment = null;
            await OnRefresh.InvokeAsync();
        }
        else
        {
            Snackbar.Add(r.ErrorMessage ?? "Greška pri dostavi dopune.", Severity.Error);
        }
    }

    private async Task SendReminderAsync()
    {
        _acting = true;
        var r = await Api93.RemindAppraiserAsync(Order.Id);
        _acting = false;

        if (r.IsSuccess)
        {
            var count = r.Data?.ReminderCount ?? (Order.AppraiserReminderCount + 1);
            Snackbar.Add($"Reminder vještaku poslan (ukupno: {count}).", Severity.Success);
            await OnRefresh.InvokeAsync();
        }
        else
        {
            Snackbar.Add(r.ErrorMessage ?? "Greška pri slanju reminders.", Severity.Error);
        }
    }

    private async Task SignConsentAsync()
    {
        var dialog = await DialogService.ShowAsync<ConfirmDialog>(
            "Potvrda saglasnosti klijenta",
            new DialogParameters
            {
                ["ContentText"] = "Potvrđujete da je klijent potpisao saglasnost? " +
                                  "Akcija bilježi vaše ime i trenutno vrijeme.",
                ["ConfirmText"] = "Potvrdi saglasnost"
            });

        if (await dialog.Result is { Canceled: false })
        {
            _acting = true;
            var r = await Api93.SignConsentAsync(Order.Id);
            _acting = false;

            if (r.IsSuccess)
            {
                Snackbar.Add("Saglasnost klijenta evidentirana.", Severity.Success);
                await OnRefresh.InvokeAsync();
            }
            else
            {
                Snackbar.Add(r.ErrorMessage ?? "Greška pri evidenciji saglasnosti.", Severity.Error);
            }
        }
    }
}
