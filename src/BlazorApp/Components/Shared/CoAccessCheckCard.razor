@inject Us93ApiService Api93
@inject ISnackbar Snackbar
@inject IDialogService DialogService

@* ── Kućica Kolateral oficir — provjera pristupa prije narudžbe (US-93) ──── *@
<div class="card" style="padding:0;overflow:hidden;">

    @* Zaglavlje kućice *@
    <div style="background:var(--rbi-off-black);padding:13px 18px;display:flex;align-items:center;gap:10px;">
        <MudIcon Icon="@Icons.Material.Outlined.VerifiedUser"
                 Style="font-size:17px;color:#E0D0FF;" />
        <span style="font-size:12px;font-weight:700;text-transform:uppercase;
                     letter-spacing:.7px;color:#E0D0FF;">
            Provjera pristupa
        </span>
    </div>

    <div style="padding:16px 18px;display:flex;flex-direction:column;gap:14px;">

        @* ─ Akcije: Uredan pristup / Dopuna ───────────────────────────────── *@
        @if (CanAccessCheck)
        {
            <div style="display:flex;align-items:center;justify-content:space-between;
                        padding:10px 14px;border:1.5px dashed #C9AAFF;border-radius:8px;gap:12px;flex-wrap:wrap;">
                <div style="display:flex;align-items:center;gap:10px;">
                    <MudIcon Icon="@Icons.Material.Outlined.RadioButtonUnchecked"
                             Style="font-size:20px;color:var(--text-muted);flex-shrink:0;" />
                    <div>
                        <div style="font-size:13.5px;font-weight:600;color:var(--rbi-off-black);">
                            Provjera pristupa prije narudžbe
                        </div>
                        <div style="font-size:12px;color:var(--text-muted);margin-top:1px;">
                            Provjerite da li je pristup nekretnini uredan prije slanja vještaku
                        </div>
                    </div>
                </div>
                <div style="display:flex;gap:8px;flex-shrink:0;">
                    <MudButton Variant="Variant.Outlined"
                               Size="Size.Small"
                               Disabled="_acting"
                               OnClick="RejectAccessAsync"
                               Style="color:var(--rbi-coral-deep);border-color:var(--rbi-coral-deep);font-weight:700;
                                      text-transform:none;white-space:nowrap;">
                        Dopuna
                    </MudButton>
                    <MudButton Variant="Variant.Filled"
                               Size="Size.Small"
                               Disabled="_acting"
                               OnClick="ApproveAccessAsync"
                               Style="background:var(--rbi-off-black);color:#E0D0FF;font-weight:700;
                                      text-transform:none;white-space:nowrap;">
                        Uredan pristup
                    </MudButton>
                </div>
            </div>
        }

        @* ─ Pristup potvrđen ili dalje u toku ────────────────────────────── *@
        @if (IsApprovedOrLater)
        {
            <div style="display:flex;align-items:flex-start;gap:12px;
                        padding:10px 14px;background:#F5F0FF;border-radius:8px;
                        border:1px solid #C9AAFF;">
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                         Style="font-size:20px;color:var(--rbi-off-black);margin-top:1px;flex-shrink:0;" />
                <div style="font-size:13.5px;font-weight:700;color:var(--rbi-off-black);">
                    Pristup potvrđen
                </div>
            </div>
        }

        @* ─ Vraćeno CA na ponovni pregled ─────────────────────────────────── *@
        @if (Order.IsAccessCheckRejected)
        {
            <div style="display:flex;align-items:flex-start;gap:12px;
                        padding:10px 14px;background:#FFFDE7;border-radius:8px;
                        border:1px solid #FFF176;">
                <MudIcon Icon="@Icons.Material.Outlined.Schedule"
                         Style="font-size:20px;color:var(--rbi-off-black);margin-top:1px;flex-shrink:0;" />
                <div style="font-size:13.5px;font-weight:700;color:var(--rbi-off-black);">
                    Vraćeno kolateral administratoru na ponovni pregled
                </div>
            </div>
        }

        @* Poruka ako nema dostupnih akcija *@
        @if (!CanAccessCheck && !IsApprovedOrLater && !Order.IsAccessCheckRejected)
        {
            <div style="text-align:center;padding:16px 8px;color:var(--text-muted);font-size:13px;">
                Provjera pristupa nije dostupna za trenutni status narudžbe.
            </div>
        }

    </div>
</div>

@code {
    [Parameter, EditorRequired] public AppraisalOrderDetailDto Order { get; set; } = default!;
    [Parameter] public EventCallback OnRefresh { get; set; }

    private bool _acting;

    private bool CanAccessCheck =>
        Order.Capabilities.CanAccessCheck || Order.IsAccessCheckRequested;

    private bool IsApprovedOrLater =>
        Order.Status is "AccessCheckApproved" or "ProtocolCreated" or "AppraiserSelected"
                      or "DocumentsGenerated" or "OrderSentToAppraiser" or "AdditionalPaymentRequested"
                      or "AdditionalPaymentCompleted" or "AppraisalInProgress" or "AppraisalReceived"
                      or "COApproved" or "ReadyForProcedure" or "OriginalReceived" or "Completed";

    private async Task ApproveAccessAsync()
    {
        var dialog = await DialogService.ShowAsync<ConfirmDialog>(
            "Potvrda pristupa",
            new DialogParameters
            {
                ["ContentText"] = $"Narudžba {Order.OrderNumber}: potvrđujete da je pristup nekretnini " +
                                  "uredan? Narudžba ide kolateral administratoru na odabir vještaka.",
                ["ConfirmText"] = "Uredan pristup"
            });

        if (await dialog.Result is { Canceled: false })
        {
            _acting = true;
            var r = await Api93.ApproveAccessCheckAsync(Order.Id, null);
            _acting = false;

            if (r.IsSuccess)
            {
                Snackbar.Add("Pristup potvrđen. Kolateral administrator je obaviješten.", Severity.Success);
                await OnRefresh.InvokeAsync();
            }
            else
            {
                Snackbar.Add(r.ErrorMessage ?? "Greška pri potvrdi pristupa.", Severity.Error);
            }
        }
    }

    private async Task RejectAccessAsync()
    {
        var dialog = await DialogService.ShowAsync<AccessCheckRejectDialog>("Dopuna prije provjere pristupa");
        var result = await dialog.Result;

        if (result is { Canceled: false } dialogResult && dialogResult.Data is string comment)
        {
            _acting = true;
            var r = await Api93.RejectAccessCheckAsync(Order.Id, comment);
            _acting = false;

            if (r.IsSuccess)
            {
                Snackbar.Add("Narudžba vraćena kolateral administratoru na ponovni pregled.", Severity.Success);
                await OnRefresh.InvokeAsync();
            }
            else
            {
                Snackbar.Add(r.ErrorMessage ?? "Greška pri vraćanju na pregled.", Severity.Error);
            }
        }
    }
}
