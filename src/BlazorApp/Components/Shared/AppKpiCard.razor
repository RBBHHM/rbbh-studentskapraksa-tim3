<div class="metric-card @CssClass @(OnClick.HasDelegate ? "clickable" : "")"
     @onclick="@(() => OnClick.InvokeAsync())">
    <div class="qa-icon-wrap">
        <MudIcon Icon="@Icon" />
    </div>
    <div style="min-width:0;">
        <div class="metric-value">@(ValueText ?? Value.ToString())</div>
        <div class="metric-label">@Label</div>
    </div>
</div>

@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public int    Value { get; set; }
    [Parameter] public string? ValueText { get; set; }
    [Parameter] public string Icon { get; set; } = Icons.Material.Outlined.Assignment;
    /// <summary>Semantička CSS klasa: "metric-success" ili "metric-danger". Prazno = žuti default.</summary>
    [Parameter] public string? Variant { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }

    // Legacy parametri — ignorirani, zadržani za backward compatibility
    [Parameter] public string? IconBg { get; set; }
    [Parameter] public string? IconColor { get; set; }
    [Parameter] public string? BorderColor { get; set; }
    [Parameter] public string? Subtitle { get; set; }

    private string CssClass => Variant switch
    {
        "success" => "metric-success",
        "danger"  => "metric-danger",
        _         => ""
    };
}
