@inject NavigationManager Nav

<div class="page-header">
    <div class="page-header-left">
        <div class="page-title">Dobrodošli, @DisplayName</div>
        <div class="page-subtitle">@Subtitle</div>
    </div>
</div>

@* ── Informativni banner o ulozi ──────────────────────────────── *@
<div style="background:var(--accent-light, #EAF0F8); border:1px solid #C8D8EC; border-radius:10px;
            padding:14px 18px; margin-bottom:24px; display:flex; gap:12px; align-items:center;">
    <MudIcon Icon="@Icons.Material.Outlined.AccountBalance"
             Style="font-size:24px; color:var(--accent, #1B3F6E); flex-shrink:0;" />
    <div>
        <div style="font-weight:700; font-size:14px; color:var(--rbi-off-black);">@RoleName</div>
        <div style="font-size:13px; color:var(--text-secondary); margin-top:2px;">@RoleDescription</div>
    </div>
</div>

<div class="section-title" style="margin-bottom:14px;">Brze akcije</div>
<MudGrid Spacing="3" Style="margin-bottom:28px;">

    @if (IsLikvidatura)
    {
        <MudItem xs="12" sm="6" md="4">
            <AppQuickActionCard Title="Protokol narudžbi"
                                 Description="Pregledajte narudžbe za koje trebate uploadovati fakturu ili potvrditi plaćanje."
                                 Icon="@Icons.Material.Outlined.Receipt"
                                 IconBg="#FFF9D6" IconColor="#2B2D33"
                                 OnClick="@(() => Nav.NavigateTo("/protokol"))" />
        </MudItem>
        <MudItem xs="12" sm="6" md="4">
            <AppQuickActionCard Title="Pregled narudžbi"
                                 Description="Lista svih narudžbi — filtrirajte po statusu fakture."
                                 Icon="@Icons.Material.Outlined.ListAlt"
                                 IconBg="#F8F6F2" IconColor="#2B2D33"
                                 OnClick="@(() => Nav.NavigateTo("/narudzbe"))" />
        </MudItem>
    }

    @if (IsSpecijalniRacuni || IsRacunovodstvo)
    {
        <MudItem xs="12" sm="6" md="4">
            <AppQuickActionCard Title="Pregled narudžbi"
                                 Description="Pregledajte narudžbe koje su u fazi fakturisanja."
                                 Icon="@Icons.Material.Outlined.ListAlt"
                                 IconBg="#FFF9D6" IconColor="#2B2D33"
                                 OnClick="@(() => Nav.NavigateTo("/narudzbe"))" />
        </MudItem>
        <MudItem xs="12" sm="6" md="4">
            <AppQuickActionCard Title="Protokol narudžbi"
                                 Description="Detaljni protokol svih narudžbi s vremenskim kalkulacijama."
                                 Icon="@Icons.Material.Outlined.MenuBook"
                                 IconBg="#F8F6F2" IconColor="#2B2D33"
                                 OnClick="@(() => Nav.NavigateTo("/protokol"))" />
        </MudItem>
    }

    <MudItem xs="12" sm="6" md="4">
        <AppQuickActionCard Title="Izvještaji"
                             Description="Generišite finansijske i procesne izvještaje."
                             Icon="@Icons.Material.Outlined.BarChart"
                             IconBg="#F8F6F2" IconColor="#2B2D33"
                             OnClick="@(() => Nav.NavigateTo("/izvjestaji"))" />
    </MudItem>

</MudGrid>

@code {
    [Parameter, EditorRequired] public string DisplayName     { get; set; } = "";
    [Parameter, EditorRequired] public string RoleName        { get; set; } = "";
    [Parameter]                 public bool   IsLikvidatura   { get; set; }
    [Parameter]                 public bool   IsSpecijalniRacuni { get; set; }
    [Parameter]                 public bool   IsRacunovodstvo { get; set; }

    private string Subtitle => IsLikvidatura
        ? "Upload faktura i potvrda plaćanja."
        : IsSpecijalniRacuni
            ? "Pregled notifikacija o fakturama pravnih lica."
            : "Evidentiranje plaćanja i finansijski izvještaji.";

    private string RoleDescription => IsLikvidatura
        ? "Vaš zadatak: uploadujte fakturu vještaka i potvrdite plaćanje kada banka izvrši transfer."
        : IsSpecijalniRacuni
            ? "Vaš zadatak: pratite fakture za narudžbe pravnih lica (PL) i budite informisani o statusu plaćanja."
            : "Vaš zadatak: evidentiranje izvršenih plaćanja i generisanje finansijskih izvještaja.";
}
