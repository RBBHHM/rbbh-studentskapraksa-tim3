@inject Us93ApiService Api93
@inject ISnackbar Snackbar
@inject IJSRuntime JS

@* ── Kućica Kolateral administrator — US-93 (pregled, read-only) ───────── *@
<div class="card" style="padding:0;overflow:hidden;">

    @* Zaglavlje kućice *@
    <div style="background:#225B45;padding:13px 18px;display:flex;align-items:center;gap:10px;">
        <MudIcon Icon="@Icons.Material.Outlined.AccountBalanceWallet"
                 Style="font-size:17px;color:#A3E2CC;" />
        <span style="font-size:12px;font-weight:700;text-transform:uppercase;
                     letter-spacing:.7px;color:#A3E2CC;">
            Kolateral administrator
        </span>
    </div>

    <div style="padding:16px 18px;display:flex;flex-direction:column;gap:14px;">

        @* ─ Preuzmi finalnu procjenu ─────────────────────────────────────── *@
        @if (CanDownload)
        {
            <div style="display:flex;align-items:center;justify-content:space-between;
                        padding:10px 14px;background:#F8F6F2;border-radius:8px;gap:12px;">
                <div>
                    <div style="font-size:13.5px;font-weight:600;color:var(--rbi-off-black);">
                        Finalna procjena
                    </div>
                    <div style="font-size:12px;color:var(--text-muted);margin-top:1px;">
                        PDF dokument spreman za preuzimanje
                    </div>
                </div>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Warning"
                           Size="Size.Small"
                           Disabled="_acting"
                           StartIcon="@Icons.Material.Outlined.Download"
                           OnClick="DownloadFinalAsync"
                           Style="font-weight:700;color:var(--rbi-off-black);text-transform:none;white-space:nowrap;flex-shrink:0;">
                    Preuzmi
                </MudButton>
            </div>
        }

        @* ─ Status: odobrenje CO ─────────────────────────────────────────── *@
        @if (Order.CoApprovedAt.HasValue)
        {
            <div style="display:flex;align-items:flex-start;gap:12px;
                        padding:10px 14px;background:#F5F0FF;border-radius:8px;
                        border:1px solid #C9AAFF;">
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                         Style="font-size:20px;color:var(--rbi-off-black);margin-top:1px;flex-shrink:0;" />
                <div>
                    <div style="font-size:13.5px;font-weight:700;color:var(--rbi-off-black);">
                        Procjena odobrena od CO
                    </div>
                    <div style="font-size:12px;color:var(--text-secondary);margin-top:3px;">
                        @(Order.CoApprovedByName ?? "—") ·
                        @Order.CoApprovedAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                    </div>
                </div>
            </div>
        }
        else if (Order.Status is "AppraisalReceived" or "COApproved")
        {
            <div style="display:flex;align-items:center;gap:12px;
                        padding:10px 14px;background:#F8F6F2;border-radius:8px;">
                <MudIcon Icon="@Icons.Material.Outlined.Schedule"
                         Style="font-size:20px;color:var(--text-muted);flex-shrink:0;" />
                <div style="font-size:13.5px;font-weight:600;color:var(--rbi-off-black);">
                    Čeka se odobrenje CO za finalnu procjenu
                </div>
            </div>
        }

        @* ─ Status: preuzimanje originala ────────────────────────────────── *@
        @if (Order.IsOriginalReceived)
        {
            <div style="display:flex;align-items:flex-start;gap:12px;
                        padding:10px 14px;background:#F0FBF6;border-radius:8px;
                        border:1px solid #A3E2CC;">
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                         Style="font-size:20px;color:var(--rbi-off-black);margin-top:1px;flex-shrink:0;" />
                <div>
                    <div style="font-size:13.5px;font-weight:700;color:var(--rbi-off-black);">
                        Original procjene preuzet
                    </div>
                    @if (Order.OriginalReceivedAt.HasValue)
                    {
                        <div style="font-size:12px;color:var(--text-secondary);margin-top:3px;">
                            @(Order.OriginalReceivedByName ?? "—") ·
                            @Order.OriginalReceivedAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                        </div>
                    }
                </div>
            </div>
        }
        else if (Order.IsReadyForProcedure)
        {
            <div style="display:flex;align-items:center;gap:12px;
                        padding:10px 14px;background:#F8F6F2;border-radius:8px;">
                <MudIcon Icon="@Icons.Material.Outlined.Schedule"
                         Style="font-size:20px;color:var(--text-muted);flex-shrink:0;" />
                <div style="font-size:13.5px;font-weight:600;color:var(--rbi-off-black);">
                    Čeka se preuzimanje originala procjene u poslovnici
                </div>
            </div>
        }

        @* Poruka ako nema dostupnih informacija *@
        @if (!CanDownload && !Order.CoApprovedAt.HasValue && Order.Status is not ("AppraisalReceived" or "COApproved")
                            && !Order.IsOriginalReceived && !Order.IsReadyForProcedure)
        {
            <div style="text-align:center;padding:16px 8px;color:var(--text-muted);font-size:13px;">
                Nema dostupnih informacija za trenutni status narudžbe.
            </div>
        }

    </div>
</div>

@code {
    [Parameter, EditorRequired] public AppraisalOrderDetailDto Order { get; set; } = default!;

    private bool _acting;

    // Vidljivost dugmeta za preuzimanje: koristi capabilities (T4) uz status fallback
    private bool CanDownload =>
        Order.Capabilities.CanDownloadFinal ||
        Order.Status is "AppraisalReceived" or "COApproved" or "ReadyForProcedure" or "OriginalReceived" or "Completed";

    private async Task DownloadFinalAsync()
    {
        _acting = true;
        var r = await Api93.GetFinalAppraisalAsync(Order.Id);
        _acting = false;

        if (!r.IsSuccess)
        {
            Snackbar.Add(r.ErrorMessage ?? "Greška pri dohvatu dokumenta.", Severity.Error);
            return;
        }

        await JS.InvokeVoidAsync("open", $"/files/documents/{r.Data!.DocumentId}", "_blank");
    }
}
