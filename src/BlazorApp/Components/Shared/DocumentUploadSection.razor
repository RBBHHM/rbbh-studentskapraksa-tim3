    // ── Runtime model kartice ────────────────────────────────────────────
    private sealed class DocCard
    {
        public required string   Code        { get; init; }
        public required string   Label       { get; init; }
        public required string[] TypeCodes   { get; init; }
        public bool              IsMandatory { get; init; }
        public bool              IsMultiple  { get; init; }
        public string[]?         Notes       { get; init; }
        public string            Group       { get; init; } = "Ostalo";
        public int?              TypeId      { get; set; }
        public DocumentDto?      ActiveDoc   { get; set; }
        public List<DocumentDto> AllDocs     { get; set; } = [];
        public bool HasActive => ActiveDoc is not null || (IsMultiple && AllDocs.Any(d => d.IsActive));
    }

    // ── State ────────────────────────────────────────────────────────────
    private bool     _loading     = true;
    private string?  _loadError;
    private string?  _busyCardCode;
    private string?  _activeDocTab;

    private MeDto?                    _me;
    private List<CodebookValueItem>   _documentTypes = [];
    private List<DocumentDto>         _documents     = [];
    private List<DocCard>             _cards         = [];

    private static readonly string[] _groupOrder = ["Obavezni", "Pravni", "Nekretnina", "Finansijski", "Ostalo"];
    private static readonly Dictionary<string, string> _groupIcons = new()
    {
        ["Obavezni"]    = Icons.Material.Outlined.Warning,
        ["Pravni"]      = Icons.Material.Outlined.Gavel,
        ["Nekretnina"]  = Icons.Material.Outlined.Home,
        ["Finansijski"] = Icons.Material.Outlined.AccountBalance,
        ["Ostalo"]      = Icons.Material.Outlined.FolderOpen,
    };

    private List<IGrouping<string, DocCard>> _docGroups =>
        _cards.GroupBy(c => c.Group)
              .OrderBy(g => Array.IndexOf(_groupOrder, g.Key) is var idx && idx >= 0 ? idx : 99)
              .ToList();

    private int GroupDelivered(string group) =>
        _cards.Where(c => c.Group == group && c.HasActive).Count();
    private int GroupTotal(string group) =>
        _cards.Count(c => c.Group == group);

    private readonly HashSet<string> _expandedHistory = [];
    private readonly HashSet<string> _checkedNotes = [];
    private readonly Dictionary<string, string> _docComments = new();

    private bool GetNoteChecked(string key) => _checkedNotes.Contains(key);
    private void SetNoteChecked(string key, bool value) { if (value) _checkedNotes.Add(key); else _checkedNotes.Remove(key); }
    private string GetDocComment(string code) => _docComments.GetValueOrDefault(code, "");
    private void SetDocComment(string code, string? value) { if (string.IsNullOrWhiteSpace(value)) _docComments.Remove(code); else _docComments[code] = value; }

    private bool _canView     => Has(AppPermissions.DocumentsView);
    private bool _canUpload   => Has(AppPermissions.DocumentsUpload);
    private bool _canDownload => Has(AppPermissions.DocumentsDownload);
    private bool _canDelete   => Has(AppPermissions.DocumentsDelete);

    private bool Has(string p) =>
        _me?.Permissions.Contains(p, StringComparer.OrdinalIgnoreCase) == true;

    private DocCardDef[] ActiveDefs =>
        string.Equals(ClientType, "PL", StringComparison.OrdinalIgnoreCase) ? PlCards : FlCards;

    private IEnumerable<DocCard> _mandatory => _cards.Where(c => c.IsMandatory);

    private int MandatoryPct
    {
        get
        {
            var total = _mandatory.Count();
            if (total == 0) return 100;
            return (int)Math.Round(_mandatory.Count(c => c.HasActive) / (double)total * 100);
        }
    }

    // ── Lifecycle ────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        var meResult = await MeSvc.GetMeAsync();
        if (meResult.IsSuccess) _me = meResult.Data;

        if (_canView) await ReloadAsync();
        _loading = false;
    }

    private async Task ReloadAsync()
    {
        _loadError = null;

        if (_documentTypes.Count == 0)
        {
            var typesResult = await DocApi.GetDocumentTypesAsync();
            if (typesResult.IsSuccess)  _documentTypes = typesResult.Data ?? [];
            else { _loadError = typesResult.ErrorMessage ?? "Greška pri učitavanju tipova dokumenata."; return; }
        }

        var docsResult = await DocApi.GetByOrderAsync(OrderId);
        if (docsResult.IsSuccess) _documents = docsResult.Data ?? [];
        else { _loadError = docsResult.ErrorMessage ?? "Greška pri učitavanju dokumenata."; return; }

        BuildCards();
        await NotifyStats();
    }

    private void BuildCards()
    {
        _cards = ActiveDefs.OrderByDescending(d => d.IsMandatory).Select(def =>
        {
            var matchedTypes = _documentTypes
                .Where(t => def.TypeCodes.Contains(t.Code, StringComparer.OrdinalIgnoreCase))
                .ToList();

            var typeId = matchedTypes.FirstOrDefault()?.Id;
            var typeIds = matchedTypes.Select(t => t.Id).ToHashSet();

            var allDocs = _documents
                .Where(d => d.DocumentTypeId.HasValue && typeIds.Contains(d.DocumentTypeId.Value))
                .OrderByDescending(d => d.Version)
                .ThenByDescending(d => d.Id)
                .ToList();

            var active = allDocs.FirstOrDefault(d => d.IsActive);

            return new DocCard
            {
                Code        = def.Code,
                Label       = def.Label,
                TypeCodes   = def.TypeCodes,
                IsMandatory = def.IsMandatory,
                IsMultiple  = def.IsMultiple,
                Notes       = def.Notes,
                Group       = def.Group,
                TypeId      = typeId,
                ActiveDoc   = active,
                AllDocs     = allDocs,
            };
        }).ToList();

        if (_activeDocTab is null && _docGroups.Count > 0)
            _activeDocTab = _docGroups[0].Key;
    }

    private async Task NotifyStats()
    {
        if (OnStatsChanged.HasDelegate)
        {
            var items = _cards.Select(c => (c.Label, c.HasActive, c.IsMandatory)).ToList();
            await OnStatsChanged.InvokeAsync(items);
        }
    }

    // ── AC3.2 — starost dokumenta ────────────────────────────────────────

    private static readonly Dictionary<string, int> DocMaxAgeDays = new()
    {
        { "ZK",  30 },
        { "KKP", 90 },
    };

    private static bool IsDocumentTooOld(DocCard card, out int maxDays)
    {
        maxDays = 0;
        if (card.ActiveDoc is null) return false;
        if (!DocMaxAgeDays.TryGetValue(card.Code, out maxDays)) return false;
        return (DateTime.UtcNow - card.ActiveDoc.UploadedAt).TotalDays > maxDays;
    }

    // ── Status ───────────────────────────────────────────────────────────

    private static string StatusLabel(DocCard card)
    {
        if (card.IsMultiple)
        {
            var count = card.AllDocs.Count(d => d.IsActive);
            return count == 0 ? "Nije dostavljen" : $"{count} fajla";
        }
        if (card.ActiveDoc is null) return "Nije dostavljen";
        return card.ActiveDoc.Version == 1 ? "Dostavljen" : "Zamijenjen";
    }

    private static string StatusBadgeClass(DocCard card)
    {
        if (card.IsMultiple)
            return card.AllDocs.Any(d => d.IsActive) ? "ds-status ds-status-ok" : "ds-status ds-status-none";
        if (card.ActiveDoc is null) return "ds-status ds-status-none";
        return card.ActiveDoc.Version == 1
            ? "ds-status ds-status-ok"
            : "ds-status ds-status-replaced";
    }

    // ── Upload ───────────────────────────────────────────────────────────

    private async Task OnFilesSelectedAsync(InputFileChangeEventArgs e, DocCard card)
    {
        if (!card.TypeId.HasValue) return;

        IReadOnlyList<IBrowserFile> selected;
        try   { selected = e.GetMultipleFiles(MaxFilesPerUpload); }
        catch { Snackbar.Add($"Možete priložiti najviše {MaxFilesPerUpload} dokumenata odjednom.", Severity.Warning); return; }

        if (selected.Count == 0) return;

        var invalid = selected.FirstOrDefault(f => !IsValidFile(f));
        if (invalid is not null) { Snackbar.Add(FileValidationMessage(invalid), Severity.Warning); return; }

        _busyCardCode = card.Code;
        try
        {
            var files = new List<UploadFile>(selected.Count);
            foreach (var file in selected)
            {
                using var ms = new MemoryStream();
                await file.OpenReadStream(MaxFileSizeBytes).CopyToAsync(ms);
                files.Add(new UploadFile(file.Name, file.ContentType, ms.ToArray()));
            }

            var result = await DocApi.UploadAsync(OrderId, card.TypeId.Value, files);
            if (result.IsSuccess)
            {
                var n = result.Data?.Count ?? files.Count;
                Snackbar.Add($"Priloženo {n} {BsPlural.Of(n, "dokument", "dokumenta", "dokumenata")}.", Severity.Success);
                await ReloadAsync();
            }
            else
            {
                Snackbar.Add(result.ErrorMessage ?? "Greška pri prilaganju dokumenata.", Severity.Error);
            }
        }
        finally
        {
            _busyCardCode = null;
            StateHasChanged();
        }
    }

    private async Task OnReplaceAsync(InputFileChangeEventArgs e, DocCard card)
    {
        if (card.ActiveDoc is null) return;

        var file = e.File;
        if (!IsValidFile(file)) { Snackbar.Add(FileValidationMessage(file), Severity.Warning); return; }

        _busyCardCode = card.Code;
        try
        {
            using var ms = new MemoryStream();
            await file.OpenReadStream(MaxFileSizeBytes).CopyToAsync(ms);
            var uploadFile = new UploadFile(file.Name, file.ContentType, ms.ToArray());

            var result = await DocApi.ReplaceAsync(card.ActiveDoc.Id, uploadFile);
            if (result.IsSuccess)
            {
                Snackbar.Add($"Dokument zamijenjen — verzija v{result.Data?.Version}.", Severity.Success);
                await ReloadAsync();
            }
            else
            {
                Snackbar.Add(result.ErrorMessage ?? "Greška pri zamjeni dokumenta.", Severity.Error);
            }
        }
        finally
        {
            _busyCardCode = null;
            StateHasChanged();
        }
    }

    // ── Preview / Download ───────────────────────────────────────────────

    private async Task PreviewAsync(DocumentDto doc) =>
        await JS.InvokeVoidAsync("open", $"/files/documents/{doc.Id}?inline=true", "_blank");

    private async Task DownloadAsync(DocumentDto doc) =>
        await JS.InvokeVoidAsync("open", $"/files/documents/{doc.Id}", "_blank");

    // ── Delete ───────────────────────────────────────────────────────────

    private bool CanDeleteDoc(DocumentDto doc)
    {
        if (!_canDelete) return false;
        var isOwn = doc.UploadedByUserId is not null &&
                    string.Equals(doc.UploadedByUserId, _me?.UserId, StringComparison.OrdinalIgnoreCase);
        var isAdmin = _me?.Roles.Contains("KolateralAdministrator", StringComparer.OrdinalIgnoreCase) == true;
        return isOwn || isAdmin;
    }

    private async Task DeleteAsync(DocumentDto doc, string cardCode)
    {
        var dialog = await DialogService.ShowAsync<ConfirmDialog>(
            "Brisanje dokumenta",
            new DialogParameters
            {
                ["ContentText"] = $"Obrisati dokument <strong>{doc.DisplayName}</strong>? Akcija se ne može poništiti.",
                ["ConfirmText"] = "Obriši",
                ["IsDanger"]    = true
            });

        if (await dialog.Result is not { Canceled: false }) return;

        _busyCardCode = cardCode;
        try
        {
            var result = await DocApi.DeleteAsync(doc.Id);
            if (result.IsSuccess)
            {
                Snackbar.Add("Dokument obrisan.", Severity.Success);
                await ReloadAsync();
            }
            else
            {
                Snackbar.Add(result.ErrorMessage ?? "Greška pri brisanju dokumenta.", Severity.Error);
            }
        }
        finally
        {
            _busyCardCode = null;
            StateHasChanged();
        }
    }

    // ── Historija ────────────────────────────────────────────────────────

    private void ToggleHistory(string code)
    {
        if (!_expandedHistory.Add(code)) _expandedHistory.Remove(code);
        StateHasChanged();
    }

    // ── Validacija fajlova ───────────────────────────────────────────────

    private static bool IsValidFile(IBrowserFile file)
    {
        if (file.Size <= 0 || file.Size > MaxFileSizeBytes) return false;
        return Path.GetExtension(file.Name).Equals(".pdf", StringComparison.OrdinalIgnoreCase);
    }

    private static string FileValidationMessage(IBrowserFile file)
    {
        if (file.Size <= 0)         return $"Fajl \"{file.Name}\" je prazan.";
        if (file.Size > MaxFileSizeBytes)
            return $"Fajl \"{file.Name}\" prelazi maksimalnu veličinu od {MaxFileSizeMb} MB.";
        return $"Fajl \"{file.Name}\" nije PDF. Dozvoljen je samo PDF format.";
    }

    // ── Helpers ──────────────────────────────────────────────────────────

    private static string FormatSize(long bytes)
    {
        if (bytes >= 1024 * 1024) return $"{bytes / 1024.0 / 1024.0:0.#} MB";
        if (bytes >= 1024)        return $"{bytes / 1024.0:0.#} KB";
        return $"{bytes} B";
    }
}
