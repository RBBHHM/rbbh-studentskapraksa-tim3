    [Parameter] public string?  ClientType             { get; set; }
    [Parameter] public EventCallback<List<(string Label, bool Delivered, bool IsMandatory)>> OnStatsChanged { get; set; }

    private const long   MaxFileSizeBytes  = 10L * 1024 * 1024;
    private const int    MaxFileSizeMb     = 10;
    private const int    MaxFilesPerUpload = 20;
    private const string PdfContentType   = "application/pdf";

    // ── Definicija tipova dokumenata ─────────────────────────────────────
