@inject DocumentApiService DocApi
@inject MeService MeSvc
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JS

@*
    DocumentUploadSection — US-92 / spec-doc (Slike 9, 10, 10.1)
    Reusable komponenta za strukturisanu dokumentaciju narudžbe.

    Prikazuje unaprijed definirane tipove dokumenata (ZK, KKP, Kupoprodajni
    ugovor, Uplatnica/Saglasnost, Ostala dokumentacija) s karticama, statusima,
    upload/replace/download, progress barom i revizijskom historijom.

    Vidljivost po permissijama (iz GET /api/me):
      documents.view    → prikaz liste
      documents.upload  → upload / zamjena
      documents.download→ preuzimanje
      documents.delete  → brisanje
*@

@* ── Zaglavlje (crno-žuto) ─────────────────────────────────────────── *@
<div class="ds-header">
    <MudIcon Icon="@Icons.Material.Outlined.FolderOpen" Style="font-size:17px;" />
    <span class="ds-header-title">Dokumentacija narudžbe</span>
    @if (!_loading && _canView)
    {
        <span style="font-size:11.5px; color:rgba(254,230,0,0.75); font-weight:600;">
            @(_mandatory.Count(x => x.HasActive)) od @(_mandatory.Count()) obaveznih dostavljeno
        </span>
    }
</div>

<div style="padding:16px 18px; display:flex; flex-direction:column; gap:0;">

    @if (_loading)
    {
        <div style="display:flex; justify-content:center; padding:28px;">
            <MudProgressCircular Indeterminate="true" Color="Color.Warning" Size="Size.Medium" />
        </div>
    }
    else if (!_canView)
    {
        <div style="display:flex; align-items:center; gap:10px; padding:14px;
                    background:#F8F6F2; border-radius:8px; color:var(--text-muted); font-size:13px;">
            <MudIcon Icon="@Icons.Material.Outlined.Lock" Style="font-size:18px;" />
            Nemate pristup dokumentaciji ove narudžbe.
        </div>
    }
    else if (_loadError is not null)
    {
        <div style="display:flex; align-items:center; justify-content:space-between; gap:12px;
                    padding:12px 14px; background:#FFF0EC; border:1px solid #F3C6BC; border-radius:8px;">
            <div style="display:flex; align-items:center; gap:10px; color:var(--rbi-coral-deep); font-size:13px;">
                <MudIcon Icon="@Icons.Material.Outlined.ErrorOutline" Style="font-size:18px;" />
                @_loadError
            </div>
            <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="ReloadAsync"
                       Style="color:var(--rbi-coral-deep); text-transform:none; font-weight:700;">
                Pokušaj ponovo
            </MudButton>
        </div>
    }
    else
    {
        @* ── Progress bar ─────────────────────────────────────────────── *@
        <div class="ds-progress-wrap" style="margin-bottom:16px;">
            <div class="ds-progress-meta">
                <span>
                    <strong>@(_mandatory.Count(x => x.HasActive))</strong>
                    od <strong>@(_mandatory.Count())</strong> obaveznih dokumenata dostavljeno
                </span>
                <span style="font-size:12px; font-weight:700; color:var(--rbi-off-black);">
                    @MandatoryPct%
                </span>
            </div>
            <div class="ds-progress-bar">
                <div class="ds-progress-fill @(MandatoryPct == 100 ? "full" : "")"
                     style="width:@(MandatoryPct)%;">
                </div>
            </div>
        </div>

        @* ── Fascikla tabovi ───────────────────────────────────────────── *@
        <div class="ds-folder-tabs" role="tablist" aria-label="Kategorije dokumenata">
            @foreach (var grp in _docGroups)
            {
                var delivered = GroupDelivered(grp.Key);
                var total     = GroupTotal(grp.Key);
                var isActive  = _activeDocTab == grp.Key;
                var hasMandatoryMissing = grp.Any(c => c.IsMandatory && !c.HasActive);
                <button class="ds-folder-tab @(isActive ? "active" : "") @(hasMandatoryMissing ? "has-pending" : "")"
                        role="tab" aria-selected="@isActive"
                        @onclick="@(() => _activeDocTab = grp.Key)">
                    <MudIcon Icon="@(_groupIcons.GetValueOrDefault(grp.Key, Icons.Material.Outlined.Folder))"
                             Style="font-size:16px;" />
                    <span class="ds-folder-tab-label">@grp.Key</span>
                    <span class="ds-folder-tab-badge @(delivered == total ? "complete" : "")">@delivered/@total</span>
                </button>
            }
        </div>

        @* ── Kartice aktivnog taba ─────────────────────────────────────── *@
        <div class="ds-tab-content">
            @foreach (var card in _cards.Where(c => c.Group == _activeDocTab))
            {
                var isBusy        = _busyCardCode == card.Code;
                var prevVersions  = card.AllDocs
                    .Where(d => !d.IsActive)
                    .OrderByDescending(d => d.Version)
                    .ToList();
                <div class="ds-doc-card">

                    @* Zaglavlje kartice *@
                    <div class="ds-doc-card-head">
                        <div class="ds-doc-icon">
                            <MudIcon Icon="@Icons.Material.Outlined.Description" Style="font-size:17px;" />
                        </div>
                        <div style="flex:1; min-width:0;">
                            <div class="ds-doc-name">
                                @card.Label
                                @if (card.IsMandatory)
                                { <span class="ds-doc-mandatory" title="Obavezan dokument"> *</span> }
                            </div>
                        </div>
                        <span class="ds-status @StatusBadgeClass(card)">@StatusLabel(card)</span>
                    </div>

                    @* Body kartice *@
                    <div class="ds-doc-card-body">

                        @if (card.IsMultiple)
                        {
                            @* ── OSTALA DOKUMENTACIJA (više fajlova) ─────────────── *@
                            @if (card.AllDocs.Count > 0)
                            {
                                <div class="ds-multi-list">
                                    @foreach (var doc in card.AllDocs.Where(d => d.IsActive))
                                    {
                                        <div class="ds-multi-item">
                                            <MudIcon Icon="@Icons.Material.Outlined.PictureAsPdf"
                                                     Style="font-size:18px; color:var(--rbi-coral-deep); flex-shrink:0;" />
                                            <div style="flex:1; min-width:0;">
                                                <div style="font-size:12.5px; font-weight:600; color:var(--rbi-off-black);
                                                            white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                                                    @doc.DisplayName
                                                </div>
                                                <div style="font-size:11px; color:var(--text-muted);">
                                                    @FormatSize(doc.FileSize) ·
                                                    @doc.UploadedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                                </div>
                                            </div>
                                            @if (_canDownload)
                                            {
                                                <button class="ds-btn ds-btn-outline"
                                                        @onclick="@(() => DownloadAsync(doc))">
                                                    <MudIcon Icon="@Icons.Material.Outlined.Download" Style="font-size:14px;" />
                                                    Preuzmi
                                                </button>
                                            }
                                            @if (CanDeleteDoc(doc))
                                            {
                                                <button class="ds-btn ds-btn-delete"
                                                        disabled="@(_busyCardCode is not null)"
                                                        @onclick="@(() => DeleteAsync(doc, card.Code))">
                                                    <MudIcon Icon="@Icons.Material.Outlined.Delete" Style="font-size:14px;" />
                                                </button>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                            @* Upload dugme (uvijek dostupno za Ostalo) *@
                            @if (_canUpload && card.TypeId.HasValue)
                            {
                                <label class="ds-upload-zone @(isBusy ? "ds-upload-zone-busy" : "")">
                                    @if (isBusy)
                                    {
                                        <MudProgressCircular Indeterminate="true" Color="Color.Warning" Size="Size.Small" />
                                        <span style="font-size:12.5px; color:var(--rbi-off-black);">Učitavanje…</span>
                                    }
                                    else
                                    {
                                        <MudIcon Icon="@Icons.Material.Outlined.UploadFile"
                                                 Style="font-size:20px; color:var(--rbi-off-black); flex-shrink:0;" />
                                        <div>
                                            <div style="font-size:12.5px; font-weight:600; color:var(--rbi-off-black);">
                                                Dodaj PDF dokument(e)
                                            </div>
                                            <div style="font-size:11px; color:var(--text-muted);">
                                                Samo PDF · max @MaxFileSizeMb MB · moguće više odjednom
                                            </div>
                                        </div>
                                    }
                                    <InputFile multiple accept=".pdf,application/pdf"
                                               OnChange="@(e => OnFilesSelectedAsync(e, card))"
                                               disabled="@(_busyCardCode is not null)"
                                               data-testid="@($"upload-input-{card.Code.ToLower()}")"
                                               style="display:none;" />
                                </label>
                            }
                        }
                        else
                        {
                            @* ── JEDNOFAJLOVSKI TIPOVI ──────────────────────────── *@
                            @if (card.ActiveDoc is null)
                            {
                                @* Nema dokumenta — upload zona *@
                                @if (_canUpload && card.TypeId.HasValue)
                                {
                                    <label class="ds-upload-zone @(isBusy ? "ds-upload-zone-busy" : "")">
                                        @if (isBusy)
                                        {
                                            <MudProgressCircular Indeterminate="true" Color="Color.Warning" Size="Size.Small" />
                                            <span style="font-size:12.5px; color:var(--rbi-off-black);">Učitavanje…</span>
                                        }
                                        else
                                        {
                                            <MudIcon Icon="@Icons.Material.Outlined.UploadFile"
                                                     Style="font-size:20px; color:var(--rbi-off-black); flex-shrink:0;" />
                                            <div>
                                                <div style="font-size:12.5px; font-weight:600; color:var(--rbi-off-black);">
                                                    Upload dokument
                                                </div>
                                                <div style="font-size:11px; color:var(--text-muted);">
                                                    Samo PDF · max @MaxFileSizeMb MB
                                                </div>
                                            </div>
                                        }
                                        <InputFile accept=".pdf,application/pdf"
                                                   OnChange="@(e => OnFilesSelectedAsync(e, card))"
                                                   disabled="@(_busyCardCode is not null)"
                                                   data-testid="@($"upload-input-{card.Code.ToLower()}")"
                                                   style="display:none;" />
                                    </label>
                                }
                                else
                                {
                                    <div style="font-size:12.5px; color:var(--text-muted); padding:8px 2px;">
                                        Nema priloženog dokumenta.
                                    </div>
                                }
                            }
                            else
                            {
                                @* Postoji aktivni dokument — prikaz info + dugmad *@
                                <div class="ds-file-info">
                                    <span class="ds-file-info-key">Naziv</span>
                                    <span class="ds-file-info-val" title="@card.ActiveDoc.DisplayName">
                                        @card.ActiveDoc.DisplayName
                                    </span>
                                    <span class="ds-file-info-key">Veličina</span>
                                    <span class="ds-file-info-val">@FormatSize(card.ActiveDoc.FileSize)</span>
                                    <span class="ds-file-info-key">Verzija</span>
                                    <span class="ds-file-info-val">v@(card.ActiveDoc.Version)</span>
                                    <span class="ds-file-info-key">Datum</span>
                                    <span class="ds-file-info-val">
                                        @card.ActiveDoc.UploadedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                    </span>
                                </div>

                                @* AC3.2 — upozorenje za zastarjele dokumente *@
                                @if (IsDocumentTooOld(card, out var maxAgeDays))
                                {
                                    <div class="ds-age-warning">
                                        <MudIcon Icon="@Icons.Material.Outlined.Warning"
                                                 Style="font-size:16px;flex-shrink:0;" />
                                        Dokument je stariji od @maxAgeDays dana — provjerite da li je još uvijek važeći.
                                    </div>
                                }

                                <div class="ds-doc-actions">
                                    @if (_canDownload)
                                    {
                                        <button class="ds-btn ds-btn-outline"
                                                @onclick="@(() => PreviewAsync(card.ActiveDoc))">
                                            <MudIcon Icon="@Icons.Material.Outlined.Visibility" Style="font-size:14px;" />
                                            Pregled
                                        </button>
                                        <button class="ds-btn ds-btn-outline"
                                                @onclick="@(() => DownloadAsync(card.ActiveDoc))">
                                            <MudIcon Icon="@Icons.Material.Outlined.Download" Style="font-size:14px;" />
                                            Preuzmi
                                        </button>
                                    }
                                    @if (_canUpload)
                                    {
                                        <label class="ds-btn ds-btn-replace"
                                               style="@(isBusy ? "opacity:.7;pointer-events:none;" : "")">
                                            @if (isBusy)
                                            {
                                                <MudProgressCircular Indeterminate="true"
                                                                     Color="Color.Dark" Size="Size.Small" />
                                                <span>Zamjena…</span>
                                            }
                                            else
                                            {
                                                <MudIcon Icon="@Icons.Material.Outlined.SwapHoriz" Style="font-size:14px;" />
                                                <span>Zamijeni</span>
                                            }
                                            <InputFile accept=".pdf,application/pdf"
                                                       OnChange="@(e => OnReplaceAsync(e, card))"
                                                       disabled="@(_busyCardCode is not null)"
                                                       style="display:none;" />
                                        </label>
                                    }
                                    @if (CanDeleteDoc(card.ActiveDoc))
                                    {
                                        <button class="ds-btn ds-btn-delete"
                                                disabled="@(_busyCardCode is not null)"
                                                @onclick="@(() => DeleteAsync(card.ActiveDoc, card.Code))">
                                            <MudIcon Icon="@Icons.Material.Outlined.Delete" Style="font-size:14px;" />
                                            Obriši
                                        </button>
                                    }
                                </div>

                                @* Historija verzija *@
                                @if (prevVersions.Count > 0)
                                {
                                    <button class="ds-history-toggle"
                                            @onclick="@(() => ToggleHistory(card.Code))">
                                        <MudIcon Icon="@(_expandedHistory.Contains(card.Code)
                                            ? Icons.Material.Outlined.ExpandLess
                                            : Icons.Material.Outlined.ExpandMore)"
                                            Style="font-size:14px;" />
                                        @(_expandedHistory.Contains(card.Code)
                                            ? "Sakrij historiju verzija"
                                            : $"Historija verzija ({prevVersions.Count} starija verzija)")
                                    </button>

                                    @if (_expandedHistory.Contains(card.Code))
                                    {
                                        @foreach (var hist in prevVersions)
                                        {
                                            <div class="ds-history-row">
                                                <MudIcon Icon="@Icons.Material.Outlined.History"
                                                         Style="font-size:14px; color:var(--text-faint); flex-shrink:0;" />
                                                <div style="flex:1; min-width:0;">
                                                    <div style="font-size:12px; font-weight:600; white-space:nowrap;
                                                                overflow:hidden; text-overflow:ellipsis;"
                                                         title="@hist.DisplayName">
                                                        v@(hist.Version) — @hist.DisplayName
                                                    </div>
                                                    <div style="font-size:11px; color:var(--text-muted);">
                                                        @FormatSize(hist.FileSize) ·
                                                        @hist.UploadedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                                    </div>
                                                </div>
                                                @if (_canDownload)
                                                {
                                                    <button class="ds-btn ds-btn-outline"
                                                            style="padding:4px 8px;"
                                                            @onclick="@(() => DownloadAsync(hist))">
                                                        <MudIcon Icon="@Icons.Material.Outlined.Download"
                                                                 Style="font-size:13px;" />
                                                    </button>
                                                }
                                            </div>
                                        }
                                    }
                                }
                            }
                        }

                        @* Poslovne napomene — interaktivni padajući meni *@
                        @if (card.Notes is { Length: > 0 })
                        {
                            <MudExpansionPanels Elevation="0" Dense="true" Style="margin-top:12px;">
                                <MudExpansionPanel Text="@($"Napomene i provjere ({card.Notes.Length})")" MaxHeight="400"
                                    Style="background:#FFFBF0;border:1px solid #E8D9A8;border-radius:8px!important;">
                                    <div style="display:flex;flex-direction:column;gap:6px;">
                                        @foreach (var n in card.Notes)
                                        {
                                            var noteKey = $"{card.Code}_{n.GetHashCode()}";
                                            var isChecked = GetNoteChecked(noteKey);
                                            <div style="display:flex;align-items:flex-start;gap:10px;padding:6px 4px;
                                                        border-radius:6px;background:@(isChecked ? "rgba(162,226,204,0.15)" : "transparent");
                                                        transition:background 0.15s;">
                                                <MudCheckBox T="bool" Dense="true" Color="Color.Warning"
                                                    Value="@isChecked"
                                                    ValueChanged="@(v => SetNoteChecked(noteKey, v))"
                                                    Style="margin:0;padding:0;flex-shrink:0;" />
                                                <span style="font-size:12.5px;color:@(isChecked ? "var(--rbi-green-deep)" : "var(--text-secondary)");
                                                             line-height:1.5;text-decoration:@(isChecked ? "line-through" : "none");
                                                             transition:color 0.15s;">@n</span>
                                            </div>
                                        }
                                    </div>
                                    <div style="margin-top:12px;padding-top:10px;border-top:1px solid #E8D9A8;">
                                        <MudTextField T="string" Label="Dodatni komentar" Variant="Variant.Outlined"
                                            Lines="2" FullWidth="true" Style="font-size:12px;"
                                            Value="@GetDocComment(card.Code)"
                                            ValueChanged="@(v => SetDocComment(card.Code, v))" />
                                    </div>
                                </MudExpansionPanel>
                            </MudExpansionPanels>
                        }

                    </div>
                </div>
            }
        </div>

        @* Stara opcionalna sekcija uklonjena — svi dokumenti su sada u fascikla tabovima iznad *@
    }

</div>

@code {
