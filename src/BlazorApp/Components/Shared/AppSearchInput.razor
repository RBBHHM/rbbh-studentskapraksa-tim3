@*
    AppSearchInput — zajednički search input sa ikonom i debounce podrškom.
    Zamjenjuje:
      - native <input> sa masivnim inline stilovima u AppraiserAdmin + CodebookManagement
      - razliku između MudTextField (MyOrders) i native input (ostali)
    Koristi .app-search-wrap / .app-search-input / .app-search-icon iz app.css (sekcija 21).
*@
<div class="app-search-wrap" style="@ContainerStyle">
    <MudIcon Icon="@Icons.Material.Outlined.Search" Class="app-search-icon" />
    <input type="text"
           value="@Value"
           placeholder="@Placeholder"
           class="app-search-input"
           @oninput="OnInput" />
</div>

@code {
    [Parameter] public string?  Value         { get; set; }
    [Parameter] public string   Placeholder   { get; set; } = "Pretraži...";
    [Parameter] public string   ContainerStyle { get; set; } = "flex:1; min-width:200px; max-width:300px;";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public EventCallback<string> OnDebounced  { get; set; }
    [Parameter] public int DebounceMs { get; set; } = 350;

    private CancellationTokenSource? _cts;

    private async Task OnInput(ChangeEventArgs e)
    {
        var val = e.Value?.ToString() ?? "";
        Value = val;
        await ValueChanged.InvokeAsync(val);

        if (OnDebounced.HasDelegate)
        {
            _cts?.Cancel();
            _cts = new CancellationTokenSource();
            var token = _cts.Token;
            try
            {
                await Task.Delay(DebounceMs, token);
                await OnDebounced.InvokeAsync(val);
            }
            catch (TaskCanceledException) { }
        }
    }
}
