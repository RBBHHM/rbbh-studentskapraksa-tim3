@*
    AppFormField — zajednički wrapper za form polja: label, obavezna zvjezdica,
    helper tekst, validacijska poruka, child content (input/select/textarea...).

    Zamjenjuje ručni pattern koji se ponavljao u: AppraiserAdmin (5x),
    CodebookManagement, i svim dijalozima — svaki sa inline <span style="color:var(--rbi-coral-deep);">*</span>.

    Koristi .app-form-field, .app-field-label, .app-field-required,
    .app-field-helper, .app-field-error iz app.css (sekcija 21).
*@
<div class="app-form-field">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <label class="app-field-label @(Required ? "app-field-required" : "")">@Label</label>
    }
    @ChildContent
    @if (!string.IsNullOrWhiteSpace(HelperText) && string.IsNullOrWhiteSpace(ErrorText))
    {
        <div class="app-field-helper">@HelperText</div>
    }
    @if (!string.IsNullOrWhiteSpace(ErrorText))
    {
        <div class="app-field-error">
            <MudIcon Icon="@Icons.Material.Outlined.ErrorOutline" Style="font-size:14px;" />
            @ErrorText
        </div>
    }
</div>

@code {
    /// <summary>Prikazni naziv polja — može biti prazan ako se label renderuje van komponente.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Dodaje " *" sufiks — stil via .app-field-required CSS.</summary>
    [Parameter] public bool Required { get; set; }

    /// <summary>Hint ispod inputa — prikazuje se samo kad ErrorText nije postavljen.</summary>
    [Parameter] public string? HelperText { get; set; }

    /// <summary>Validacijska greška — prikazuje se umjesto HelperText, crvenim.</summary>
    [Parameter] public string? ErrorText { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }
}
