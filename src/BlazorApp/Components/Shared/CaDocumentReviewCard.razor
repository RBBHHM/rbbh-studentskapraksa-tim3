@inject Us93ApiService Api93
@inject ISnackbar Snackbar
@inject IDialogService DialogService

@* ── Kućica Kolateral administrator — pregled dokumentacije (US-91/92) ─── *@
<div class="card" style="padding:0;overflow:hidden;">

    @* Zaglavlje kućice *@
    <div style="background:#225B45;padding:13px 18px;display:flex;align-items:center;gap:10px;">
        <MudIcon Icon="@Icons.Material.Outlined.FactCheck"
                 Style="font-size:17px;color:#A3E2CC;" />
        <span style="font-size:12px;font-weight:700;text-transform:uppercase;
                     letter-spacing:.7px;color:#A3E2CC;">
            Pregled dokumentacije
        </span>
    </div>

    <div style="padding:16px 18px;display:flex;flex-direction:column;gap:14px;">

        @* ─ Dopuna dostavljena od Prodaje — info baner ───────────────────── *@
        @if (Order.Status == "CorrectionSubmitted" && !string.IsNullOrWhiteSpace(Order.CorrectionComment))
        {
            <div style="display:flex;align-items:flex-start;gap:12px;
                        padding:10px 14px;background:#F0FBF6;border-radius:8px;
                        border:1px solid #A3E2CC;">
                <MudIcon Icon="@Icons.Material.Outlined.MarkEmailRead"
                         Style="font-size:20px;color:var(--rbi-off-black);margin-top:1px;flex-shrink:0;" />
                <div>
                    <div style="font-size:13.5px;font-weight:700;color:var(--rbi-off-black);">
                        Dopuna podataka dostavljena
                    </div>
                    <div style="font-size:12px;color:var(--text-secondary);margin-top:3px;">
                        @Order.CorrectionComment
                    </div>
                </div>
            </div>
        }

        @* ─ Vraćeno od CO — provjera pristupa nije prošla ────────────────── *@
        @if (Order.IsAccessCheckRejected && !string.IsNullOrWhiteSpace(Order.AccessCheckComment))
        {
            <div style="display:flex;align-items:flex-start;gap:12px;
                        padding:10px 14px;background:#F5F0FF;border-radius:8px;
                        border:1px solid #C9AAFF;">
                <MudIcon Icon="@Icons.Material.Outlined.MarkEmailRead"
                         Style="font-size:20px;color:var(--rbi-off-black);margin-top:1px;flex-shrink:0;" />
                <div>
                    <div style="font-size:13.5px;font-weight:700;color:var(--rbi-off-black);">
                        Kolateral oficir je tražio dopunu prije provjere pristupa
                    </div>
                    <div style="font-size:12px;color:var(--text-secondary);margin-top:3px;">
                        @Order.AccessCheckComment
                    </div>
                </div>
            </div>
        }

        @* ─ Akcije: Završi pregled / Dopuna podataka ─────────────────────── *@
        @if (CanReview)
        {
            <div style="display:flex;flex-direction:column;gap:10px;
                        padding:12px 14px;border:1.5px dashed #A3E2CC;border-radius:8px;">

                @* AC3.3 — obavezne potvrde (checkbox) prije završetka pregleda *@
                <div style="display:flex;flex-direction:column;gap:6px;">
                    <label style="display:flex;align-items:center;gap:10px;cursor:pointer;
                                  font-size:13px;color:var(--rbi-off-black);">
                        <input type="checkbox" @bind="_checkDocumentsComplete"
                               style="width:16px;height:16px;accent-color:var(--rbi-off-black);flex-shrink:0;" />
                        Svi obavezni dokumenti su priloženi i pregledani
                    </label>
                    <label style="display:flex;align-items:center;gap:10px;cursor:pointer;
                                  font-size:13px;color:var(--rbi-off-black);">
                        <input type="checkbox" @bind="_checkDocumentsValid"
                               style="width:16px;height:16px;accent-color:var(--rbi-off-black);flex-shrink:0;" />
                        Dokumenti su tačni, čitki i odgovaraju zahtjevima procjene
                    </label>
                </div>

                <div style="display:flex;align-items:center;justify-content:space-between;
                            gap:12px;flex-wrap:wrap;">
                    <div style="font-size:12px;color:var(--text-muted);">
                        Potvrdite provjere i odaberite akciju
                    </div>
                    <div style="display:flex;gap:8px;flex-shrink:0;">
                        <MudButton Variant="Variant.Outlined"
                                   Size="Size.Small"
                                   Disabled="_acting"
                                   OnClick="RequestCorrectionAsync"
                                   Style="color:var(--rbi-coral-deep);border-color:var(--rbi-coral-deep);font-weight:700;
                                          text-transform:none;white-space:nowrap;">
                            Dopuna podataka
                        </MudButton>
                        <MudButton Variant="Variant.Filled"
                                   Size="Size.Small"
                                   Disabled="@(_acting || !_checkDocumentsComplete || !_checkDocumentsValid)"
                                   OnClick="CompleteReviewAsync"
                                   Style="background:#225B45;color:#A3E2CC;font-weight:700;
                                          text-transform:none;white-space:nowrap;">
                            Završi pregled
                        </MudButton>
                    </div>
                </div>
            </div>
        }

        @* ─ Vraćeno na dopunu — čeka se Prodaja ──────────────────────────── *@
        @if (Order.IsReturnedForCorrection)
        {
            <div style="display:flex;align-items:flex-start;gap:12px;
                        padding:10px 14px;background:#FFFDE7;border-radius:8px;
                        border:1px solid #FFF176;">
                <MudIcon Icon="@Icons.Material.Outlined.Schedule"
                         Style="font-size:20px;color:var(--rbi-off-black);margin-top:1px;flex-shrink:0;" />
                <div>
                    <div style="font-size:13.5px;font-weight:700;color:var(--rbi-off-black);">
                        Čeka se dopuna podataka od Prodaje
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Order.CorrectionReason))
                    {
                        <div style="font-size:12px;color:var(--text-secondary);margin-top:3px;">
                            @Order.CorrectionReason
                        </div>
                    }
                </div>
            </div>
        }

        @* ─ Dokumentacija odobrena ────────────────────────────────────────── *@
        @if (Order.Status is "DocumentationApproved" or "AccessCheckRequested" or "AccessCheckApproved"
                            or "AppraiserSelected" or "DocumentsGenerated" or "OrderSentToAppraiser"
                            or "AdditionalPaymentRequested" or "AdditionalPaymentCompleted"
                            or "AppraisalInProgress" or "AppraisalReceived" or "COApproved"
                            or "ReadyForProcedure" or "OriginalReceived" or "Completed")
        {
            <div style="display:flex;align-items:flex-start;gap:12px;
                        padding:10px 14px;background:#F0FBF6;border-radius:8px;
                        border:1px solid #A3E2CC;">
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                         Style="font-size:20px;color:var(--rbi-off-black);margin-top:1px;flex-shrink:0;" />
                <div style="font-size:13.5px;font-weight:700;color:var(--rbi-off-black);">
                    Dokumentacija odobrena
                </div>
            </div>
        }

        @* Poruka ako nema dostupnih akcija *@
        @if (!CanReview && !Order.IsReturnedForCorrection && Order.Status is not ("DocumentationApproved" or "AccessCheckRequested" or "AccessCheckApproved"
                            or "AppraiserSelected" or "DocumentsGenerated" or "OrderSentToAppraiser"
                            or "AdditionalPaymentRequested" or "AdditionalPaymentCompleted"
                            or "AppraisalInProgress" or "AppraisalReceived" or "COApproved"
                            or "ReadyForProcedure" or "OriginalReceived" or "Completed"))
        {
            <div style="text-align:center;padding:16px 8px;color:var(--text-muted);font-size:13px;">
                Pregled dokumentacije nije dostupan za trenutni status narudžbe.
            </div>
        }

    </div>
</div>

@code {
    [Parameter, EditorRequired] public AppraisalOrderDetailDto Order { get; set; } = default!;
    [Parameter] public EventCallback OnRefresh { get; set; }

    private bool _acting;
    private bool _checkDocumentsComplete;
    private bool _checkDocumentsValid;

    private bool CanReview =>
        Order.Capabilities.CanCompleteReview ||
        Order.Status is "DocumentationReviewInProgress" or "CorrectionSubmitted";

    private async Task CompleteReviewAsync()
    {
        var dialog = await DialogService.ShowAsync<ConfirmDialog>(
            "Završi pregled dokumentacije",
            new DialogParameters
            {
                ["ContentText"] = $"Narudžba {Order.OrderNumber}: potvrđujete da je dokumentacija " +
                                  "kompletna i tačna? Narudžba ide u sljedeći korak procesa.",
                ["ConfirmText"] = "Završi pregled"
            });

        if (await dialog.Result is { Canceled: false })
        {
            _acting = true;
            var r = await Api93.CompleteReviewAsync(Order.Id);
            _acting = false;

            if (r.IsSuccess)
            {
                Snackbar.Add("Pregled dokumentacije završen. Dokumentacija je odobrena.", Severity.Success);
                await OnRefresh.InvokeAsync();
            }
            else
            {
                Snackbar.Add(r.ErrorMessage ?? "Greška pri završavanju pregleda.", Severity.Error);
            }
        }
    }

    private async Task RequestCorrectionAsync()
    {
        var dialog = await DialogService.ShowAsync<RequestCorrectionDialog>("Dopuna podataka");
        var result = await dialog.Result;

        if (result is { Canceled: false } dialogResult && dialogResult.Data is RequestCorrectionDialogResult data)
        {
            _acting = true;
            var r = await Api93.RequestCorrectionAsync(Order.Id, data.ReasonCodeId, data.Comment);
            _acting = false;

            if (r.IsSuccess)
            {
                Snackbar.Add("Narudžba vraćena Prodaji na dopunu podataka.", Severity.Success);
                await OnRefresh.InvokeAsync();
            }
            else
            {
                Snackbar.Add(r.ErrorMessage ?? "Greška pri vraćanju na dopunu.", Severity.Error);
            }
        }
    }
}
