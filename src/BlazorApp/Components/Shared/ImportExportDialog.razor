@inject ImportExportService ImportExportSvc
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<div style="position:fixed; inset:0; background:rgba(43,45,51,0.4); z-index:1000;
            display:flex; align-items:center; justify-content:center; padding:24px;">
    <div style="background:#fff; border-radius:12px; padding:32px; max-width:720px; width:100%;
                max-height:85vh; overflow-y:auto; box-shadow:0 8px 40px rgba(43,45,51,0.18);">

        <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:20px;">
            <div style="font-size:17px; font-weight:700; color:var(--rbi-off-black);">Import / Export šifarnika</div>
            <button @onclick="Close" style="width:30px; height:30px; border:none; background:none; cursor:pointer; border-radius:6px; font-size:18px; color:#777;">✕</button>
        </div>

        <!-- Izbor šifarnika -->
        <AppFormField Label="Šifarnik" Required="true">
            <MudSelect T="string" @bind-Value="_selectedType" Variant="Variant.Outlined" Margin="Margin.Dense"
                       Style="width:100%;" Placeholder="Odaberite šifarnik">
                @foreach (var t in _types)
                {
                    <MudSelectItem T="string" Value="@t">@GetTypeLabel(t)</MudSelectItem>
                }
            </MudSelect>
        </AppFormField>

        <!-- ═══ TAB: Import / Export ═══ -->
        <MudTabs Elevation="0" Rounded="false" @bind-ActivePanelIndex="_tabIndex">

            <!-- ── IMPORT ─────────────────────────────────────────── -->
            <MudTabPanel Text="Import">
                <div style="padding-top:16px; display:flex; flex-direction:column; gap:12px;">

                    <AppFormField Label="Način importa">
                        <MudSelect T="int" @bind-Value="_importMode" Variant="Variant.Outlined" Margin="Margin.Dense" Style="width:100%;">
                            <MudSelectItem T="int" Value="1">Dodaj samo nove</MudSelectItem>
                            <MudSelectItem T="int" Value="2">Ažuriraj samo postojeće</MudSelectItem>
                            <MudSelectItem T="int" Value="3">Dodaj nove i ažuriraj postojeće</MudSelectItem>
                            <MudSelectItem T="int" Value="4">Deaktiviraj one koji nisu u fajlu</MudSelectItem>
                        </MudSelect>
                    </AppFormField>

                    <MudFileUpload T="IBrowserFile" Accept=".csv,.xlsx,.xls" FilesChanged="OnFileSelected" MaximumFileCount="1">
                        <ActivatorContent>
                            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.UploadFile"
                                       Style="width:100%; text-transform:none; font-weight:600;">
                                @(_fileName ?? "Odaberite fajl (CSV, XLSX, XLS)")
                            </MudButton>
                        </ActivatorContent>
                    </MudFileUpload>

                    @if (_previewing)
                    {
                        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                    }

                    @if (_preview is not null)
                    {
                        @* Statistike importa *@
                        <div class="card" style="padding:16px;">
                            <div style="font-weight:700; margin-bottom:8px;">
                                @(_isVjestaci ? "Rezultat importa vještaka" : "Preview rezultata")
                            </div>
                            <div style="display:grid; grid-template-columns:repeat(2,1fr); gap:4px 16px; font-size:13px;">
                                @if (_isVjestaci)
                                {
                                    <span>Ukupno obrađeno:</span><span style="font-weight:600;">@_preview.TotalRows</span>
                                    <span>Kreirano:</span><span style="font-weight:600; color:var(--rbi-green-deep);">@_preview.NewCount</span>
                                    <span>Ažurirano:</span><span style="font-weight:600; color:#C9A100;">@_preview.UpdateCount</span>
                                    <span>Preskoćeno:</span><span style="font-weight:600;">@_preview.SkipCount</span>
                                    <span>Grešaka:</span><span style="font-weight:600; color:@(_preview.ErrorCount > 0 ? "var(--rbi-coral-deep)" : "var(--rbi-green-deep)");">@_preview.ErrorCount</span>
                                }
                                else
                                {
                                    <span>Ukupno redova:</span><span style="font-weight:600;">@_preview.TotalRows</span>
                                    <span>Novih:</span><span style="font-weight:600; color:var(--rbi-off-black);">@_preview.NewCount</span>
                                    <span>Ažuriranih:</span><span style="font-weight:600; color:#C9A100;">@_preview.UpdateCount</span>
                                    <span>Preskoćenih:</span><span style="font-weight:600;">@_preview.SkipCount</span>
                                    <span>Grešaka:</span><span style="font-weight:600; color:var(--rbi-coral-deep);">@_preview.ErrorCount</span>
                                }
                            </div>
                            @if (_isVjestaci && _preview.ErrorCount == 0)
                            {
                                <MudAlert Severity="Severity.Success" Dense="true" Class="mt-2">
                                    Import vještaka je uspješno završen. Klikni "Potvrdi" da zatvoris dialog.
                                </MudAlert>
                            }
                        </div>

                        @* Greške (za vještake: detaljni opis po sheetu) *@
                        @if (_preview.Errors.Count > 0)
                        {
                            <div style="max-height:200px; overflow-y:auto; border:1px solid #f0e0e0; border-radius:8px; padding:12px; background:#fef5f5;">
                                <div style="font-weight:600; color:var(--rbi-coral-deep); margin-bottom:6px;">
                                    @(_isVjestaci ? "Upozorenja po vještaku:" : "Greške:")
                                </div>
                                @foreach (var e in _preview.Errors.Take(50))
                                {
                                    <div style="font-size:12px; color:#8a3a3a; margin-bottom:2px;">
                                        @if (_isVjestaci)
                                        {
                                            @e.Message
                                        }
                                        else
                                        {
                                            @($"Red {e.Row}, kolona {e.Column}: {e.Message}")
                                        }
                                    </div>
                                }
                                @if (_preview.Errors.Count > 50)
                                {
                                    <div style="font-size:12px; color:#888;">...i još @(_preview.Errors.Count - 50) grešaka</div>
                                }
                            </div>
                        }

                        @* Confirm dugme *@
                        @if (_preview.IsValid || _isVjestaci)
                        {
                            <MudButton Variant="Variant.Filled" Class="btn-primary-rbi"
                                       Disabled="_confirming" OnClick="ConfirmImport"
                                       Style="font-weight:700; text-transform:none;">
                                @if (_confirming)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                    <span>U toku...</span>
                                }
                                else
                                {
                                    <span>@(_isVjestaci ? "Zatvori i osvježi listu" : "Potvrdi import")</span>
                                }
                            </MudButton>
                        }
                    }

                    @if (_importResult is not null)
                    {
                        <MudAlert Severity="Severity.Success" Dense="true">@_importResult.Message</MudAlert>
                    }
                </div>
            </MudTabPanel>

            <!-- ── EXPORT ─────────────────────────────────────────── -->
            <MudTabPanel Text="Export">
                <div style="padding-top:16px; display:flex; flex-direction:column; gap:12px;">
                    <AppFormField Label="Format">
                        <MudSelect T="string" @bind-Value="_exportFormat" Variant="Variant.Outlined" Margin="Margin.Dense" Style="width:100%;">
                            <MudSelectItem T="string" Value="@("xlsx")">Excel (XLSX)</MudSelectItem>
                            <MudSelectItem T="string" Value="@("csv")">CSV</MudSelectItem>
                        </MudSelect>
                    </AppFormField>

                    <MudCheckBox T="bool" @bind-Value="_includeInactive" Label="Uključi neaktivne zapise"
                                 Dense="true" Color="Color.Primary" />

                    <MudButton Variant="Variant.Filled" Class="btn-primary-rbi"
                               Disabled="@string.IsNullOrWhiteSpace(_selectedType)"
                               OnClick="ExportAsync"
                               Style="font-weight:700; text-transform:none;">
                        <MudIcon Icon="@Icons.Material.Outlined.Download" Style="font-size:15px; margin-right:5px;" />
                        Preuzmi
                    </MudButton>
                </div>
            </MudTabPanel>
        </MudTabs>
    </div>
</div>

@code {
    [Parameter] public EventCallback OnClose { get; set; }

    private List<string> _types = [];
    private string _selectedType = "";
    private int _tabIndex;

    // Import state
    private int _importMode = 3;
    private string? _fileName;
    private byte[]? _fileContent;
    private bool _previewing;
    private ImportPreviewResultDto? _preview;
    private bool _confirming;
    private ImportResultDto? _importResult;

    // Vještaci multi-sheet: import se izvršava na preview koraku.
    // Confirm samo vraća keširan rezultat i poziva OnClose za reload liste.
    private bool _isVjestaci => _selectedType == "vjestaci";

    // Export state
    private string _exportFormat = "xlsx";
    private bool _includeInactive;

    protected override async Task OnInitializedAsync()
    {
        var r = await ImportExportSvc.GetSupportedTypesAsync();
        if (r.IsSuccess && r.Data is not null)
            _types = r.Data;
    }

    private async Task OnFileSelected(IBrowserFile file)
    {
        _preview = null;
        _importResult = null;
        _fileName = file.Name;

        using var ms = new MemoryStream();
        await file.OpenReadStream(10 * 1024 * 1024).CopyToAsync(ms);
        _fileContent = ms.ToArray();

        if (string.IsNullOrWhiteSpace(_selectedType))
        {
            Snackbar.Add("Prvo odaberite šifarnik.", Severity.Warning);
            return;
        }

        _previewing = true;
        StateHasChanged();

        var r = await ImportExportSvc.PreviewImportAsync(_selectedType, _importMode, _fileName, _fileContent);
        _previewing = false;

        if (r.IsSuccess && r.Data is not null)
            _preview = r.Data;
        else
            Snackbar.Add(r.ErrorMessage ?? "Greška pri preview-u.", Severity.Error);

        await InvokeAsync(StateHasChanged);
    }

    private async Task ConfirmImport()
    {
        if (_preview is null || string.IsNullOrWhiteSpace(_preview.PreviewToken)) return;
        _confirming = true;

        var r = await ImportExportSvc.ConfirmImportAsync(_preview.PreviewToken);
        _confirming = false;

        if (r.IsSuccess && r.Data is not null)
        {
            _importResult = r.Data;
            _preview = null;
            Snackbar.Add(_importResult.Message, Severity.Success);
        }
        else
        {
            Snackbar.Add(r.ErrorMessage ?? "Import nije uspio.", Severity.Error);
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task ExportAsync()
    {
        if (string.IsNullOrWhiteSpace(_selectedType)) return;
        var url = ImportExportSvc.GetExportUrl(_selectedType, _exportFormat, _includeInactive);
        await JS.InvokeVoidAsync("open", url, "_blank");
    }

    private void Close() => OnClose.InvokeAsync();

    private static string GetTypeLabel(string type) => type switch
    {
        "vjestaci"                       => "Vještaci",
        "tipovi_kolaterala"              => "Tipovi kolaterala",
        "tipovi_nekretnina"              => "Tipovi nekretnina",
        "gradovi"                        => "Gradovi",
        "poslovnice"                     => "Poslovnice",
        "kombinovani_tipovi_kolaterala"  => "Kombinovani tipovi kolaterala",
        "razlozi_dopune_dokumentacije"   => "Razlozi dopune dokumentacije",
        "protokol_narudzbi"              => "Protokol narudžbi (masovni import)",
        _                                => type
    };
}
