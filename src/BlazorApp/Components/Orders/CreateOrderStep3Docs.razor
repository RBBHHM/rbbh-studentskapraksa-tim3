@* ── CreateOrderStep3Docs — Korak 3: Dokumentacija ───────────────────────────
   Ekstrahovano iz CreateOrder.razor (B-1 refactoring).
   Prikazuje DocumentUploadSection ili placeholder ako nacrt još nije kreiran.
*@

<div class="of-card of-card-accent-yellow" style="overflow:hidden;grid-column:1/-1;">
    @if (DraftOrderId.HasValue)
    {
        <DocumentUploadSection OrderId="@DraftOrderId.Value"
                               ClientType="@ClientType"
                               OnStatsChanged="OnDocStatsChanged" />
    }
    else
    {
        <div class="of-card-header">
            <div class="of-card-icon of-card-icon-yellow">
                <MudIcon Icon="@Icons.Material.Outlined.UploadFile" Style="font-size:18px;color:var(--rbi-off-black);" />
            </div>
            <div>
                <div class="of-card-title">Dokumentacija</div>
                <div class="of-card-subtitle">PDF dokumenti koji prate narudžbu</div>
            </div>
        </div>
        <div class="of-card-body">
            <div style="display:flex;align-items:center;gap:10px;padding:12px;
                        background:#FAFAF8;border-radius:8px;border:1.5px dashed #E5DDD2;">
                <MudIcon Icon="@Icons.Material.Outlined.FolderOpen" Style="font-size:22px;color:var(--text-faint);" />
                <div>
                    <div style="font-size:13px;font-weight:600;color:var(--text-secondary);">
                        Upload dokumentacije je dostupan čim se kreira nacrt
                    </div>
                    <div style="font-size:12px;color:var(--text-muted);margin-top:2px;">
                        ZK, KKP, Kupoprodajni ugovor, Uplatnica/Saglasnost, Ostala dok.
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@* ── Wizard navigacija ── *@
<div class="of-wizard-nav" style="grid-column:1/-1;">
    <MudButton Variant="Variant.Outlined"
               StartIcon="@Icons.Material.Outlined.ArrowBack"
               OnClick="OnPrevious">
        Nazad
    </MudButton>
    <MudButton Variant="Variant.Filled" Color="Color.Warning"
               EndIcon="@Icons.Material.Outlined.ArrowForward"
               OnClick="OnNext">
        Naprijed
    </MudButton>
</div>

@code {
    [Parameter] public int?    DraftOrderId   { get; set; }
    [Parameter] public string? ClientType     { get; set; }
    [Parameter] public EventCallback<List<(string Label, bool Delivered, bool IsMandatory)>> OnDocStatsChanged { get; set; }
    [Parameter] public EventCallback OnPrevious { get; set; }
    [Parameter] public EventCallback OnNext     { get; set; }
}
