@* ── OrderWorkflowStepper — vizualni prikaz napretka narudžbe ──────────────────
   Ekstrahovano iz OrderDetail.razor (B-2 refactoring).
   Prikazuje workflow korake (FL: 6 koraka, PL: 8 koraka) s trenutnim i završenim stanjima.
*@

<div class="od-workflow-stepper" role="list" aria-label="Tok obrade narudžbe">
    @{
        var wfSteps = IsPl
            ? new[] { "Prodaja", "CA", "CO pristup", "Ponude", "Vještak", "CO pregled", "Faktura", "Završeno" }
            : new[] { "Prodaja", "CA", "Vještak", "CO pregled", "Faktura", "Završeno" };

        var currentIdx = ResolveStepIndex(StatusCode, IsPl);
    }
    @for (var i = 0; i < wfSteps.Length; i++)
    {
        var isDone = i < currentIdx;
        var isCurrent = i == currentIdx;
        <div class="od-wf-step @(isDone ? "done" : "") @(isCurrent ? "current" : "")">
            <div class="od-wf-dot" role="listitem"
                 aria-label="@(isDone ? "Završeno" : isCurrent ? "Aktivan korak" : "Čeka") — @wfSteps[i]">
                @if (isDone)    { <MudIcon Icon="@Icons.Material.Filled.Check" Style="font-size:12px;color:#fff;" /> }
                else if (isCurrent) { <MudIcon Icon="@Icons.Material.Filled.FiberManualRecord" Style="font-size:10px;color:var(--rbi-off-black);" /> }
            </div>
            <div class="od-wf-label">@wfSteps[i]</div>
            @if (isCurrent && !string.IsNullOrWhiteSpace(StatusLabel))
            {
                <div style="font-size:10px;color:var(--rbi-warning-text);font-weight:600;margin-top:1px;white-space:nowrap;">
                    @StatusLabel
                </div>
            }
        </div>
        @if (i < wfSteps.Length - 1) { <div class="od-wf-line @(isDone ? "done" : "")"></div> }
    }
</div>

@if (!string.IsNullOrWhiteSpace(CurrentOwnerRole))
{
    <div class="od-workflow-info">
        <span style="color:var(--text-muted);font-size:12px;">Trenutno odgovoran:</span>
        <span style="font-weight:700;font-size:13px;">@CurrentOwnerRole</span>
        @if (!string.IsNullOrWhiteSpace(NextResponsibleRole))
        {
            <span style="color:var(--text-muted);font-size:12px;margin-left:16px;">Sljedeći korak:</span>
            <span style="font-weight:600;font-size:13px;">@NextResponsibleRole</span>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public int    StatusCode           { get; set; }
    [Parameter]                 public bool   IsPl                 { get; set; }
    [Parameter]                 public string? StatusLabel         { get; set; }
    [Parameter]                 public string? CurrentOwnerRole    { get; set; }
    [Parameter]                 public string? NextResponsibleRole { get; set; }

    private static readonly Dictionary<int, int> FlPhaseMap = new()
    {
        [0] = 0, [10] = 0, [20] = 1, [30] = 1, [40] = 1, [45] = 1,
        [50] = 1, [80] = 1, [90] = 1, [95] = 1,
        [100] = 2, [105] = 2, [110] = 2, [115] = 2, [120] = 2, [125] = 2,
        [130] = 3, [140] = 3, [150] = 3,
        [200] = 5, [999] = 5,
    };

    private static readonly Dictionary<int, int> PlPhaseMap = new()
    {
        [0] = 0, [10] = 0, [20] = 1, [30] = 1, [40] = 1, [45] = 1, [50] = 1,
        [60] = 2, [65] = 2, [70] = 2,
        [80] = 3, [90] = 3, [95] = 3,
        [100] = 4, [105] = 4, [110] = 4, [115] = 4, [120] = 4, [125] = 4,
        [130] = 5, [140] = 5, [150] = 5,
        [200] = 7, [999] = 7,
    };

    private static int ResolveStepIndex(int statusCode, bool isPl)
    {
        var map = isPl ? PlPhaseMap : FlPhaseMap;
        return map.GetValueOrDefault(statusCode, isPl ? 7 : 5);
    }
}
