@* ── CreateOrderWizardStepper — navigacijski stepper za wizard narudžbe ─────────
   Ekstrahovano iz CreateOrder.razor (B-1 refactoring).
   Prikazuje 4 koraka (Klijent, Nekretnina, Dokumentacija, Pregled) s mogućnošću
   klika na prethodne korake.
*@

<div class="of-stepper">
    @foreach (var (label, icon, stepIdx) in Steps)
    {
        var isCurrent = CurrentStep == stepIdx;
        var isDone    = CurrentStep > stepIdx;
        <div class="of-step @(isCurrent ? "current" : "") @(isDone ? "done" : "")"
             @onclick="() => OnStepClick.InvokeAsync(stepIdx)">
            <div class="of-step-dot">
                @if (isDone)
                { <MudIcon Icon="@Icons.Material.Filled.Check" Style="font-size:14px;color:#fff;" /> }
                else
                { <span>@(stepIdx + 1)</span> }
            </div>
            <div class="of-step-label">@label</div>
        </div>
        @if (stepIdx < Steps.Length - 1)
        { <div class="of-step-line @(isDone ? "done" : "")"></div> }
    }
</div>

@code {
    public static readonly (string Label, string Icon, int Idx)[] DefaultSteps =
    [
        ("Klijent",       Icons.Material.Outlined.Person,    0),
        ("Nekretnina",    Icons.Material.Outlined.Home,      1),
        ("Dokumentacija", Icons.Material.Outlined.Folder,    2),
        ("Pregled",       Icons.Material.Outlined.Checklist, 3)
    ];

    [Parameter, EditorRequired]
    public (string Label, string Icon, int Idx)[] Steps { get; set; } = DefaultSteps;

    [Parameter, EditorRequired] public int CurrentStep { get; set; }

    [Parameter] public EventCallback<int> OnStepClick { get; set; }
}
