@* Layout za javne stranice (login) — bez sidebara, minimalan header *@
@inherits LayoutComponentBase

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<header style="position:fixed; top:0; left:0; right:0; height:64px; background:#FEE600;
               border-bottom:1px solid rgba(0,0,0,0.08); z-index:1000;
               display:flex; align-items:center; justify-content:space-between; padding:0 28px;">
    <div style="display:flex; align-items:center; gap:12px;">
        <div style="width:auto; height:36px; display:flex; align-items:center; justify-content:center;">
            <img src="images/rbbh-logo.png" alt="Raiffeisen Logo" style="height:32px; width:auto; display:block;" />
        </div>
        <div style="line-height:1.25;">
            <div style="font-size:14px; font-weight:700; color:var(--rbi-off-black);">Digitalizacija procjene nekretnina</div>
            <div style="font-size:11px; color:#555;">Raiffeisen Bank d.d.</div>
        </div>
    </div>
    <a href="/login"
       style="font-size:13px; font-weight:700; color:var(--rbi-off-black); text-decoration:none;
              padding:8px 18px; background:#2B2D33; color:#FEE600; border-radius:8px;">
        Prijava
    </a>
</header>

<div style="padding-top:64px; min-height:100vh; background:#F8F6F2;">
    @Body
</div>