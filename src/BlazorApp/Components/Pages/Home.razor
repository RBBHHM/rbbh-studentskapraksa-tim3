@page "/"
@* prerender:false — bez ovoga, navigacija na "/" radi DVA OnInitializedAsync prolaza:
   prvi (statički prerender) sa SVJEŽIM/praznim DI scope-om (RoleState.ActiveRole se
   čini prazan iako je upravo postavljen na /select-role) koji pogrešno zaključi
   "korisnik nije odabrao rolu" i odmah redirect-uje na /select-role PRIJE nego što
   drugi (interaktivni) prolaz sa ispravnim stanjem stigne renderovati — korisnik
   vidi "ništa se ne desi" / bounce-back na /select-role. *@
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject MeService MeService
@inject RoleContextApiService RoleContextApi
@inject ActiveRoleState RoleState
@inject OrderService OrderService
@inject NavigationManager Nav

<PageTitle>Početna — Digitalizacija procjene nekretnina</PageTitle>

<AppWelcomeDialog UserName="@(_me?.DisplayName ?? _me?.Username)"
                  RoleName="@(AppRoles.PrimaryDisplayName(_me?.Roles))" />

@if (_loading)
{
    <AppLoadingState />
}
else if (_noRole)
{
    @* No role — redirect handled in code *@
}
else if (_isAdmin)
{
    <BlazorApp.Components.Shared.DashboardAdmin DisplayName="@(_me?.DisplayName ?? _me?.Username ?? "")"
                    Checking="_checking" LastCheck="_lastStatusCheck"
                    Services="@_services.Select(s => (s.Name, s.Status)).ToList()" />
}
else if (_isSalesRole || _isCA)
{
    <!-- ═══ PRODAJA / CA DASHBOARD (AM/SM/UB/CA) ═══ -->
    <div class="page-header">
        <div class="page-header-left">
            <div class="page-title">Dobrodošli, @(_me?.DisplayName ?? _me?.Username)</div>
            <div class="page-subtitle">
                @(_isCA ? "Pregled svih narudžbi procjene u sistemu." : "Pregled vaših narudžbi procjene nekretnina.")
            </div>
        </div>
    </div>

    @* ── "Čeka vas" hero sekcija ──────────────────────────────────── *@
    @if (_pendingActionCount > 0)
    {
        <div class="od-pending-hero">
            <div style="display:flex;align-items:center;gap:12px;">
                <div style="background:var(--rbi-yellow);border-radius:50%;width:44px;height:44px;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                    <MudIcon Icon="@Icons.Material.Outlined.NotificationsActive" Style="font-size:22px;color:var(--rbi-off-black);" />
                </div>
                <div>
                    <div style="font-size:18px;font-weight:800;color:var(--rbi-off-black);">
                        Čeka vas: @_pendingActionCount @(_pendingActionCount == 1 ? "stavka" : "stavki")
                    </div>
                    <div style="font-size:13px;color:var(--text-secondary);">
                        @if (_isCA) { <span>Narudžbe koje čekaju vaš pregled i akciju</span> }
                        else { <span>Narudžbe vraćene na dopunu ili čekaju vaše slanje</span> }
                    </div>
                </div>
            </div>
            <MudButton Variant="Variant.Filled" Color="Color.Warning"
                       Style="font-weight:700;color:var(--rbi-off-black);text-transform:none;white-space:nowrap;"
                       OnClick='@(() => Nav.NavigateTo("/narudzbe"))'>
                Pogledaj sve
            </MudButton>
        </div>
    }

    <!-- KPI kartice -->
    <div class="section-title" style="margin-bottom:14px;">@(_isCA ? "Narudžbe u sistemu" : "Vaše narudžbe")</div>
    <MudGrid Spacing="3" Style="margin-bottom:28px;">
        @foreach (var kpi in KpiCards)
        {
            <MudItem xs="12" sm="6" md="4" lg="2">
                <AppKpiCard Label="@kpi.Label" Value="kpi.Count" Icon="@kpi.Icon"
                            Variant="@kpi.Variant"
                            OnClick="@(() => GoToOrders(kpi.StatusFilter))" />
            </MudItem>
        }
    </MudGrid>

    @* ── CA: najnovije pristigle narudžbe (čekaju prihvat) ─────────────────── *@
    @if (_isCA)
    {
        <div class="card" style="margin-bottom:28px;">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;">
                <div class="section-title" style="margin:0;">Najnovije pristigle narudžbe</div>
                <span class="badge badge-warning" style="font-size:11.5px;">Čekaju prihvat: @_newOrders.Count</span>
            </div>
            @if (_recentLoading)
            {
                <div style="display:flex;justify-content:center;padding:18px;"><MudProgressCircular Indeterminate="true" Color="Color.Warning" Size="Size.Small" /></div>
            }
            else if (_newOrders.Count == 0)
            {
                <div style="font-size:13.5px;color:var(--text-muted);padding:8px 0;">Trenutno nema novih narudžbi koje čekaju prihvat.</div>
            }
            else
            {
                @foreach (var o in _newOrders)
                {
                    var waitDays = (int)(DateTime.UtcNow - (o.SubmittedAt ?? o.CreatedAt)).TotalDays;
                    <div style="display:flex;align-items:center;gap:10px;padding:9px 0;border-bottom:1px solid var(--rbi-warm-grey-50);cursor:pointer;"
                         @onclick="@(() => Nav.NavigateTo($"/narudzbe/{o.Id}"))">
                        <MudIcon Icon="@Icons.Material.Outlined.MoveToInbox" Style="font-size:18px;color:var(--rbi-off-black);flex-shrink:0;" />
                        <div style="flex:1;min-width:0;">
                            <div style="font-size:13.5px;font-weight:600;color:var(--rbi-off-black);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                                @o.Title <span style="color:var(--text-muted);font-weight:500;">(@o.OrderNumber)</span>
                            </div>
                            <div class="metric-label" style="margin-top:1px;">
                                @o.ClientName · @((o.SubmittedAt ?? o.CreatedAt).ToLocalTime().ToString("dd.MM.yyyy HH:mm"))
                            </div>
                        </div>
                        <span class="badge @(waitDays > 2 ? "badge-error" : waitDays > 0 ? "badge-warning" : "badge-info")"
                              style="font-size:10px;" title="Čeka @waitDays dana">
                            @(waitDays > 0 ? $"Čeka {waitDays}d" : "Novo")
                        </span>
                    </div>
                }
            }
        </div>
    }

    @* ── Prodaja: Task inbox — strukturirani zadaci (audit P5) ──────────── *@
    @if (!_isCA && _returnedOrders.Count > 0)
    {
        <div class="card" style="margin-bottom:28px;border-left:3px solid var(--rbi-yellow);">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;">
                <div class="section-title" style="margin:0;">Vaši zadaci</div>
                <span class="badge badge-warning" style="font-size:11.5px;">@_returnedOrders.Count zadatak(a)</span>
            </div>
            @foreach (var o in _returnedOrders)
            {
                var daysAgo = (int)(DateTime.UtcNow - (o.UpdatedAt ?? o.CreatedAt)).TotalDays;
                <div style="display:flex;align-items:center;gap:10px;padding:9px 0;border-bottom:1px solid var(--rbi-warm-grey-50);cursor:pointer;"
                     @onclick="@(() => Nav.NavigateTo($"/narudzbe/{o.Id}"))">
                    <div style="width:32px;height:32px;border-radius:8px;background:#FFF0A6;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                        <MudIcon Icon="@Icons.Material.Outlined.EditNote" Style="font-size:16px;color:var(--rbi-off-black);" />
                    </div>
                    <div style="flex:1;min-width:0;">
                        <div style="font-size:13px;font-weight:700;color:var(--rbi-off-black);">
                            Dopuni podatke
                        </div>
                        <div style="font-size:12px;color:var(--text-secondary);margin-top:1px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                            @o.Title · @o.OrderNumber
                        </div>
                    </div>
                    <div style="text-align:right;flex-shrink:0;">
                        <span class="badge @(daysAgo > 2 ? "badge-error" : "badge-warning")" style="font-size:10px;">
                            @(daysAgo > 0 ? $"{daysAgo}d" : "Danas")
                        </span>
                    </div>
                </div>
            }
        </div>
    }

    <!-- ═══ NARUDŽBE PROCJENA — FL / PL PREGLED PROCESA (DIO_1, Slika 7) ═══ -->
    <div class="section-title" style="margin-bottom:14px;">Narudžbe procjena</div>
    <MudGrid Spacing="3" Style="margin-bottom:28px;">
        @foreach (var wf in new[] {
            (Label: "Fizička lica (FL)", Type: "FL"),
            (Label: "Pravna lica (PL)", Type: "PL")
        })
        {
            <MudItem xs="12" md="6">
                <div class="card">
                    <div style="font-size:14px;font-weight:800;color:var(--rbi-off-black);margin-bottom:14px;display:flex;align-items:center;gap:8px;">
                        <MudIcon Icon="@(wf.Type == "FL" ? Icons.Material.Outlined.Person : Icons.Material.Outlined.Business)"
                                 Style="font-size:18px;color:var(--rbi-off-black);" />
                        @wf.Label
                    </div>
                    @foreach (var box in new[] {
                        (Name: "Prodaja", Icon: Icons.Material.Outlined.Storefront, Desc: "Unos podataka, upload dokumentacije, iniciranje zadatka", Route: _isCA ? "/narudzbe" : $"/narudzbe/nova/{wf.Type}"),
                        (Name: "Kolateral administrator", Icon: Icons.Material.Outlined.FactCheck, Desc: "Pregled dokumentacije, izbor vještaka, slanje narudžbe", Route: "/narudzbe"),
                        (Name: "Vještak", Icon: Icons.Material.Outlined.Engineering, Desc: "Izrada procjene, dostava dokumentacije", Route: "/narudzbe"),
                        (Name: "Kolateral oficir", Icon: Icons.Material.Outlined.Gavel, Desc: "Provjera pristupa, odobrenje procjene, mišljenje", Route: "/narudzbe"),
                        (Name: "Faktura / Protokol", Icon: Icons.Material.Outlined.Receipt, Desc: "Obrada fakture, protokol narudžbi", Route: "/protokol"),
                    })
                    {
                        <div style="display:flex;align-items:center;gap:12px;padding:8px 6px;
                                    border-bottom:1px solid var(--rbi-warm-grey-50);cursor:pointer;border-radius:6px;transition:background .15s;"
                             class="proc-box-row"
                             @onclick="@(() => Nav.NavigateTo(box.Route))">
                            <div style="width:34px;height:34px;border-radius:8px;background:var(--rbi-warm-grey-50);
                                        display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                                <MudIcon Icon="@box.Icon" Style="font-size:16px;color:var(--rbi-off-black);" />
                            </div>
                            <div style="flex:1;min-width:0;">
                                <div style="font-size:13px;font-weight:700;color:var(--rbi-off-black);">@box.Name</div>
                                <div style="font-size:11px;color:var(--text-muted);">@box.Desc</div>
                            </div>
                            <MudIcon Icon="@Icons.Material.Outlined.ChevronRight" Style="font-size:16px;color:var(--text-faint);" />
                        </div>
                    }
                </div>
            </MudItem>
        }
    </MudGrid>

    <!-- Brze akcije -->
    <div class="section-title" style="margin-bottom:14px;">Brze akcije</div>
    <MudGrid Spacing="3" Style="margin-bottom:28px;">
        @if (_isCA)
        {
            <MudItem xs="12" sm="6" md="4">
                <AppQuickActionCard Title="Moji taskovi"
                                     Description="Pregledajte i obradite taskove dodijeljene vama kao Credit Analyst-u."
                                     Icon="@Icons.Material.Outlined.AssignmentTurnedIn"
                                     IconBg="#FFF9D6" IconColor="#2B2D33"
                                     OnClick="@(() => Nav.NavigateTo("/moji-taskovi"))" />
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <AppQuickActionCard Title="Pregled narudžbi"
                                     Description="Pregledajte sve narudžbe u sistemu, filtrirajte i pratite status obrade."
                                     Icon="@Icons.Material.Outlined.ListAlt"
                                     IconBg="#F8F6F2" IconColor="#2B2D33"
                                     OnClick="@(() => Nav.NavigateTo("/narudzbe"))" />
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <AppQuickActionCard Title="Protokol narudžbi"
                                     Description="Pregledajte protokol svih obrađenih narudžbi procjene."
                                     Icon="@Icons.Material.Outlined.MenuBook"
                                     IconBg="#F8F6F2" IconColor="#2B2D33"
                                     OnClick="@(() => Nav.NavigateTo("/protokol"))" />
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <AppQuickActionCard Title="Izvještaji"
                                     Description="Generišite izvještaje: koncentracija vještaka, vremenske analize narudžbi."
                                     Icon="@Icons.Material.Outlined.BarChart"
                                     IconBg="#F8F6F2" IconColor="#2B2D33"
                                     OnClick="@(() => Nav.NavigateTo("/izvjestaji"))" />
            </MudItem>
        }
        else
        {
            <MudItem xs="12" sm="6" md="4">
                <AppQuickActionCard Title="Kreiraj novu narudžbu"
                                     Description="Pokrenite novu narudžbu procjene nekretnine za klijenta."
                                     Icon="@Icons.Material.Outlined.NoteAdd"
                                     IconBg="#FFF9D6" IconColor="#2B2D33"
                                     OnClick="@(() => Nav.NavigateTo("/narudzbe/nova"))" />
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <AppQuickActionCard Title="Pregled narudžbi"
                                     Description="Pregledajte sve vaše narudžbe, filtrirajte i pratite status obrade."
                                     Icon="@Icons.Material.Outlined.ListAlt"
                                     IconBg="#F8F6F2" IconColor="#2B2D33"
                                     OnClick="@(() => Nav.NavigateTo("/narudzbe"))" />
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <AppQuickActionCard Title="Moji nacrti"
                                     Description="Nastavite popunjavanje narudžbi koje još nisu poslane na obradu."
                                     Icon="@Icons.Material.Outlined.Drafts"
                                     IconBg="#F8F6F2" IconColor="#2B2D33"
                                     OnClick="@(() => Nav.NavigateTo("/narudzbe?status=Draft"))" />
            </MudItem>
        }
    </MudGrid>

    <!-- Posljednje aktivnosti -->
    <div class="card">
        <div class="section-title" style="margin-bottom:14px;">Posljednje aktivnosti</div>
        @if (_recentLoading)
        {
            <div style="display:flex; justify-content:center; padding:24px;">
                <MudProgressCircular Indeterminate="true" Color="Color.Warning" Size="Size.Small" />
            </div>
        }
        else if (_recentOrders.Count == 0)
        {
            <div style="font-size:13.5px; color:var(--text-muted); padding:8px 0;">
                Još nema aktivnosti — kreirajte prvu narudžbu.
            </div>
        }
        else
        {
            @foreach (var o in _recentOrders)
            {
                <div style="display:flex; align-items:center; gap:10px; padding:9px 0;
                            border-bottom:1px solid var(--rbi-warm-grey-50); cursor:pointer;"
                     @onclick="@(() => Nav.NavigateTo($"/narudzbe/{o.Id}"))">
                    <MudIcon Icon="@Icons.Material.Outlined.History" Style="font-size:17px; color:var(--rbi-off-black); flex-shrink:0;" />
                    <div style="flex:1; min-width:0;">
                        <div style="font-size:13.5px; font-weight:600; color:var(--rbi-off-black); white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                            @o.Title <span style="color:var(--text-muted); font-weight:500;">(@o.OrderNumber)</span>
                        </div>
                        <div class="metric-label" style="margin-top:1px;">
                            @ActivityLabel(o) · @((o.UpdatedAt ?? o.CreatedAt).ToLocalTime().ToString("dd.MM.yyyy HH:mm"))
                        </div>
                    </div>
                </div>
            }
        }
    </div>
}
else if (_isTaskRole)
{
    <DashboardTask DisplayName="@(_me?.DisplayName ?? _me?.Username ?? "")"
                   Subtitle="@TaskRoleSubtitle" ActionDesc="@TaskRoleActionDesc"
                   Loading="_tasksLoading" Tasks="_myTasks"
                   OpenCount="TasksOpen" InProgressCount="TasksInProgress" TotalCount="TasksTotal"
                   ShowReports="_isCO" />
}
else if (_isProtokol)
{
    <DashboardProtokol DisplayName="@(_me?.DisplayName ?? _me?.Username ?? "")" />
}
else if (_isInvoiceRole)
{
    <DashboardInvoice DisplayName="@(_me?.DisplayName ?? _me?.Username ?? "")"
                      RoleName="@(AppRoles.PrimaryDisplayName(_me?.Roles) ?? "—")"
                      IsLikvidatura="_isLikvidatura"
                      IsSpecijalniRacuni="_isSpecijalniRacuni"
                      IsRacunovodstvo="_isRacunovodstvo" />
}
else
{
    <DashboardGeneric DisplayName="@(_me?.DisplayName ?? _me?.Username ?? "")"
                      RoleName="@(AppRoles.PrimaryDisplayName(_me?.Roles) ?? "—")"
                      Services="@_services.Select(s => (s.Name, s.Status)).ToList()" />
}

@code {
    private bool _loading = true;
    private bool _checking;
    private DateTime _lastStatusCheck = DateTime.UtcNow;
    private bool _noRole;
    private MeDto? _me;

    /// <summary>Rola odabrana na /select-role, proslijeđena kroz query string — vidi
    /// SelectRoleAsync u SelectRole.razor (zaobilazi reset scoped ActiveRoleState
    /// kod prelaza između stranica sa odvojenim @rendermode InteractiveServer root-ovima).</summary>
    [SupplyParameterFromQuery(Name = "activeRole")]
    public string? ActiveRoleQuery { get; set; }

    private bool _isAdmin => _me?.Roles.Contains(AppRoles.Administrator, StringComparer.OrdinalIgnoreCase) ?? false;
    private bool _isSalesRole => _me?.Roles.Any(r => AppRoles.SalesRoles.Contains(r, StringComparer.OrdinalIgnoreCase)) ?? false;
    private bool _isCA => _me?.Roles.Contains(AppRoles.KolateralAdministrator, StringComparer.OrdinalIgnoreCase) ?? false;
    private bool _isCO => _me?.Roles.Contains(AppRoles.KolateralOficir, StringComparer.OrdinalIgnoreCase) ?? false;
    private bool _isVjestak => _me?.Roles.Contains(AppRoles.Vjestak, StringComparer.OrdinalIgnoreCase) ?? false;
    private bool _isPravna => _me?.Roles.Contains(AppRoles.PravnaSluzba, StringComparer.OrdinalIgnoreCase) ?? false;
    private bool _isProtokol => _me?.Roles.Contains(AppRoles.Protokol, StringComparer.OrdinalIgnoreCase) ?? false;
    private bool _isLikvidatura => _me?.Roles.Contains(AppRoles.Likvidatura, StringComparer.OrdinalIgnoreCase) ?? false;
    private bool _isSpecijalniRacuni => _me?.Roles.Contains(AppRoles.SpecijalniRacuni, StringComparer.OrdinalIgnoreCase) ?? false;
    private bool _isRacunovodstvo => _me?.Roles.Contains(AppRoles.Racunovodstvo, StringComparer.OrdinalIgnoreCase) ?? false;
    private bool _isInvoiceRole => _isLikvidatura || _isSpecijalniRacuni || _isRacunovodstvo;

    /// <summary>Role koje rade preko taskova (kućica) — dijele task-orijentisan dashboard.</summary>
    private bool _isTaskRole => _isCO || _isVjestak || _isPravna;

    // ── Task dashboard (CO / Vještak / Pravna služba) ──────────────────────
    private List<WorkflowTaskDto> _myTasks = [];
    private bool _tasksLoading = true;
    private string? _myUserId;
    private int TasksOpen     => _myTasks.Count(t => t.Status == "Open");
    private int TasksInProgress => _myTasks.Count(t => t.Status is "Accepted" or "InProgress" && t.AcceptedByUserId == _myUserId);
    private int TasksTotal    => _myTasks.Count;

    private record ServiceItem(string Name, string Status);
    private List<ServiceItem> _services = [
        new("Backend API",   "Nije provjereno"),
        new("Keycloak Auth", "Nije provjereno"),
        new("Baza podataka", "Nije provjereno"),
    ];

    // ── Prodaja dashboard ──────────────────────────────────────────────────
    private OrderSummaryDto _summary = new();
    private List<AppraisalOrderListItemDto> _recentOrders = [];
    private List<AppraisalOrderListItemDto> _newOrders = [];       // CA: pristigle (SubmittedBySales)
    private List<AppraisalOrderListItemDto> _returnedOrders = [];  // Prodaja: vraćene na dopunu
    private bool _recentLoading = true;

    private int _pendingActionCount => _isCA ? _newOrders.Count : _returnedOrders.Count;

    private record KpiCard(string Label, int Count, string? StatusFilter, string Icon, string? IconBg, string? IconColor, string? Variant);

    private IReadOnlyList<KpiCard> KpiCards => [
        new("Ukupno narudžbi",     _summary.Total,            null,               Icons.Material.Outlined.Assignment,     null,      null, null),
        new("Nacrti",               _summary.Draft,            "Draft",            Icons.Material.Outlined.Drafts,          null,      null, null),
        new("Poslane",              _summary.SubmittedBySales, "SubmittedBySales", Icons.Material.Outlined.Send,            null,      null, null),
        new("U obradi",             _summary.InProgress,       "InProgress",       Icons.Material.Outlined.PendingActions,  null,      null, null),
        new("Završene",             _summary.Completed,        "Completed",        Icons.Material.Outlined.CheckCircle,    null,      null, "success"),
        new("Otkazane",             _summary.Cancelled,        "Cancelled",        Icons.Material.Outlined.Cancel,         null,      null, "danger"),
    ];

    private void GoToOrders(string? statusFilter) =>
        Nav.NavigateTo(string.IsNullOrEmpty(statusFilter) ? "/narudzbe" : $"/narudzbe?status={statusFilter}");

    private string TaskRoleSubtitle =>
        _isCO      ? "Pregled i odobrenje procjena, provjera pristupa i mišljenja."
      : _isVjestak ? "Izrada procjena i dostava dokumentacije po dodijeljenim zadacima."
      : _isPravna  ? "Pravna mišljenja po dodijeljenim zadacima."
      : "Pregled vaših zadataka.";

    private string TaskRoleActionDesc =>
        _isCO      ? "Pregledajte procjene, zatražite korekcije, odobrite i obradite mišljenja."
      : _isVjestak ? "Prihvatite i obradite procjene, uploadujte dokumentaciju i finalnu procjenu."
      : _isPravna  ? "Pregledajte i dostavite pravna mišljenja."
      : "Pregledajte i obradite dodijeljene zadatke.";

    private static string ActivityLabel(AppraisalOrderListItemDto o)
    {
        var edited = o.UpdatedAt.HasValue && o.UpdatedAt.Value > o.CreatedAt;
        return o.Status switch
        {
            "Cancelled"          => "Narudžba otkazana",
            "Draft" when edited  => "Nacrt nastavljen",
            "Draft"              => "Nacrt kreiran",
            "SubmittedBySales"   => "Narudžba poslana CA-u",
            _ when edited        => "Narudžba izmijenjena",
            _                    => "Narudžba kreirana"
        };
    }

    protected override async Task OnInitializedAsync()
    {
        var r = await MeService.GetMeAsync();
        if (!r.IsSuccess || r.Data is null)
        {
            _loading = false;
            return;
        }

        _me = r.Data;

        // ── Korisnik nema role → access denied ────────────────────────────────
        if (_me.Roles == null || !_me.Roles.Any())
        {
            _noRole = true;
            Nav.NavigateTo("/access-denied", replace: true);
            return;
        }

        // Ako je rola upravo odabrana na /select-role, stigla je kroz query string
        // (vidi SelectRole.razor) — primijeni je PRIJE provjere ispod, jer je
        // RoleState (scoped) mogao biti resetovan novim DI scope-om ove stranice.
        if (!string.IsNullOrWhiteSpace(ActiveRoleQuery) &&
            _me.Roles.Contains(ActiveRoleQuery, StringComparer.OrdinalIgnoreCase))
        {
            RoleState.SetActiveRole(ActiveRoleQuery);
        }

        // Inicijalizuj role state sa svim rolama
        RoleState.Initialize(_me.Roles, RoleState.ActiveRole);

        // ── Preusmjeravanje prema broju validnih rola ─────────────────────────
        // UserStatus "SelectRole" znači da API detektovao 2+ rola. Ako je korisnik
        // već odabrao aktivnu rolu u ovoj sesiji (npr. rola čiji dashboard je "/"),
        // ne vraćamo ga opet na /select-role.
        if (_me.UserStatus == "SelectRole" && string.IsNullOrEmpty(RoleState.ActiveRole))
        {
            Nav.NavigateTo("/select-role", replace: true);
            return;
        }

        // UserStatus "NoRole" ili "UnknownRole"
        if (_me.UserStatus is "NoRole" or "UnknownRole")
        {
            Nav.NavigateTo("/access-denied", replace: true);
            return;
        }

        // Jedna validna rola — automatski redirect na dashboard
        // Preskačemo ako je rola već odabrana (multi-role korisnik stigao sa /select-role)
        if (!string.IsNullOrWhiteSpace(_me.DefaultRoute) && _me.DefaultRoute != "/" && string.IsNullOrEmpty(RoleState.ActiveRole))
        {
            var current = new Uri(Nav.Uri).AbsolutePath;
            if (string.Equals(current, "/", StringComparison.OrdinalIgnoreCase))
            {
                // Postavi active role i redirect
                var primaryRole = _me.Roles.FirstOrDefault();
                if (primaryRole is not null && string.IsNullOrEmpty(RoleState.ActiveRole))
                {
                    await RoleContextApi.SetActiveRoleAsync(primaryRole);
                    RoleState.SetActiveRole(primaryRole);
                }
                Nav.NavigateTo(_me.DefaultRoute, replace: true);
                return;
            }
        }

        if (_isAdmin)
        {
            await CheckStatus();
        }
        else if (_isSalesRole || _isCA)
        {
            await LoadOrdersDashboardAsync();
        }
        else if (_isTaskRole)
        {
            _myUserId = _me.UserId;
            await LoadTasksDashboardAsync();
        }

        _loading = false;
    }

    private async Task LoadTasksDashboardAsync()
    {
        var r = await OrderService.GetMyTasksAsync(page: 1, pageSize: 50);
        if (r.IsSuccess && r.Data is not null)
            _myTasks = r.Data.Items.ToList();
        _tasksLoading = false;
    }

    private async Task LoadOrdersDashboardAsync()
    {
        var summaryResult = await OrderService.GetSummaryAsync();
        if (summaryResult.IsSuccess && summaryResult.Data is not null)
            _summary = summaryResult.Data;

        var recentResult = await OrderService.GetListAsync(
            page: 1, pageSize: 5, sortBy: "UpdatedAt", sortDescending: true);
        if (recentResult.IsSuccess && recentResult.Data is not null)
            _recentOrders = recentResult.Data.Items.ToList();

        if (_isCA)
        {
            var newRes = await OrderService.GetListAsync(
                page: 1, pageSize: 8, status: "SubmittedBySales", sortBy: "SubmittedAt", sortDescending: true);
            if (newRes.IsSuccess && newRes.Data is not null)
                _newOrders = newRes.Data.Items.ToList();
        }
        else
        {
            var retRes = await OrderService.GetListAsync(
                page: 1, pageSize: 8, status: "ReturnedForCorrection", sortBy: "UpdatedAt", sortDescending: true);
            if (retRes.IsSuccess && retRes.Data is not null)
                _returnedOrders = retRes.Data.Items.ToList();
        }

        _recentLoading = false;
    }

    private async Task CheckStatus()
    {
        _checking = true;
        try
        {
            var r = await MeService.GetMeAsync();
            var ok = r.StatusCode is null or 200 or 401 or 403 ? "Aktivan" : "Greška";
            _services = [
                new("Backend API",   ok),
                new("Keycloak Auth", "Nije provjereno"),
                new("Baza podataka", ok == "Aktivan" ? "Aktivan" : "Greška"),
            ];
        }
        catch { _services = _services.Select(s => new ServiceItem(s.Name, "Greška")).ToList(); }
        finally { _lastStatusCheck = DateTime.UtcNow; _checking = false; }
    }
}
