@page "/protokol"
@rendermode InteractiveServer
@attribute [Authorize]
@inject ProtocolService ProtocolService
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState

<PageTitle>Protokol narudžbi — Procjena nekretnine</PageTitle>

@* ── 403 guard ────────────────────────────────────────────────────────────── *@
@if (_accessDenied)
{
    <AppAccessDenied />
    return;
}

@* ── Breadcrumb ──────────────────────────────────────────────────────────── *@
<AppBreadcrumb Items="@(new List<AppBreadcrumb.BreadcrumbItem> { new("Početna", "/"), new("Protokol narudžbi", "") })" />

@* ── Page header ──────────────────────────────────────────────────────────── *@
<AppPageHeader Title="Protokol narudžbi"
               Subtitle="Pregled svih protokolnih unosa generisanih prilikom slanja narudžbi procjene.">
    <Actions>
        <MudButton Variant="Variant.Outlined" Size="Size.Small"
                   StartIcon="@Icons.Material.Outlined.Upload"
                   OnClick="@(() => _showImportExport = true)"
                   Style="height:38px; font-size:13px; text-transform:none; font-weight:600;">
            Masovni import
        </MudButton>
    </Actions>
</AppPageHeader>

@if (_showImportExport)
{
    <ImportExportDialog OnClose="@(() => { _showImportExport = false; _ = LoadEntries(); })" />
}

@* ── Loading ──────────────────────────────────────────────────────────────── *@
@if (_loading)
{
    <AppLoadingState />
}
else if (_loadError is not null)
{
    <AppErrorBanner Message="@_loadError" OnRetry="LoadEntries" />
}
else if (_entries.Count == 0)
{
    <AppEmptyState Title="Još nema protokolnih unosa">
        <div style="font-size:13.5px; color:var(--text-muted);">
            Protokolni unos se automatski generiše prilikom slanja narudžbe procjene.
        </div>
    </AppEmptyState>
}
else
{
    @* ── Column toggle ─────────────────────────────────────────────────────── *@
    <div class="col-toggle-wrap">
        <span style="font-weight:600; color:var(--rbi-off-black); margin-right:6px;">Kolone:</span>
        @foreach (var col in _allColumns)
        {
            <span class="col-toggle-chip @(_visibleColumns.Contains(col.Key) ? "active" : "")"
                  @onclick="@(() => ToggleColumn(col.Key))">
                @col.Label
            </span>
        }
    </div>

    @* ── Tabela ────────────────────────────────────────────────────────────── *@
    <div class="app-table-wrap" style="overflow:auto;">
        <table class="app-table">
            <thead>
                <tr class="app-thead-row">
                    <th class="app-th">Protokolni broj</th>
                    <th class="app-th">Broj narudžbe</th>
                    @if (Col("naslov"))     { <th class="app-th">Naslov</th> }
                    @if (Col("klijent"))    { <th class="app-th">Klijent</th> }
                    @if (Col("tipkl"))      { <th class="app-th">Tip klijenta</th> }
                    @if (Col("jmbg"))       { <th class="app-th">JMBG</th> }
                    @if (Col("tipkolG"))    { <th class="app-th">Tip kolaterala (G)</th> }
                    @if (Col("tipkolH"))    { <th class="app-th">Tip kolaterala kombin. (H)</th> }
                    @if (Col("adresa"))     { <th class="app-th">Adresa nekretnine</th> }
                    @if (Col("grad"))       { <th class="app-th">Grad</th> }
                    @if (Col("poslovnica")) { <th class="app-th">Poslovnica</th> }
                    @if (Col("adrPosl"))    { <th class="app-th">Adresa poslovnice</th> }
                    @if (Col("kontakt"))    { <th class="app-th">Kontakt osoba</th> }
                    @if (Col("telefon"))    { <th class="app-th">Kontakt telefon</th> }
                    @if (Col("inicirao"))   { <th class="app-th">Inicirao (AM/SM/UB)</th> }
                    @if (Col("dostava"))    { <th class="app-th">Osoba za dostavu</th> }
                    @if (Col("ammail"))     { <th class="app-th">Ime AM-a za mail</th> }
                    @if (Col("caIme"))      { <th class="app-th">Prihvatio CA</th> }
                    @if (Col("docStat"))    { <th class="app-th">Status dokumentacije</th> }
                    <th class="app-th">Status</th>
                    <th class="app-th">Datum</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in _entries)
                {
                    <tr class="app-tr clickable" tabindex="0"
                        @onclick="@(() => Nav.NavigateTo($"/narudzbe/{p.OrderId}"))"
                        @onkeydown="@(e => { if (e.Key is "Enter") Nav.NavigateTo($"/narudzbe/{p.OrderId}"); })"
                        aria-label="@($"Protokol {p.ProtocolNumber}")">
                        <td class="app-td nowrap bold">
                            @p.ProtocolNumber
                            @if (p.IsCancelled)
                            {
                                <AppStatusBadge Status="Cancelled" ExtraStyle="margin-left:8px;" />
                            }
                        </td>
                        <td class="app-td nowrap">@p.OrderNumber</td>
                        @if (Col("naslov"))     { <td class="app-td ellipsis" style="max-width:280px;" title="@p.OrderTitle">@p.OrderTitle</td> }
                        @if (Col("klijent"))    { <td class="app-td ellipsis" title="@p.ClientName">@p.ClientName</td> }
                        @if (Col("tipkl"))      { <td class="app-td nowrap">@(p.ClientTypeLabel ?? "—")</td> }
                        @if (Col("jmbg"))       { <td class="app-td nowrap mono-code">@(p.ClientIdentifier ?? "—")</td> }
                        @if (Col("tipkolG"))    { <td class="app-td nowrap">@(p.CollateralTypeLabel ?? "—")</td> }
                        @if (Col("tipkolH"))    { <td class="app-td nowrap">@(p.CombinedCollateralTypeLabel ?? "—")</td> }
                        @if (Col("adresa"))     { <td class="app-td ellipsis" title="@p.PropertyAddress">@(p.PropertyAddress ?? "—")</td> }
                        @if (Col("grad"))       { <td class="app-td nowrap">@(p.City ?? "—")</td> }
                        @if (Col("poslovnica")) { <td class="app-td nowrap">@(p.Branch ?? "—")</td> }
                        @if (Col("adrPosl"))    { <td class="app-td ellipsis" title="@p.BranchAddress">@(p.BranchAddress ?? "—")</td> }
                        @if (Col("kontakt"))    { <td class="app-td ellipsis" title="@p.ContactName">@(p.ContactName ?? "—")</td> }
                        @if (Col("telefon"))    { <td class="app-td nowrap">@(p.ContactPhone ?? "—")</td> }
                        @if (Col("inicirao"))   { <td class="app-td ellipsis" title="@InitiatorLabel(p)">@InitiatorLabel(p)</td> }
                        @if (Col("dostava"))    { <td class="app-td ellipsis" title="@p.DeliveryContactName">@(p.DeliveryContactName ?? "—")</td> }
                        @if (Col("ammail"))     { <td class="app-td ellipsis" title="@p.AmRecipientName">@(p.AmRecipientName ?? "—")</td> }
                        @if (Col("caIme"))      { <td class="app-td ellipsis" title="@p.AcceptedByCAName">@(p.AcceptedByCAName ?? "—")</td> }
                        @if (Col("docStat"))    { <td class="app-td nowrap">@(p.DocumentationReviewStatus ?? "—")</td> }
                        <td class="app-td nowrap">
                            <AppStatusBadge Status="@p.OrderStatus" Label="@p.OrderStatusLabel" />
                        </td>
                        <td class="app-td nowrap secondary">@p.GeneratedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @* ── Paginacija ────────────────────────────────────────────────────────── *@
    <AppPagination Page="_page" TotalPages="_totalPages" TotalCount="_totalCount" OnPageChange="ChangePage" />
}

@code {
    /// <summary>"Ime Prezime (AM/SM/UB)" — ko je inicirao narudžbu (zahtjev: Protokol
    /// mora preslikati AM/SM/UB rolu + ime inicijatora; datum/vrijeme je već vidljivo
    /// u koloni "Datum generisanja").</summary>
    private static string InitiatorLabel(ProtocolEntryDto p) =>
        (p.CreatedByName, p.CreatedByRole) switch
        {
            (null or "", _)            => "—",
            (var name, null or "")      => name,
            (var name, var role)        => $"{name} ({role})"
        };

    private record ColDef(string Key, string Label);

    private static readonly ColDef[] _allColumns =
    [
        new("naslov",     "Naslov"),
        new("klijent",    "Klijent"),
        new("tipkl",      "Tip klijenta"),
        new("jmbg",       "JMBG"),
        new("tipkolG",    "Tip nekretnine"),
        new("tipkolH",    "Kombinovani tip"),
        new("adresa",     "Adresa"),
        new("grad",       "Grad"),
        new("poslovnica", "Poslovnica"),
        new("adrPosl",    "Adr. poslovnice"),
        new("kontakt",    "Kontakt osoba"),
        new("telefon",    "Telefon"),
        new("inicirao",   "Inicirao"),
        new("dostava",    "Dostava"),
        new("ammail",     "AM mail"),
        new("caIme",      "Prihvatio CA"),
        new("docStat",    "Status dokumentacije"),
    ];

    private HashSet<string> _visibleColumns = ["naslov", "klijent", "tipkl", "grad", "poslovnica", "inicirao", "telefon"];

    private bool Col(string key) => _visibleColumns.Contains(key);

    private void ToggleColumn(string key)
    {
        if (!_visibleColumns.Remove(key))
            _visibleColumns.Add(key);
    }

    private List<ProtocolEntryDto> _entries = [];
    private bool   _loading;
    private bool   _accessDenied;
    private bool   _showImportExport;
    private string? _loadError;
    private int    _page = 1;
    private int    _totalCount;
    private int    _totalPages;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState.GetAuthenticationStateAsync();
        var user      = authState.User;

        if (!user.Identity?.IsAuthenticated ?? true)
        {
            Nav.NavigateTo("/login", replace: true);
            return;
        }

        var roles  = user.FindAll("roles").Select(c => c.Value).ToList();
        var hasAccess = roles.Any(r =>
            r.Equals(AppRoles.KolateralAdministrator, StringComparison.OrdinalIgnoreCase) ||
            r.Equals(AppRoles.Protokol,               StringComparison.OrdinalIgnoreCase) ||
            r.Equals(AppRoles.Administrator,          StringComparison.OrdinalIgnoreCase));

        if (!hasAccess) { _accessDenied = true; return; }

        await LoadEntries();
    }

    private async Task LoadEntries()
    {
        _loading   = true;
        _loadError = null;
        StateHasChanged();

        var result = await ProtocolService.GetListAsync(_page, 10);
        _loading   = false;

        if (result.IsSuccess && result.Data is not null)
        {
            _entries    = result.Data.Items.ToList();
            _totalCount = result.Data.TotalCount;
            _totalPages = result.Data.TotalPages;
        }
        else
        {
            _loadError = result.ErrorMessage ?? "Greška pri učitavanju protokola.";
        }
    }

    private async Task ChangePage(int newPage)
    {
        _page = newPage;
        await LoadEntries();
    }
}
