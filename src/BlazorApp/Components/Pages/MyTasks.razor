@page "/moji-taskovi"
@rendermode InteractiveServer
@attribute [Authorize]
@inject OrderService OrderService
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav

<PageTitle>Moji zadaci — Procjena nekretnine</PageTitle>

@if (_accessDenied)
{
    <AppAccessDenied Message="Ova stranica je dostupna samo za kolateral administratora i kolateral oficira." />
    return;
}

<AppBreadcrumb Items="@(new List<AppBreadcrumb.BreadcrumbItem> { new("Početna", "/"), new("Moji zadaci", "") })" />

<AppPageHeader Title="Moji zadaci"
               Subtitle="Taskovi dodijeljeni vama ili vašoj roli koji čekaju obradu.">
    <Actions>
        <MudTooltip Text="Osvježi listu zadataka" Placement="Placement.Bottom">
            <MudIconButton Icon="@Icons.Material.Outlined.Refresh" Size="Size.Small"
                           OnClick="LoadTasks" Disabled="_loading"
                           Style="color:var(--text-secondary);" aria-label="Osvježi" />
        </MudTooltip>
    </Actions>
</AppPageHeader>

@if (_loading)
{
    <AppLoadingState />
}
else if (_loadError is not null)
{
    <AppErrorBanner Message="@_loadError" OnRetry="LoadTasks" />
}
else if (_tasks.Count == 0)
{
    <AppEmptyState Icon="@Icons.Material.Outlined.CheckCircleOutline" IconColor="#A3E2CC" Title="Nema otvorenih taskova">
        <div style="font-size:13.5px; color:var(--text-muted);">Sve je odrađeno.</div>
    </AppEmptyState>
}
else
{
    <div style="display:flex; flex-direction:column; gap:10px;">
        @foreach (var task in _tasks)
        {
            <div class="task-card @(task.IsOverdue ? "overdue" : "")">

                @* Row 1 — naslov + badges *@
                <div class="task-card-head">
                    <span class="task-card-title">@task.Title</span>
                    <AppStatusBadge Label="@task.StatusLabel" ColorOverride="#6B6560" />
                    @if (task.IsOverdue)
                    {
                        <span class="task-overdue-badge">
                            <MudIcon Icon="@Icons.Material.Outlined.Schedule" Style="font-size:13px; margin-right:3px;" />
                            Prekoračen rok
                        </span>
                    }
                </div>

                @* Row 2 — subtitle (naslov narudžbe) *@
                @if (!string.IsNullOrWhiteSpace(task.OrderTitle))
                {
                    <div class="task-card-body">@task.OrderTitle</div>
                }

                @* Row 3 — meta podaci *@
                <div class="task-card-meta">
                    <span>
                        <MudIcon Icon="@Icons.Material.Outlined.Tag" Style="font-size:13px; vertical-align:middle;" />
                        @task.OrderNumber
                    </span>
                    @if (task.DueDate.HasValue)
                    {
                        var remaining = task.DueDate.Value - DateTime.UtcNow;
                        var countdownLabel = CountdownLabel(remaining);
                        <span style="color:@(task.IsOverdue ? "#C65C4A" : remaining.TotalHours < 4 ? "#E8960C" : "#9B9590");
                                     font-weight:@(remaining.TotalHours < 4 ? "700" : "400")">
                            <MudIcon Icon="@(task.IsOverdue ? Icons.Material.Outlined.Warning : Icons.Material.Outlined.Timer)"
                                     Style="font-size:13px; vertical-align:middle;" />
                            @countdownLabel
                        </span>
                    }
                    <span>
                        <MudIcon Icon="@Icons.Material.Outlined.CalendarToday" Style="font-size:13px; vertical-align:middle;" />
                        Kreiran: @task.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                    </span>
                </div>

                @* Row 4 — akcije *@
                <div class="task-card-foot">
                    <MudButton Variant="Variant.Text" Size="Size.Small"
                               OnClick="@(() => Nav.NavigateTo(OrderLink(task.OrderId)))"
                               Style="color:var(--text-secondary); font-size:12px;">
                        Otvori narudžbu →
                    </MudButton>

                    @if (task.Status == BlazorApp.Constants.OrderStatusDisplay.TaskOpen && task.IsLocked)
                    {
                        <span style="font-size:12px; color:var(--text-muted); font-style:italic;">
                            Prihvaćen od strane drugog korisnika
                        </span>
                    }
                    else if (task.Status == BlazorApp.Constants.OrderStatusDisplay.TaskOpen && !task.IsLocked)
                    {
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Warning"
                                   Size="Size.Small"
                                   Disabled="_accepting == task.Id"
                                   OnClick="@(() => AcceptTask(task))"
                                   Style="font-weight:700; color:var(--rbi-off-black);">
                            @if (_accepting == task.Id)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Style="margin-right:6px;" />
                            }
                            Prihvati task
                        </MudButton>
                    }
                    else if (task.Status == BlazorApp.Constants.OrderStatusDisplay.TaskAccepted && task.AcceptedByUserId is not null)
                    {
                        @* Task je prihvaćen (claim-an) — stvarna radnja (Uredan pristup,
                           Odobri dokumentaciju, Odobri procjenu, …) se obavlja na stranici
                           narudžbe, a NE generičkim "Završi task" koji bi zaobišao workflow. *@
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Success"
                                   Size="Size.Small"
                                   OnClick="@(() => Nav.NavigateTo(OrderLink(task.OrderId)))"
                                   Style="font-weight:700;">
                            Nastavi na narudžbi →
                        </MudButton>
                    }
                </div>

            </div>
        }
    </div>

    <AppPagination Page="_page" TotalPages="_totalPages" TotalCount="_tasks.Count" OnPageChange="ChangePage" />
}

@code {
    private List<WorkflowTaskDto> _tasks = [];
    private bool _loading;
    private bool _accessDenied;
    private string? _loadError;
    private int  _page       = 1;
    private int  _totalPages;
    private int? _accepting;
    private bool _isCa;
    private bool _isCo;

     private static string CountdownLabel(TimeSpan remaining)
    {
        var hours = remaining.TotalHours;
        if (hours < 0)
            return $"Prekoračen za {Math.Abs((int)remaining.TotalDays)}d {Math.Abs(remaining.Hours)}h";
        if (hours < 24)
            return $"Još {(int)remaining.TotalHours}h {remaining.Minutes}min";
        return $"Još {(int)remaining.TotalDays} dana";
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState.GetAuthenticationStateAsync();
        var user      = authState.User;

        if (!user.Identity?.IsAuthenticated ?? true) { Nav.NavigateTo("/login", replace: true); return; }

        var roles = user.FindAll("roles").Select(c => c.Value).ToList();
        _isCa = roles.Any(r => r.Equals(AppRoles.KolateralAdministrator, StringComparison.OrdinalIgnoreCase));
        _isCo = roles.Any(r => r.Equals(AppRoles.KolateralOficir, StringComparison.OrdinalIgnoreCase));

        // Zadatke imaju sve workflow role (CA, CO, Vještak, Pravna, Protokol) —
        // API ionako filtrira samo zadatke dodijeljene korisniku/njegovoj roli.
        var taskRoles = new[]
        {
            AppRoles.KolateralAdministrator, AppRoles.KolateralOficir,
            AppRoles.Vjestak, AppRoles.PravnaSluzba, AppRoles.Protokol, AppRoles.Administrator,
            AppRoles.Likvidatura, AppRoles.Racunovodstvo
        };
        if (!roles.Any(r => taskRoles.Contains(r, StringComparer.OrdinalIgnoreCase)))
        {
            _accessDenied = true;
            return;
        }

        await LoadTasks();
    }

    // CO ide na "/narudzbe/{id}/procjena" (kućice za njegove akcije); svi ostali
    // (CA, vještak, pravna) idu na regularne detalje narudžbe sa tabom Dokumenti.
    private string OrderLink(int orderId) =>
        _isCo ? $"/narudzbe/{orderId}/procjena" : $"/narudzbe/{orderId}";

    private async Task LoadTasks()
    {
        _loading   = true;
        _loadError = null;
        StateHasChanged();

        var result = await OrderService.GetMyTasksAsync(_page, 10);
        _loading   = false;

        if (result.IsSuccess && result.Data is not null)
        {
            _tasks      = result.Data.Items.ToList();
            _totalPages = result.Data.TotalPages;
        }
        else
        {
            _loadError = result.ErrorMessage ?? "Greška pri učitavanju taskova.";
        }
    }

    private async Task AcceptTask(WorkflowTaskDto task)
    {
        _accepting = task.Id;
        StateHasChanged();

        var result = await OrderService.AcceptTaskAsync(task.Id);
        _accepting = null;

        if (result.IsSuccess)
        {
            // Nakon prihvata vodimo korisnika direktno na narudžbu gdje se obavlja
            // stvarna radnja (CA: pregled dokumentacije; CO: provjera pristupa / odobrenje).
            // Time se izbjegava dojam "ništa se ne dešava" kad prihvat spawn-a novi task
            // ili kad je sljedeća akcija na kartici narudžbe.
            Snackbar.Add("Task je prihvaćen. Nastavite radnju na narudžbi.", Severity.Success);
            Nav.NavigateTo(OrderLink(task.OrderId));
        }
        else
        {
            Snackbar.Add(result.ErrorMessage ?? "Greška pri prihvatanju taska.", Severity.Error);
        }
    }

    private async Task ChangePage(int p)
    {
        _page = p;
        await LoadTasks();
    }
}
