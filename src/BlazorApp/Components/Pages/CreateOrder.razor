    private static readonly (string Key, string ElementId, Func<CreateOrder, bool> IsValid)[] _requiredFields =
    [
        ("clientName",      "field-clientName",      p => p.IsValidClientName(p._clientName)),
        ("clientType",      "field-clientType",      p => !string.IsNullOrWhiteSpace(p._clientType)),
        ("jmbg",            "field-jmbg",            p => ValidateIdentifier(p._clientIdentifier, p._clientType)),
        ("city",            "field-city",            p => p._selectedCity is not null),
        ("branch",          "field-branch",          p => p._selectedBranch is not null),
        ("branchAddress",   "field-branchAddress",   p => !string.IsNullOrWhiteSpace(p._branchAddress)),
        ("appraisalType",   "field-appraisalType",   p => !string.IsNullOrWhiteSpace(p._selectedCategory)),
        ("collateralType",  "field-collateralType",  p => p._selectedCollateral is not null),
        ("propertyCity",    "field-propertyCity",    p => !string.IsNullOrWhiteSpace(p._propertyCity)),
        ("propertyAddress", "field-propertyAddress", p => !string.IsNullOrWhiteSpace(p._propertyAddressInput)),
        ("contactName",     "field-contactName",     p => IsValidPersonName(p._contactName, 2, 200)),
        ("deliveryContactName", "field-deliveryContactName", p => IsValidPersonName(p._deliveryContactName, 2, 300)),
        ("amRecipientName", "field-amRecipientName", p => IsValidPersonName(p._amRecipientName, 2, 300)),
        ("phone",             "field-phone",             p => ValidatePhone(p._contactPhone)),
        ("email",             "field-email",             p => string.IsNullOrWhiteSpace(p._contactEmail) || ValidateEmail(p._contactEmail)),
    ];

    private async Task ShowMissingFields()
    {
        foreach (var f in _requiredFields)
            _touched.Add(f.Key);

        if (!_mandatoryDocsOk)
            Snackbar.Add("Svi obavezni dokumenti (ZK, Uplatnica/Saglasnost) moraju biti priloženi prije slanja narudžbe.", Severity.Warning);

        var firstInvalid = _requiredFields.FirstOrDefault(f => !f.IsValid(this));
        if (firstInvalid.ElementId is not null)
            await JS.InvokeVoidAsync("orderForm.scrollToField", firstInvalid.ElementId);

        StateHasChanged();
    }

