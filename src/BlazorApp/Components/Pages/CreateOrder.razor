    // ── Lifecycle ─────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        var user = auth.User;
        if (!user.Identity?.IsAuthenticated ?? true) { Nav.NavigateTo("/login", replace: true); return; }

        var roles = user.FindAll("roles").Select(c => c.Value).ToList();
        var ok = roles.Any(r =>
            AppRoles.SalesRoles.Contains(r, StringComparer.OrdinalIgnoreCase) ||
            r.Equals(AppRoles.Administrator, StringComparison.OrdinalIgnoreCase));
        if (!ok) { _accessDenied = true; _initializing = false; return; }

        // Tip workflow-a (FL/PL) mora biti odabran na ulaznom ekranu. Bez validnog tipa
        // vraćamo korisnika na izbor (Slika 7.1) — tip određuje cijeli tok narudžbe.
        _workflowCode = Tip?.Trim().ToUpperInvariant() switch
        {
            "FL" or "FIZICKA" or "FIZICKALICA" => "FL",
            "PL" or "PRAVNA"  or "PRAVNALICA"  => "PL",
            _ => null
        };
        if (_workflowCode is null) { Nav.NavigateTo("/narudzbe/nova", replace: true); return; }
        _clientType = _workflowCode;

        await Task.WhenAll(
            Load(() => OrderService.GetCollateralTypesAsync(),          v => _collateralTypes         = v ?? []),
            Load(() => OrderService.GetCombinedCollateralTypesAsync(),   v => _combinedCollateralTypes  = v ?? []),
            Load(() => OrderService.GetClientTypesAsync(),               v => _clientTypes              = v ?? []),
            Load(() => BranchApiService.GetCitiesAsync(),                v => _cities                   = v ?? []),
            Load(() => BranchApiService.GetBranchesAsync(),              v => _branches                 = v ?? []));

        var me = await MeService.GetMeAsync();
        if (me.IsSuccess) _me = me.Data;

        // Datum prijema zahtjeva od klijenta — automatski iz sistema
        _requestReceivedAt = DateTime.UtcNow;

        if (CloneFromId.HasValue)
            await LoadCloneSourceAsync(CloneFromId.Value);
        else
            await LoadExistingDraftAsync();

        _initializing = false;
    }

    private async Task LoadCloneSourceAsync(int sourceId)
    {
        try
        {
            var result = await OrderService.GetByIdAsync(sourceId);
            if (!result.IsSuccess || result.Data is null) return;
            var src = result.Data;

            _clientName = src.ClientName;
            _contactName = src.ContactName;
            _contactPhone = src.ContactPhone;
            _contactEmail = src.ContactEmail;
            _deliveryContactName = src.DeliveryContactName;
            _amRecipientName = src.AmRecipientName;
            _propertyAddressInput = src.PropertyAddress;
            _propertyCity = src.PropertyCity;
            _internalNote = "";

            _selectedCity = _cities.FirstOrDefault(c => c.Name == src.City);
            if (_selectedCity is not null)
                _selectedBranch = _branches.FirstOrDefault(b => b.Code == src.Branch);
            _branchAddress = _selectedBranch?.Address;

            if (src.CollateralTypeId.HasValue)
                _selectedCollateral = _collateralTypes.FirstOrDefault(c => c.Id == src.CollateralTypeId);
            if (src.CombinedCollateralTypeId is > 0)
                _selectedCombined = _combinedCollateralTypes.FirstOrDefault(c => c.Id == src.CombinedCollateralTypeId);

            _dirty = true;
            Snackbar.Add($"Podaci klonirani iz narudžbe {src.OrderNumber}. Pregledajte i prilagodite prije slanja.", Severity.Info);
        }
        catch { /* graceful — clone is optional */ }
    }

    private async Task LoadExistingDraftAsync()
    {
        try
        {
            var list = await OrderService.GetListAsync(1, 10, status: "Draft");
            if (!list.IsSuccess || list.Data is null || list.Data.Items.Count == 0) return;

            // Ponudi za nastavak samo nacrt istog tipa narudžbe (FL/PL) kao odabrani.
            var expected = _workflowCode == "PL" ? "PravnaLica" : "FizickaLica";
            var match = list.Data.Items.FirstOrDefault(i => i.WorkflowType == expected)
                        ?? list.Data.Items.FirstOrDefault(i => i.WorkflowType is null);
            if (match is null) return;

            var full = await OrderService.GetByIdAsync(match.Id);
            if (full.IsSuccess && full.Data is not null && full.Data.Capabilities.CanEdit)
                _existingDraft = full.Data;
        }
        catch { /* graceful degradation — autosave i dalje radi bez resume bannera */ }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _autosaveTimer = new System.Threading.Timer(async _ => await InvokeAsync(AutosaveTick), null, 3000, 3000);
        }

        if (!_inputRestrictionsApplied && !_initializing && !_accessDenied)
        {
            _inputRestrictionsApplied = true;
            try
            {
                await JS.InvokeVoidAsync("orderForm.restrictToPattern", "field-jmbg", "[0-9]");
                await JS.InvokeVoidAsync("orderForm.restrictToPattern", "field-phone", "[0-9+\\-() ]");
            }
            catch { /* JS interop nije spreman još */ }
        }

        await JS.InvokeVoidAsync("eval", @"
            if (!window.__orderLeaveGuard) {
                window.__orderLeaveGuard = true;
                window.addEventListener('beforeunload', function(e) {
                    if (document.querySelector('.of-page')) {
                        e.preventDefault();
                        e.returnValue = '';
                    }
                });
            }
        ");
    }

    private static async Task Load<T>(Func<Task<Result<List<T>>>> fetch, Action<List<T>?> set)
    {
        try { var r = await fetch(); if (r.IsSuccess) set(r.Data); }
        catch { /* graceful degradation */ }
    }

    public void Dispose()
    {
        _autosaveTimer?.Dispose();
    }

    // ── Autosave nacrta ─────────────────────────────────────────────────

    private async Task EnsureDraftAsync()
    {
        if (_draftOrderId is not null) return;

        var r = await OrderService.CreateDraftAsync(_workflowCode);
        if (r.IsSuccess && r.Data is not null)
        {
            _draftOrderId     = r.Data.Id;
            _draftOrderNumber = r.Data.OrderNumber;
        }
    }

    private async Task AutosaveTick()
    {
        if (!_dirty)
        {
            StateHasChanged();
            return;
        }

        // Korisnik je počeo popunjavati novu narudžbu. Ako još stoji ponuda za nastavak
        // ranijeg nacrta (npr. napušteni PL pokušaj), smatramo da želi NOVI nacrt i
        // sklanjamo banner — inače bi autosave ostao blokiran, draft se nikad ne bi
        // kreirao i sekcija za upload dokumentacije se ne bi otvorila.
        if (_existingDraft is not null && !_draftBannerDismissed)
            _draftBannerDismissed = true;

        await EnsureDraftAsync();
        if (_draftOrderId is null) { StateHasChanged(); return; }

        var r = await OrderService.UpdateDraftAsync(
            _draftOrderId.Value, BuildUpdateRequest(sanitized: true), autosave: true);
        if (r.IsSuccess)
        {
            _lastAutosaveAt = DateTime.UtcNow;
            _dirty = false;
        }

        StateHasChanged();
    }

    private UpdateOrderRequest BuildUpdateRequest(bool sanitized)
    {
        var clientName          = _clientName;
        var clientType          = _clientType;
        var clientIdentifier    = _clientIdentifier;
        var contactName         = _contactName;
        var contactPhone        = _contactPhone;
        var propertyAddress     = _propertyAddressInput;
        var deliveryContactName = _deliveryContactName;
        var amRecipientName     = _amRecipientName;

        if (sanitized)
        {
            if (string.IsNullOrWhiteSpace(clientType))
                clientType = null;

            if (string.IsNullOrWhiteSpace(clientName) || clientName.Length is < 2 or > 300 ||
                (_clientType == "FL"
                    ? !Regex.IsMatch(clientName, @"^[\p{L}\s\-]+$")
                    : ContainsDangerousChars(clientName)))
                clientName = null;

            if (!ValidateIdentifier(clientIdentifier, _clientType))
                clientIdentifier = null;

            if (string.IsNullOrWhiteSpace(contactName) || contactName.Length is < 2 or > 200 ||
                !Regex.IsMatch(contactName, @"^[\p{L}\s\-]+$"))
                contactName = null;

            if (!ValidatePhone(contactPhone))
                contactPhone = null;

            if (string.IsNullOrWhiteSpace(propertyAddress) || propertyAddress.Length > 500)
                propertyAddress = null;

            if (string.IsNullOrWhiteSpace(deliveryContactName) || deliveryContactName.Length is < 2 or > 300 ||
                !Regex.IsMatch(deliveryContactName, @"^[\p{L}\s\-]+$"))
                deliveryContactName = null;

            if (string.IsNullOrWhiteSpace(amRecipientName) || amRecipientName.Length is < 2 or > 300 ||
                !Regex.IsMatch(amRecipientName, @"^[\p{L}\s\-]+$"))
                amRecipientName = null;
        }

        var contactEmail = string.IsNullOrWhiteSpace(_contactEmail)
            ? ""
            : (!sanitized || ValidateEmail(_contactEmail)) ? _contactEmail.Trim() : null;

        var city   = _selectedBranch is not null ? _selectedCity?.Name : null;
        var branch = _selectedBranch?.Code;

        return new UpdateOrderRequest(
            ClientName:               clientName,
            ClientType:               clientType,
            ClientIdentifier:         clientIdentifier,
            CollateralTypeId:         _selectedCollateral?.Id,
            CombinedCollateralTypeId: _selectedCombined?.Id ?? 0,
            City:                     city,
            PropertyAddress:          propertyAddress,
            PropertyCity:             _propertyCity,
            Branch:                   branch,
            BranchAddress:            _branchAddress,
            ContactName:              contactName,
            ContactPhone:             contactPhone,
            ContactEmail:             contactEmail,
            InternalNote:             _internalNote ?? "",
            DeliveryContactName:      deliveryContactName,
            AmRecipientName:          amRecipientName,
            RequestReceivedAt:        _requestReceivedAt,
            RequestSentAt:            _requestSentAt,
            SquareMetersCommercial:   ShowSquareMetersFields ? _sqmCommercial : null,
            SquareMetersResidential:  ShowSquareMetersFields ? _sqmResidential : null);
    }

    private void LoadDraftIntoForm(AppraisalOrderDto dto)
    {
        _draftOrderId     = dto.Id;
        _draftOrderNumber = dto.OrderNumber;
        _lastAutosaveAt   = dto.UpdatedAt;

        _clientName       = string.IsNullOrEmpty(dto.ClientName) ? null : dto.ClientName;
        _clientType       = dto.ClientType switch
        {
            "FL" or "FizickaLica" or "FIZICKA" => "FL",
            "PL" or "PravnaLica"  or "PRAVNA"  => "PL",
            _ => _workflowCode ?? "FL"
        };
        _clientIdentifier = dto.ClientIdentifier;

        _selectedCity   = _cities.FirstOrDefault(c => c.Name == dto.City);
        _selectedBranch = _branches.FirstOrDefault(b => b.Code == dto.Branch);
        _branchAddress  = dto.BranchAddress;

        _selectedCollateral = dto.CollateralTypeId.HasValue
            ? _collateralTypes.FirstOrDefault(c => c.Id == dto.CollateralTypeId.Value)
            : null;
        _selectedCombined = dto.CombinedCollateralTypeId.HasValue
            ? _combinedCollateralTypes.FirstOrDefault(c => c.Id == dto.CombinedCollateralTypeId.Value)
            : null;

        _selectedCategory = _selectedCollateral?.Description is { } desc
            ? _collateralCategories.FirstOrDefault(cat => desc.StartsWith(cat.DescriptionFilter))?.Key
            : null;

        _propertyAddressInput = dto.PropertyAddress;
        _propertyCity         = dto.PropertyCity;
        _contactName  = dto.ContactName;
        _contactPhone = dto.ContactPhone;
        _contactEmail = dto.ContactEmail;
        _internalNote = dto.InternalNote;
        _deliveryContactName = dto.DeliveryContactName;
        _amRecipientName     = dto.AmRecipientName;
        _requestReceivedAt   = dto.RequestReceivedAt;
        _requestSentAt       = dto.RequestSentAt;
        _sqmCommercial       = dto.SquareMetersCommercial;
        _sqmResidential      = dto.SquareMetersResidential;
    }

    private void ResumeDraft()
    {
        if (_existingDraft is null) return;
        LoadDraftIntoForm(_existingDraft);
        _draftBannerDismissed = true;
        _wizardStep = 0;
        StateHasChanged();
    }

    private void DismissDraftBanner()
    {
        _draftBannerDismissed = true;
        StateHasChanged();
    }

    // ── Field update handlers ─────────────────────────────────────────

    private void Touch(string field) { _touched.Add(field); _dirty = true; StateHasChanged(); }
    private void Recalculate()       => StateHasChanged();

    private async Task OnDocStatsChanged(List<(string Label, bool Delivered, bool IsMandatory)> items)
    {
        _docChecklistItems = items;
        _docDelivered      = items.Count(x => x.Delivered);
        _docTotal          = items.Count;
        _mandatoryDocsOk   = !items.Any(x => x.IsMandatory) || items.Where(x => x.IsMandatory).All(x => x.Delivered);
        await InvokeAsync(StateHasChanged);
    }

    private void UpdateClientName(string v)
    {
        var clean = _clientType == "FL"
            ? Regex.Replace(v, @"[^\p{L}\s\-]", "")
            : Regex.Replace(v, @"[<>&""']", "");
        _clientName = clean.Length > 300 ? clean[..300] : clean;
        _touched.Add("clientName");
        _dirty = true;
        StateHasChanged();
    }

    private void UpdateIdentifier(string v)
    {
        var digits = new string(v.Where(char.IsDigit).Take(13).ToArray());
        _clientIdentifier = digits;
        _touched.Add("jmbg");
        _dirty = true;
        StateHasChanged();
    }

    private void UpdateContactName(string v)
    {
        var clean = Regex.Replace(v, @"[^\p{L}\s\-]", "");
        _contactName = clean.Length > 200 ? clean[..200] : clean;
        _touched.Add("contactName");
        _dirty = true;
        StateHasChanged();
    }

