    private RenderFragment InlineError(
        string? val, string fieldKey, string emptyMsg,
        Func<string, bool>? formatCheck, string? formatMsg) => b =>
    {
        if (!_touched.Contains(fieldKey)) return;
        const string errIcon = "<svg style='width:14px;height:14px;flex-shrink:0;color:var(--rbi-coral-deep)' viewBox='0 0 24 24' fill='currentColor'><path d='M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z'/></svg>";
        if (string.IsNullOrWhiteSpace(val))
        {
            b.OpenElement(0, "div"); b.AddAttribute(1, "class", "of-val-msg");
            b.AddMarkupContent(2, errIcon);
            b.AddContent(3, emptyMsg); b.CloseElement();
        }
        else if (formatCheck is not null && !formatCheck(val) && formatMsg is not null)
        {
            b.OpenElement(0, "div"); b.AddAttribute(1, "class", "of-val-msg");
            b.AddMarkupContent(2, errIcon);
            b.AddContent(3, formatMsg); b.CloseElement();
        }
    };

