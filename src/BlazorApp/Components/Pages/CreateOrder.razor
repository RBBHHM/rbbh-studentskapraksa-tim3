                                       _selectedCollateral is not null &&
                                       !string.IsNullOrWhiteSpace(_propertyAddressInput) &&
                                       !string.IsNullOrWhiteSpace(_propertyCity);
    private bool SectionLocationOk => _selectedCity is not null && _selectedBranch is not null &&
                                       !string.IsNullOrWhiteSpace(_branchAddress);
    private bool SectionContactOk  => IsValidPersonName(_contactName, 2, 200) &&
                                       ValidatePhone(_contactPhone) &&
                                       IsValidPersonName(_deliveryContactName, 2, 300) &&
                                       IsValidPersonName(_amRecipientName, 2, 300);
    private bool IsFormValid => SectionClientOk && SectionPropertyOk &&
                                SectionLocationOk && SectionContactOk &&
                                (string.IsNullOrWhiteSpace(_contactEmail) || ValidateEmail(_contactEmail)) &&
                                (_internalNote?.Length ?? 0) <= 500 &&
                                _mandatoryDocsOk;

    private string AutosaveAgoLabel
    {
        get
        {
            if (_lastAutosaveAt is null) return "";
            var sec = Math.Max(0, (int)(DateTime.UtcNow - _lastAutosaveAt.Value).TotalSeconds);
            return sec < 60 ? $"{sec} s" : $"{sec / 60} min";
        }
    }

    private int ProgressPct
    {
        get
        {
            int n = 0;
            if (IsValidClientName(_clientName))            n++;
            if (!string.IsNullOrWhiteSpace(_clientType))   n++;
            if (ValidateIdentifier(_clientIdentifier, _clientType)) n++;
            if (!string.IsNullOrWhiteSpace(_selectedCategory) && _selectedCollateral is not null) n++;
            if (!string.IsNullOrWhiteSpace(_propertyCity))        n++;
            if (!string.IsNullOrWhiteSpace(_propertyAddressInput)) n++;
            if (_selectedCity       is not null)            n++;
            if (_selectedBranch     is not null)            n++;
            if (!string.IsNullOrWhiteSpace(_branchAddress)) n++;
            if (IsValidPersonName(_contactName, 2, 200))    n++;
            if (ValidatePhone(_contactPhone))               n++;
            if (IsValidPersonName(_deliveryContactName, 2, 300)) n++;
            if (IsValidPersonName(_amRecipientName, 2, 300))     n++;
            if (string.IsNullOrWhiteSpace(_contactEmail) || ValidateEmail(_contactEmail)) n++;
            return (int)Math.Round(n / 14.0 * 100);
        }
    }

