@page "/narudzbe/nova/{Tip}"
@rendermode InteractiveServer
@attribute [Authorize]
@implements IDisposable
@using System.Text.RegularExpressions
@using BlazorApp.Validation
@inject OrderService     OrderService
@inject BranchApiService BranchApiService
@inject ISnackbar        Snackbar
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState
@inject MeService MeService
@inject ActiveRoleState RoleState
@inject IJSRuntime JS
@inject BranchApiService BranchApiSvc

<PageTitle>Nova narudžba — Procjena nekretnine</PageTitle>

@* ── 403 guard ─────────────────────────────────────────────────────── *@
@if (_accessDenied)
{
    <div style="display:flex;flex-direction:column;align-items:center;justify-content:center;
                min-height:60vh;gap:16px;text-align:center;">
        <MudIcon Icon="@Icons.Material.Outlined.Lock"
                 Style="font-size:56px;color:var(--rbi-coral-deep);opacity:.7;" />
        <div style="font-size:20px;font-weight:700;">Pristup odbijen</div>
        <div style="font-size:14px;color:var(--text-secondary);max-width:360px;">
            Samo korisnici s prodajnom rolom (AM, SM, UB) mogu inicirati narudžbe.
        </div>
        <MudButton Variant="Variant.Outlined" OnClick='@(()=>Nav.NavigateTo("/"))'>
            Povratak na početnu
        </MudButton>
    </div>
    return;
}

@if (_initializing)
{
    <div class="loading-state">
        <MudProgressCircular Indeterminate="true" Color="Color.Warning" Size="Size.Medium" />
    </div>
    return;
}

<div class="of-page">

    @* ── Breadcrumb ────────────────────────────────────────────────────────── *@
    <AppBreadcrumb Items="@(new List<AppBreadcrumb.BreadcrumbItem> { new("Početna", "/"), new("Narudžbe", "/narudzbe"), new("Nova narudžba", "/narudzbe/nova"), new($"Iniciranje ({Tip})", "") })" />

    @* ── Page header ──────────────────────────────────────────────────────── *@
    <div style="margin-bottom:20px;">
        <div style="font-size:20px;font-weight:800;color:var(--rbi-off-black);">
            Iniciranje narudžbe procjene
        </div>
    </div>

    @if (_existingDraft is not null && !_draftBannerDismissed)
    {
        <div class="of-resume-banner">
            <MudIcon Icon="@Icons.Material.Outlined.History" Style="font-size:20px;flex-shrink:0;" />
            <div class="of-resume-banner-text">
                Imate nesačuvani nacrt narudžbe <strong>@_existingDraft.OrderNumber</strong>
                od @_existingDraft.CreatedAt.ToString("dd.MM.yyyy HH:mm").
            </div>
            <MudButton Variant="Variant.Filled" Size="Size.Small" Color="Color.Warning"
                       OnClick="ResumeDraft">
                Nastavi nacrt
            </MudButton>
            <MudButton Variant="Variant.Outlined" Size="Size.Small"
                       OnClick="DismissDraftBanner">
                Počni novu narudžbu
            </MudButton>
        </div>
    }

    @* ── WIZARD STEPPER — ekstrahovano u CreateOrderWizardStepper.razor (B-1) *@
    <CreateOrderWizardStepper
        Steps="_wizardSteps"
        CurrentStep="_wizardStep"
        OnStepClick="GoToStep" />

    <div class="of-workspace">

        <div class="of-form-area">

            @* ═══ KORAK 1: KLIJENT + KONTAKT ═══════════════════════════════ *@
            @if (_wizardStep == 0)
            {

            @* ═══ SEKCIJA 1: KLIJENT ═══════════════════════════════════════ *@
            <div class="of-card of-card-accent-yellow">
                <div class="of-card-header">
                    <div class="of-card-icon of-card-icon-yellow">
                        <MudIcon Icon="@Icons.Material.Outlined.Person" Style="font-size:18px;color:var(--rbi-off-black);" />
                    </div>
                    <div>
                        <div class="of-card-title">Podaci o klijentu</div>
                        <div class="of-card-subtitle">Ime, tip i identifikacioni broj naručioca</div>
                    </div>
                </div>
                <div class="of-card-body">

                    @* Inicirao (Ime AM/SM/UB) — read-only, automatski povučeno *@
                    <div class="of-field">
                        <div class="of-field-label-row">
                            <MudIcon Icon="@Icons.Material.Outlined.Badge"
                                     Style="font-size:16px;color:var(--rbi-off-black);" Class="of-field-icon" />
                            <label class="of-label of-label-req">Naziv odgovorne osobe u prodaji</label>
                        </div>
                        <MudTextField T="string"
                                      Value="@InitiatorLabel"
                                      ReadOnly="true" Disabled="true"
                                      Variant="Variant.Outlined" Margin="Margin.Dense"
                                      Style="width:100%;" />
                    </div>

                    @* Ime i prezime *@
                    <div class="of-field" id="field-clientName">
                        <div class="of-field-label-row">
                            <MudIcon Icon="@Icons.Material.Outlined.PersonOutline"
                                     Style="font-size:16px;color:var(--rbi-off-black);" Class="of-field-icon" />
                            <label class="of-label of-label-req">Naziv klijenta</label>
                        </div>
                        <MudTextField T="string"
                                      Value="@_clientName"
                                      ValueChanged="@((string v) => UpdateClientName(v))"
                                      Placeholder="npr. Petar Petrović ili ABC d.o.o."
                                      Variant="Variant.Outlined" Margin="Margin.Dense"
                                      Immediate="true"
                                      Class="@FieldCss(_clientName, "clientName")"
                                      Style="width:100%;" />
                        <div style="display:flex;justify-content:space-between;align-items:center;">
                            @InlineError(_clientName, "clientName",
                                "Ime / naziv je obavezan.",
                                v => v.Length >= 2 && v.Length <= 300 &&
                                     (_clientType == "FL" ? Regex.IsMatch(v, @"^[\p{L}\s\-]+$") : !ContainsDangerousChars(v)),
                                _clientType == "FL"
                                    ? "Ime smije sadržavati samo slova, razmake i crtice (2–300 znakova)."
                                    : "Unos mora biti od 2 do 300 znakova i ne smije sadržavati znakove < > & \" '.")
                            <div class="of-char-count @((_clientName?.Length ?? 0) > 280 ? "warn" : "")">
                                @(_clientName?.Length ?? 0)/300
                            </div>
                        </div>
                    </div>

                    @* Tip klijenta — zaključan prema odabiru workflow-a na ulaznom ekranu (FL/PL) *@
                    <div class="of-field" id="field-clientType">
                        <div class="of-field-label-row">
                            <MudIcon Icon="@Icons.Material.Outlined.Badge"
                                     Style="font-size:16px;color:var(--rbi-off-black);" Class="of-field-icon" />
                            <label class="of-label of-label-req">Tip klijenta</label>
                        </div>
                        <div class="of-branch-info" style="margin-top:0;display:flex;align-items:center;gap:10px;">
                            <MudIcon Icon="@(_clientType == "PL" ? Icons.Material.Outlined.Business : Icons.Material.Outlined.Person)"
                                     Style="font-size:18px;color:var(--rbi-off-black);" />
                            <div style="font-weight:700;color:var(--rbi-off-black);font-size:13.5px;">
                                @(_clientType == "PL" ? "Pravno lice (PL)" : "Fizičko lice (FL)")
                            </div>
                            <MudIcon Icon="@Icons.Material.Outlined.Lock"
                                     Style="font-size:14px;color:var(--text-muted);margin-left:auto;"
                                     title="Određeno odabirom tipa narudžbe" />
                        </div>
                    </div>

                    @* JMBG — obavezno za FL i PL *@
                    <div class="of-field" id="field-jmbg" style="margin-bottom:0;">
                        <div class="of-field-label-row">
                            <MudIcon Icon="@Icons.Material.Outlined.CreditCard"
                                     Style="font-size:16px;color:var(--rbi-off-black);" Class="of-field-icon" />
                            <label class="@("of-label" + (_clientType is null ? "" : " of-label-req"))">
                                @JmbgLabel
                            </label>
                        </div>
                        <div style="font-size:11px;color:var(--text-muted);margin:-2px 0 6px;">
                            @JmbgHelperText
                        </div>
                        <MudTextField T="string"
                                      Value="@_clientIdentifier"
                                      ValueChanged="@((string v) => UpdateIdentifier(v))"
                                      Placeholder="@JmbgPlaceholder"
                                      Variant="Variant.Outlined" Margin="Margin.Dense"
                                      Immediate="true"
                                      InputMode="InputMode.numeric"
                                      MaxLength="13"
                                      OnBlur="@(_ => Touch("jmbg"))"
                                      Class="@(_touched.Contains("jmbg") && !ValidateIdentifier(_clientIdentifier, _clientType) ? "of-input-error" : "")"
                                      Style="width:100%;" />
                        @if (_touched.Contains("jmbg"))
                        {
                            var _jmbgError = JmbgValidator.GetError(_clientIdentifier);
                            @if (_jmbgError is null)
                            {
                                <div class="of-val-ok">
                                    <MudIcon Icon="@Icons.Material.Outlined.CheckCircle" Style="font-size:14px;" />
                                    Ispravan JMBG.
                                </div>
                            }
                            else
                            {
                                <div class="of-val-msg">
                                    <MudIcon Icon="@Icons.Material.Outlined.Error" Style="font-size:14px;" />
                                    @_jmbgError
                                </div>
                            }
                        }
                        @if (!string.IsNullOrWhiteSpace(_clientIdentifier))
                        {
                            <div class="of-char-count">
                                @(_clientIdentifier.Length) / 13 cifara
                            </div>
                        }
                    </div>

                </div>
            </div>

            @* ═══ SEKCIJA 2: KONTAKT ═════════════════════════════════════════ *@
            <div class="of-card of-card-accent-yellow">
                <div class="of-card-header">
                    <div class="of-card-icon of-card-icon-yellow">
                        <MudIcon Icon="@Icons.Material.Outlined.ContactPhone" Style="font-size:18px;color:var(--rbi-off-black);" />
                    </div>
                    <div>
                        <div class="of-card-title">Kontakt osoba</div>
                        <div class="of-card-subtitle">Kontakt za koordinaciju i eventualne dopune dokumentacije</div>
                    </div>
                </div>
                <div class="of-card-body">

                    @* Kontakt ime *@
                    <div class="of-field" id="field-contactName">
                        <div class="of-field-label-row">
                            <MudIcon Icon="@Icons.Material.Outlined.PersonOutline"
                                     Style="font-size:16px;color:#7A5C00;" Class="of-field-icon" />
                            <label class="of-label of-label-req">Ime i prezime</label>
                        </div>
                        <MudTextField T="string"
                                      Value="@_contactName"
                                      ValueChanged="@((string v) => UpdateContactName(v))"
                                      Placeholder="Kontakt osoba"
                                      Variant="Variant.Outlined" Margin="Margin.Dense"
                                      Immediate="true"
                                      Class="@FieldCss(_contactName, "contactName")"
                                      Style="width:100%;" />
                        @InlineError(_contactName, "contactName",
                            "Kontakt ime je obavezno.",
                            v => v.Length >= 2 && v.Length <= 200 && Regex.IsMatch(v, @"^[\p{L}\s\-]+$"),
                            "Kontakt ime smije sadržavati samo slova, razmake i crtice (2–200 znakova).")
                    </div>

                    @* Osoba u poslovnici za dostavu originala procjene *@
                    <div class="of-field" id="field-deliveryContactName">
                        <div class="of-field-label-row">
                            <MudIcon Icon="@Icons.Material.Outlined.MarkEmailRead"
                                     Style="font-size:16px;color:#7A5C00;" Class="of-field-icon" />
                            <label class="of-label of-label-req">Osoba u poslovnici za dostavu originala procjene</label>
                            <MudTooltip Text="Ime osobe u vašoj poslovnici koja će fizički preuzeti original procjene od vještaka." Placement="Placement.Top" Arrow="true">
                                <MudIcon Icon="@Icons.Material.Outlined.Info" Style="font-size:14px;color:var(--text-faint);cursor:help;" />
                            </MudTooltip>
                        </div>
                        <div style="font-size:11px;color:var(--text-muted);margin-bottom:4px;">Osoba koja preuzima fizički original procjene u vašoj poslovnici.</div>
                        <MudTextField T="string"
                                      Value="@_deliveryContactName"
                                      ValueChanged="@((string v) => UpdateDeliveryContactName(v))"
                                      Placeholder="Ime i prezime"
                                      Variant="Variant.Outlined" Margin="Margin.Dense"
                                      Immediate="true"
                                      Class="@FieldCss(_deliveryContactName, "deliveryContactName")"
                                      Style="width:100%;" />
                        @InlineError(_deliveryContactName, "deliveryContactName",
                            "Osoba za dostavu je obavezna.",
                            v => v.Length >= 2 && v.Length <= 300 && Regex.IsMatch(v, @"^[\p{L}\s\-]+$"),
                            "Ime i prezime smije sadržavati samo slova, razmake i crtice (2–300 znakova).")
                    </div>

                    @* Ime AM na kojeg se šalje procjena mailom *@
                    <div class="of-field" id="field-amRecipientName">
                        <div class="of-field-label-row">
                            <MudIcon Icon="@Icons.Material.Outlined.Forward"
                                     Style="font-size:16px;color:#7A5C00;" Class="of-field-icon" />
                            <label class="of-label of-label-req">Ime AM-a na kojeg se šalje procjena mailom</label>
                            <MudTooltip Text="Account Manager koji treba primiti gotovu procjenu putem e-maila." Placement="Placement.Top" Arrow="true">
                                <MudIcon Icon="@Icons.Material.Outlined.Info" Style="font-size:14px;color:var(--text-faint);cursor:help;" />
                            </MudTooltip>
                        </div>
                        <div style="font-size:11px;color:var(--text-muted);margin-bottom:4px;">Account Manager koji treba primiti gotovu procjenu e-mailom.</div>
                        <MudTextField T="string"
                                      Value="@_amRecipientName"
                                      ValueChanged="@((string v) => UpdateAmRecipientName(v))"
                                      Placeholder="Ime i prezime"
                                      Variant="Variant.Outlined" Margin="Margin.Dense"
                                      Immediate="true"
                                      Class="@FieldCss(_amRecipientName, "amRecipientName")"
                                      Style="width:100%;" />
                        @InlineError(_amRecipientName, "amRecipientName",
                            "Ime AM-a je obavezno.",
                            v => v.Length >= 2 && v.Length <= 300 && Regex.IsMatch(v, @"^[\p{L}\s\-]+$"),
                            "Ime i prezime smije sadržavati samo slova, razmake i crtice (2–300 znakova).")
                    </div>

                    @* Telefon — strict format *@
                    <div class="of-field" id="field-phone">
                        <div class="of-field-label-row">
                            <MudIcon Icon="@Icons.Material.Outlined.Phone"
                                     Style="font-size:16px;color:#7A5C00;" Class="of-field-icon" />
                            <label class="of-label of-label-req">Telefon</label>
                        </div>
                        <MudTextField T="string"
                                      Value="@_contactPhone"
                                      ValueChanged="@((string v) => UpdatePhone(v))"
                                      Placeholder="npr. 061123456 ili +38761123456"
                                      Variant="Variant.Outlined" Margin="Margin.Dense"
                                      Immediate="true"
                                      InputType="InputType.Telephone"
                                      Style="width:100%;" />
                        @if (_touched.Contains("phone"))
                        {
                            @if (string.IsNullOrWhiteSpace(_contactPhone))
                            { <div class="of-val-msg"><MudIcon Icon="@Icons.Material.Outlined.Error" Style="font-size:14px;" /> Telefon je obavezan.</div> }
                            else if (ValidatePhone(_contactPhone))
                            { <div class="of-val-ok"><MudIcon Icon="@Icons.Material.Outlined.CheckCircle" Style="font-size:14px;" /> Ispravan format.</div> }
                            else
                            { <div class="of-val-msg"><MudIcon Icon="@Icons.Material.Outlined.Error" Style="font-size:14px;" /> Neispravan format telefonskog broja.</div> }
                        }
                    </div>

                    @* Email *@
                    <div class="of-field" id="field-email">
                        <div class="of-field-label-row">
                            <MudIcon Icon="@Icons.Material.Outlined.Email"
                                     Style="font-size:16px;color:#7A5C00;" Class="of-field-icon" />
                            <label class="of-label">
                                Email
                                <span style="font-size:11px;font-weight:400;color:var(--text-muted);">(opcionalno)</span>
                            </label>
                        </div>
                        <MudTextField @bind-Value="_contactEmail"
                                      Placeholder="kontakt@email.ba"
                                      Variant="Variant.Outlined" Margin="Margin.Dense"
                                      Immediate="true"
                                      InputType="InputType.Email"
                                      OnBlur="@(_ => Touch("email"))"
                                      Style="width:100%;" />
                        @if (_touched.Contains("email") && !string.IsNullOrWhiteSpace(_contactEmail))
                        {
                            @if (ValidateEmail(_contactEmail))
                            { <div class="of-val-ok"><MudIcon Icon="@Icons.Material.Outlined.CheckCircle" Style="font-size:14px;" /> Ispravan email.</div> }
                            else
                            { <div class="of-val-msg"><MudIcon Icon="@Icons.Material.Outlined.Error" Style="font-size:14px;" /> Neispravan format email adrese.</div> }
                        }
                    </div>

                    @* Interna napomena *@
                    <div class="of-field" style="margin-bottom:0;">
                        <div class="of-field-label-row">
                            <MudIcon Icon="@Icons.Material.Outlined.Notes"
                                     Style="font-size:16px;color:#7A5C00;" Class="of-field-icon" />
                            <label class="of-label">
                                Interna napomena
                                <span style="font-size:11px;font-weight:400;color:var(--text-muted);">(opcionalno, maks 500 znakova)</span>
                            </label>
                        </div>
                        <MudTextField T="string"
                                      Value="@_internalNote"
                                      ValueChanged="@((string v) => UpdateInternalNote(v))"
                                      Placeholder="Dodatne informacije za CA..."
                                      Variant="Variant.Outlined" Margin="Margin.Dense"
                                      Immediate="true"
                                      Lines="3"
                                      Style="width:100%;" />
                        @if ((_internalNote?.Length ?? 0) > 450)
                        {
                            <div class="of-char-count warn">
                                @(_internalNote?.Length ?? 0)/500
                                @if ((_internalNote?.Length ?? 0) >= 500)
                                { <span> — Maksimalna dužina dostignuta</span> }
                            </div>
                        }
                    </div>

                </div>
            </div>

            @* ── Wizard navigacija Korak 1 ── *@
            <div class="of-wizard-nav" style="grid-column:1/-1;">
                <div></div>
                <MudButton Variant="Variant.Filled" Color="Color.Warning"
                           EndIcon="@Icons.Material.Outlined.ArrowForward"
                           OnClick="() => GoToStep(1)"
                           Disabled="@(!SectionClientOk || !SectionContactOk)">
                    Naprijed
                </MudButton>
            </div>
            } @* kraj korak 1 *@

            @* ═══ KORAK 2: NEKRETNINA + LOKACIJA ══════════════════════════ *@
            @if (_wizardStep == 1)
            {

            @* ═══ SEKCIJA 3: NEKRETNINA ══════════════════════════════════════ *@
            <div class="of-card of-card-accent-yellow">
                <div class="of-card-header">
                    <div class="of-card-icon of-card-icon-yellow">
                        <MudIcon Icon="@Icons.Material.Outlined.Home" Style="font-size:18px;color:var(--rbi-off-black);" />
                    </div>
                    <div>
                        <div class="of-card-title">Podaci o nekretnini</div>
                        <div class="of-card-subtitle">Odaberite tip procjene i unesite adresu nekretnine.</div>
                    </div>
                </div>
                <div class="of-card-body">

                    @* Kategorija kolaterala — selectable cards (nivo 1) *@
                    <div class="of-field" id="field-appraisalType">
                        <div class="of-field-label-row">
                            <MudIcon Icon="@Icons.Material.Outlined.Category"
                                     Style="font-size:16px;color:#7A5C00;" Class="of-field-icon" />
                            <label class="of-label of-label-req">Kategorija kolaterala</label>
                            <MudTooltip Text="Odaberite vrstu nekretnine: stambena, poslovna, zemljište, pokretna imovina, zalihe ili vozila." Placement="Placement.Top" Arrow="true">
                                <MudIcon Icon="@Icons.Material.Outlined.Info" Style="font-size:14px;color:var(--text-faint);cursor:help;" />
                            </MudTooltip>
                        </div>
                        <div class="of-cards-grid" style="grid-template-columns:repeat(3,1fr);">
                            @foreach (var cat in _collateralCategories)
                            {
                                <div class="of-option-card @(_selectedCategory == cat.Key ? "of-option-card-active" : "")"
                                     data-testid="category-@(cat.Key.ToLower().Replace("_","-"))"
                                     @onclick='@(() => OnCategoryChanged(cat.Key))'>
                                    @if (_selectedCategory == cat.Key)
                                    { <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Class="of-option-card-check" /> }
                                    <div class="of-option-card-icon"><MudIcon Icon="@cat.Icon" Style="font-size:20px;" /></div>
                                    <div class="of-option-card-title">@cat.Label</div>
                                    <div class="of-option-card-desc">@cat.Description</div>
                                </div>
                            }
                        </div>
                        @if (_touched.Contains("appraisalType") && string.IsNullOrWhiteSpace(_selectedCategory))
                        { <div class="of-val-msg"><MudIcon Icon="@Icons.Material.Outlined.Error" Style="font-size:14px;" /> Kategorija kolaterala je obavezna.</div> }
                    </div>

                    @* Tip kolaterala — dropdown filtriran po odabranoj kategoriji (nivo 2) *@
                    @if (!string.IsNullOrWhiteSpace(_selectedCategory))
                    {
                        <div class="of-field" id="field-collateralType">
                            <div class="of-field-label-row">
                                <MudIcon Icon="@Icons.Material.Outlined.Home"
                                         Style="font-size:16px;color:#7A5C00;" Class="of-field-icon" />
                                <label class="of-label of-label-req">Tip kolaterala</label>
                                <MudTooltip Text="Specifičan podtip nekretnine unutar odabrane kategorije (npr. stan, kuća, garaža)." Placement="Placement.Top" Arrow="true">
                                    <MudIcon Icon="@Icons.Material.Outlined.Info" Style="font-size:14px;color:var(--text-faint);cursor:help;" />
                                </MudTooltip>
                            </div>
                            <MudAutocomplete T="CodebookValueItem"
                                             Value="_selectedCollateral"
                                             ValueChanged="OnCollateralTypeChanged"
                                             SearchFunc="SearchCollateralTypes"
                                             ToStringFunc="@(x => x?.Label ?? string.Empty)"
                                             Placeholder="Pretražite tip kolaterala..."
                                             Variant="Variant.Outlined" Margin="Margin.Dense"
                                             CoerceText="false" CoerceValue="false"
                                             ResetValueOnEmptyText="true"
                                             Clearable="true"
                                             Style="width:100%;" />
                            @if (_touched.Contains("collateralType") && _selectedCollateral is null)
                            { <div class="of-val-msg"><MudIcon Icon="@Icons.Material.Outlined.Error" Style="font-size:14px;" /> Tip kolaterala je obavezan.</div> }
                        </div>
                    }

                    @* Kombinovani tip kolaterala — samo za Stan (APP) *@
                    @if (IsApartmentSelected)
                    {
                        <div class="of-field" id="field-combined">
                            <div class="of-field-label-row">
                                <MudIcon Icon="@Icons.Material.Outlined.Layers"
                                         Style="font-size:16px;color:#7A5C00;" Class="of-field-icon" />
                                <label class="of-label">Kombinovani tip kolaterala (opciono)</label>
                                <MudTooltip Text="Ako kolateral obuhvata više tipova (npr. stan + garaža), odaberite kombinovani tip." Placement="Placement.Top" Arrow="true">
                                    <MudIcon Icon="@Icons.Material.Outlined.Info" Style="font-size:14px;color:var(--text-faint);cursor:help;" />
                                </MudTooltip>
                            </div>
                            <MudAutocomplete T="CodebookValueItem"
                                             Value="_selectedCombined"
                                             ValueChanged="OnCombinedChanged"
                                             SearchFunc="SearchCombinedTypes"
                                             ToStringFunc="@(x => x?.Label ?? string.Empty)"
                                             Placeholder="APP-stan i garaža, APP-stan i ostava..."
                                             Variant="Variant.Outlined" Margin="Margin.Dense"
                                             CoerceText="false" CoerceValue="false"
                                             ResetValueOnEmptyText="true"
                                             Clearable="true"
                                             Style="width:100%;" />
                        </div>
                    }

                    @* Površine objekta — vidljivo za kategoriju 52 (CRE) ili MXR *@
                    @if (ShowSquareMetersFields)
                    {
                        <div class="of-field-divider"></div>
                        <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;align-items:start;">
                            <div class="of-field" id="field-sqmCommercial" style="margin-bottom:0;">
                                <div class="of-field-label-row">
                                    <MudIcon Icon="@Icons.Material.Outlined.Store"
                                             Style="font-size:16px;color:#7A5C00;" Class="of-field-icon" />
                                    <label class="of-label">Površina poslovnog dijela (m²)</label>
                                </div>
                                <MudTextField T="string"
                                              Value="@(_sqmCommercial?.ToString("F2") ?? "")"
                                              ValueChanged="@((string v) => OnSqmCommercialChanged(v))"
                                              Placeholder="npr. 120.50"
                                              Variant="Variant.Outlined" Margin="Margin.Dense"
                                              Immediate="true"
                                              Style="width:100%;" />
                                @if (_touched.Contains("sqmCommercial") && _sqmCommercialError is not null)
                                { <div class="of-val-msg"><MudIcon Icon="@Icons.Material.Outlined.Error" Style="font-size:14px;" /> @_sqmCommercialError</div> }
                            </div>
                            <div class="of-field" id="field-sqmResidential" style="margin-bottom:0;">
                                <div class="of-field-label-row">
                                    <MudIcon Icon="@Icons.Material.Outlined.Home"
                                             Style="font-size:16px;color:#7A5C00;" Class="of-field-icon" />
                                    <label class="of-label">Površina stambenog dijela (m²)</label>
                                </div>
                                <MudTextField T="string"
                                              Value="@(_sqmResidential?.ToString("F2") ?? "")"
                                              ValueChanged="@((string v) => OnSqmResidentialChanged(v))"
                                              Placeholder="npr. 80.00"
                                              Variant="Variant.Outlined" Margin="Margin.Dense"
                                              Immediate="true"
                                              Style="width:100%;" />
                                @if (_touched.Contains("sqmResidential") && _sqmResidentialError is not null)
                                { <div class="of-val-msg"><MudIcon Icon="@Icons.Material.Outlined.Error" Style="font-size:14px;" /> @_sqmResidentialError</div> }
                            </div>
                        </div>
                    }

                    <div class="of-field-divider"></div>

                    @* Grad nekretnine + Adresa nekretnine — oba obavezna, jednake kolone i poravnata na vrhu *@
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;align-items:start;">
                        <div class="of-field" id="field-propertyCity" style="margin-bottom:0;">
                            <div class="of-field-label-row">
                                <MudIcon Icon="@Icons.Material.Outlined.LocationCity"
                                         Style="font-size:16px;color:#7A5C00;" Class="of-field-icon" />
                                <label class="of-label of-label-req">Grad nekretnine</label>
                            </div>
                            <MudTextField @bind-Value="_propertyCity"
                                          Placeholder="Npr. Sarajevo"
                                          Variant="Variant.Outlined" Margin="Margin.Dense"
                                          OnBlur="@(_ => Touch("propertyCity"))"
                                          Class="@FieldCss(_propertyCity, "propertyCity")"
                                          Style="width:100%;" />
                            @if (_touched.Contains("propertyCity") && string.IsNullOrWhiteSpace(_propertyCity))
                            { <div class="of-val-msg"><MudIcon Icon="@Icons.Material.Outlined.Error" Style="font-size:14px;" /> Grad nekretnine je obavezan.</div> }
                        </div>
                        <div class="of-field" id="field-propertyAddress" style="margin-bottom:0;">
                            <div class="of-field-label-row">
                                <MudIcon Icon="@Icons.Material.Outlined.LocationOn"
                                         Style="font-size:16px;color:#7A5C00;" Class="of-field-icon" />
                                <label class="of-label of-label-req">Adresa nekretnine</label>
                            </div>
                            <MudTextField @bind-Value="_propertyAddressInput"
                                          Placeholder="Npr. Titova 5"
                                          Variant="Variant.Outlined" Margin="Margin.Dense"
                                          OnBlur="@(_ => Touch("propertyAddress"))"
                                          Class="@FieldCss(_propertyAddressInput, "propertyAddress")"
                                          Style="width:100%;" />
                            @if (_touched.Contains("propertyAddress") && string.IsNullOrWhiteSpace(_propertyAddressInput))
                            { <div class="of-val-msg"><MudIcon Icon="@Icons.Material.Outlined.Error" Style="font-size:14px;" /> Adresa nekretnine je obavezna.</div> }
                        </div>
                    </div>

                </div>
            </div>

            @* ═══ SEKCIJA 4: LOKACIJA ═══════════════════════════════════════ *@
            <div class="of-card of-card-accent-yellow">
                <div class="of-card-header">
                    <div class="of-card-icon of-card-icon-yellow">
                        <MudIcon Icon="@Icons.Material.Outlined.LocationCity" Style="font-size:18px;color:var(--rbi-off-black);" />
                    </div>
                    <div>
                        <div class="of-card-title">Lokacija i poslovnica</div>
                        <div class="of-card-subtitle">Grad i poslovnica su međusobno povezani — odaberite bilo koji prvi.</div>
                    </div>
                </div>
                <div class="of-card-body">

                    @* Grad *@
                    <div class="of-field" id="field-city">
                        <div class="of-field-label-row">
                            <MudIcon Icon="@Icons.Material.Outlined.LocationOn"
                                     Style="font-size:16px;color:#7A5C00;" Class="of-field-icon" />
                            <label class="of-label of-label-req">Grad</label>
                        </div>
                        <MudAutocomplete T="CityDto"
                                         Value="_selectedCity"
                                         ValueChanged="OnCityChanged"
                                         SearchFunc="SearchCities"
                                         ToStringFunc="@(x => x?.Name ?? string.Empty)"
                                         Placeholder="Pretražite grad..."
                                         Variant="Variant.Outlined" Margin="Margin.Dense"
                                         CoerceText="false" CoerceValue="false"
                                         ResetValueOnEmptyText="true"
                                         OnBlur="@(_ => Touch("city"))"
                                         Style="width:100%;" />
                        @if (_touched.Contains("city") && _selectedCity is null)
                        { <div class="of-val-msg"><MudIcon Icon="@Icons.Material.Outlined.Error" Style="font-size:14px;" /> Grad je obavezan.</div> }
                    </div>

                    @* Poslovnica — filtrirana prema gradu *@
                    <div class="of-field" id="field-branch">
                        <div class="of-field-label-row">
                            <MudIcon Icon="@Icons.Material.Outlined.AccountBalance"
                                     Style="font-size:16px;color:#7A5C00;" Class="of-field-icon" />
                            <label class="of-label of-label-req">Poslovnica</label>
                            @if (_selectedCity is not null)
                            {
                                <span style="font-size:11px;color:var(--text-muted);">
                                    (@FilteredBranches.Count() dostupnih)
                                </span>
                            }
                        </div>
                        <MudAutocomplete T="BranchDto"
                                         Value="_selectedBranch"
                                         ValueChanged="OnBranchChanged"
                                         SearchFunc="SearchBranches"
                                         ToStringFunc="@(x => x?.Name ?? string.Empty)"
                                         Placeholder="Pretražite poslovnicu..."
                                         Variant="Variant.Outlined" Margin="Margin.Dense"
                                         CoerceText="false" CoerceValue="false"
                                         ResetValueOnEmptyText="true"
                                         OnBlur="@(_ => Touch("branch"))"
                                         Style="width:100%;" />
                        @if (_touched.Contains("branch") && _selectedBranch is null)
                        { <div class="of-val-msg"><MudIcon Icon="@Icons.Material.Outlined.Error" Style="font-size:14px;" /> Poslovnica je obavezna.</div> }

                        @* Branch info kartica *@
                        @if (_selectedBranch is not null)
                        {
                            <div class="of-branch-info">
                                <div class="of-branch-info-label">
                                    <MudIcon Icon="@Icons.Material.Outlined.Info"
                                             Style="font-size:12px;vertical-align:middle;" />
                                    Detalji poslovnice
                                </div>
                                <div style="font-weight:700;color:var(--rbi-off-black);font-size:13.5px;">
                                    @_selectedBranch.Name
                                </div>
                                @if (!string.IsNullOrWhiteSpace(_selectedBranch.Address))
                                {
                                    <div style="color:var(--text-secondary);font-size:12.5px;margin-top:3px;
                                                display:flex;align-items:center;gap:5px;">
                                        <MudIcon Icon="@Icons.Material.Outlined.Place"
                                                 Style="font-size:13px;flex-shrink:0;" />
                                        @_selectedBranch.Address
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    @* Adresa poslovnice — prikazana u info kartici iznad, skriveno polje za API *@
                    <input type="hidden" id="field-branchAddress" value="@_branchAddress" />
                    @if (string.IsNullOrWhiteSpace(_branchAddress) && _selectedBranch is null && _touched.Contains("branchAddress"))
                    {
                        <div class="of-val-msg" style="margin-top:4px;">
                            <MudIcon Icon="@Icons.Material.Outlined.Error" Style="font-size:14px;" />
                            Odaberite poslovnicu da se adresa automatski popuni.
                        </div>
                    }

                </div>
            </div>

            @* ── Wizard navigacija Korak 2 ── *@
            <div class="of-wizard-nav" style="grid-column:1/-1;">
                <MudButton Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Outlined.ArrowBack"
                           OnClick="() => GoToStep(0)">
                    Nazad
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Warning"
                           EndIcon="@Icons.Material.Outlined.ArrowForward"
                           OnClick="() => GoToStep(2)"
                           Disabled="@(!SectionPropertyOk || !SectionLocationOk)">
                    Naprijed
                </MudButton>
            </div>
            } @* kraj korak 2 *@

            @* ═══ KORAK 3: DOKUMENTACIJA — ekstrahovano u CreateOrderStep3Docs.razor (B-1) ═══ *@
            @if (_wizardStep == 2)
            {
                <CreateOrderStep3Docs DraftOrderId="_draftOrderId"
                                      ClientType="@_clientType"
                                      OnDocStatsChanged="OnDocStatsChanged"
                                      OnPrevious="@(() => GoToStep(1))"
                                      OnNext="@(() => GoToStep(3))" />
            } @* kraj korak 3 *@

            @* ═══ KORAK 4: PREGLED I SLANJE ════════════════════════════════ *@
            @if (_wizardStep == 3)
            {
            <div class="of-card of-card-accent-yellow">
                <div class="of-card-header">
                    <div class="of-card-icon of-card-icon-yellow">
                        <MudIcon Icon="@Icons.Material.Outlined.Checklist" Style="font-size:18px;color:var(--rbi-off-black);" />
                    </div>
                    <div>
                        <div class="of-card-title">Pregled prije slanja</div>
                        <div class="of-card-subtitle">Provjerite unesene podatke i pošaljite narudžbu</div>
                    </div>
                </div>
                <div class="of-card-body">
                    <div class="of-review-grid">
                        <div class="of-review-row"><span class="of-review-label">Klijent</span><span class="of-review-value">@_clientName</span></div>
                        <div class="of-review-row"><span class="of-review-label">Tip</span><span class="of-review-value">@ClientTypeLabel</span></div>
                        <div class="of-review-row"><span class="of-review-label">JMBG/PIB</span><span class="of-review-value">@_clientIdentifier</span></div>
                        <div class="of-review-row"><span class="of-review-label">Kontakt</span><span class="of-review-value">@_contactName — @_contactPhone</span></div>
                        <div class="of-review-row"><span class="of-review-label">Kategorija</span><span class="of-review-value">@CategoryLabel</span></div>
                        <div class="of-review-row"><span class="of-review-label">Kolateral</span><span class="of-review-value">@_selectedCollateral?.Label</span></div>
                        @if (_selectedCombined is not null)
                        {
                            <div class="of-review-row"><span class="of-review-label">Kombinirani</span><span class="of-review-value">@_selectedCombined.Label</span></div>
                        }
                        <div class="of-review-row"><span class="of-review-label">Adresa</span><span class="of-review-value">@_propertyAddressInput, @_selectedCity?.Name</span></div>
                        <div class="of-review-row"><span class="of-review-label">Poslovnica</span><span class="of-review-value">@_selectedBranch?.Name</span></div>
                        <div class="of-review-row"><span class="of-review-label">Dostava originala</span><span class="of-review-value">@_deliveryContactName</span></div>
                        <div class="of-review-row"><span class="of-review-label">AM za mail</span><span class="of-review-value">@_amRecipientName</span></div>
                        <div class="of-review-row"><span class="of-review-label">Dokumenti</span><span class="of-review-value">@_docDelivered / @_docTotal dostavljeno</span></div>
                    </div>

                    <div class="of-val-status" style="margin-top:16px;">
                        <div class="of-val-status-title">Spremnost za slanje</div>
                        @ValItem("Klijent",       SectionClientOk)
                        @ValItem("Nekretnina",    SectionPropertyOk)
                        @ValItem("Lokacija",      SectionLocationOk)
                        @ValItem("Kontakt",       SectionContactOk)
                    </div>
                </div>
            </div>

            @* ── Wizard navigacija Korak 4 ── *@
            <div class="of-wizard-nav" style="grid-column:1/-1;">
                <MudButton Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Outlined.ArrowBack"
                           OnClick="() => GoToStep(2)">
                    Nazad
                </MudButton>
            </div>
            } @* kraj korak 4 *@

        </div>

        @* ═══ SUMMARY PANEL ═══════════════════════════════════════════════ *@
        <div class="of-summary">
            <div class="of-summary-card">

                <div class="of-summary-header">
                    <MudIcon Icon="@Icons.Material.Outlined.Receipt"
                             Style="font-size:18px;color:var(--rbi-yellow);flex-shrink:0;" />
                    <div class="of-summary-title">Pregled narudžbe</div>
                </div>

                <div class="of-summary-body">

                    @SumRow("Klijent",    _clientName)
                    @SumRow("Tip kl.",    ClientTypeLabel)
                    @SumRow("Kategorija", CategoryLabel)
                    @SumRow("Kolateral",  _selectedCollateral?.Label)
                    @if (_selectedCombined is not null)
                    { @SumRow("Kombinirani", _selectedCombined.Label) }
                    @SumRow("Grad",       _selectedCity?.Name)
                    @SumRow("Poslovnica", _selectedBranch?.Name)
                    @SumRow("Kontakt",    _contactName)
                    @SumRow("Telefon",    _contactPhone)

                    <div style="margin-top:10px;padding-top:10px;border-top:var(--app-border);">
                        <span class="badge badge-warning" style="font-size:11.5px;">
                            <MudIcon Icon="@Icons.Material.Outlined.Edit"
                                     Style="font-size:13px;vertical-align:middle;margin-right:3px;" />
                            Nacrt
                        </span>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(TitlePreview))
                    {
                        <div class="of-title-box">
                            <div class="of-title-label">Generisani naslov</div>
                            <div class="of-title-text">@TitlePreview</div>
                        </div>
                    }
                    else
                    {
                        <div class="of-title-box"
                             style="background:var(--rbi-warm-grey-50);border-color:var(--rbi-warm-grey-dark);">
                            <div class="of-title-label" style="color:var(--text-faint);">Generisani naslov</div>
                            <div style="font-size:12px;color:var(--text-faint);font-style:italic;">
                                Unesi tip kolaterala, klijenta i grad.
                            </div>
                        </div>
                    }

                    <div style="background:var(--rbi-warm-grey-50);border:var(--app-border);
                                border-radius:var(--app-radius-sm);padding:10px 12px;margin-bottom:14px;">
                        <div style="font-size:10.5px;font-weight:700;text-transform:uppercase;
                                    letter-spacing:.6px;color:var(--text-muted);margin-bottom:4px;">
                            Dodijeljeni CA
                        </div>
                        <div style="display:flex;align-items:center;gap:8px;">
                            <MudIcon Icon="@Icons.Material.Outlined.AccountCircle"
                                     Style="font-size:20px;color:var(--text-faint);" />
                            <div style="font-size:13px;color:var(--text-muted);font-style:italic;">
                                Automatska dodjela pri slanju
                            </div>
                        </div>
                    </div>

                    <div class="of-val-status">
                        <div class="of-val-status-title">Validacioni status</div>
                        @ValItem("Klijent",    SectionClientOk)
                        @ValItem("Nekretnina", SectionPropertyOk)
                        @ValItem("Lokacija",   SectionLocationOk)
                        @ValItem("Kontakt",    SectionContactOk)
                    </div>

                    @if (_draftOrderId.HasValue)
                    {
                        <div class="ds-panel-checklist">
                            <div style="font-size:10.5px;font-weight:700;text-transform:uppercase;
                                        letter-spacing:.6px;color:var(--text-muted);margin-bottom:6px;">
                                Dokumentacija
                            </div>
                            @foreach (var item in _docChecklistItems)
                            {
                                <div class="ds-panel-item @(item.Delivered ? "done" : "")">
                                    <div class="ds-panel-dot @(item.Delivered ? "done" : "")">
                                        @if (item.Delivered)
                                        {
                                            <MudIcon Icon="@Icons.Material.Outlined.Check"
                                                     Style="font-size:10px;color:var(--rbi-off-black);" />
                                        }
                                    </div>
                                    @item.Label
                                </div>
                            }
                            <div style="font-size:11.5px;color:var(--text-muted);margin-top:6px;font-weight:600;">
                                @_docDelivered / @_docTotal dostavljeno
                            </div>
                        </div>
                    }

                    <div class="of-progress-wrap">
                        <div class="of-progress-meta">
                            <span style="color:var(--text-secondary);font-size:12px;">Popunjenost forme</span>
                            <span class="of-progress-pct">@ProgressPct%</span>
                        </div>
                        <div class="of-progress-bar">
                            <div class="of-progress-fill" style="width:@(ProgressPct)%;"></div>
                        </div>
                    </div>

                    @if (!IsFormValid)
                    {
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" FullWidth="true"
                                   StartIcon="@Icons.Material.Outlined.MyLocation"
                                   Style="margin-top:10px;"
                                   OnClick="ShowMissingFields">
                            Prikaži nedostajuća polja
                        </MudButton>
                    }

                    @* ── Brze akcije ──────────────────────────────────────────── *@
                    <div class="of-quick-actions">
                        <button class="of-btn-submit" data-testid="btn-submit-order"
                                disabled="@_submitting"
                                @onclick="SubmitOrder">
                            @if (_submitting)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true"
                                                     Style="--mud-palette-primary:#2B2D33;" />
                                <span style="margin-left:6px;">Slanje...</span>
                            }
                            else
                            {
                                <MudIcon Icon="@Icons.Material.Outlined.Send" Style="font-size:16px;" />
                                <span style="margin-left:6px;">Pošalji narudžbu</span>
                            }
                        </button>
                        <button class="of-btn-draft" data-testid="btn-save-draft" disabled="@_submitting" @onclick="SaveDraft">
                            <MudIcon Icon="@Icons.Material.Outlined.Save"
                                     Style="font-size:15px;margin-right:6px;vertical-align:middle;" />
                            Sačuvaj nacrt
                        </button>
                        <button class="of-btn-cancel" @onclick='@(()=>Nav.NavigateTo("/narudzbe/nova"))'>
                            <MudIcon Icon="@Icons.Material.Outlined.Close"
                                     Style="font-size:15px;margin-right:5px;vertical-align:middle;" />
                            Odustani
                        </button>

                        @if (!string.IsNullOrWhiteSpace(_serverError))
                        {
                            <div style="font-size:12.5px;color:var(--rbi-coral-deep);display:flex;
                                        align-items:center;gap:5px;margin-top:4px;">
                                <MudIcon Icon="@Icons.Material.Outlined.ErrorOutline" Style="font-size:15px;flex-shrink:0;" />
                                @_serverError
                            </div>
                        }

                        @if (_lastAutosaveAt is not null)
                        {
                            <div style="display:inline-flex;align-items:center;gap:4px;font-size:11px;color:var(--text-muted);"
                                 title="Nacrt automatski sačuvan prije @AutosaveAgoLabel">
                                <MudIcon Icon="@Icons.Material.Outlined.CloudDone" Style="font-size:12px;color:var(--rbi-green-deep);" />
                                Sačuvano
                            </div>
                        }
                    </div>

                </div>
            </div>
        </div>

    </div>
</div>

@code {

    // ── State ─────────────────────────────────────────────────────────

    /// <summary>Tip workflow-a odabran na ulaznom ekranu (ruta /narudzbe/nova/{Tip}): "FL" ili "PL".</summary>
    [Parameter] public string? Tip { get; set; }

    [SupplyParameterFromQuery(Name = "cloneFrom")]
    public int? CloneFromId { get; set; }

    /// <summary>Normalizovani kod tipa narudžbe ("FL"/"PL") — šalje se backendu pri kreiranju nacrta.</summary>
    private string? _workflowCode;

    private bool _initializing = true;
    private bool _accessDenied;
    private bool _inputRestrictionsApplied;
    private bool _submitting;

    // Wizard stepper
    private int _wizardStep;
    private static readonly (string Label, string Icon, int Idx)[] _wizardSteps =
    [
        ("Klijent",        Icons.Material.Outlined.Person, 0),
        ("Nekretnina",     Icons.Material.Outlined.Home, 1),
        ("Dokumentacija",  Icons.Material.Outlined.Folder, 2),
        ("Pregled",        Icons.Material.Outlined.Checklist, 3)
    ];

    private async Task GoToStep(int step)
    {
        if (step < 0 || step >= _wizardSteps.Length) return;

        // Allow going back freely
        if (step < _wizardStep) { _wizardStep = step; StateHasChanged(); return; }

        // Validate previous steps before going forward
        if (step >= 1 && !SectionClientOk) { Snackbar.Add("Popunite podatke o klijentu prije nastavka.", Severity.Warning); return; }
        if (step >= 1 && !SectionContactOk) { Snackbar.Add("Popunite kontakt podatke prije nastavka.", Severity.Warning); return; }
        if (step >= 2 && !SectionPropertyOk) { Snackbar.Add("Popunite podatke o nekretnini prije nastavka.", Severity.Warning); return; }
        if (step >= 2 && !SectionLocationOk) { Snackbar.Add("Odaberite lokaciju i poslovnicu prije nastavka.", Severity.Warning); return; }

        // Osiguraj da nacrt postoji prije koraka dokumentacije da bi upload section bio dostupan
        if (step == 2)
            await EnsureDraftAsync();

        _wizardStep = step;
        StateHasChanged();
    }
    private string? _serverError;
    private readonly HashSet<string> _touched = [];
    private DateTime? _lastAutosaveAt;
    private MeDto? _me;

    /// <summary>
    /// Aktivna AM/SM/UB rola prijavljenog korisnika — preferira RoleState.ActiveRole
    /// (postavljen kroz /select-role mehanizam), s fallback-om na prvu prodajnu
    /// rolu iz MeDto.Roles (npr. ako je korisnik direktno otvorio ovu stranicu
    /// u sesiji koja još nije inicijalizovala ActiveRoleState).
    /// </summary>
    private string? ActiveSalesRole =>
        (RoleState.ActiveRole is { } active && AppRoles.IsSalesRole(active))
            ? active
            : _me?.Roles.FirstOrDefault(AppRoles.IsSalesRole);

    /// <summary>"Ime Prezime (AM/SM/UB)" — auto-popunjeno, read-only (zahtjev #11/#12).</summary>
    private string InitiatorLabel =>
        $"{_me?.DisplayName ?? _me?.Username} ({ActiveSalesRole})";

    // Autosave nacrta
    private int?     _draftOrderId;
    private string?  _draftOrderNumber;
    private bool     _dirty;
    private AppraisalOrderDto? _existingDraft;
    private bool     _draftBannerDismissed;
    private System.Threading.Timer? _autosaveTimer;

    // Klijent
    private string? _clientName;
