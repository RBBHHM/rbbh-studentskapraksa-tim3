    private void OnSqmCommercialChanged(string v)
    {
        _sqmCommercialError = null;
        if (string.IsNullOrWhiteSpace(v)) { _sqmCommercial = null; _dirty = true; return; }
        if (decimal.TryParse(v.Replace(',', '.'), System.Globalization.NumberStyles.Number,
                System.Globalization.CultureInfo.InvariantCulture, out var d))
        {
            if (d < 0) { _sqmCommercialError = "Vrijednost ne smije biti negativna."; return; }
            _sqmCommercial = d;
        }
        else { _sqmCommercialError = "Unesite broj (npr. 120.50)."; }
        _touched.Add("sqmCommercial");
        _dirty = true;
        StateHasChanged();
    }

