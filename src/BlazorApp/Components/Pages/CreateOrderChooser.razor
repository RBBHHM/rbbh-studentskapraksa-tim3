@page "/narudzbe/nova"
@rendermode InteractiveServer
@attribute [Authorize]
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState
@inject IJSRuntime JS

<PageTitle>Nova narudžba — odabir tipa</PageTitle>

@if (_accessDenied)
{
    <div style="display:flex;flex-direction:column;align-items:center;justify-content:center;
                min-height:60vh;gap:16px;text-align:center;">
        <MudIcon Icon="@Icons.Material.Outlined.Lock"
                 Style="font-size:56px;color:var(--rbi-coral-deep);opacity:.7;" />
        <div style="font-size:20px;font-weight:700;">Pristup odbijen</div>
        <div style="font-size:14px;color:var(--text-secondary);max-width:360px;">
            Samo korisnici s prodajnom rolom (AM, SM, UB) mogu inicirati narudžbe.
        </div>
        <MudButton Variant="Variant.Outlined" OnClick='@(()=>Nav.NavigateTo("/"))'>
            Povratak na početnu
        </MudButton>
    </div>
    return;
}

<AppBreadcrumb Items="@(new List<AppBreadcrumb.BreadcrumbItem> { new("Početna", "/"), new("Narudžbe", "/narudzbe"), new("Nova narudžba", "") })" />

<div class="noc-page">

    @* ── Page header ──────────────────────────────────────────────────── *@
    <h1 class="noc-heading">Kreiranje nove narudžbe procjene</h1>
    <p class="noc-subtitle">Odaberite segment klijenta za koji želite inicirati narudžbu procjene.</p>

    @* ── Dvije kartice ────────────────────────────────────────────────── *@
    <div class="noc-grid">

        @* ── Fizička lica ──────────────────────────────────────── *@
        <div class="noc-card" @onclick='@(() => Choose("FL"))'>
            <div class="noc-card-top">
                <div class="noc-badge">
                    <MudIcon Icon="@Icons.Material.Outlined.Person" Style="font-size:28px;" />
                </div>
                <div>
                    <div class="noc-card-title">Fizička lica</div>
                    <div class="noc-card-desc">Narudžbe procjene za građane.</div>
                </div>
            </div>

            <div class="noc-collateral-section">
                <div class="noc-collateral-label">Tipovi kolaterala</div>
                <div class="noc-collateral-list">
                    <span class="noc-check-item"><MudIcon Icon="@Icons.Material.Filled.CheckCircle" Style="font-size:16px;color:var(--rbi-yellow);" /> Stan</span>
                    <span class="noc-check-item"><MudIcon Icon="@Icons.Material.Filled.CheckCircle" Style="font-size:16px;color:var(--rbi-yellow);" /> Kuća</span>
                    <span class="noc-check-item"><MudIcon Icon="@Icons.Material.Filled.CheckCircle" Style="font-size:16px;color:var(--rbi-yellow);" /> Zemljište</span>
                    <span class="noc-check-item"><MudIcon Icon="@Icons.Material.Filled.CheckCircle" Style="font-size:16px;color:var(--rbi-yellow);" /> Garaža</span>
                    <span class="noc-check-item"><MudIcon Icon="@Icons.Material.Filled.CheckCircle" Style="font-size:16px;color:var(--rbi-yellow);" /> Kombinovani kolaterali</span>
                </div>
            </div>

            <div class="noc-illustration noc-illustration-fl"></div>

            <button class="noc-cta" @onclick='@(() => Choose("FL"))' @onclick:stopPropagation>
                Odaberi fizičko lice
                <MudIcon Icon="@Icons.Material.Outlined.ArrowForward" Style="font-size:18px;" />
            </button>
        </div>

        @* ── Pravna lica ───────────────────────────────────────── *@
        <div class="noc-card" @onclick='@(() => Choose("PL"))'>
            <div class="noc-card-top">
                <div class="noc-badge noc-badge-pl">
                    <MudIcon Icon="@Icons.Material.Outlined.Business" Style="font-size:28px;" />
                </div>
                <div>
                    <div class="noc-card-title">Pravna lica</div>
                    <div class="noc-card-desc">Narudžbe procjene za poslovne subjekte.</div>
                </div>
            </div>

            <div class="noc-collateral-section">
                <div class="noc-collateral-label">Tipovi kolaterala</div>
                <div class="noc-collateral-list">
                    <span class="noc-check-item"><MudIcon Icon="@Icons.Material.Filled.CheckCircle" Style="font-size:16px;color:var(--rbi-yellow);" /> Poslovni objekti</span>
                    <span class="noc-check-item"><MudIcon Icon="@Icons.Material.Filled.CheckCircle" Style="font-size:16px;color:var(--rbi-yellow);" /> Hale</span>
                    <span class="noc-check-item"><MudIcon Icon="@Icons.Material.Filled.CheckCircle" Style="font-size:16px;color:var(--rbi-yellow);" /> Zemljišta</span>
                    <span class="noc-check-item"><MudIcon Icon="@Icons.Material.Filled.CheckCircle" Style="font-size:16px;color:var(--rbi-yellow);" /> Kompleksi</span>
                    <span class="noc-check-item"><MudIcon Icon="@Icons.Material.Filled.CheckCircle" Style="font-size:16px;color:var(--rbi-yellow);" /> Kombinovani kolaterali</span>
                </div>
            </div>

            <div class="noc-illustration noc-illustration-pl"></div>

            <button class="noc-cta" @onclick='@(() => Choose("PL"))' @onclick:stopPropagation>
                Odaberi pravno lice
                <MudIcon Icon="@Icons.Material.Outlined.ArrowForward" Style="font-size:18px;" />
            </button>
        </div>

    </div>

    @* ── Napomena ──────────────────────────────────────────────────────── *@
    <div class="noc-note">
        <MudIcon Icon="@Icons.Material.Outlined.Info" Style="font-size:20px;color:var(--text-secondary);flex-shrink:0;" />
        <div>
            <div style="font-weight:700;font-size:13.5px;color:var(--rbi-off-black);">Napomena</div>
            <div style="font-size:13px;color:var(--text-secondary);margin-top:2px;">
                Nakon odabira segmenta klijenta, vodićemo vas kroz proces kreiranja narudžbe procjene korak po korak.
            </div>
        </div>
    </div>
</div>

@code {
    private bool _accessDenied;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        var user = auth.User;
        if (!(user.Identity?.IsAuthenticated ?? false)) { Nav.NavigateTo("/login", replace: true); return; }

        var roles = user.FindAll("roles").Select(c => c.Value).ToList();
        var ok = roles.Any(r =>
            AppRoles.SalesRoles.Contains(r, StringComparer.OrdinalIgnoreCase) ||
            r.Equals(AppRoles.Administrator, StringComparison.OrdinalIgnoreCase));
        if (!ok) _accessDenied = true;
    }

    private void Choose(string tip) => Nav.NavigateTo($"/narudzbe/nova/{tip}");
}
