@page "/access-denied"
@layout BlazorApp.Components.Layout.PublicLayout
@rendermode InteractiveServer

<PageTitle>Pristup odbijen — Digitalizacija procjene nekretnina</PageTitle>

<div style="min-height:calc(100vh - 64px); display:flex; align-items:center; justify-content:center; padding:40px;">
    <div style="background:#fff; border-radius:12px; padding:48px 44px; max-width:480px; width:100%;
                box-shadow:0 4px 24px rgba(43,45,51,0.09); border:1px solid #F1EDE6; text-align:center;">

        <!-- Icon -->
        <div style="width:72px; height:72px; background:#FFF9D6; border-radius:12px;
                    display:flex; align-items:center; justify-content:center; margin:0 auto 24px;">
            <MudIcon Icon="@Icons.Material.Outlined.Lock"
                     Style="font-size:36px; color:var(--rbi-off-black);" />
        </div>

        <!-- Title -->
        <div style="font-size:22px; font-weight:700; color:var(--rbi-off-black); margin-bottom:12px;">
            Pristup nije dozvoljen
        </div>

        <!-- Message -->
        <div style="font-size:14px; color:#777; line-height:1.7; margin-bottom:28px;">
            Vaš korisnički nalog trenutno nema dodijeljenu ulogu.<br />
            Obratite se administratoru sistema kako bi vam bila dodijeljena odgovarajuća uloga.
        </div>

        <!-- Info box -->
        <div style="background:#FFF9D6; border:1px solid #FFD403; border-radius:8px;
                    padding:14px 18px; margin-bottom:28px; text-align:left;">
            <div style="font-size:13px; color:#6B5000; line-height:1.7;">
                <MudIcon Icon="@Icons.Material.Outlined.Info"
                         Style="font-size:16px; vertical-align:middle; margin-right:6px;" />
                <strong>Šta dalje?</strong><br />
                Kontaktirajte administratora sistema koji može dodijeliti odgovarajuću ulogu
                vašem korisničkom nalogu putem modula za upravljanje korisnicima.
            </div>
        </div>

        <!-- Actions -->
        <div style="display:flex; flex-direction:column; gap:10px;">
            <a href="/login"
               style="display:block; width:100%; height:44px; background:#FEE600;
                      border-radius:8px; font-size:14px; font-weight:700; color:var(--rbi-off-black);
                      text-decoration:none; display:flex; align-items:center; justify-content:center;
                      transition:background 0.15s;"
               onmouseover="this.style.background='#D4BF00'"
               onmouseout="this.style.background='#FEE600'">
                Pokušaj ponovo
            </a>
        </div>

        <div style="margin-top:24px; font-size:12px; color:#aaa;">
            Raiffeisen Bank d.d. · Digitalizacija procjene nekretnina
        </div>
    </div>
</div>
