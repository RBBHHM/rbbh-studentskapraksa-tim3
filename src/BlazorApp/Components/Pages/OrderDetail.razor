    private async Task OpenSendQuoteDialog()
    {
        if (_order is null) return;

        _acting = true;
        var candidatesResult = await AppraiserApi.GetCandidatesAsync(Id);
        _acting = false;

        if (!candidatesResult.IsSuccess || candidatesResult.Data is null || candidatesResult.Data.Count == 0)
        {
            Snackbar.Add("Nema dostupnih vještaka za slanje ponude.", Severity.Warning);
            return;
        }

        var parameters = new MudBlazor.DialogParameters
        {
            ["ContentText"] = $"Odaberite vještake i rok za dostavu ponude za narudžbu '{_order.OrderNumber}'.\n" +
                              $"Sistem će poslati zahtjev za ponudu na sve odabrane vještake.",
            ["ConfirmText"] = "Pošalji zahtjeve"
        };

        var dialog = await DialogService.ShowAsync<Shared.ConfirmDialog>(
            "Pošalji zahtjev za ponudu", parameters);

        if (await dialog.Result is { Canceled: false })
        {
            var deadline = DateTime.UtcNow.Date.AddHours(17);
            var allIds = candidatesResult.Data.Select(c => c.Id).ToList();
            var request = new SendQuoteRequestsRequest { AppraiserIds = allIds, Deadline = deadline };

            _acting = true;
            var r = await AppraiserApi.SendQuoteRequestsAsync(Id, request);
            _acting = false;

            if (r.IsSuccess)
            {
                Snackbar.Add(r.Data?.Message ?? "Zahtjevi za ponudu poslani.", Severity.Success);
                await LoadOrder();
            }
            else Snackbar.Add(r.ErrorMessage ?? "Greška pri slanju zahtjeva.", Severity.Error);
        }
    }

