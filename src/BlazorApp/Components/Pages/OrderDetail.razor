    private async Task UploadInvoice()
    {
        if (_order is null) return;

        var documents = await DocumentApi.GetByOrderAsync(Id);
        if (!documents.IsSuccess || documents.Data is null || documents.Data.Count == 0)
        {
            Snackbar.Add("Nema uploadovanih dokumenata. Prvo uploadujte fakturu u tab Dokumenti.", Severity.Warning);
            return;
        }

        var invoiceDoc = documents.Data
            .OrderByDescending(d => d.UploadedAt)
            .FirstOrDefault();

        if (invoiceDoc is null) return;

        var dialog = await DialogService.ShowAsync<Shared.ConfirmDialog>(
            "Upload fakture",
            new MudBlazor.DialogParameters
            {
                ["ContentText"] = $"Posljednji uploadovani dokument '{invoiceDoc.DisplayName}' će biti označen kao faktura za narudžbu '{_order.OrderNumber}'. " +
                                  "CA će primiti notifikaciju o uploadu.",
                ["ConfirmText"] = "Potvrdi upload fakture"
            });

        if (await dialog.Result is { Canceled: false })
        {
            _acting = true;
            var r = await OrderService.UploadInvoiceAsync(Id, invoiceDoc.Id);
            _acting = false;

            if (r.IsSuccess)
            {
                Snackbar.Add(r.Data?.Message ?? "Faktura uploadovana.", Severity.Success);
                await LoadOrder();
            }
            else Snackbar.Add(r.ErrorMessage ?? "Greška pri uploadu fakture.", Severity.Error);
        }
    }

