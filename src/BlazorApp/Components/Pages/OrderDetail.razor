    protected override async Task OnInitializedAsync()
    {
        var meResult = await MeSvc.GetMeAsync();
        if (meResult.IsSuccess) _me = meResult.Data;

        await LoadOrder();
        if (_order is null) return;

        var authState = await AuthState.GetAuthenticationStateAsync();
        var roles = authState.User.FindAll("roles").Select(c => c.Value).ToList();
        _isAdmin   = roles.Any(r => r.Equals(AppRoles.Administrator,         StringComparison.OrdinalIgnoreCase));
        _isVjestak = roles.Any(r => r.Equals(AppRoles.Vjestak,               StringComparison.OrdinalIgnoreCase));
        _isCA      = roles.Any(r => r.Equals(AppRoles.KolateralAdministrator, StringComparison.OrdinalIgnoreCase));

        if (_isAdmin) await LoadAuditAsync();

    }


    private async Task LoadOrder()
    {
        _loading = true;
        _error   = null;
        StateHasChanged();

        var r = await OrderService.GetByIdAsync(Id);
        _loading = false;

        if (r.IsSuccess)
        {
            _order = r.Data;
            if (_order?.IsLegalEntity == true)
                await LoadQuoteRequestsAsync();
        }
        else _error = r.StatusCode == 403
            ? "Nemate pristup ovoj narudžbi."
            : r.StatusCode == 404
            ? "Narudžba nije pronađena."
            : r.ErrorMessage ?? "Greška pri učitavanju narudžbe.";
    }

    private async Task LoadQuoteRequestsAsync()
    {
        try
        {
            var result = await Http.GetFromJsonAsync<List<QuoteRequestListItem>>($"/api/orders/{Id}/quote-requests");
            _quoteRequests = result ?? [];
        }
        catch { _quoteRequests = []; }
    }

    private async Task LoadAuditAsync()
    {
        _loadingAudit = true;
        var result = await AccessSvc.GetAuditAsync(
            entityType: "AppraisalOrder", entityKey: Id.ToString(), pageSize: 50);

        if (result.IsSuccess && result.Data is not null)
            _auditItems = result.Data.Items.ToList();

        _loadingAudit = false;
    }

    private async Task AcceptOrder()
    {
        if (_order is null) return;

        _acting = true;
        var r   = await OrderService.AcceptByAppraiserAsync(Id);
        _acting = false;

        if (r.IsSuccess)
        {
            Snackbar.Add("Narudžba prihvaćena — možete pristupiti izradi i dostavi procjene.", Severity.Success);
            await LoadOrder();
        }
        else Snackbar.Add(r.ErrorMessage ?? "Greška pri prihvatanju narudžbe.", Severity.Error);
    }

    private void OpenAppraisalDialog()
    {
        _visitDate      = null;
        _visitDateStr   = "";
        _visitDateError = null;
        _appraisalDialogOpen = true;
    }

    private void OnVisitDateChanged(string value)
    {
        _visitDateStr   = value;
        _visitDateError = null;
        if (DateTime.TryParse(value, out var d))
            _visitDate = DateTime.SpecifyKind(d.Date, DateTimeKind.Utc);
        else
            _visitDate = null;
    }

    private async Task SubmitAppraisal()
    {
        if (_order is null) return;

        if (!_visitDate.HasValue)
        {
            _visitDateError = "Obavezno unesite datum obilaska imovine.";
            return;
        }

        _appraisalDialogOpen = false;
        _acting = true;
        var r   = await OrderService.SubmitAppraisalAsync(Id, _visitDate.Value);
        _acting = false;

        if (r.IsSuccess)
        {
            Snackbar.Add("Procjena je dostavljena kolateral oficiru.", Severity.Success);
            await LoadOrder();
        }
        else Snackbar.Add(r.ErrorMessage ?? "Greška pri dostavi procjene.", Severity.Error);
    }

