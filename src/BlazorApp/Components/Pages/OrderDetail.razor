    // ── Odbijanje narudžbe (vještak) ────────────────────────────────────

    private async Task RejectOrder()
    {
        if (_order is null) return;

        var reasons = new[] { "Nisam u gradu", "Ne mogu stići od dr. obaveza", "Bolest", "Smrtni slučaj", "Ostali razlozi" };

        var dialog = await DialogService.ShowAsync<Shared.SelectReasonDialog>(
            "Odbijanje narudžbe",
            new MudBlazor.DialogParameters
            {
                ["Title"] = "Odbijanje narudžbe",
                ["Reasons"] = reasons,
                ["RequireCommentForLast"] = true,
                ["CommentLabel"] = "Obrazloženje (obavezno za 'Ostali razlozi')"
            });

        var result = await dialog.Result;
        if (result is null || result.Canceled) return;

        var data = (Shared.ReasonDialogResult)result.Data!;

        var reasonInt = Array.IndexOf(reasons, data.Reason) + 1;
        if (reasonInt <= 0) reasonInt = 5;

        _acting = true;
        var r = await OrderService.RejectByAppraiserAsync(Id, reasonInt, data.Comment);
        _acting = false;

        if (r.IsSuccess)
        {
            Snackbar.Add("Narudžba odbijena — sistem traži sljedećeg vještaka.", Severity.Success);
            await LoadOrder();
        }
        else Snackbar.Add(r.ErrorMessage ?? "Greška pri odbijanju narudžbe.", Severity.Error);
    }

