    // Kratki naziv role koja je trenutno vlasnik — za isticanje u lancu rola.
    private string? OwnerRoleShort => _order?.CurrentOwnerRole switch
    {
        "Prodaja"                 => "Prodaja",
        "Kolateral administrator" => "CA",
        "Kolateral oficir"        => "CO",
        "Vještak"                 => "Vještak",
        _                         => null
    };

    // Indeks trenutno aktivne karike u lancu rola. Highlight-a se SAMO jedna karika —
    // u PL lancu se ime role ponavlja (Prodaja/CA/CO više puta) pa poređenje po imenu
    // (ranija logika) osvjetljava obje "Prodaja" karike. Mapiramo status → poziciju.
    private int _activeChainIndex
    {
        get
        {
            if (_order is null) return -1;
            var s = _order.StatusCode;

            if (_order.IsLegalEntity)
            {
                // PL: [0 Klijent,1 Prodaja,2 CA,3 CO,4 CA,5 Prodaja,6 CA,7 Vještak,8 CO]
                return s switch
                {
                    <= 0                            => 1,  // Nacrt — Prodaja kreira
                    10                              => 2,  // Poslano CA-u
                    20 or 30                        => 2,  // CA prihvat / pregled dokumentacije
                    60                              => 3,  // CO provjera pristupa
                    70                              => 4,  // pristup vraćen na CA
                    40                              => 5,  // vraćeno na dopunu — Prodaja
                    45                              => 6,  // dopuna dostavljena — CA
                    65 or 50 or 80 or 90 or 95      => 6,  // pristup potvrđen / odabir vještaka — CA
                    100 or 110 or 115 or 120 or 130 => 7,  // kod vještaka
                    >= 140                          => 8,  // CO odobrenje i dalje u proceduru
                    _                               => 2
                };
            }

            // FL: [0 Klijent,1 Prodaja,2 CA,3 Vještak,4 CO]
            return s switch
            {
                <= 0                                         => 1,  // Nacrt — Prodaja
                40                                           => 1,  // vraćeno na dopunu — Prodaja
                10 or 20 or 30 or 45 or 50 or 80 or 90 or 95 => 2,  // CA
                100 or 110 or 115 or 120 or 130              => 3,  // kod vještaka
                >= 140                                       => 4,  // CO
                _                                            => 2
            };
        }
    }

    private static string RoleChipStyle(bool isOwner)
    {
        var baseStyle = "display:inline-flex;align-items:center;padding:4px 10px;border-radius:12px;" +
                        "font-size:12px;font-weight:700;white-space:nowrap;";
        return isOwner
            ? baseStyle + "background:var(--rbi-yellow);color:var(--rbi-off-black);box-shadow:0 0 0 3px rgba(254,230,0,0.25);"
            : baseStyle + "background:var(--rbi-warm-grey-50);color:var(--text-secondary);border:1px solid var(--rbi-warm-grey-dark);";
    }

    private static string WorkflowDotStyle(bool done, bool current)
    {
        var bg = done ? "var(--rbi-green-deep)" : current ? "var(--rbi-yellow)" : "var(--rbi-warm-grey-dark)";
        var style = $"width:14px;height:14px;border-radius:50%;background:{bg};flex-shrink:0;margin-top:2px;";
        if (current) style += "box-shadow:0 0 0 4px rgba(254,230,0,0.25);";
        return style;
    }

    private string? ClientTypeFullLabel => _order?.ClientType switch
    {
        "FL" => "Fizičko lice",
        "PL" => "Pravno lice",
        _    => _order?.ClientType
    };

    private string JmbgLabel => "JMBG";

    // Audit badge helpers (vidi AccessManagement.razor)
    private static (string cssClass, string label) GetStatusBadge(string status) => status switch
    {
        "Success"          => ("badge badge-active",  "Uspješno"),
        "Failed"           => ("badge badge-error",   "Neuspješno"),
        "Forbidden"        => ("badge badge-warning", "Zabranjeno"),
        "Conflict"         => ("badge badge-warning", "Konflikt"),
        "ValidationFailed" => ("badge badge-neutral", "Validacija"),
        "SystemError"      => ("badge badge-error",   "Sistemska greška"),
        _                  => ("badge badge-neutral", status)
    };

    private static (string cssClass, string label) GetSeverityBadge(string severity) => severity switch
    {
        "Info"     => ("badge badge-info",    "Info"),
        "Warning"  => ("badge badge-warning", "Upozorenje"),
        "Security" => ("badge badge-info",    "Sigurnost"),
        "Critical" => ("badge badge-error",   "Kritično"),
        _          => ("badge badge-neutral", severity)
    };

