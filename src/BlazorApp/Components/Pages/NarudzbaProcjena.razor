@page "/narudzbe/{Id:int}/procjena"
@rendermode InteractiveServer
@attribute [Authorize]
@inject MeService MeSvc
@inject OrderService OrderSvc
@inject NavigationManager Nav

<PageTitle>Procjena — Procjena nekretnine</PageTitle>

@if (_loading)
{
    <div class="loading-state">
        <MudProgressCircular Indeterminate="true" Color="Color.Warning" Size="Size.Medium" />
    </div>
}
else if (_order is null)
{
    <div style="display:flex;flex-direction:column;align-items:center;justify-content:center;
                min-height:40vh;gap:14px;text-align:center;">
        <MudIcon Icon="@Icons.Material.Outlined.SearchOff"
                 Style="font-size:52px;color:var(--text-muted);opacity:.7;" />
        <div style="font-size:18px;font-weight:700;color:var(--rbi-off-black);">Narudžba nije pronađena</div>
        <div style="font-size:13.5px;color:var(--text-secondary);max-width:360px;">
            @(_error ?? $"Narudžba procjene sa ID={Id} ne postoji ili nije dostupna.")
        </div>
    </div>
}
else
{
    var order = _order;

    @* ── Breadcrumb + naslov ─────────────────────────────────────────────── *@
    <div style="display:flex;align-items:center;gap:10px;margin-bottom:24px;flex-wrap:wrap;">
        <MudIconButton Icon="@Icons.Material.Outlined.ArrowBack"
                       Size="Size.Small"
                       OnClick='@(() => Nav.NavigateTo($"/narudzbe/{Id}"))'
                       Style="color:var(--text-secondary);" />
        <div style="flex:1;min-width:0;">
            <div style="font-size:11px;color:var(--text-muted);text-transform:uppercase;
                        letter-spacing:.7px;font-weight:700;margin-bottom:2px;">
                Narudžbe / @order.OrderNumber / Procjena
            </div>
            <div style="font-size:18px;font-weight:800;color:var(--rbi-off-black);">
                @order.Title
            </div>
        </div>
        <span class="badge" style="background:#FFF9E6;color:var(--rbi-off-black);border:1px solid #FEE600;font-size:12.5px;flex-shrink:0;">
            @order.StatusLabel
        </span>
    </div>

    @* ── Provjera pristupa ───────────────────────────────────────────────── *@
    @if (!_isSales && !_isCo && !_isPravna && !_isCA)
    {
        <div style="display:flex;flex-direction:column;align-items:center;justify-content:center;
                    min-height:40vh;gap:14px;text-align:center;">
            <MudIcon Icon="@Icons.Material.Outlined.Lock"
                     Style="font-size:52px;color:var(--rbi-coral-deep);opacity:.7;" />
            <div style="font-size:18px;font-weight:700;color:var(--rbi-off-black);">Pristup odbijen</div>
            <div style="font-size:13.5px;color:var(--text-secondary);max-width:360px;">
                Stranica je dostupna prodaji (AM/SM/UB), kolateral administratoru (CA),
                kolateral oficiru (CO) i pravnoj službi.
                <br/><br/>
                <strong>Trenutna rola:</strong> @(string.Join(", ", _me?.Roles ?? []))
            </div>
        </div>
        return;
    }

    @* ── Kućice ─────────────────────────────────────────────────────────── *@
    <MudGrid Spacing="3">

        @if (_isSales)
        {
            <MudItem xs="12" md="@TopBoxWidth">
                <Us93SalesActions Order="order" OnRefresh="OnRefresh" />
            </MudItem>
        }

        @if (_isCo)
        {
            <MudItem xs="12" md="@TopBoxWidth">
                <CoAccessCheckCard Order="order" OnRefresh="OnRefresh" />
            </MudItem>

            <MudItem xs="12" md="@TopBoxWidth">
                <Us93CoApproval Order="order" OnRefresh="OnRefresh" />
            </MudItem>
        }

        @if (_isCA)
        {
            <MudItem xs="12" md="@TopBoxWidth">
                <CaDocumentReviewCard Order="order" OnRefresh="OnRefresh" />
            </MudItem>

            <MudItem xs="12" md="@TopBoxWidth">
                <AppraiserSelectionCard Order="order" OnRefresh="OnRefresh" />
            </MudItem>

            <MudItem xs="12" md="@TopBoxWidth">
                <Us93CaOverview Order="order" />
            </MudItem>
        }

        <MudItem xs="12">
            <DocumentUploadSection OrderId="@Id" ClientType="@order.ClientType" />
        </MudItem>

        @if (_isSales || _isCA)
        {
            <MudItem xs="12" md="6">
                <OpinionRequestSection OrderId="@Id" />
            </MudItem>
        }

        @if (_isCo)
        {
            <MudItem xs="12" md="6">
                <OpinionSubmitSection OrderId="@Id" Role="OpinionType.CO" />
            </MudItem>
        }

        @if (_isPravna)
        {
            <MudItem xs="12" md="6">
                <OpinionSubmitSection OrderId="@Id" Role="OpinionType.Pravna" />
            </MudItem>
        }

    </MudGrid>
}

@code {
    [Parameter] public int Id { get; set; }

    private MeDto? _me;
    private AppraisalOrderDetailDto? _order;
    private string? _error;
    private bool _loading = true;

    // Kućica Prodaja (AM/SM/UB) — prodaja traži mišljenja i potvrđuje original procjene
    private bool _isSales =>
        _me?.Permissions.Contains(AppPermissions.OrdersConfirmOriginal, StringComparer.OrdinalIgnoreCase) == true;

    // Kućica Kolateral oficir (CO) — odobrava finalnu procjenu i daje mišljenje CO
    private bool _isCo =>
        _me?.Permissions.Contains(AppPermissions.OrdersApproveFinal, StringComparer.OrdinalIgnoreCase) == true;

    // Kućica Pravna služba — daje pravno mišljenje (US 94)
    private bool _isPravna =>
        _me?.Permissions.Contains(AppPermissions.OpinionsSubmitLegal, StringComparer.OrdinalIgnoreCase) == true;

    // Kolateral administrator (CA) — read-only pristup: dokumentaciju i status mišljenja
    // vide AM/SM/UB, CA i CO (vidi 02-POSLOVNI-PROCES.md §5.4)
    private bool _isCA =>
        _me?.Roles.Contains(AppRoles.KolateralAdministrator, StringComparer.OrdinalIgnoreCase) == true;

    // Širina gornjih kućica (Prodaja/CO/CA) — ravnomjerno podijeli red prema broju prikazanih kućica
    private int TopBoxCount => (_isSales ? 1 : 0) + (_isCo ? 1 : 0) + (_isCA ? 1 : 0);

    private int TopBoxWidth => TopBoxCount switch
    {
        1 => 12,
        2 => 6,
        _ => 4
    };

    protected override async Task OnInitializedAsync()
    {
        var r = await MeSvc.GetMeAsync();
        if (r.IsSuccess) _me = r.Data;

        await LoadOrderAsync();
        _loading = false;
    }

    private async Task LoadOrderAsync()
    {
        var r = await OrderSvc.GetDetailByIdAsync(Id);
        if (r.IsSuccess)
        {
            _order = r.Data;
            _error = null;
        }
        else
        {
            _order = null;
            _error = r.ErrorMessage;
        }
    }

    private async Task OnRefresh()
    {
        await LoadOrderAsync();
    }
}
