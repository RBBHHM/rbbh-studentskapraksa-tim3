@layout BlazorApp.Components.Layout.PublicLayout
@page "/login"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@inject NavigationManager Nav

<PageTitle>Prijava — Digitalizacija procjene nekretnina</PageTitle>

@if (_loading)
{
    <div style="position:fixed; inset:0; background:rgba(248,246,242,0.96); z-index:9999;
                display:flex; flex-direction:column; align-items:center; justify-content:center; gap:0;">

        <div style="position:relative; width:80px; height:80px; margin-bottom:24px;">
            <svg width="80" height="80" style="position:absolute; top:0; left:0; animation:spin 1.2s linear infinite;">
                <circle cx="40" cy="40" r="34" fill="none" stroke="#F1EDE6" stroke-width="5"/>
                <circle cx="40" cy="40" r="34" fill="none" stroke="#FEE600" stroke-width="5"
                        stroke-dasharray="60 154" stroke-linecap="round"/>
            </svg>
            <div style="position:absolute; inset:0; display:flex; align-items:center; justify-content:center;">
                <MudIcon Icon="@Icons.Material.Outlined.Shield" Style="font-size:28px; color:var(--rbi-off-black);" />
            </div>
        </div>

        <div style="font-size:17px; font-weight:700; color:var(--rbi-off-black); margin-bottom:6px;">Prijava je u toku...</div>
        <div style="font-size:13px; color:#9CA3AF; text-align:center; max-width:280px; line-height:1.6;">
            Molimo sačekajte dok se verifikuju vaši podaci.
        </div>
    </div>
}

<div class="login-wrapper">
    <div class="login-card">

        <div class="login-brand">
            <img src="images/rbbh-logo.png" alt="Raiffeisen" style="height:36px; width:auto; display:block; flex-shrink:0;" />
            <div>
                <div class="login-brand-text">Raiffeisen Bank d.d.</div>
                <div class="login-brand-sub">Bosna i Hercegovina</div>
            </div>
            <div style="width:1px; height:36px; background:#E5DDD2; flex-shrink:0;"></div>
            <div style="font-size:12.5px; color:#9CA3AF; line-height:1.4; max-width:130px;">
                Digitalizacija procjene nekretnina
            </div>
        </div>

        <div class="login-title">Prijava u sistem</div>
        <div class="login-sub">Unesite korisničko ime i bit ćete preusmjereni na Keycloak za autentifikaciju.</div>

        <EditForm EditContext="_ctx" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator />

            <div style="margin-bottom:24px;">
                <label class="field-label">Email ili korisničko ime <span style="color:#C65C4A;">*</span></label>
                <MudTextField @bind-Value="_model.Email"
                              Placeholder="Unesite email ili korisničko ime"
                              Variant="Variant.Outlined"
                              InputType="InputType.Text"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Outlined.PersonOutline"
                              For="@(() => _model.Email)"
                              Immediate="true"
                              OnBlur="@(_ => ValidateField(nameof(LoginModel.Email)))"
                              Margin="Margin.Dense"
                              Style="width:100%;" />
            </div>

            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <div style="background:#FFF0EC; border:1px solid #FFB9A5; border-radius:8px;
                            padding:12px 14px; margin-bottom:18px; font-size:13.5px; color:#9B2C1C;
                            display:flex; align-items:flex-start; gap:10px; line-height:1.5;">
                    <MudIcon Icon="@Icons.Material.Outlined.ErrorOutline"
                             Style="font-size:18px; margin-top:1px; flex-shrink:0;" />
                    @_error
                </div>
            }

            <button type="submit"
                    disabled="@_loading"
                    class="login-btn">
                Prijava
            </button>

        </EditForm>

        <div class="login-footer">
            <MudIcon Icon="@Icons.Material.Outlined.Security"
                     Style="font-size:15px; vertical-align:middle; margin-right:5px; opacity:0.4;" />
            Pristup je dostupan isključivo ovlaštenim korisnicima.<br />
            Svi pokušaji pristupa se evidentiraju.
        </div>

    </div>
</div>

<style>
@@keyframes spin { to { transform: rotate(360deg); } }
</style>

@code {
    private readonly LoginModel _model = new();
    private EditContext _ctx = default!;
    private bool _isValid;
    private bool _loading;
    private string? _error;

    protected override void OnInitialized()
    {
        _ctx = new EditContext(_model);
        _ctx.OnFieldChanged += (_, _) =>
        {
            _error   = null;
            _isValid = _ctx.Validate();
            StateHasChanged();
        };

        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var qs  = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        if (qs.TryGetValue("error", out var errorVal))
        {
            _error = errorVal.ToString() switch
            {
                "auth_failed"     => "Prijava nije uspjela. Provjerite korisničke podatke i pokušajte ponovo.",
                "session_expired" => "Vaša sesija je istekla. Molimo prijavite se ponovo.",
                "access_denied"   => "Pristup odbijen. Nemate ovlaštenje za pristup ovom sistemu.",
                _                 => "Prijava nije uspjela. Pokušajte ponovo."
            };
        }
    }

    private void ValidateField(string f)
    {
        _ctx.NotifyFieldChanged(new FieldIdentifier(_model, f));
        _isValid = _ctx.Validate();
    }

    private void HandleSubmit()
    {
        if (!_isValid) return;

        _loading = true;
        StateHasChanged();

        var loginHint = Uri.EscapeDataString(_model.Email?.Trim() ?? string.Empty);
        Nav.NavigateTo($"/api/login?loginHint={loginHint}", forceLoad: true);
    }

    private sealed class LoginModel
    {
        [Required(ErrorMessage = "Email ili korisničko ime je obavezno.")]
        [MinLength(3, ErrorMessage = "Unesite ispravno korisničko ime ili email.")]
        public string? Email { get; set; }
    }
}
