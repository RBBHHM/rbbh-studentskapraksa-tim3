    // ── CSV Export ───────────────────────────────────────────────────────────
    private async Task LoadKpiAsync()
    {
        try
        {
            var draftR = await OrderService.GetListAsync(page: 1, pageSize: 1, status: "Draft");
            var sentR  = await OrderService.GetListAsync(page: 1, pageSize: 1, status: "SubmittedBySales");
            var progR  = await OrderService.GetListAsync(page: 1, pageSize: 1, status: "InProgress");
            var compR  = await OrderService.GetListAsync(page: 1, pageSize: 1, status: "Completed");

            _kpiDraft      = draftR.IsSuccess ? draftR.Data?.TotalCount ?? 0 : 0;
            _kpiSent       = sentR.IsSuccess  ? sentR.Data?.TotalCount ?? 0 : 0;
            _kpiInProgress = progR.IsSuccess  ? progR.Data?.TotalCount ?? 0 : 0;
            _kpiCompleted  = compR.IsSuccess  ? compR.Data?.TotalCount ?? 0 : 0;

            await InvokeAsync(StateHasChanged);
        }
        catch { /* KPI su nice-to-have, ne blokiraj stranicu */ }
    }

    private bool _exporting;

    private async Task ExportToCsvAsync()
    {
        _exporting = true;
        try
        {
            var result = await OrderService.GetListAsync(
                1, 5000, _search, _statusFilter, _cityFilter, _appraisalTypeFilter,
                _createdFrom, _createdTo, _sortBy, _sortDesc);

            if (!result.IsSuccess || result.Data is null)
            {
                Snackbar.Add(result.ErrorMessage ?? "Greška pri dohvatu podataka za export.", Severity.Error);
                return;
            }

            var sb = new StringBuilder();
            sb.AppendLine("Broj narudžbe,Naslov,Klijent,Tip procjene,Status,Grad,Poslovnica,Datum kreiranja,Zadnja izmjena");

            foreach (var o in result.Data.Items)
            {
                sb.AppendLine(string.Join(",",
                    CsvCell(o.OrderNumber),
                    CsvCell(o.Title),
                    CsvCell(o.ClientName),
                    CsvCell(o.AppraisalTypeLabel),
                    CsvCell(o.SimpleStatusLabel),
                    CsvCell(o.City),
                    CsvCell(o.Branch),
                    CsvCell(o.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")),
                    CsvCell((o.UpdatedAt ?? o.CreatedAt).ToLocalTime().ToString("dd.MM.yyyy HH:mm"))));
            }

            var filename = $"narudzbe-{DateTime.Now:yyyyMMdd-HHmm}.csv";
            await JS.InvokeVoidAsync("downloadTextFile", filename, sb.ToString(), "text/csv");
            var cnt = result.Data.Items.Count;
            Snackbar.Add($"Izvezeno {cnt} {BsPlural.Of(cnt, "narudžba", "narudžbe", "narudžbi")}.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Greška pri exportu: {ex.Message}", Severity.Error);
        }
        finally
        {
            _exporting = false;
        }
    }

    private static string CsvCell(string? value)
    {
        if (string.IsNullOrEmpty(value)) return "\"\"";
        return $"\"{value.Replace("\"", "\"\"")}\"";
    }
}
