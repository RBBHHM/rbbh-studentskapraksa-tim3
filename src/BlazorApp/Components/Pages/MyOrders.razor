@page "/narudzbe"
@rendermode InteractiveServer
@attribute [Authorize]
@inject OrderService     OrderService
@inject BranchApiService BranchApiService
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject AuthenticationStateProvider AuthState
@inject IJSRuntime JS
@using System.Text

<PageTitle>Pregled narudžbi — Procjena nekretnine</PageTitle>

@* ── 403 guard ────────────────────────────────────────────────────────────── *@
@if (_accessDenied)
{
    <AppAccessDenied />
    return;
}

@* ── Breadcrumb ──────────────────────────────────────────────────────────── *@
<AppBreadcrumb Items="@(new List<AppBreadcrumb.BreadcrumbItem> { new("Početna", "/"), new("Pregled narudžbi", "") })" />

@* ── Page header ──────────────────────────────────────────────────────────── *@
<AppPageHeader Title="Pregled narudžbi"
               Subtitle="@(_isCA ? "Pregled svih narudžbi u sistemu." : "Vaše narudžbe procjene nekretnina.")">
    <Actions>
        <MudTooltip Text="@($"Posljednje osvježenje: {_lastRefresh?.ToLocalTime().ToString("HH:mm") ?? "—"}")" Placement="Placement.Bottom">
            <MudIconButton Icon="@Icons.Material.Outlined.Refresh" Size="Size.Small"
                           OnClick="LoadOrders" Disabled="_loading"
                           Style="color:var(--text-secondary);" aria-label="Osvježi" />
        </MudTooltip>
        <MudButton Variant="Variant.Outlined" Size="Size.Small"
                   StartIcon="@Icons.Material.Outlined.Download"
                   Disabled="_exporting"
                   OnClick="ExportToCsvAsync"
                   Style="height:38px; border-color:#E5DDD2; color:var(--text-secondary); font-size:13px; text-transform:none; font-weight:600;">
            @(_exporting ? "Izvoz..." : "Export CSV")
        </MudButton>
        @if (_selectedIds.Count > 0)
        {
            <MudButton Variant="Variant.Outlined" Size="Size.Small"
                       StartIcon="@Icons.Material.Outlined.Cancel"
                       OnClick="BulkCancelAsync"
                       Style="height:38px; border-color:var(--rbi-coral-deep); color:var(--rbi-coral-deep); font-size:13px; text-transform:none;">
                Otkaži odabrane (@_selectedIds.Count)
            </MudButton>
        }
        @if (_canCreate)
        {
            <MudButton Variant="Variant.Filled" Class="btn-primary-rbi"
                       StartIcon="@Icons.Material.Outlined.Add"
                       OnClick='@(() => Nav.NavigateTo("/narudzbe/nova"))'
                       Style="text-transform:none; font-weight:700; height:38px;">
                Nova narudžba
            </MudButton>
        }
    </Actions>
</AppPageHeader>

@* ── KPI kartice ─────────────────────────────────────────────────────────── *@
<div class="kpi-row">
    <div class="kpi-card">
        <div class="kpi-icon" style="background:var(--rbi-warm-grey-50); color:var(--rbi-off-black);">
            <MudIcon Icon="@Icons.Material.Outlined.Assignment" Style="font-size:22px;" />
        </div>
        <div class="kpi-body">
            <div class="kpi-value">@_totalCount</div>
            <div class="kpi-label">Ukupno narudžbi</div>
            <div class="kpi-sub">Sve narudžbe</div>
        </div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon" style="background:#F5F0E8; color:#8A6500;">
            <MudIcon Icon="@Icons.Material.Outlined.EditNote" Style="font-size:22px;" />
        </div>
        <div class="kpi-body">
            <div class="kpi-value">@_kpiDraft</div>
            <div class="kpi-label">Nacrt</div>
            <div class="kpi-sub">@Pct(_kpiDraft) od ukupno</div>
        </div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon" style="background:var(--rbi-yellow-1); color:var(--rbi-off-black);">
            <MudIcon Icon="@Icons.Material.Outlined.Send" Style="font-size:22px;" />
        </div>
        <div class="kpi-body">
            <div class="kpi-value">@_kpiSent</div>
            <div class="kpi-label">Poslano</div>
            <div class="kpi-sub">@Pct(_kpiSent) od ukupno</div>
        </div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon" style="background:var(--rbi-blue-light); color:var(--rbi-blue);">
            <MudIcon Icon="@Icons.Material.Outlined.HourglassTop" Style="font-size:22px;" />
        </div>
        <div class="kpi-body">
            <div class="kpi-value">@_kpiInProgress</div>
            <div class="kpi-label">U obradi</div>
            <div class="kpi-sub">@Pct(_kpiInProgress) od ukupno</div>
        </div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon" style="background:var(--rbi-success-light); color:var(--rbi-green-deep);">
            <MudIcon Icon="@Icons.Material.Outlined.CheckCircleOutline" Style="font-size:22px;" />
        </div>
        <div class="kpi-body">
            <div class="kpi-value">@_kpiCompleted</div>
            <div class="kpi-label">Završeno</div>
            <div class="kpi-sub">@Pct(_kpiCompleted) od ukupno</div>
        </div>
    </div>
</div>

@* ── Filter traka ─────────────────────────────────────────────────────────── *@
<div class="card" style="padding:16px 20px; margin-bottom:12px;">
    <div class="filter-row">

        @* Pretraga — širi stupac, spacer visina labele umjesto labele *@
        <div class="filter-search">
            <MudTextField @bind-Value="_search"
                          Placeholder="Pretraga po naslovu, klijentu ili broju narudžbe..."
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Outlined.Search"
                          Variant="Variant.Outlined" Margin="Margin.Dense"
                          Immediate="true"
                          DebounceInterval="400"
                          OnDebounceIntervalElapsed="OnFilterChanged" />
        </div>

        @* Status *@
        <AppFormField Label="Status">
            <MudSelect T="string?"
                       Value="_statusFilter"
                       ValueChanged="@(async (string? v) => { _statusFilter = v; await OnFilterChanged(); })"
                       Placeholder="Svi statusi"
                       Variant="Variant.Outlined" Margin="Margin.Dense"
                       Clearable="true">
                <MudSelectItem Value="@("Draft")">Nacrt</MudSelectItem>
                <MudSelectItem Value="@("SubmittedBySales")">Poslana CA</MudSelectItem>
                <MudSelectItem Value="@("InProgress")">U obradi</MudSelectItem>
                <MudSelectItem Value="@("Completed")">Završena</MudSelectItem>
                <MudSelectItem Value="@("Cancelled")">Otkazana</MudSelectItem>
            </MudSelect>
        </AppFormField>

        @* Grad *@
        <AppFormField Label="Grad">
            <MudSelect T="string?"
                       Value="_cityFilter"
                       ValueChanged="@(async (string? v) => { _cityFilter = v; await OnFilterChanged(); })"
                       Placeholder="Svi gradovi"
                       Variant="Variant.Outlined" Margin="Margin.Dense"
                       Clearable="true">
                @foreach (var city in _cities)
                {
                    <MudSelectItem Value="@city.Name">@city.Name</MudSelectItem>
                }
            </MudSelect>
        </AppFormField>

        @* Tip procjene *@
        <AppFormField Label="Tip procjene">
            <MudSelect T="string?"
                       Value="_appraisalTypeFilter"
                       ValueChanged="@(async (string? v) => { _appraisalTypeFilter = v; await OnFilterChanged(); })"
                       Placeholder="Svi tipovi"
                       Variant="Variant.Outlined" Margin="Margin.Dense"
                       Clearable="true">
                <MudSelectItem Value="@("STAN")">Stan</MudSelectItem>
                <MudSelectItem Value="@("STAN_I_GARAZA")">Stan i garaža</MudSelectItem>
                <MudSelectItem Value="@("STAN_I_OSTAVA")">Stan i ostava</MudSelectItem>
                <MudSelectItem Value="@("STAN_GARAZA_I_OSTAVA")">Stan, garaža i ostava</MudSelectItem>
            </MudSelect>
        </AppFormField>

        @* Datum kreiranja — dva pikersa bez razdvojenog AppFormField *@
        <AppFormField Label="Kreirano od / do">
            <div class="filter-date-range">
                <MudDatePicker Date="_createdFrom" DateChanged="OnCreatedFromChanged"
                               Placeholder="Od" Variant="Variant.Outlined" Margin="Margin.Dense"
                               Clearable="true" DateFormat="dd.MM.yyyy" Culture="_bsCulture" />
                <span style="color:var(--text-muted); font-size:12px; flex-shrink:0;">–</span>
                <MudDatePicker Date="_createdTo" DateChanged="OnCreatedToChanged"
                               Placeholder="Do" MinDate="_createdFrom"
                               Variant="Variant.Outlined" Margin="Margin.Dense"
                               Clearable="true" DateFormat="dd.MM.yyyy" Culture="_bsCulture" />
            </div>
        </AppFormField>

    </div>

    @* Akcije ispod filtera *@
    <div class="filter-actions-row">
        <MudButton Variant="Variant.Text" Size="Size.Small"
                   StartIcon="@Icons.Material.Outlined.FilterList"
                   Style="text-transform:none; color:var(--text-secondary); font-weight:600; font-size:13px;"
                   OnClick="@(() => _advancedOpen = !_advancedOpen)">
            Više filtera
        </MudButton>
        @if (HasActiveFilters)
        {
            <MudButton Variant="Variant.Text" Size="Size.Small"
                       StartIcon="@Icons.Material.Outlined.FilterAltOff"
                       Style="text-transform:none; color:var(--rbi-blue); font-weight:600; font-size:13px;"
                       OnClick="ClearFilters">
                Resetuj filtere
            </MudButton>
        }
    </div>
</div>

@if (_savedFilters.Count > 0)
{
    <div class="saved-filter-bar">
        <span style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.6px;color:var(--text-muted);margin-right:4px;">
            Sačuvani filteri:
        </span>
        @foreach (var sf in _savedFilters)
        {
            <span class="saved-filter-chip @(sf.IsActive ? "active" : "")"
                  @onclick="@(() => ApplySavedFilter(sf))">
                @sf.Name
                <span class="chip-close" @onclick="@(() => RemoveSavedFilter(sf))" @onclick:stopPropagation="true">&times;</span>
            </span>
        }
    </div>
}

@* ── Loading ──────────────────────────────────────────────────────────────── *@
@if (_loading)
{
    <AppLoadingState />
}
else if (_loadError is not null)
{
    <AppErrorBanner Message="@_loadError" OnRetry="LoadOrders" />
}
else if (_orders.Count == 0)
{
    <AppEmptyState Title="@(HasActiveFilters ? "Nema narudžbi za odabrane filtere" : "Još nema narudžbi")">
        @if (_canCreate && !HasActiveFilters)
        {
            <div style="font-size:13.5px; color:var(--text-muted); margin-bottom:16px;">
                Kreirajte prvu narudžbu procjene nekretnine.
            </div>
            <button class="button-primary-rbi" @onclick='@(() => Nav.NavigateTo("/narudzbe/nova"))'>
                Nova narudžba
            </button>
        }
    </AppEmptyState>
}
else
{
    @* ── Tabela ────────────────────────────────────────────────────────────── *@
    <div class="app-table-wrap" style="overflow:auto;">
        <table class="app-table">
            <thead>
                <tr class="app-thead-row">
                    <th class="app-th" style="width:40px; text-align:center;">
                        <MudCheckBox T="bool" Dense="true" Color="Color.Warning"
                                     Value="_allSelected"
                                     ValueChanged="ToggleSelectAll"
                                     Style="margin:0;padding:0;" aria-label="Odaberi sve" />
                    </th>
                    <th class="app-th sortable" @onclick='@(() => SortByColumn("OrderNumber"))'>@SortableHeader("Broj narudžbe", "OrderNumber")</th>
                    <th class="app-th sortable" @onclick='@(() => SortByColumn("Title"))'>@SortableHeader("Naslov", "Title")</th>
                    <th class="app-th">Klijent</th>
                    <th class="app-th">Tip procjene</th>
                    <th class="app-th sortable" @onclick='@(() => SortByColumn("Status"))'>@SortableHeader("Status", "Status")</th>
                    <th class="app-th sortable" @onclick='@(() => SortByColumn("City"))'>@SortableHeader("Grad", "City")</th>
                    <th class="app-th">Poslovnica</th>
                    <th class="app-th sortable" @onclick='@(() => SortByColumn("CreatedAt"))'>@SortableHeader("Datum kreiranja", "CreatedAt")</th>
                    <th class="app-th right" style="width:48px;">Akcije</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var o in _orders)
                {
                    <tr class="app-tr clickable" tabindex="0"
                        @onclick="@(() => Nav.NavigateTo($"/narudzbe/{o.Id}"))"
                        @onkeydown="@(e => { if (e.Key is "Enter") Nav.NavigateTo($"/narudzbe/{o.Id}"); })"
                        aria-label="@($"Narudžba {o.OrderNumber}")">
                        <td class="app-td" style="width:40px; text-align:center;" @onclick:stopPropagation="true">
                            <MudCheckBox T="bool" Dense="true" Color="Color.Warning"
                                         Value="@_selectedIds.Contains(o.Id)"
                                         ValueChanged="@(v => ToggleSelect(o.Id, v))"
                                         Style="margin:0;padding:0;" />
                        </td>
                        <td class="app-td nowrap">
                            <a href="/narudzbe/@o.Id" style="color:var(--rbi-off-black); font-weight:700; text-decoration:none;"
                               onmouseover="this.style.color='#D4BF00'" onmouseout="this.style.color='var(--rbi-off-black)'"
                               @onclick:stopPropagation="true">@o.OrderNumber</a>
                        </td>
                        <td class="app-td ellipsis" style="max-width:260px;" title="@o.Title">@o.Title</td>
                        <td class="app-td ellipsis" style="max-width:140px;" title="@o.ClientName">@o.ClientName</td>
                        <td class="app-td nowrap">@o.AppraisalTypeLabel</td>
                        <td class="app-td nowrap">
                            <AppStatusBadge Label="@o.SimpleStatusLabel" ColorOverride="@o.SimpleStatusColor" />
                        </td>
                        <td class="app-td nowrap">@(o.City ?? "—")</td>
                        <td class="app-td nowrap">@(o.Branch ?? "—")</td>
                        <td class="app-td nowrap secondary">@o.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</td>
                        <td class="app-td right nowrap" @onclick:stopPropagation="true">
                            <MudMenu Icon="@Icons.Material.Outlined.MoreVert" Size="Size.Small"
                                     AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight"
                                     Dense="true">
                                <MudMenuItem Icon="@Icons.Material.Outlined.Visibility"
                                             OnClick="@(() => Nav.NavigateTo($"/narudzbe/{o.Id}"))">
                                    Detalji
                                </MudMenuItem>
                                <MudMenuItem Icon="@Icons.Material.Outlined.RemoveRedEye"
                                             OnClick="@(() => OpenQuickView(o))">
                                    Brzi pregled
                                </MudMenuItem>
                                @if (_canCreate)
                                {
                                    <MudMenuItem Icon="@Icons.Material.Outlined.ContentCopy"
                                                 OnClick="@(() => CloneOrder(o))">
                                        Kloniraj
                                    </MudMenuItem>
                                }
                                @if (o.Status == BlazorApp.Constants.OrderStatusDisplay.Draft)
                                {
                                    <MudDivider />
                                    <MudMenuItem Icon="@Icons.Material.Outlined.Send"
                                                 OnClick="@(() => SubmitOrder(o))">
                                        Pošalji
                                    </MudMenuItem>
                                    <MudMenuItem Icon="@Icons.Material.Outlined.Delete"
                                                 IconColor="Color.Error"
                                                 OnClick="@(() => CancelOrder(o))">
                                        Otkaži
                                    </MudMenuItem>
                                }
                            </MudMenu>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @* ── Paginacija ─────────────────────────────────────────────────────────── *@
    <div class="paging-bar">
        <span class="paging-summary">
            Ukupno <strong>@_totalCount</strong> narudžbi
        </span>
        <div class="paging-controls">
            <MudSelect T="int" Value="_pageSize" ValueChanged="OnPageSizeChanged"
                       Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"
                       Style="width:150px;">
                <MudSelectItem T="int" Value="10">10 po stranici</MudSelectItem>
                <MudSelectItem T="int" Value="20">20 po stranici</MudSelectItem>
                <MudSelectItem T="int" Value="50">50 po stranici</MudSelectItem>
            </MudSelect>
            <AppPagination Page="_page" TotalPages="_totalPages" TotalCount="0" OnPageChange="ChangePage" />
        </div>
    </div>

}

@* ── Quick View Panel ────────────────────────────────────────────────────── *@
@if (_quickViewOrder is not null)
{
    <div class="quick-view-overlay" @onclick="CloseQuickView"></div>
    <div class="quick-view-panel">
        <div class="quick-view-header">
            <div>
                <div class="quick-view-header-title">@_quickViewOrder.OrderNumber</div>
                <div style="font-size:12px;color:var(--text-muted);margin-top:2px;">Brzi pregled</div>
            </div>
            <MudIconButton Icon="@Icons.Material.Outlined.Close" Size="Size.Small"
                           OnClick="CloseQuickView" Style="color:var(--text-secondary);" />
        </div>
        <div class="quick-view-body">
            <div style="margin-bottom:16px;">
                <AppStatusBadge Label="@_quickViewOrder.SimpleStatusLabel" ColorOverride="@_quickViewOrder.SimpleStatusColor"
                                ExtraStyle="font-size:12px;" />
            </div>

            <div style="font-size:16px;font-weight:700;color:var(--rbi-off-black);margin-bottom:16px;line-height:1.4;">
                @_quickViewOrder.Title
            </div>

            <div class="detail-row"><span class="detail-label" style="width:140px;min-width:140px;">Klijent</span><span class="detail-value">@(_quickViewOrder.ClientName ?? "—")</span></div>
            <div class="detail-row"><span class="detail-label" style="width:140px;min-width:140px;">Tip procjene</span><span class="detail-value">@(_quickViewOrder.AppraisalTypeLabel ?? "—")</span></div>
            <div class="detail-row"><span class="detail-label" style="width:140px;min-width:140px;">Grad</span><span class="detail-value">@(_quickViewOrder.City ?? "—")</span></div>
            <div class="detail-row"><span class="detail-label" style="width:140px;min-width:140px;">Poslovnica</span><span class="detail-value">@(_quickViewOrder.Branch ?? "—")</span></div>
            <div class="detail-row"><span class="detail-label" style="width:140px;min-width:140px;">Kreirana</span><span class="detail-value">@_quickViewOrder.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span></div>
            <div class="detail-row"><span class="detail-label" style="width:140px;min-width:140px;">Zadnja izmjena</span><span class="detail-value">@((_quickViewOrder.UpdatedAt ?? _quickViewOrder.CreatedAt).ToLocalTime().ToString("dd.MM.yyyy HH:mm"))</span></div>
            @if (_quickViewOrder.CreatedByRole is not null)
            {
                <div class="detail-row"><span class="detail-label" style="width:140px;min-width:140px;">Kreirao</span><span class="detail-value">@_quickViewOrder.CreatedByRole</span></div>
            }
        </div>
        <div class="quick-view-footer">
            <MudButton Variant="Variant.Outlined" Size="Size.Small"
                       OnClick="CloseQuickView"
                       Style="color:var(--text-secondary);">
                Zatvori
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Warning" Size="Size.Small"
                       OnClick="@(() => Nav.NavigateTo($"/narudzbe/{_quickViewOrder.Id}"))"
                       Style="font-weight:700;color:var(--rbi-off-black);">
                Otvori detalje
            </MudButton>
        </div>
    </div>
}

@code {
    private static readonly System.Globalization.CultureInfo _bsCulture = new("bs-Latn-BA");

    [Parameter]
    [SupplyParameterFromQuery(Name = "status")]
    public string? StatusQuery { get; set; }

    private List<AppraisalOrderListItemDto> _orders = [];
    private List<CityDto> _cities = [];
    private bool   _loading;
    private bool   _accessDenied;
    private bool   _isCA;
    private bool   _canCreate;
    private string? _loadError;
    private DateTime? _lastRefresh;
    private string? _search;
    private string? _statusFilter;
    private string? _cityFilter;
    private string? _appraisalTypeFilter;
    private DateTime? _createdFrom;
    private DateTime? _createdTo;
    private string _sortBy   = "CreatedAt";
    private bool   _sortDesc = true;
    private int    _page       = 1;
    private int    _pageSize   = 10;
    private int    _totalCount;
    private int    _totalPages;
    private bool   _advancedOpen;
    private int    _kpiDraft;
    private int    _kpiSent;
    private int    _kpiInProgress;
    private int    _kpiCompleted;

    private string Pct(int count) => _totalCount > 0 ? $"{count * 100.0 / _totalCount:F1}%" : "0%";

    private bool _hasDateFilters => _createdFrom is not null || _createdTo is not null;

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(_search) || _statusFilter is not null || _cityFilter is not null ||
        _appraisalTypeFilter is not null || _createdFrom is not null || _createdTo is not null;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState.GetAuthenticationStateAsync();
        var user      = authState.User;

        if (!user.Identity?.IsAuthenticated ?? true)
        {
            Nav.NavigateTo("/login", replace: true);
            return;
        }

        var roles   = user.FindAll("roles").Select(c => c.Value).ToList();
        _isCA       = roles.Any(r => r.Equals(AppRoles.KolateralAdministrator, StringComparison.OrdinalIgnoreCase));
        _canCreate  = roles.Any(r => AppRoles.SalesRoles.Contains(r, StringComparer.OrdinalIgnoreCase));

        // Narudžbe vide sve workflow role (prodaja svoje, ostali zajednički red).
        var orderRoles = new[]
        {
            AppRoles.Administrator, AppRoles.KolateralAdministrator, AppRoles.KolateralOficir,
            AppRoles.Vjestak, AppRoles.PravnaSluzba, AppRoles.Protokol,
            AppRoles.Likvidatura, AppRoles.SpecijalniRacuni, AppRoles.Racunovodstvo
        };
        var hasAccess = _canCreate ||
                        roles.Any(r => orderRoles.Contains(r, StringComparer.OrdinalIgnoreCase));

        if (!hasAccess) { _accessDenied = true; return; }

        if (!string.IsNullOrWhiteSpace(StatusQuery))
            _statusFilter = StatusQuery;

        var citiesResult = await BranchApiService.GetCitiesAsync();
        if (citiesResult.IsSuccess && citiesResult.Data is not null)
            _cities = citiesResult.Data;

        await LoadOrders();
    }

    private async Task LoadOrders()
    {
        _loading   = true;
        _loadError = null;
        StateHasChanged();

        var result = await OrderService.GetListAsync(
            _page, _pageSize, _search, _statusFilter, _cityFilter, _appraisalTypeFilter,
            _createdFrom, _createdTo, _sortBy, _sortDesc);
        _loading   = false;

        if (result.IsSuccess && result.Data is not null)
        {
            _orders     = result.Data.Items.ToList();
            _totalCount = result.Data.TotalCount;
            _totalPages = result.Data.TotalPages;
            _lastRefresh = DateTime.UtcNow;

            if (_kpiDraft == 0 && _kpiSent == 0 && _kpiInProgress == 0 && _kpiCompleted == 0)
                _ = LoadKpiAsync();
        }
        else
        {
            _loadError = result.ErrorMessage ?? "Greška pri učitavanju narudžbi.";
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task OnFilterChanged()
    {
        _page = 1;
        _selectedIds.Clear();
        await LoadOrders();
    }

    // ── Bulk Select ─────────────────────────────────────────────────────────
    private HashSet<int> _selectedIds = [];
    private bool _allSelected => _orders.Count > 0 && _orders.All(o => _selectedIds.Contains(o.Id));

    private void ToggleSelect(int id, bool selected)
    {
        if (selected) _selectedIds.Add(id); else _selectedIds.Remove(id);
    }

    private void ToggleSelectAll(bool selectAll)
    {
        if (selectAll)
            foreach (var o in _orders) _selectedIds.Add(o.Id);
        else
            _selectedIds.Clear();
    }

    private async Task BulkCancelAsync()
    {
        if (_selectedIds.Count == 0) return;

        var dialog = await DialogService.ShowAsync<Components.Shared.ConfirmDialog>(
            "Otkazivanje odabranih narudžbi",
            new MudBlazor.DialogParameters
            {
                ["ContentText"] = $"<strong>{_selectedIds.Count}</strong> narudžbi će biti otkazano. Ova radnja se ne može poništiti.",
                ["ConfirmText"] = $"Otkaži {_selectedIds.Count} narudžbi",
                ["IsDanger"] = true
            });

        if (await dialog.Result is { Canceled: false })
        {
            var success = 0;
            var failed = 0;
            foreach (var id in _selectedIds.ToList())
            {
                var r = await OrderService.CancelAsync(id);
                if (r.IsSuccess) success++; else failed++;
            }

            _selectedIds.Clear();
            if (success > 0) Snackbar.Add($"Otkazano {success} narudžbi.", Severity.Warning);
            if (failed > 0) Snackbar.Add($"{failed} narudžbi nije moguće otkazati.", Severity.Error);
            await LoadOrders();
        }
    }

    private async Task OnCreatedFromChanged(DateTime? value)
    {
        _createdFrom = value.HasValue ? DateTime.SpecifyKind(value.Value, DateTimeKind.Utc) : null;
        if (_createdFrom.HasValue && _createdTo.HasValue && _createdTo < _createdFrom)
            _createdTo = null;
        await OnFilterChanged();
    }

    private async Task OnCreatedToChanged(DateTime? value)
    {
        if (value.HasValue && _createdFrom.HasValue && value < _createdFrom)
            return;
        _createdTo = value.HasValue ? DateTime.SpecifyKind(value.Value, DateTimeKind.Utc) : null;
        await OnFilterChanged();
    }

    private async Task ClearFilters()
    {
        _search              = null;
        _statusFilter        = null;
        _cityFilter          = null;
        _appraisalTypeFilter = null;
        _createdFrom         = null;
        _createdTo           = null;
        _advancedOpen        = false;
        await OnFilterChanged();
    }

    private async Task SortByColumn(string column)
    {
        if (_sortBy == column) _sortDesc = !_sortDesc;
        else { _sortBy = column; _sortDesc = true; }
        _page = 1;
        await LoadOrders();
    }

    private RenderFragment SortableHeader(string label, string column) => @<text>
        <span style="display:inline-flex; align-items:center; gap:4px;">
            @label
            @if (_sortBy == column)
            {
                <MudIcon Icon="@(_sortDesc ? Icons.Material.Filled.ArrowDownward : Icons.Material.Filled.ArrowUpward)" Style="font-size:13px;" />
            }
        </span>
    </text>;

    private async Task SubmitOrder(AppraisalOrderListItemDto order)
    {
        var dialog = await DialogService.ShowAsync<Components.Shared.ConfirmDialog>(
            "Pošaljite narudžbu",
            new MudBlazor.DialogParameters
            {
                ["ContentText"] = $"Narudžba '{order.OrderNumber}' će biti poslana CA-u na obradu. Nastaviti?",
                ["ConfirmText"] = "Pošalji"
            });

        if (await dialog.Result is { Canceled: false })
        {
            var r = await OrderService.SubmitAsync(order.Id);
            if (r.IsSuccess)
            {
                Snackbar.Add($"Narudžba {order.OrderNumber} je uspješno poslana.", Severity.Success);
                await LoadOrders();
            }
            else
            {
                Snackbar.Add(r.ErrorMessage ?? "Greška pri slanju narudžbe.", Severity.Error);
            }
        }
    }

    private async Task CancelOrder(AppraisalOrderListItemDto order)
    {
        var dialog = await DialogService.ShowAsync<Components.Shared.ConfirmDialog>(
            "Otkazivanje narudžbe",
            new MudBlazor.DialogParameters
            {
                ["ContentText"] = $"Narudžba '{order.OrderNumber}' će biti otkazana. Ova radnja se ne može poništiti.",
                ["ConfirmText"] = "Otkaži narudžbu",
                ["IsDanger"]    = true
            });

        if (await dialog.Result is { Canceled: false })
        {
            var r = await OrderService.CancelAsync(order.Id);
            if (r.IsSuccess)
            {
                Snackbar.Add("Narudžba je otkazana.", Severity.Warning);
                await LoadOrders();
            }
            else
            {
                Snackbar.Add(r.ErrorMessage ?? "Greška pri otkazivanju.", Severity.Error);
            }
        }
    }

    private async Task ChangePage(int newPage)
    {
        _page = newPage;
        await LoadOrders();
    }

    private async Task OnPageSizeChanged(int newSize)
    {
        _pageSize = newSize;
        _page = 1;
        await LoadOrders();
    }

    // ── Saved Filters ───────────────────────────────────────────────────────
    private sealed class SavedFilter
    {
        public string Name { get; set; } = "";
        public string? Status { get; set; }
        public string? City { get; set; }
        public string? AppraisalType { get; set; }
        public bool IsActive { get; set; }
    }

    private List<SavedFilter> _savedFilters = [];

    private void SaveCurrentFilter()
    {
        var parts = new List<string>();
        if (_statusFilter is not null) parts.Add(_statusFilter);
        if (_cityFilter is not null) parts.Add(_cityFilter);
        if (_appraisalTypeFilter is not null) parts.Add(_appraisalTypeFilter);
        var name = parts.Count > 0 ? string.Join(" + ", parts) : "Filter";

        if (_savedFilters.Any(f => f.Name == name)) return;

        _savedFilters.Add(new SavedFilter
        {
            Name = name,
            Status = _statusFilter,
            City = _cityFilter,
            AppraisalType = _appraisalTypeFilter,
        });
        Snackbar.Add($"Filter \"{name}\" sačuvan.", Severity.Success);
    }

    private async Task ApplySavedFilter(SavedFilter sf)
    {
        foreach (var f in _savedFilters) f.IsActive = false;
        sf.IsActive = true;
        _statusFilter = sf.Status;
        _cityFilter = sf.City;
        _appraisalTypeFilter = sf.AppraisalType;
        await OnFilterChanged();
    }

    private void RemoveSavedFilter(SavedFilter sf)
    {
        _savedFilters.Remove(sf);
        Snackbar.Add("Filter uklonjen.", Severity.Info);
    }

