    // ── Values Panel ──────────────────────────────────────────────────────────
    private async Task OpenValues(CbListItem cb)
    {
        _selectedCb      = cb;
        _valuesLoading   = true;
        _values          = [];
        _valuesSearch    = "";
        _showValuesPanel = true;

        try
        {
            var http = HttpFactory.CreateClient("BackendApi");
            var resp = await http.GetAsync($"/api/codebooks/{cb.Code}/values");
            if (resp.IsSuccessStatusCode)
            {
                var list = await resp.Content.ReadFromJsonAsync<List<CbValueItem>>(
                    new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                _values = list ?? [];
            }
        }
        catch { /* API not available */ }
        finally { _valuesLoading = false; }
    }

    private void CloseValuesPanel() { _showValuesPanel = false; _selectedCb = null; }

