    private void OpenEditValueDialog(CbValueItem v)
    {
        _valueDialogIsEdit  = true;
        _valueEditTarget    = v;
        _vCode              = v.Code;
        _vLabel             = v.Label;
        _vDescription       = v.Description ?? "";
        _vSortOrder         = v.SortOrder;
        _valueDialogError   = null;
        _valueDialogOpen    = true;
    }

    private async Task SaveValueAsync()
    {
        _valueDialogSaving = true;
        _valueDialogError  = null;

        try
        {
            var http = HttpFactory.CreateClient("BackendApi");
            System.Net.Http.HttpResponseMessage resp;

            if (!_valueDialogIsEdit)
            {
                var body = System.Text.Json.JsonSerializer.Serialize(new
                {
                    code        = _vCode.Trim().ToUpperInvariant(),
                    label       = _vLabel.Trim(),
                    description = string.IsNullOrWhiteSpace(_vDescription) ? null : _vDescription.Trim(),
                    sortOrder   = _vSortOrder
                });
                resp = await http.PostAsync(
                    $"/api/codebooks/{_selectedCb!.Code}/values",
                    new StringContent(body, System.Text.Encoding.UTF8, "application/json"));
            }
            else
            {
                var body = System.Text.Json.JsonSerializer.Serialize(new
                {
                    label       = _vLabel.Trim(),
                    description = string.IsNullOrWhiteSpace(_vDescription) ? null : _vDescription.Trim(),
                    sortOrder   = _vSortOrder
                });
                resp = await http.PutAsync(
                    $"/api/codebooks/{_selectedCb!.Code}/values/{_valueEditTarget!.Id}",
                    new StringContent(body, System.Text.Encoding.UTF8, "application/json"));
            }

            if (resp.IsSuccessStatusCode)
            {
                Snackbar.Add(_valueDialogIsEdit ? "Vrijednost ažurirana." : "Vrijednost dodana.", Severity.Success);
                _valueDialogOpen = false;
                await OpenValues(_selectedCb!);
            }
            else
            {
                var content = await resp.Content.ReadAsStringAsync();
                _valueDialogError = ParseErrorDetail(content) ?? "Greška pri snimanju.";
            }
        }
        catch (Exception ex) { _valueDialogError = ex.Message; }

        _valueDialogSaving = false;
    }

