@page "/admin/sifarnici"
@rendermode InteractiveServer
@inject IHttpClientFactory HttpFactory
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Upravljanje šifarnicima — Digitalizacija procjene nekretnina</PageTitle>

<!-- ═══════════════════ BREADCRUMB ═══════════════════ -->
<AppBreadcrumb Items="@(new List<AppBreadcrumb.BreadcrumbItem> { new("Početna", "/"), new("Administracija", "/dashboard/admin"), new("Šifarnici", "") })" />

<!-- ═══════════════════ PAGE HEADER ═══════════════════ -->
<AppPageHeader Title="Upravljanje šifarnicima"
               Subtitle="Administracija referentnih šifarnika koji se koriste u formama i poslovnim procesima." />

<!-- ═══════════════════ TOOLBAR ═══════════════════ -->
<AppFilterBar Style="margin-bottom:16px;">

    <AppSearchInput Value="@_search"
                    Placeholder="Pretraži šifarnike..."
                    ContainerStyle="flex:1; min-width:200px; max-width:300px;"
                    OnDebounced="OnSearchDebounced" />

    <!-- Status filter -->
    <MudSelect T="bool?" Value="_filterActive" ValueChanged="OnFilterChanged"
               Variant="Variant.Outlined" Margin="Margin.Dense"
               Placeholder="Status: Svi" Style="min-width:140px;">
        <MudSelectItem Value="@((bool?)null)">Status: Svi</MudSelectItem>
        <MudSelectItem Value="@((bool?)true)">Aktivni</MudSelectItem>
        <MudSelectItem Value="@((bool?)false)">Neaktivni</MudSelectItem>
    </MudSelect>

    <!-- IsSystem filter -->
    <MudSelect T="bool?" Value="_filterSystem" ValueChanged="OnSystemFilterChanged"
               Variant="Variant.Outlined" Margin="Margin.Dense"
               Placeholder="Tip: Svi" Style="min-width:150px;">
        <MudSelectItem Value="@((bool?)null)">Tip: Svi</MudSelectItem>
        <MudSelectItem Value="@((bool?)true)">Sistemski</MudSelectItem>
        <MudSelectItem Value="@((bool?)false)">Prilagođeni</MudSelectItem>
    </MudSelect>

    <div style="flex:1;"></div>

    <!-- Import/Export -->
    <MudButton Variant="Variant.Outlined"
               StartIcon="@Icons.Material.Outlined.SwapVert"
               OnClick="@(() => _showImportExport = true)"
               Style="height:40px; text-transform:none; font-weight:600;">
        Import / Export
    </MudButton>

    <!-- Novi šifarnik -->
    <MudButton Variant="Variant.Filled" Class="btn-primary-rbi"
               StartIcon="@Icons.Material.Filled.Add"
               OnClick="OpenCreateDialog"
               Style="height:40px;">
        Novi šifarnik
    </MudButton>
</AppFilterBar>

<!-- ═══════════════════ AUDIT INFO BANNER ═══════════════════ -->
<MudAlert Severity="Severity.Info" Dense="true" Class="mb-4" Style="font-size:13px;">
    Sve izmjene šifarnika automatski se evidentiraju u audit log sistem.
    Sistemski šifarnici ne mogu biti obrisani — mogu biti deaktivirani.
</MudAlert>

<!-- ═══════════════════ TABLE ═══════════════════ -->
<div class="app-table-wrap" style="margin-bottom:20px;">

    @if (_loading)
    {
        <AppLoadingState />
    }
    else if (!_codebooks.Any())
    {
        <AppEmptyState Icon="@Icons.Material.Outlined.LibraryBooks" Title="Nema šifarnika">
            <div style="font-size:13px; color:#aaa; margin-top:6px;">
                Nema šifarnika koji odgovaraju odabranim filterima.
            </div>
        </AppEmptyState>
    }
    else
    {
        <table class="app-table">
            <thead>
                <tr class="app-thead-row">
                    <th class="app-th sortable" @onclick="@(() => ToggleSort("name"))">
                        <span style="display:inline-flex; align-items:center; gap:4px;">
                            Naziv šifarnika
                            <MudIcon Icon="@GetSortIcon("name")" Style="font-size:13px; color:#ccc;" />
                        </span>
                    </th>
                    <th class="app-th">Kategorija</th>
                    <th class="app-th">Opis</th>
                    <th class="app-th sortable" @onclick="@(() => ToggleSort("status"))">
                        <span style="display:inline-flex; align-items:center; gap:4px;">
                            Status
                            <MudIcon Icon="@GetSortIcon("status")" Style="font-size:13px; color:#ccc;" />
                        </span>
                    </th>
                    <th class="app-th center">Vrijednosti</th>
                    <th class="app-th sortable" @onclick="@(() => ToggleSort("updatedat"))">
                        <span style="display:inline-flex; align-items:center; gap:4px;">
                            Zadnja izmjena
                            <MudIcon Icon="@GetSortIcon("updatedat")" Style="font-size:13px; color:#ccc;" />
                        </span>
                    </th>
                    <th class="app-th right">Akcije</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var cb in _codebooks)
                {
                    <tr class="app-tr">
                        <td class="app-td">
                            <div class="app-td bold" style="padding:0;">
                                @cb.Name
                                @if (cb.IsSystem)
                                {
                                    <span class="badge badge-info" style="margin-left:6px; font-size:10px;">Sistemski</span>
                                }
                            </div>
                            <div class="mono" style="margin-top:2px; font-size:11px;">@cb.Code</div>
                        </td>
                        <td class="app-td">
                            @if (!string.IsNullOrWhiteSpace(cb.Category))
                            {
                                <div style="display:flex; align-items:center; gap:8px;">
                                    <div style="width:28px; height:28px; border-radius:6px;
                                                background:@GetCategoryBg(cb.Category);
                                                display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                                        <MudIcon Icon="@GetCategoryIcon(cb.Category)"
                                                 Style="@($"font-size:15px; color:{GetCategoryColor(cb.Category)};")" />
                                    </div>
                                    <span class="app-td muted" style="padding:0;">@cb.Category</span>
                                </div>
                            }
                            else
                            {
                                <span class="app-td secondary" style="padding:0;">—</span>
                            }
                        </td>
                        <td class="app-td ellipsis muted" title="@cb.Description">
                            @(cb.Description ?? "—")
                        </td>
                        <td class="app-td">
                            <span class="badge @(cb.IsActive ? "badge-active" : "badge-inactive")">
                                @(cb.IsActive ? "Aktivan" : "Neaktivan")
                            </span>
                        </td>
                        <td class="app-td center">
                            <div class="app-td bold" style="padding:0;">@cb.ValueCount</div>
                            <div class="app-td secondary" style="padding:0;">@cb.ActiveValueCount @BsPlural.AktivanF(cb.ActiveValueCount)</div>
                        </td>
                        <td class="app-td muted">
                            @(cb.UpdatedAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? cb.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm"))
                            @if (!string.IsNullOrWhiteSpace(cb.UpdatedByUserId))
                            {
                                <div class="app-td secondary" style="padding:0;">@cb.UpdatedByUserId</div>
                            }
                        </td>
                        <td class="app-td right">
                            <div style="display:flex; align-items:center; justify-content:flex-end; gap:2px;">
                                <button title="Prikaži vrijednosti" @onclick="@(() => OpenValues(cb))"
                                        class="tbl-action" style="color:var(--rbi-off-black);">
                                    <MudIcon Icon="@Icons.Material.Outlined.List" Style="font-size:16px;" />
                                </button>
                                <button title="Uredi" @onclick="@(() => OpenEditDialog(cb))"
                                        class="tbl-action">
                                    <MudIcon Icon="@Icons.Material.Outlined.Edit" Style="font-size:16px;" />
                                </button>
                                @if (!cb.IsSystem)
                                {
                                    @if (cb.IsActive)
                                    {
                                        <button title="Deaktiviraj" @onclick="@(() => ConfirmDeactivate(cb))"
                                                class="tbl-action" style="color:var(--rbi-coral-deep);">
                                            <MudIcon Icon="@Icons.Material.Outlined.ToggleOff" Style="font-size:16px;" />
                                        </button>
                                    }
                                    else
                                    {
                                        <button title="Aktiviraj" @onclick="@(() => ActivateAsync(cb))"
                                                class="tbl-action" style="color:var(--rbi-off-black);">
                                            <MudIcon Icon="@Icons.Material.Outlined.ToggleOn" Style="font-size:16px;" />
                                        </button>
                                    }
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div style="padding:0 16px;">
            <AppPagination Page="_page" TotalPages="_totalPages" TotalCount="_total" OnPageChange="ChangePage" />
        </div>
    }
</div>

<!-- ═══════════════════ BOTTOM INFO CARDS ═══════════════════ -->
<div class="cb-info-grid">
    <div class="cb-info-card">
        <div class="cb-info-icon" style="background:var(--rbi-yellow-1);">
            <MudIcon Icon="@Icons.Material.Outlined.Shield" Style="font-size:20px; color:var(--rbi-off-black);" />
        </div>
        <div class="cb-info-body">
            <div class="cb-info-title">Integritet podataka</div>
            <div class="cb-info-text">
                Sistemski šifarnici ne mogu biti obrisani. Deaktivacija ostaje jedina opcija — historija ostaje validna.
            </div>
        </div>
    </div>
    <div class="cb-info-card">
        <div class="cb-info-icon" style="background:var(--rbi-success-light);">
            <MudIcon Icon="@Icons.Material.Outlined.Sync" Style="font-size:20px; color:var(--rbi-off-black);" />
        </div>
        <div class="cb-info-body">
            <div class="cb-info-title">Automatska ažuriranja</div>
            <div class="cb-info-text">
                Izmjene šifarnika se reflektuju u svim formama i procesima bez promjene koda.
            </div>
        </div>
    </div>
    <div class="cb-info-card">
        <div class="cb-info-icon" style="background:#E8E4F8;">
            <MudIcon Icon="@Icons.Material.Outlined.Verified" Style="font-size:20px; color:var(--rbi-off-black);" />
        </div>
        <div class="cb-info-body">
            <div class="cb-info-title">Audit i usklađenost</div>
            <div class="cb-info-text">
                Sve izmjene evidentiraju se u centralnom audit log sistemu.
            </div>
        </div>
    </div>
</div>

@* Deactivate confirm — sada koristi ConfirmDialog via DialogService (bez inline modal-a) *@

<!-- ═══ CREATE / EDIT CODEBOOK DIALOG ═══ -->
@if (_cbDialogOpen)
{
    <div style="position:fixed; inset:0; background:rgba(43,45,51,0.4); z-index:1000;
                display:flex; align-items:center; justify-content:center; padding:24px;"
         @onkeydown="@(async (KeyboardEventArgs e) => { if (e.Key == "Escape") _cbDialogOpen = false; else if (e.Key == "Enter" && !_cbDialogSaving) await SaveCodebookAsync(); })"
         tabindex="-1">
        <div style="background:#fff; border-radius:12px; padding:32px; max-width:500px; width:100%;
                    box-shadow:0 8px 40px rgba(43,45,51,0.18);">
            <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:24px;">
                <div style="font-size:17px; font-weight:700; color:var(--rbi-off-black);">
                    @(_cbDialogIsEdit ? $"Uredi šifarnik — {_cbEditTarget?.Name}" : "Novi šifarnik")
                </div>
                <button @onclick="@(() => _cbDialogOpen = false)"
                        style="width:30px; height:30px; border:none; background:none; cursor:pointer;
                               border-radius:6px; font-size:18px; color:#777;">✕</button>
            </div>

            @if (!_cbDialogIsEdit)
            {
                <AppFormField Label="Kod šifarnika" Required="true"
                              HelperText="Jedinstven identifikator. Ne može se mijenjati. Koristiti mala slova i _ između riječi.">
                    <MudTextField @bind-Value="_cbCode"
                                  Placeholder="npr. tipovi_dokumenata"
                                  Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Style="width:100%;" />
                </AppFormField>
            }

            <AppFormField Label="Naziv šifarnika" Required="true">
                <MudTextField @bind-Value="_cbName"
                              Placeholder="npr. Tipovi dokumenata"
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              Style="width:100%;" />
            </AppFormField>

            <AppFormField Label="Opis">
                <MudTextField @bind-Value="_cbDescription"
                              Placeholder="Kratki opis namjene šifarnika"
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              Lines="2" Style="width:100%;" />
            </AppFormField>

            <AppFormField Label="Kategorija">
                <MudTextField @bind-Value="_cbCategory"
                              Placeholder="npr. Dokumenti, Lokacija, Narudžba"
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              Style="width:100%;" />
            </AppFormField>

            @if (!string.IsNullOrWhiteSpace(_cbDialogError))
            {
                <AppErrorBanner Message="@_cbDialogError" />
            }

            <div style="display:flex; gap:10px; justify-content:flex-end;">
                <button @onclick="@(() => _cbDialogOpen = false)"
                        style="padding:10px 20px; border:1px solid #E5DDD2; border-radius:8px;
                               background:#fff; font-size:14px; color:#555; cursor:pointer; font-weight:600;">
                    Odustani
                </button>
                <button @onclick="SaveCodebookAsync"
                        disabled="@(_cbDialogSaving)"
                        style="padding:10px 20px; border:none; border-radius:8px; background:#FEE600;
                               font-size:14px; color:var(--rbi-off-black); cursor:pointer; font-weight:700;">
                    @(_cbDialogSaving ? "Snimanje..." : (_cbDialogIsEdit ? "Spremi izmjene" : "Kreiraj šifarnik"))
                </button>
            </div>
        </div>
    </div>
}

<!-- ═══ VALUE CREATE/EDIT DIALOG ═══ -->
@if (_valueDialogOpen)
{
    <div style="position:fixed; inset:0; background:rgba(43,45,51,0.4); z-index:1000;
                display:flex; align-items:center; justify-content:center; padding:24px;"
         @onkeydown="@(async (KeyboardEventArgs e) => { if (e.Key == "Escape") _valueDialogOpen = false; else if (e.Key == "Enter" && IsValueFormValid && !_valueDialogSaving) await SaveValueAsync(); })"
         tabindex="-1">
        <div style="background:#fff; border-radius:12px; padding:32px; max-width:480px; width:100%;
                    box-shadow:0 8px 40px rgba(43,45,51,0.18);">
            <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:24px;">
                <div style="font-size:17px; font-weight:700; color:var(--rbi-off-black);">
                    @(_valueDialogIsEdit ? "Uredi vrijednost" : "Nova vrijednost")
                </div>
                <button @onclick="@(() => _valueDialogOpen = false)"
                        style="width:30px; height:30px; border:none; background:none; cursor:pointer;
                               border-radius:6px; font-size:18px; color:#777;">✕</button>
            </div>

            <AppFormField Label="Kod vrijednosti" Required="true"
                          HelperText="Jedinstven unutar šifarnika. Ne može se mijenjati.">
                <MudTextField @bind-Value="_vCode"
                              Placeholder="npr. ADMINISTRATOR"
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              Disabled="@_valueDialogIsEdit" Style="width:100%;" />
            </AppFormField>

            <AppFormField Label="Naziv / Labela" Required="true">
                <MudTextField @bind-Value="_vLabel"
                              Placeholder="npr. Administrator"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Style="width:100%;" />
            </AppFormField>

            <AppFormField Label="Opis">
                <MudTextField @bind-Value="_vDescription"
                              Placeholder="Kratki opis namjene vrijednosti"
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              Lines="2" Style="width:100%;" />
            </AppFormField>

            <AppFormField Label="Redoslijed prikaza"
                          HelperText="Manji broj = prikazuje se ranije. Koristiti razmake (10, 20, 30...) za fleksibilnost.">
                <MudNumericField @bind-Value="_vSortOrder"
                                 Variant="Variant.Outlined" Margin="Margin.Dense"
                                 Min="0" Style="width:100%;" />
            </AppFormField>

            @if (!string.IsNullOrWhiteSpace(_valueDialogError))
            {
                <AppErrorBanner Message="@_valueDialogError" />
            }

            <div style="display:flex; gap:10px; justify-content:flex-end;">
                <button @onclick="@(() => _valueDialogOpen = false)"
                        style="padding:10px 20px; border:1px solid #E5DDD2; border-radius:8px;
                               background:#fff; font-size:14px; color:#555; cursor:pointer; font-weight:600;">
                    Odustani
                </button>
                <button @onclick="SaveValueAsync"
                        disabled="@(!IsValueFormValid || _valueDialogSaving)"
                        style="padding:10px 20px; border:none; border-radius:8px;
                               background:@(IsValueFormValid && !_valueDialogSaving ? "#FEE600" : "#F8F6F2");
                               color:@(IsValueFormValid && !_valueDialogSaving ? "#2B2D33" : "#aaa");
                               font-size:14px; cursor:@(IsValueFormValid && !_valueDialogSaving ? "pointer" : "not-allowed");
                               font-weight:700;">
                    @(_valueDialogSaving ? "Snimanje..." : (_valueDialogIsEdit ? "Spremi izmjene" : "Dodaj vrijednost"))
                </button>
            </div>
        </div>
    </div>
}

<!-- ═══════════════════ VALUES DRAWER ═══════════════════ -->
@if (_showValuesPanel && _selectedCb is not null)
{
    <div style="position:fixed; inset:0; background:rgba(43,45,51,0.25); z-index:500;"
         @onclick="CloseValuesPanel"></div>

    <div style="position:fixed; top:0; right:0; bottom:0; width:520px; max-width:95vw;
                background:#fff; z-index:600; display:flex; flex-direction:column;
                box-shadow:-4px 0 32px rgba(43,45,51,0.14); overflow:hidden;">

        <div style="display:flex; align-items:center; justify-content:space-between;
                    padding:20px 24px; border-bottom:1px solid #F1EDE6; flex-shrink:0;">
            <div>
                <div style="font-size:16px; font-weight:700; color:var(--rbi-off-black); margin-bottom:2px;">
                    @_selectedCb.Name
                </div>
                <div style="font-size:12.5px; color:#777;">
                    @_selectedCb.Description &nbsp;·&nbsp;
                    <span style="font-family:monospace;">@_selectedCb.Code</span>
                </div>
            </div>
            <button @onclick="CloseValuesPanel"
                    style="width:32px; height:32px; border:none; background:none; cursor:pointer;
                           border-radius:6px; font-size:20px; color:#777;">✕</button>
        </div>

        <div style="padding:14px 24px; border-bottom:1px solid var(--rbi-warm-grey-50); display:flex; gap:10px; flex-shrink:0;">
            <div style="position:relative; flex:1;">
                <input type="text" @bind="_valuesSearch" @bind:event="oninput"
                       placeholder="Pretraži vrijednosti..."
                       style="width:100%; height:40px; padding:0 12px 0 36px;
                              border:1px solid #E5DDD2; border-radius:8px; font-size:13.5px;
                              font-family:'Inter',sans-serif; outline:none;" />
                <MudIcon Icon="@Icons.Material.Outlined.Search"
                         Style="position:absolute; left:10px; top:50%; transform:translateY(-50%); font-size:16px; color:#aaa;" />
            </div>
            <MudButton Variant="Variant.Filled" Class="btn-primary-rbi"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="OpenAddValueDialog"
                       Style="height:40px; white-space:nowrap;">
                Dodaj
            </MudButton>
        </div>

        <div style="flex:1; overflow-y:auto;">
            @if (_valuesLoading)
            {
                <div style="display:flex; flex-direction:column; align-items:center; padding:40px; gap:12px; color:#aaa;">
                    <MudProgressCircular Indeterminate="true" Color="Color.Warning" Size="Size.Small" />
                    <span style="font-size:13px;">Učitavanje vrijednosti...</span>
                </div>
            }
            else if (!FilteredValues.Any())
            {
                <div style="display:flex; flex-direction:column; align-items:center; padding:48px 24px; color:#ddd; text-align:center;">
                    <MudIcon Icon="@Icons.Material.Outlined.Inbox" Style="font-size:48px; margin-bottom:12px;" />
                    <div style="font-size:14px; color:#aaa;">
                        @(string.IsNullOrWhiteSpace(_valuesSearch) ? "Nema vrijednosti za ovaj šifarnik." : "Nema rezultata pretrage.")
                    </div>
                </div>
            }
            else
            {
                @foreach (var v in FilteredValues.OrderBy(x => x.SortOrder).ThenBy(x => x.Label))
                {
                    <div style="display:flex; align-items:center; gap:12px; padding:13px 24px;
                                border-bottom:1px solid var(--rbi-warm-grey-50); transition:background 0.1s;"
                         onmouseover="this.style.background='#FDFCF9'"
                         onmouseout="this.style.background='transparent'">

                        <div style="width:8px; height:8px; border-radius:50%; flex-shrink:0;
                                    background:@(v.IsActive ? "#67D0AB" : "#ddd");"></div>

                        <div style="flex:1; min-width:0;">
                            <div style="font-size:14px; font-weight:600; color:var(--rbi-off-black);">@v.Label</div>
                            <div style="font-size:12px; color:#aaa; margin-top:1px;">
                                <span style="font-family:monospace;">@v.Code</span>
                                @if (!string.IsNullOrWhiteSpace(v.Description))
                                { <span style="margin-left:8px;">· @v.Description</span> }
                                @if (v.IsSystem)
                                { <span class="badge badge-info" style="margin-left:8px; font-size:10px;">Sistemska</span> }
                            </div>
                        </div>

                        <span class="badge @(v.IsActive ? "badge-active" : "badge-inactive")" style="flex-shrink:0;">
                            @(v.IsActive ? "Aktivna" : "Neaktivna")
                        </span>

                        <div style="display:flex; gap:2px; flex-shrink:0;">
                            @if (!v.IsSystem)
                            {
                                @if (v.IsActive)
                                {
                                    <button title="Deaktiviraj" @onclick="@(() => DeactivateValue(v))"
                                            class="tbl-action" style="color:var(--rbi-coral-deep);">
                                        <MudIcon Icon="@Icons.Material.Outlined.PowerSettingsNew" Style="font-size:16px;" />
                                    </button>
                                }
                                else
                                {
                                    <button title="Aktiviraj" @onclick="@(() => ActivateValue(v))"
                                            class="tbl-action" style="color:var(--rbi-off-black);">
                                        <MudIcon Icon="@Icons.Material.Outlined.PowerSettingsNew" Style="font-size:16px;" />
                                    </button>
                                }
                            }
                            <button title="Uredi" class="tbl-action"
                                    @onclick="@(() => OpenEditValueDialog(v))">
                                <MudIcon Icon="@Icons.Material.Outlined.Edit" Style="font-size:16px;" />
                            </button>
                        </div>
                    </div>
                }
            }
        </div>

        <div style="padding:14px 24px; border-top:1px solid #F1EDE6; flex-shrink:0;
                    display:flex; align-items:center; justify-content:space-between;">
            <span style="font-size:12.5px; color:#aaa;">
                @FilteredValues.Count() vrijednosti · @FilteredValues.Count(v => v.IsActive) aktivnih
            </span>
            <span style="font-size:11.5px; color:#ccc; font-style:italic;">
                Sve izmjene se evidentiraju u audit logu.
            </span>
        </div>
    </div>
}

@if (_showImportExport)
{
    <ImportExportDialog OnClose="@(() => _showImportExport = false)" />
}

@code {

    // ── Codebook list state ───────────────────────────────────────────────────
    private bool _loading = true;
    private bool _showImportExport;
    private string _search = "";
    private bool? _filterActive;
    private bool? _filterSystem;
    private string _sortCol = "name";
    private bool _sortAsc = true;
    private int _page = 1, _pageSize = 20, _total, _totalPages = 1;
    private List<CbListItem> _codebooks = [];

    // ── Codebook create/edit dialog ───────────────────────────────────────────
