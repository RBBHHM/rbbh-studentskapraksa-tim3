    private async Task SaveCodebookAsync()
    {
        if (!_cbDialogIsEdit && string.IsNullOrWhiteSpace(_cbCode))
        { _cbDialogError = "Kod šifarnika je obavezan."; return; }
        if (string.IsNullOrWhiteSpace(_cbName))
        { _cbDialogError = "Naziv šifarnika je obavezan."; return; }

        _cbDialogSaving = true;
        _cbDialogError  = null;

        try
        {
            var http = HttpFactory.CreateClient("BackendApi");
            System.Net.Http.HttpResponseMessage resp;

            if (!_cbDialogIsEdit)
            {
                var body = System.Text.Json.JsonSerializer.Serialize(new
                {
                    code        = _cbCode.Trim(),
                    name        = _cbName.Trim(),
                    description = string.IsNullOrWhiteSpace(_cbDescription) ? null : _cbDescription.Trim(),
                    category    = string.IsNullOrWhiteSpace(_cbCategory) ? null : _cbCategory.Trim()
                });
                resp = await http.PostAsync("/api/admin/codebooks",
                    new StringContent(body, System.Text.Encoding.UTF8, "application/json"));
            }
            else
            {
                var body = System.Text.Json.JsonSerializer.Serialize(new
                {
                    name        = _cbName.Trim(),
                    description = string.IsNullOrWhiteSpace(_cbDescription) ? null : _cbDescription.Trim(),
                    category    = string.IsNullOrWhiteSpace(_cbCategory) ? null : _cbCategory.Trim()
                });
                resp = await http.PutAsync($"/api/admin/codebooks/{_cbEditTarget!.Code}",
                    new StringContent(body, System.Text.Encoding.UTF8, "application/json"));
            }

            if (resp.IsSuccessStatusCode)
            {
                Snackbar.Add(_cbDialogIsEdit ? "Šifarnik ažuriran." : "Šifarnik kreiran.", Severity.Success);
                _cbDialogOpen = false;
                await LoadAsync();
            }
            else
            {
                var content = await resp.Content.ReadAsStringAsync();
                _cbDialogError = ParseErrorDetail(content) ?? "Greška pri snimanju.";
            }
        }
        catch (Exception ex)
        {
            _cbDialogError = ex.Message;
        }
        _cbDialogSaving = false;
    }

    private void ConfirmDeactivate(CbListItem cb) => _ = ConfirmDeactivateDialog(cb);

    private async Task ConfirmDeactivateDialog(CbListItem cb)
    {
        var dialog = await DialogService.ShowAsync<ConfirmDialog>(
            "Deaktivacija šifarnika",
            new MudBlazor.DialogParameters
            {
                ["ContentText"] = $"Da li ste sigurni da želite deaktivirati šifarnik \"{cb.Name}\"? " +
                                  "Postojeće reference ostaju historijski validne. Akcija će biti evidentirana u audit logu.",
                ["ConfirmText"] = "Deaktiviraj",
                ["IsDanger"]    = true
            });

        if (await dialog.Result is { Canceled: false })
        {
            try
            {
                var http = HttpFactory.CreateClient("BackendApi");
                var resp = await http.PostAsync(
                    $"/api/admin/codebooks/{cb.Code}/deactivate",
                    new StringContent("{}", System.Text.Encoding.UTF8, "application/json"));

                if (resp.IsSuccessStatusCode)
                {
                    Snackbar.Add($"Šifarnik \"{cb.Name}\" deaktiviran.", Severity.Warning);
                    await LoadAsync();
                }
                else
                {
                    var content = await resp.Content.ReadAsStringAsync();
                    Snackbar.Add(ParseErrorDetail(content) ?? "Greška pri deaktivaciji.", Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }
    }

