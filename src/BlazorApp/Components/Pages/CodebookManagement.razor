    // ── Local record types ────────────────────────────────────────────────────
    private sealed record CbListItem(
        int Id, string Code, string Name, string? Description, string? Category,
        bool IsActive, bool IsSystem, int ValueCount, int ActiveValueCount,
        DateTime CreatedAt, DateTime? UpdatedAt, string? UpdatedByUserId);

    private sealed record CbValueItem(
        int Id, string Code, string Label, string? Description,
        int SortOrder, bool IsActive, bool IsSystem);

    private IEnumerable<CbValueItem> FilteredValues => string.IsNullOrWhiteSpace(_valuesSearch)
        ? _values
        : _values.Where(v => v.Code.Contains(_valuesSearch, StringComparison.OrdinalIgnoreCase)
                           || v.Label.Contains(_valuesSearch, StringComparison.OrdinalIgnoreCase));

    // ── Lifecycle ─────────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync() => await LoadAsync();

    // ── Search debounce (via AppSearchInput) ─────────────────────────────────
    private async Task OnSearchDebounced(string value)
    {
        _search = value;
        _page   = 1;
        await LoadAsync(silent: true);
    }

    // ── Load codebooks from API ───────────────────────────────────────────────
    private async Task LoadAsync(bool silent = false)
    {
        if (!silent) _loading = true;
        try
        {
            var http = HttpFactory.CreateClient("BackendApi");
            var url  = $"/api/admin/codebooks?page={_page}&pageSize={_pageSize}&sortBy={_sortCol}&sortAsc={_sortAsc}";

            if (!string.IsNullOrWhiteSpace(_search)) url += $"&search={Uri.EscapeDataString(_search)}";
            if (_filterActive.HasValue)  url += $"&isActive={_filterActive.Value.ToString().ToLower()}";
            if (_filterSystem.HasValue)  url += $"&isSystem={_filterSystem.Value.ToString().ToLower()}";

            var resp = await http.GetAsync(url);
            if (resp.IsSuccessStatusCode)
            {
                var result = await resp.Content.ReadFromJsonAsync<PagedResultDto<CbListItem>>(
                    new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });

                if (result is not null)
                {
                    _codebooks   = result.Items?.ToList() ?? [];
                    _total       = result.TotalCount;
                    _totalPages  = result.TotalPages > 0 ? result.TotalPages : 1;
                    if (_page > _totalPages) _page = _totalPages;
                }
            }
            else if (resp.StatusCode is System.Net.HttpStatusCode.Unauthorized
                                     or System.Net.HttpStatusCode.Forbidden)
            {
                Snackbar.Add("Nemate ovlaštenje za upravljanje šifarnicima.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Greška pri učitavanju šifarnika: {ex.Message}", Severity.Error);
        }
        if (!silent) _loading = false;
    }

    // ── Filter handlers ───────────────────────────────────────────────────────
    private async Task OnFilterChanged(bool? v)  { _filterActive = v; _page = 1; await LoadAsync(silent: true); }
    private async Task OnSystemFilterChanged(bool? v) { _filterSystem = v; _page = 1; await LoadAsync(); }

    // ── Sort ──────────────────────────────────────────────────────────────────
    private async Task ToggleSort(string col)
    {
        if (_sortCol == col) _sortAsc = !_sortAsc;
        else { _sortCol = col; _sortAsc = true; }
        _page = 1;
        await LoadAsync();
    }

    private string GetSortIcon(string col) => _sortCol == col
        ? (_sortAsc ? Icons.Material.Filled.ArrowUpward : Icons.Material.Filled.ArrowDownward)
        : Icons.Material.Filled.UnfoldMore;

