@page "/admin/upravljanje-rolama"
@rendermode InteractiveServer
@using BlazorApp.Models
@using BlazorApp.Services
@using System.Text
@inject UserRoleService UserRoleService
@inject RoleApiService RoleApiService
@inject AccessManagementService AccessSvc
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JS

<PageTitle>Upravljanje korisničkim rolama</PageTitle>

<!-- ── Breadcrumb ─────────────────────────────────────────────────── -->
<AppBreadcrumb Items="@(new List<AppBreadcrumb.BreadcrumbItem> { new("Početna", "/"), new("Administracija", "/dashboard/admin"), new("Upravljanje rolama", "") })" />

<!-- ── Page Header ────────────────────────────────────────────────── -->
<AppPageHeader Title="Upravljanje korisničkim rolama"
               Subtitle="Pregledajte korisnike, dodjeljujte ili mijenjajte role i upravljajte pristupom.">
    <Actions>
        <MudButton Variant="Variant.Outlined" Size="Size.Small"
                   StartIcon="@Icons.Material.Outlined.Download"
                   Disabled="_exportingUsers"
                   OnClick="ExportUsersToCsvAsync"
                   Style="height:36px; border-color:#E5DDD2; color:#6B7280; font-size:12px; white-space:nowrap;">
            @(_exportingUsers ? "Izvoz..." : "Export CSV")
        </MudButton>
    </Actions>
</AppPageHeader>

<!-- ── Metric Cards ───────────────────────────────────────────────── -->
<MudGrid Spacing="3" Style="margin-bottom:24px;">
    @foreach (var m in _metrics)
    {
        <MudItem xs="12" sm="6" md="3">
            <div style="background:#fff; border-radius:12px; padding:18px 20px;
                        box-shadow:var(--app-shadow); border:var(--app-border);
                        display:flex; align-items:center; gap:16px;">
                <div style="width:44px; height:44px; border-radius:8px;
                            background:@m.IconBg; display:flex; align-items:center;
                            justify-content:center; flex-shrink:0;">
                    <MudIcon Icon="@m.Icon" Style="@($"color:{m.IconColor}; font-size:22px;")" />
                </div>
                <div>
                    <div style="font-size:26px; font-weight:700; color:var(--rbi-off-black); line-height:1;">
                        @(_loading ? "–" : m.Value)
                    </div>
                    <div style="font-size:12.5px; color:var(--text-secondary); font-weight:500; margin-top:3px;">
                        @m.Label
                    </div>
                </div>
            </div>
        </MudItem>
    }
</MudGrid>

<!-- ── Filter Bar ─────────────────────────────────────────────── -->
<div class="card" style="padding:16px 20px; margin-bottom:0; border-bottom-left-radius:0; border-bottom-right-radius:0;">
    <AppFilterBar Style="padding-bottom:0; flex-wrap:wrap;">
        <MudTextField Value="_search"
                      ValueChanged="@((string? v) => OnSearchChangedAsync(v))"
                      Placeholder="Pretražite korisnike..."
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Immediate="true"
                      DebounceInterval="400"
                      Adornment="Adornment.End"
                      AdornmentIcon="@Icons.Material.Outlined.Search"
                      OnAdornmentClick="@(async () => { _page = 1; await LoadUsersAsync(silent: true); })"
                      Style="min-width:220px; max-width:300px; background:#fff;" />

        <MudSelect T="bool?" Value="_filterActive" ValueChanged="OnFilterActiveChanged"
                   Variant="Variant.Outlined" Margin="Margin.Dense"
                   Placeholder="Status"
                   Style="min-width:130px; background:#fff;">
            <MudSelectItem Value="@((bool?)null)">Svi korisnici</MudSelectItem>
            <MudSelectItem Value="@((bool?)true)">Aktivni</MudSelectItem>
            <MudSelectItem Value="@((bool?)false)">Neaktivni</MudSelectItem>
        </MudSelect>

        <MudSelect T="string" Value="_filterRole" ValueChanged="OnFilterRoleChanged"
                   Variant="Variant.Outlined" Margin="Margin.Dense"
                   Placeholder="Sve role"
                   Style="min-width:140px; background:#fff;">
            <MudSelectItem Value="@("")">Sve role</MudSelectItem>
            @foreach (var r in _availableRoles)
            {
                <MudSelectItem Value="@r.Name">@r.DisplayName</MudSelectItem>
            }
        </MudSelect>

        @if (!string.IsNullOrWhiteSpace(_search) || _filterActive.HasValue || !string.IsNullOrWhiteSpace(_filterRole))
        {
            <MudButton Variant="Variant.Text" Size="Size.Small"
                       Style="color:var(--text-muted); font-size:12px; min-width:0; text-transform:none; white-space:nowrap;"
                       StartIcon="@Icons.Material.Outlined.FilterAltOff"
                       OnClick="ResetFiltersAsync">
                Reset filtera
            </MudButton>
        }
    </AppFilterBar>
</div>

<!-- ── Table Card ────────────────────────────────────────────────── -->
<div class="card" style="padding:0; overflow:hidden; border-top:none; border-top-left-radius:0; border-top-right-radius:0;">

    @if (_loading)
    {
        <div class="loading-state">
            <MudProgressCircular Indeterminate="true" Color="Color.Warning" />
            <span class="text-muted text-sm">Učitavanje korisnika...</span>
        </div>
    }
    else if (_unauthorized)
    {
        <div style="padding:40px; text-align:center;">
            <MudIcon Icon="@Icons.Material.Outlined.Lock"
                     Style="font-size:48px; color:#E5E0D8; margin-bottom:12px;" />
            <div style="font-size:16px; font-weight:600; color:var(--text-secondary); margin-bottom:6px;">
                Pristup odbijen
            </div>
            <div style="font-size:14px; color:var(--text-muted);">
                Nemate ovlaštenje za upravljanje korisničkim rolama.
            </div>
        </div>
    }
    else if (_error is not null)
    {
        <div class="error-banner" style="margin:20px;">
            <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Style="flex-shrink:0;" />
            @_error
        </div>
    }
    else if (!_users.Any())
    {
        <div class="empty-state">
            <MudIcon Icon="@Icons.Material.Outlined.PeopleOutline" Class="empty-state-icon" />
            <div class="empty-state-title">Nema korisnika</div>
            <div class="empty-state-text">Nema korisnika koji odgovaraju pretrazi ili filteru.</div>
        </div>
    }
    else
    {
        <MudTable Items="_users" Hover="true" Dense="false" Elevation="0" Breakpoint="Breakpoint.Sm">
            <HeaderContent>
                <MudTh>Korisnik</MudTh>
                <MudTh>Email</MudTh>
                <MudTh>Trenutna rola</MudTh>
                <MudTh>Nova rola</MudTh>
                <MudTh>Status</MudTh>
                <MudTh Style="text-align:right;">Akcije</MudTh>
            </HeaderContent>
            <RowTemplate>
                <!-- Korisnik -->
                <MudTd DataLabel="Korisnik">
                    <div style="display:flex; align-items:center; gap:10px;">
                        <div style="width:34px; height:34px; border-radius:50%;
                                    background:@GetAvatarBg(context.Username);
                                    display:flex; align-items:center; justify-content:center;
                                    flex-shrink:0;">
                            <MudIcon Icon="@Icons.Material.Filled.Person" Style="color:#fff; font-size:18px;" />
                        </div>
                        <div>
                            <div style="font-size:14px; font-weight:600; color:var(--rbi-off-black);">
                                @(context.DisplayName ?? context.Username)
                            </div>
                            <div style="font-size:12px; color:var(--text-muted);">@context.Username</div>
                        </div>
                    </div>
                </MudTd>

                <!-- Email -->
                <MudTd DataLabel="Email">
                    <span style="font-size:13.5px; color:var(--text-secondary);">@context.Email</span>
                </MudTd>

                <!-- Trenutna rola -->
                <MudTd DataLabel="Trenutna rola">
                    <div style="display:flex; flex-wrap:wrap; gap:4px;">
                        @foreach (var r in context.Roles)
                        {
                            <span class="badge @GetRoleBadgeClass(r)">@r</span>
                        }
                        @if (!context.Roles.Any())
                        {
                            <span style="color:var(--rbi-coral-deep); font-size:13px; font-style:italic;">Bez role</span>
                        }
                    </div>
                </MudTd>

                <!-- Nova rola — dinamički iz API-ja -->
                <MudTd DataLabel="Nova rola">
                    @if (context.CanManageRoles)
                    {
                        <MudSelect T="string"
                                   Value="@GetSel(context.UserId)"
                                   ValueChanged="@(v => SetSel(context.UserId, v))"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Style="width:180px;">
                            @foreach (var role in _availableRoles.Where(r => r.IsActive))
                            {
                                <MudSelectItem Value="@role.Name">@role.DisplayName</MudSelectItem>
                            }
                        </MudSelect>
                    }
                    else
                    {
                        <span style="color:var(--text-muted); font-size:13px;">—</span>
                    }
                </MudTd>

                <!-- Status -->
                <MudTd DataLabel="Status">
                    <span class="badge @(context.IsActive ? "badge-active" : "badge-error")">
                        @(context.IsActive ? "Aktivan" : "Suspendovan")
                    </span>
                </MudTd>

                <!-- Akcije -->
                <MudTd DataLabel="Akcija" Style="text-align:right;">
                    <div style="display:flex; align-items:center; justify-content:flex-end; gap:2px;">
                        <!-- Spremi promjenu role -->
                        @if (context.CanManageRoles && HasChanged(context))
                        {
                            <MudIconButton Icon="@Icons.Material.Outlined.Save"
                                           Size="Size.Small"
                                           Style="color:var(--rbi-off-black);"
                                           aria-label="Sačuvaj promjenu role"
                                           Disabled="@(_updating == context.UserId)"
                                           OnClick="@(() => ConfirmUpdateAsync(context))" />
                            <MudIconButton Icon="@Icons.Material.Outlined.RestartAlt"
                                           Size="Size.Small"
                                           Style="color:var(--text-muted);"
                                           aria-label="Poništi"
                                           OnClick="@(() => ResetSel(context))" />
                        }
                        <!-- Dodaj rolu (bez zamjene) -->
                        @if (context.CanManageRoles)
                        {
                            <MudIconButton Icon="@Icons.Material.Outlined.PersonAdd"
                                           Size="Size.Small"
                                           Style="color:var(--rbi-off-black);"
                                           aria-label="Dodaj rolu"
                                           OnClick="@(() => OpenAddRoleDialog(context))" />
                        }
                        <!-- Suspenduj / Reaktiviraj -->
                        @if (context.IsActive)
                        {
                            <MudIconButton Icon="@Icons.Material.Outlined.PersonOff"
                                           Size="Size.Small"
                                           Style="color:var(--rbi-coral-deep);"
                                           aria-label="Suspenduj korisnika"
                                           Disabled="@(_suspending == context.UserId)"
                                           OnClick="@(() => ConfirmSuspendAsync(context))" />
                        }
                        else
                        {
                            <MudIconButton Icon="@Icons.Material.Outlined.HowToReg"
                                           Size="Size.Small"
                                           Style="color:var(--rbi-off-black);"
                                           aria-label="Reaktiviraj korisnika"
                                           Disabled="@(_suspending == context.UserId)"
                                           OnClick="@(() => ReactivateAsync(context))" />
                        }
                    </div>
                </MudTd>
            </RowTemplate>
        </MudTable>

        <!-- Paginacija -->
        <div style="display:flex; align-items:center; justify-content:space-between;
                    padding:14px 20px; border-top:1px solid #F8F6F2; flex-wrap:wrap; gap:10px;">
            <span style="font-size:13px; color:var(--text-secondary);">
                @_total @BsPlural.Korisnik(_total) — stranica @_page / @_totalPages
            </span>
            <div style="display:flex; align-items:center; gap:6px;">
                <span style="font-size:13px; color:var(--text-secondary); margin-right:4px;">Redova:</span>
                <MudSelect T="int" Value="_pageSize" ValueChanged="ChangePageSize"
                           Variant="Variant.Outlined" Margin="Margin.Dense" Style="width:70px;">
                    <MudSelectItem Value="10">10</MudSelectItem>
                    <MudSelectItem Value="20">20</MudSelectItem>
                    <MudSelectItem Value="50">50</MudSelectItem>
                </MudSelect>
                <MudIconButton Icon="@Icons.Material.Filled.NavigateBefore"
                               Size="Size.Small" Disabled="@(_page <= 1)"
                               OnClick="@(() => ChangePage(_page - 1))" />
                @for (int i = Math.Max(1, _page - 2); i <= Math.Min(_totalPages, _page + 2); i++)
                {
                    var pg = i;
                    <div style="width:32px; height:32px; border-radius:6px; display:flex;
                                align-items:center; justify-content:center; cursor:pointer;
                                background:@(pg == _page ? "#FEE600" : "transparent");
                                font-size:13px; font-weight:@(pg == _page ? "700" : "400");
                                color:var(--rbi-off-black);"
                         @onclick="@(() => ChangePage(pg))">
                        @pg
                    </div>
                }
                <MudIconButton Icon="@Icons.Material.Filled.NavigateNext"
                               Size="Size.Small" Disabled="@(_page >= _totalPages)"
                               OnClick="@(() => ChangePage(_page + 1))" />
            </div>
        </div>
    }
</div>

<!-- ── Add Role Dialog ─────────────────────────────────────────────── -->
<MudDialog Visible="_addRoleDialogOpen"
           VisibleChanged="@(v => _addRoleDialogOpen = v)"
           Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true })">
    <TitleContent>
        <MudText Typo="Typo.h6" Style="font-weight:700;">
            Upravljanje rolama — @(_addRoleTarget?.DisplayName ?? _addRoleTarget?.Username)
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (_addRoleTarget is not null)
        {
            <div style="margin-bottom:16px;">
                <div style="font-size:12px; color:#9CA3AF; font-weight:700; margin-bottom:8px;">
                    TRENUTNE ROLE
                </div>
                <div style="display:flex; flex-wrap:wrap; gap:6px;">
                    @foreach (var r in _addRoleTarget.Roles)
                    {
                        var roleName = r;
                        <div style="display:flex; align-items:center; gap:4px; background:#F8F6F2; border-radius:6px; padding:4px 8px;">
                            <span class="badge @GetRoleBadgeClass(roleName)" style="margin:0;">@roleName</span>
                            <MudIconButton Icon="@Icons.Material.Filled.Close"
                                           Size="Size.Small"
                                           Style="color:var(--rbi-coral-deep); width:20px; height:20px; padding:0;"
                                           Disabled="@(_revokingRole == roleName)"
                                           OnClick="@(() => RevokeRoleFromDialogAsync(roleName))"
                                           aria-label="Opozovi rolu" />
                        </div>
                    }
                    @if (!_addRoleTarget.Roles.Any())
                    {
                        <span style="font-style:italic; color:#9CA3AF;">Nema rola</span>
                    }
                </div>
            </div>
            <MudDivider Class="mb-3" />
        }
        <div style="font-size:12px; color:#9CA3AF; font-weight:700; margin-bottom:8px;">
            DODAJ NOVU ROLU
        </div>
        <MudSelect T="string" @bind-Value="_addRoleSelection" Label="Odaberi rolu"
                   Variant="Variant.Outlined">
            @foreach (var role in _availableRoles.Where(r => r.IsActive))
            {
                var alreadyHas = _addRoleTarget?.Roles.Contains(role.Name, StringComparer.OrdinalIgnoreCase) ?? false;
                if (!alreadyHas)
                {
                    <MudSelectItem Value="@role.Name">@role.DisplayName</MudSelectItem>
                }
            }
        </MudSelect>
        @if (!string.IsNullOrWhiteSpace(_addRoleError))
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">@_addRoleError</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _addRoleDialogOpen = false)"
                   Variant="Variant.Text" Style="color:var(--text-secondary);">Odustani</MudButton>
        <MudButton OnClick="SaveAddRoleAsync"
                   Disabled="@(string.IsNullOrWhiteSpace(_addRoleSelection) || _addRoleSaving)"
                   Variant="Variant.Filled" Class="btn-primary-rbi">
            @(_addRoleSaving ? "Dodjeljujem..." : "Dodaj rolu")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    // ── State ─────────────────────────────────────────────────────────────────
    private bool _loading = true, _unauthorized;
    private bool _exportingUsers;
    private string? _error, _updating, _suspending;
    private string _search = string.Empty;
    private bool? _filterActive;
    private string? _filterRole;
    private List<UserRoleListItemDto> _users = [];
    private List<RoleDefinitionListItemDto> _availableRoles = [];
    private Dictionary<string, string> _sel = [];
    private int _page = 1, _pageSize = 10, _total, _totalPages = 1;

    // Add/Manage Role Dialog
    private bool _addRoleDialogOpen;
    private bool _addRoleSaving;
    private string? _addRoleError;
    private string _addRoleSelection = string.Empty;
    private UserRoleListItemDto? _addRoleTarget;
    private string? _revokingRole;

    // Metric cards
    private record Metric(string Label, string Value, string Icon, string IconBg, string IconColor);
    private List<Metric> _metrics =
    [
        new("Ukupno korisnika",    "–", Icons.Material.Outlined.PeopleAlt,          "#FFF9D6", "#8A6500"),
        new("Aktivni korisnici",   "–", Icons.Material.Outlined.HowToReg,            "#E8F8F2", "#225B45"),
        new("Neaktivni korisnici", "–", Icons.Material.Outlined.PersonOff,           "#FFF0EC", "#C65C4A"),
        new("Administratori",      "–", Icons.Material.Outlined.AdminPanelSettings,  "#E8E4F8", "var(--rbi-off-black)"),
    ];

    // ── Lifecycle ─────────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadRolesAsync(), LoadUsersAsync(), LoadStatsAsync());
    }

    // ── Data Loading ──────────────────────────────────────────────────────────

    private async Task LoadRolesAsync()
    {
        var result = await AccessSvc.GetRolesAsync(isActive: true, pageSize: 100);
        if (result.IsSuccess && result.Data is not null)
            _availableRoles = result.Data.Items.ToList();
    }

    private async Task LoadUsersAsync(bool silent = false)
    {
        if (!silent) _loading = true;
        _error        = null;
        _unauthorized = false;

        var s = string.IsNullOrWhiteSpace(_search) ? null : _search.Trim();
        var r = string.IsNullOrWhiteSpace(_filterRole) ? null : _filterRole;

        var res = await UserRoleService.GetUsersAsync(
            search: s, role: r, isActive: _filterActive,
            page: _page, pageSize: _pageSize);

        if (res.StatusCode is 401 or 403)
        {
            _unauthorized = true;
        }
        else if (!res.IsSuccess)
        {
            _error = res.ErrorMessage ?? "Greška pri učitavanju korisnika.";
        }
        else if (res.Data is not null)
        {
            _users      = res.Data.Items.ToList();
            _total      = res.Data.TotalCount;
            _totalPages = Math.Max(1, res.Data.TotalPages);
            if (_page > _totalPages) _page = _totalPages;

            _sel = new();
            foreach (var u in _users)
                _sel.TryAdd(u.UserId, u.Roles.FirstOrDefault() ?? "");
        }
        if (!silent) _loading = false;
    }

    // ── Aggregate stats (4 parallel calls, page-filter-independent) ──────────

    private async Task LoadStatsAsync()
    {
        var tAll      = UserRoleService.GetUsersAsync(pageSize: 1);
        var tActive   = UserRoleService.GetUsersAsync(isActive: true,  pageSize: 1);
        var tInactive = UserRoleService.GetUsersAsync(isActive: false, pageSize: 1);
        var tAdmin    = UserRoleService.GetUsersAsync(role: AppRoles.Administrator, pageSize: 1);

        await Task.WhenAll(tAll, tActive, tInactive, tAdmin);

        var total    = tAll.Result.IsSuccess      ? tAll.Result.Data?.TotalCount      ?? 0 : 0;
        var active   = tActive.Result.IsSuccess   ? tActive.Result.Data?.TotalCount   ?? 0 : 0;
        var inactive = tInactive.Result.IsSuccess ? tInactive.Result.Data?.TotalCount ?? 0 : 0;
        var admins   = tAdmin.Result.IsSuccess    ? tAdmin.Result.Data?.TotalCount    ?? 0 : 0;

        _metrics =
        [
            new("Ukupno korisnika",    total.ToString(),    Icons.Material.Outlined.PeopleAlt,         "#FFF9D6", "#8A6500"),
            new("Aktivni korisnici",   active.ToString(),   Icons.Material.Outlined.HowToReg,           "#E8F8F2", "#225B45"),
            new("Neaktivni korisnici", inactive.ToString(), Icons.Material.Outlined.PersonOff,          "#FFF0EC", "#C65C4A"),
            new("Administratori",      admins.ToString(),   Icons.Material.Outlined.AdminPanelSettings, "#E8E4F8", "var(--rbi-off-black)"),
        ];
        StateHasChanged();
    }

    // ── Filter handlers ───────────────────────────────────────────────────────

    private async Task OnFilterActiveChanged(bool? value)
    {
        _filterActive = value;
        _page = 1;
        await LoadUsersAsync(silent: true);
    }

    private async Task OnFilterRoleChanged(string value)
    {
        _filterRole = value;
        _page = 1;
        await LoadUsersAsync(silent: true);
    }

    private async Task OnSearchChangedAsync(string? value)
    {
        _search = value ?? string.Empty;
        _page = 1;
        await LoadUsersAsync(silent: true);
    }

    private async Task ResetFiltersAsync()
    {
        _search       = string.Empty;
        _filterActive = null;
        _filterRole   = null;
        _page         = 1;
        await LoadUsersAsync(silent: true);
    }

    private async Task ChangePage(int p)     { _page = p;    await LoadUsersAsync(silent: true); }
    private async Task ChangePageSize(int s) { _pageSize = s; _page = 1; await LoadUsersAsync(silent: true); }

    // ── Role selection helpers ────────────────────────────────────────────────

    private string GetSel(string id) => _sel.GetValueOrDefault(id, "");
    private void SetSel(string id, string v) => _sel[id] = v;

    private void ResetSel(UserRoleListItemDto u)
        => _sel[u.UserId] = u.Roles.FirstOrDefault() ?? "";

    private bool HasChanged(UserRoleListItemDto u)
    {
        if (!_sel.TryGetValue(u.UserId, out var s) || string.IsNullOrWhiteSpace(s)) return false;
        return !u.Roles.Contains(s, StringComparer.OrdinalIgnoreCase);
    }

    // ── Replace Role (zamjena postojeće role novom) ───────────────────────────

    private async Task ConfirmUpdateAsync(UserRoleListItemDto user)
    {
        var newRole = _sel.GetValueOrDefault(user.UserId, "");
        if (string.IsNullOrWhiteSpace(newRole)) return;

        bool adminWarning = user.Roles.Contains(AppRoles.Administrator, StringComparer.OrdinalIgnoreCase)
                         && newRole != AppRoles.Administrator;

        var prms = new DialogParameters
        {
            ["ContentText"] = adminWarning
                ? $"<b>Pažnja:</b> Uklanjate administratorsku rolu korisniku <b>{user.DisplayName ?? user.Username}</b>.<br/><br/>Da li ste sigurni da želite promijeniti rolu u <b>{newRole}</b>?"
                : $"Promijeniti rolu korisnika <b>{user.DisplayName ?? user.Username}</b> u <b>{newRole}</b>?",
            ["ConfirmText"] = adminWarning ? "Ukloni admin rolu i primijeni" : "Primijeni",
            ["IsDanger"]    = adminWarning
        };
        var dlg = await DialogService.ShowAsync<ConfirmDialog>("Potvrda promjene role", prms,
            new DialogOptions { MaxWidth = MaxWidth.Small });
        var res = await dlg.Result;
        if (res is null || res.Canceled) return;

        await ReplaceRoleAsync(user, newRole);
    }

    private async Task ReplaceRoleAsync(UserRoleListItemDto user, string newRole)
    {
        _updating = user.UserId;
        StateHasChanged();
        try
        {
            // Ukloni sve stare role osim nove
            foreach (var old in user.Roles.ToList())
            {
                if (string.Equals(old, newRole, StringComparison.OrdinalIgnoreCase)) continue;
                var r = await RoleApiService.RemoveRoleAsync(user.UserId, old);
                if (!r.IsSuccess)
                {
                    Snackbar.Add($"Greška pri uklanjanju role '{old}': {r.ErrorMessage}", Severity.Error);
                    return;
                }
            }
            // Dodaj novu rolu ako je korisnik nema
            if (!user.Roles.Contains(newRole, StringComparer.OrdinalIgnoreCase))
            {
                var r = await RoleApiService.AssignRoleAsync(user.UserId, newRole);
                if (!r.IsSuccess)
                {
                    Snackbar.Add($"Greška pri dodjeli role '{newRole}': {r.ErrorMessage}", Severity.Error);
                    return;
                }
            }
            Snackbar.Add($"Rola korisnika {user.DisplayName ?? user.Username} promijenjena u {newRole}.", Severity.Success);
            Snackbar.Add(
                "Promjena role je uspješno sačuvana. Korisnik će novu rolu dobiti nakon osvježavanja sesije ili ponovne prijave.",
                Severity.Info, cfg => { cfg.VisibleStateDuration = 8000; });
            await Task.WhenAll(LoadUsersAsync(), LoadStatsAsync());
        }
        finally { _updating = null; }
    }

    // ── Add Role (dodavanje role bez zamjene) ─────────────────────────────────

    private void OpenAddRoleDialog(UserRoleListItemDto user)
    {
        _addRoleTarget     = user;
        _addRoleSelection  = string.Empty;
        _addRoleError      = null;
        _revokingRole      = null;
        _addRoleDialogOpen = true;
    }

    private async Task RevokeRoleFromDialogAsync(string roleName)
    {
        if (_addRoleTarget is null || _revokingRole is not null) return;
        _revokingRole = roleName;
        _addRoleError = null;
        StateHasChanged();

        var r = await RoleApiService.RemoveRoleAsync(_addRoleTarget.UserId, roleName);
        if (r.IsSuccess)
        {
            Snackbar.Add($"Rola '{roleName}' opozovana korisniku {_addRoleTarget.DisplayName ?? _addRoleTarget.Username}.", Severity.Success);
            // Osvježi listu korisnika i ažuriraj target unutar dijaloga
            await Task.WhenAll(LoadUsersAsync(silent: true), LoadStatsAsync());
            _addRoleTarget = _users.FirstOrDefault(u => u.UserId == _addRoleTarget.UserId) ?? _addRoleTarget;
        }
        else
        {
            _addRoleError = r.ErrorMessage ?? "Greška pri opozivanju role.";
        }
        _revokingRole = null;
        StateHasChanged();
    }

    private async Task SaveAddRoleAsync()
    {
        if (string.IsNullOrWhiteSpace(_addRoleSelection) || _addRoleTarget is null) return;

        _addRoleSaving = true;
        _addRoleError  = null;

        var r = await RoleApiService.AssignRoleAsync(_addRoleTarget.UserId, _addRoleSelection);
        if (r.IsSuccess)
        {
            Snackbar.Add($"Rola '{_addRoleSelection}' dodana korisniku {_addRoleTarget.DisplayName ?? _addRoleTarget.Username}.", Severity.Success);
            Snackbar.Add(
                "Promjena role je uspješno sačuvana. Korisnik će novu rolu dobiti nakon osvježavanja sesije ili ponovne prijave.",
                Severity.Info, cfg => { cfg.VisibleStateDuration = 8000; });
            _addRoleDialogOpen = false;
            await Task.WhenAll(LoadUsersAsync(), LoadStatsAsync());
        }
        else
        {
            _addRoleError = r.ErrorMessage ?? "Greška pri dodjeli role.";
        }
        _addRoleSaving = false;
    }

    // ── Suspend / Reactivate ──────────────────────────────────────────────────

    private async Task ConfirmSuspendAsync(UserRoleListItemDto user)
    {
        var prms = new DialogParameters
        {
            ["ContentText"] = $"Da li ste sigurni da želite <b>suspendovati</b> korisnika <b>{user.DisplayName ?? user.Username}</b>?<br/><br/>" +
                              "Korisnik neće moći pristupiti sistemu dok se nalog ne reaktivira.",
            ["ConfirmText"] = "Suspenduj",
            ["IsDanger"]    = true
        };
        var dlg = await DialogService.ShowAsync<ConfirmDialog>("Suspendovanje korisnika", prms,
            new DialogOptions { MaxWidth = MaxWidth.Small });
        var res = await dlg.Result;
        if (res is null || res.Canceled) return;

        await SuspendUserAsync(user);
    }

    private async Task SuspendUserAsync(UserRoleListItemDto user)
    {
        _suspending = user.UserId;
        StateHasChanged();
        try
        {
            var reason = "Suspendovano od administratora putem Role Management modula.";
            var result = await AccessSvc.SuspendUserAsync(user.UserId, reason);
            if (result.IsSuccess)
            {
                Snackbar.Add($"Korisnik {user.DisplayName ?? user.Username} je suspendovan.", Severity.Warning);
                await LoadUsersAsync();
            }
            else
            {
                Snackbar.Add(result.ErrorMessage ?? "Greška pri suspenziji.", Severity.Error);
            }
        }
        finally { _suspending = null; }
    }

    private async Task ReactivateAsync(UserRoleListItemDto user)
    {
        _suspending = user.UserId;
        StateHasChanged();
        try
        {
            var result = await AccessSvc.ReactivateUserAsync(user.UserId);
            if (result.IsSuccess)
            {
                Snackbar.Add($"Korisnik {user.DisplayName ?? user.Username} je reaktiviran.", Severity.Success);
                await LoadUsersAsync();
            }
            else
            {
                Snackbar.Add(result.ErrorMessage ?? "Greška pri reaktivaciji.", Severity.Error);
            }
        }
        finally { _suspending = null; }
    }

    // ── CSV Export ────────────────────────────────────────────────────────────

    private async Task ExportUsersToCsvAsync()
    {
        _exportingUsers = true;
        try
        {
            var s = string.IsNullOrWhiteSpace(_search) ? null : _search.Trim();
            var r = string.IsNullOrWhiteSpace(_filterRole) ? null : _filterRole;

            var result = await UserRoleService.GetUsersAsync(
                search: s, role: r, isActive: _filterActive,
                page: 1, pageSize: 2000);

            if (!result.IsSuccess || result.Data is null)
            {
                Snackbar.Add(result.ErrorMessage ?? "Greška pri dohvatu podataka za export.", Severity.Error);
                return;
            }

            var sb = new StringBuilder();
            sb.AppendLine("Korisnik,Korisničko ime,Email,Role,Status");

            foreach (var u in result.Data.Items)
            {
                sb.AppendLine(string.Join(",",
                    CsvCell(u.DisplayName ?? u.Username),
                    CsvCell(u.Username),
                    CsvCell(u.Email),
                    CsvCell(string.Join("; ", u.Roles)),
                    CsvCell(u.IsActive ? "Aktivan" : "Suspendovan")));
            }

            var filename = $"korisnici-{DateTime.Now:yyyyMMdd-HHmm}.csv";
            await JS.InvokeVoidAsync("downloadTextFile", filename, sb.ToString(), "text/csv");
            var cnt = result.Data.Items.Count;
            Snackbar.Add($"Izvezeno {cnt} {BsPlural.Korisnik(cnt)}.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Greška pri exportu: {ex.Message}", Severity.Error);
        }
        finally
        {
            _exportingUsers = false;
        }
    }

    private static string CsvCell(string? value)
    {
        if (string.IsNullOrEmpty(value)) return "\"\"";
        return $"\"{value.Replace("\"", "\"\"")}\"";
    }

    // ── UI Helpers ────────────────────────────────────────────────────────────

    private static string GetAvatarInitials(UserRoleListItemDto u)
    {
        var n = u.DisplayName ?? u.Username ?? "?";
        var parts = n.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2
            ? $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant()
            : n.Length > 0 ? n[..1].ToUpperInvariant() : "?";
    }

    private static readonly string[] _avatarColors =
        ["var(--rbi-off-black)", "#225B45", "var(--rbi-off-black)", "#92400E", "#C65C4A", "#2B2D33", "#225B45"];

    private static string GetAvatarBg(string? u)
    {
        if (string.IsNullOrEmpty(u)) return "#9B9590";
        return _avatarColors[Math.Abs(u.GetHashCode()) % _avatarColors.Length];
    }

    private static string GetRoleBadgeClass(string role) => role switch
    {
        AppRoles.Administrator => "badge role-admin",
        AppRoles.Unosnik       => "badge badge-info",
        AppRoles.Verifikator   => "badge badge-active",
        _                      => "badge badge-neutral"
    };
}
