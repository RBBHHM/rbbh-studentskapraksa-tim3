@page "/admin/pristup"
@rendermode InteractiveServer
@using BlazorApp.Services
@using BlazorApp.Models
@using System.Text
@inject AccessManagementService AccessSvc
@inject UserRoleService UserRoleService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JS

<PageTitle>Administracija pristupa — Digitalizacija procjene nekretnina</PageTitle>

<style>
    .audit-detail-card {
        background: #F8F6F2;
        border-radius: 8px;
        padding: 10px 14px;
    }
    .audit-detail-label {
        font-size: 10.5px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.6px;
        color: #9CA3AF;
        margin-bottom: 4px;
    }
</style>

<!-- Breadcrumb -->
<AppBreadcrumb Items="@(new List<AppBreadcrumb.BreadcrumbItem> { new("Početna", "/"), new("Administracija", "/dashboard/admin"), new("Pristup", "") })" />

<!-- Page header -->
<AppPageHeader Title="Administracija pristupa"
               Subtitle="Upravljanje korisnicima, rolama, dozvolama i audit logom sistema." />

<MudTabs Elevation="0"
         Rounded="false"
         ApplyEffectsToContainer="true"
         PanelClass="pt-4"
         @bind-ActivePanelIndex="_activeTab">

    <!-- ── Tab 1: Korisnici ────────────────────────────────────────────────── -->
    <MudTabPanel Text="Korisnici" Icon="@Icons.Material.Filled.People">
        @if (_loadingUsers)
        {
            <div class="loading-state"><MudProgressCircular Indeterminate="true" Color="Color.Warning" /></div>
        }
        else
        {
            <div class="enterprise-card">
                <div class="filter-bar">
                    <MudTextField Value="_userSearch"
                                  ValueChanged="@((string? v) => OnUserSearchChangedAsync(v))"
                                  Placeholder="Pretraži po imenu ili emailu..."
                                  Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Immediate="true"
                                  DebounceInterval="400"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  OnAdornmentClick="@(async () => { _userPage = 1; await LoadUsersAsync(silent: true); })"
                                  Style="max-width:320px;" />
                    <MudSpacer />
                    <MudText Typo="Typo.caption" Style="color:#9CA3AF; align-self:center;">
                        @_userTotalCount @BsPlural.Korisnik(_userTotalCount)
                    </MudText>
                </div>

                <MudTable Items="_users" Hover="true" Dense="false" Elevation="0" Loading="_loadingUsers">
                    <HeaderContent>
                        <MudTh>Korisnik</MudTh>
                        <MudTh>Email</MudTh>
                        <MudTh>Role</MudTh>
                        <MudTh>Status</MudTh>
                        <MudTh>Akcije</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>
                            <div class="d-flex align-center gap-2">
                                <MudAvatar Style="@("width:32px;height:32px;background:" + GetAvatarBg(context.Username) + ";color:#fff;")">
                                    <MudIcon Icon="@Icons.Material.Filled.Person" Style="font-size:17px;" />
                                </MudAvatar>
                                <div>
                                    <div style="font-weight:600;font-size:14px;">@(context.DisplayName ?? context.Username)</div>
                                    <div style="font-size:12px;color:#9CA3AF;">@context.Username</div>
                                </div>
                            </div>
                        </MudTd>
                        <MudTd>@context.Email</MudTd>
                        <MudTd>
                            @foreach (var role in context.Roles)
                            {
                                <MudChip T="string" Size="Size.Small" Class="@GetRoleChipClass(role)" Style="margin:2px;">@role</MudChip>
                            }
                        </MudTd>
                        <MudTd>
                            @if (context.IsActive)
                            { <span class="badge badge-active">Aktivan</span> }
                            else
                            { <span class="badge badge-inactive">Suspendovan</span> }
                        </MudTd>
                        <MudTd>
                            <div class="d-flex gap-1">
                                @if (context.IsActive)
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined"
                                               Class="btn-danger-outline" Style="font-size:12px;"
                                               OnClick="@(() => ConfirmSuspendAsync(context))">
                                        Suspenduj
                                    </MudButton>
                                }
                                else
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined"
                                               Style="color:var(--rbi-off-black);border-color:var(--rbi-off-black);font-size:12px;"
                                               OnClick="@(() => ReactivateUserAsync(context.UserId))">
                                        Reaktiviraj
                                    </MudButton>
                                }
                            </div>
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <div class="empty-state">
                            <MudIcon Icon="@Icons.Material.Filled.PeopleOutline"
                                     Style="font-size:48px;opacity:0.2;color:#9CA3AF;" />
                            <MudText Style="color:#9CA3AF;font-size:14px;margin-top:8px;">Nema korisnika.</MudText>
                        </div>
                    </NoRecordsContent>
                </MudTable>

                <div class="d-flex justify-space-between align-center mt-4 pt-4"
                     style="border-top:1px solid #F1EDE6;">
                    <MudText Typo="Typo.caption" Style="color:#9CA3AF;">Stranica @_userPage / @_userTotalPages</MudText>
                    <div class="d-flex gap-1">
                        <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft"
                                       Disabled="@(_userPage <= 1)" Size="Size.Small"
                                       OnClick="@(async () => { _userPage--; await LoadUsersAsync(silent: true); })" />
                        <MudText Style="padding:0 8px;">@_userPage</MudText>
                        <MudIconButton Icon="@Icons.Material.Filled.ChevronRight"
                                       Disabled="@(_userPage >= _userTotalPages)" Size="Size.Small"
                                       OnClick="@(async () => { _userPage++; await LoadUsersAsync(silent: true); })" />
                    </div>
                </div>
            </div>
        }
    </MudTabPanel>

    <!-- ── Tab 2: Role ─────────────────────────────────────────────────────── -->
    <MudTabPanel Text="Role" Icon="@Icons.Material.Filled.AdminPanelSettings">
        @if (_loadingRoles)
        {
            <div class="loading-state"><MudProgressCircular Indeterminate="true" Color="Color.Warning" /></div>
        }
        else
        {
            <div class="enterprise-card">
                <div class="d-flex align-center justify-space-between mb-4">
                    <MudText Typo="Typo.subtitle1" Style="font-weight:700;">Definicije rola</MudText>
                    <div class="d-flex gap-2">
                        <MudButton Variant="Variant.Outlined" Size="Size.Small"
                                   StartIcon="@Icons.Material.Outlined.Download"
                                   Disabled="_exportingRoles"
                                   OnClick="ExportRolesToCsvAsync"
                                   Style="height:36px; border-color:#E5DDD2; color:#6B7280; font-size:12px;">
                            @(_exportingRoles ? "Izvoz..." : "Export CSV")
                        </MudButton>
                        <MudButton Variant="Variant.Filled" Class="btn-primary-rbi"
                                   StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="OpenCreateRoleDialog">
                            Nova rola
                        </MudButton>
                    </div>
                </div>

                <MudTable Items="_roles" Hover="true" Dense="false" Elevation="0">
                    <HeaderContent>
                        <MudTh>Naziv</MudTh>
                        <MudTh>Prikazni naziv</MudTh>
                        <MudTh>Tip</MudTh>
                        <MudTh>Status</MudTh>
                        <MudTh>Dozvole</MudTh>
                        <MudTh>Akcije</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>
                            <MudText style="font-family:monospace;font-size:13px;background:#F8F6F2;padding:2px 8px;border-radius:4px;">
                                @context.Name
                            </MudText>
                        </MudTd>
                        <MudTd>
                            <div style="font-weight:600;">@context.DisplayName</div>
                            @if (!string.IsNullOrWhiteSpace(context.Description))
                            {
                                <div style="font-size:12px;color:#9CA3AF;">@context.Description</div>
                            }
                        </MudTd>
                        <MudTd>
                            @if (context.IsSystem)
                            { <span class="badge badge-info">Sistemska</span> }
                            else
                            { <span style="font-size:12px;color:#6B7280;">Custom</span> }
                        </MudTd>
                        <MudTd>
                            @if (context.IsActive)
                            { <span class="badge badge-active">Aktivna</span> }
                            else
                            { <span class="badge badge-inactive">Neaktivna</span> }
                        </MudTd>
                        <MudTd>
                            <MudChip T="string" Size="Size.Small"
                                     Style="background:#F8F6F2;color:var(--rbi-off-black);">
                                @context.PermissionCount doz.
                            </MudChip>
                        </MudTd>
                        <MudTd>
                            <div class="d-flex gap-1">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                               Size="Size.Small" Style="color:#6B7280;"
                                               OnClick="@(() => OpenEditRoleDialog(context))"
                                               aria-label="Uredi" />
                                <MudIconButton Icon="@Icons.Material.Filled.Key"
                                               Size="Size.Small" Style="color:#1E40AF;"
                                               OnClick="@(() => OpenPermissionsDialog(context))"
                                               aria-label="Dozvole" />
                                @if (!context.IsSystem)
                                {
                                    @if (context.IsActive)
                                    {
                                        <MudIconButton Icon="@Icons.Material.Filled.ToggleOff"
                                                       Size="Size.Small" Style="color:#92400E;"
                                                       OnClick="@(() => DeactivateRoleAsync(context))"
                                                       aria-label="Deaktiviraj" />
                                    }
                                    else
                                    {
                                        <MudIconButton Icon="@Icons.Material.Filled.ToggleOn"
                                                       Size="Size.Small" Style="color:var(--rbi-off-black);"
                                                       OnClick="@(() => ActivateRoleAsync(context))"
                                                       aria-label="Aktiviraj" />
                                    }
                                    <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                                   Size="Size.Small" Style="color:var(--rbi-coral-deep);"
                                                   OnClick="@(() => ConfirmDeleteRoleAsync(context))"
                                                   aria-label="Obriši" />
                                }
                            </div>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </div>
        }
    </MudTabPanel>

    <!-- ── Tab 3: Dozvole ───────────────────────────────────────────────── -->
    <MudTabPanel Text="Dozvole" Icon="@Icons.Material.Filled.Security">
@if (_loadingPerms)
        {
            <div class="loading-state"><MudProgressCircular Indeterminate="true" Color="Color.Warning" /></div>
        }
        else
        {
            <div class="enterprise-card">
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-4" Style="font-size:13px;">
                    Katalog dozvola je read-only. Nove dozvole se dodaju kroz razvojni proces (migracija/seed),
                    jer moraju odgovarati stvarnoj backend akciji.
                </MudAlert>

                @foreach (var module in _permissions.GroupBy(p => p.Module).OrderBy(g => g.Key))
                {
                    <div style="margin-bottom:20px;">
                        <MudText Typo="Typo.subtitle2"
                                 Style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.8px;color:#9CA3AF;margin-bottom:8px;">
                            @module.Key
                        </MudText>
                        @foreach (var perm in module.OrderBy(p => p.DisplayName))
                        {
                            <div class="d-flex align-center gap-3 py-2"
                                 style="border-bottom:1px solid var(--rbi-warm-grey-50);">
                                <MudText style="font-family:monospace;font-size:12px;background:#F8F6F2;padding:2px 8px;border-radius:4px;min-width:200px;">
                                    @perm.Code
                                </MudText>
                                <div>
                                    <div style="font-size:14px;font-weight:500;">@perm.DisplayName</div>
                                    @if (!string.IsNullOrWhiteSpace(perm.Description))
                                    {
                                        <div style="font-size:12px;color:#9CA3AF;">@perm.Description</div>
                                    }
                                </div>
                                @if (!perm.IsActive)
                                {
                                    <MudChip T="string" Size="Size.Small"
                                             Style="background:#FEF3C7;color:#92400E;font-size:11px;">
                                        Neaktivan
                                    </MudChip>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </MudTabPanel>

    <!-- ── Tab 4: Audit ───────────────────────────────────────────────────── -->
    <MudTabPanel Text="Audit" Icon="@Icons.Material.Filled.History">
        @if (_loadingAudit)
        {
            <div class="loading-state"><MudProgressCircular Indeterminate="true" Color="Color.Warning" /></div>
        }
        else
        {
            <div class="enterprise-card">

                <!-- Filteri — red 1: Search + Modul + Status + Severity -->
                <div class="filter-bar mb-2">
                    <MudTextField Value="_auditSearch"
                                  ValueChanged="@((string? v) => OnAuditSearchChangedAsync(v))"
                                  Placeholder="Pretraži akciju, korisnika, entitet..."
                                  Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Immediate="true"
                                  DebounceInterval="400"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  OnAdornmentClick="@(async () => { _auditPage = 1; await LoadAuditAsync(silent: true); })"
                                  Style="min-width:260px;" Clearable="true" />

                    <MudSelect T="string" Value="_auditModule" Label="Modul"
                               ValueChanged="@(async (string v) => { _auditModule = v; _auditPage = 1; await LoadAuditAsync(); })"
                               Variant="Variant.Outlined" Margin="Margin.Dense"
                               Style="min-width:140px;" Clearable="true">
                        <MudSelectItem Value="@("Users")">Korisnici</MudSelectItem>
                        <MudSelectItem Value="@("Roles")">Role</MudSelectItem>
                        <MudSelectItem Value="@("Codebooks")">Šifarnici</MudSelectItem>
                        <MudSelectItem Value="@("Security")">Sigurnost</MudSelectItem>
                        <MudSelectItem Value="@("AppraisalOrders")">Narudžbe procjene</MudSelectItem>
                        <MudSelectItem Value="@("Documents")">Dokumenti</MudSelectItem>
                        <MudSelectItem Value="@("System")">Sistem</MudSelectItem>
                    </MudSelect>

                    <MudTextField Value="_auditActorUsername"
                                  ValueChanged="@(async (string v) => { _auditActorUsername = v; _auditPage = 1; await LoadAuditAsync(); })"
                                  Label="Korisnik" Placeholder="username"
                                  Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Immediate="true" DebounceInterval="400"
                                  Style="min-width:140px;" Clearable="true" />

                    <MudTextField Value="_auditActorRole"
                                  ValueChanged="@(async (string v) => { _auditActorRole = v; _auditPage = 1; await LoadAuditAsync(); })"
                                  Label="Rola" Placeholder="npr. AM, CA, Administrator"
                                  Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Immediate="true" DebounceInterval="400"
                                  Style="min-width:140px;" Clearable="true" />

                    <MudSelect T="string" Value="_auditStatus" Label="Status"
                               ValueChanged="@(async (string v) => { _auditStatus = v; _auditPage = 1; await LoadAuditAsync(); })"
                               Variant="Variant.Outlined" Margin="Margin.Dense"
                               Style="min-width:130px;" Clearable="true">
                        <MudSelectItem Value="@("Success")">Uspješno</MudSelectItem>
                        <MudSelectItem Value="@("Failed")">Neuspješno</MudSelectItem>
                        <MudSelectItem Value="@("Conflict")">Konflikt</MudSelectItem>
                        <MudSelectItem Value="@("Forbidden")">Zabranjeno</MudSelectItem>
                        <MudSelectItem Value="@("ValidationFailed")">Validacija</MudSelectItem>
                    </MudSelect>

                    <MudSelect T="string" Value="_auditSeverity" Label="Ozbiljnost"
                               ValueChanged="@(async (string v) => { _auditSeverity = v; _auditPage = 1; await LoadAuditAsync(); })"
                               Variant="Variant.Outlined" Margin="Margin.Dense"
                               Style="min-width:130px;" Clearable="true">
                        <MudSelectItem Value="@("Info")">Info</MudSelectItem>
                        <MudSelectItem Value="@("Warning")">Upozorenje</MudSelectItem>
                        <MudSelectItem Value="@("Security")">Sigurnost</MudSelectItem>
                        <MudSelectItem Value="@("Critical")">Kritično</MudSelectItem>
                    </MudSelect>
                </div>

                <!-- Filteri — red 2: Datum od/do + Dugmad -->
                <div class="filter-bar mb-4">
                    <MudDatePicker Date="_auditFrom"
                                   DateChanged="OnAuditFromChanged"
                                   Label="Datum od"
                                   Variant="Variant.Outlined" Margin="Margin.Dense"
                                   Style="min-width:160px;" Clearable="true"
                                   DateFormat="dd.MM.yyyy"
                                   Culture="_bsCulture" />

                    <MudDatePicker Date="_auditTo"
                                   DateChanged="OnAuditToChanged"
                                   Label="Datum do"
                                   MinDate="_auditFrom"
                                   Variant="Variant.Outlined" Margin="Margin.Dense"
                                   Style="min-width:160px;" Clearable="true"
                                   DateFormat="dd.MM.yyyy"
                                   Culture="_bsCulture"
                                   HelperText="@(_auditFrom.HasValue && _auditTo.HasValue && _auditTo < _auditFrom ? "Datum do ne može biti prije datum od" : null)"
                                   Error="@(_auditFrom.HasValue && _auditTo.HasValue && _auditTo < _auditFrom)" />

                    <MudButton Variant="Variant.Text" Style="color:#6B7280;height:40px;"
                               OnClick="ClearAuditFiltersAsync">
                        Očisti filtere
                    </MudButton>

                    <MudSpacer />
                    <MudText Typo="Typo.caption" Style="color:#9CA3AF;align-self:center;">
                        @_auditTotalCount @BsPlural.Zapis(_auditTotalCount)
                    </MudText>

                    <MudButton Variant="Variant.Outlined" Size="Size.Small"
                               StartIcon="@Icons.Material.Outlined.Download"
                               Disabled="_exportingAudit"
                               OnClick="ExportAuditToCsvAsync"
                               Style="height:36px; border-color:#E5DDD2; color:#6B7280; font-size:12px; white-space:nowrap;">
                        @(_exportingAudit ? "Izvoz..." : "Export CSV")
                    </MudButton>
                </div>

                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3" Style="font-size:12px;">
                    Audit log je <strong>read-only</strong>. Zapisi se ne mogu mijenjati ni brisati.
                    Kliknite na red za detalje (izmjene, IP, user agent).
                </MudAlert>

                <MudTable Items="_auditItems" Hover="true" Dense="true" Elevation="0"
                          OnRowClick="@((TableRowClickEventArgs<AuditLogItemDto> e) => { if (e.Item is not null) OpenAuditDetail(e.Item); })"
                          RowStyle="cursor:pointer;">
                    <HeaderContent>
                        <MudTh>Datum/Vrijeme</MudTh>
                        <MudTh>Korisnik</MudTh>
                        <MudTh>Akcija</MudTh>
                        <MudTh>Modul</MudTh>
                        <MudTh>Entitet</MudTh>
                        <MudTh>Status</MudTh>
                        <MudTh>Ozbiljnost</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>
                            <div style="font-size:12px;font-family:monospace;">
                                @context.TimestampUtc.ToLocalTime().ToString("dd.MM.yy HH:mm:ss")
                            </div>
                        </MudTd>
                        <MudTd>
                            <div style="font-size:13px;font-weight:600;">
                                @(context.ActorFullName ?? context.ActorUsername ?? "sistem")
                            </div>
                            @if (!string.IsNullOrWhiteSpace(context.ActorFullName) && !string.IsNullOrWhiteSpace(context.ActorUsername))
                            {
                                <div style="font-size:10.5px;color:#9CA3AF;">@context.ActorUsername</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(context.ActiveRole ?? context.ActorRole))
                            {
                                <div style="font-size:11px;color:#9CA3AF;">@(context.ActiveRole ?? context.ActorRole)</div>
                            }
                        </MudTd>
                        <MudTd>
                            <span style="font-family:monospace;background:#F8F6F2;padding:2px 6px;
                                         border-radius:4px;font-size:10px;word-break:break-all;">
                                @context.Action
                            </span>
                        </MudTd>
                        <MudTd>
                            <MudText Typo="Typo.caption" Style="color:#6B7280;">@context.Module</MudText>
                        </MudTd>
                        <MudTd>
                            <div style="font-size:13px;">@(context.EntityDisplayName ?? context.EntityKey ?? "-")</div>
                            @if (!string.IsNullOrWhiteSpace(context.EntityType))
                            {
                                <div style="font-size:11px;color:#9CA3AF;">@context.EntityType</div>
                            }
                        </MudTd>
                        <MudTd>
                            @{ var (cls, lbl) = GetStatusBadge(context.Status); }
                            <span class="@cls" style="font-size:11px;">@lbl</span>
                        </MudTd>
                        <MudTd>
                            @{ var (scls, slbl) = GetSeverityBadge(context.Severity); }
                            <span class="@scls" style="font-size:11px;">@slbl</span>
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <div class="empty-state">
                            <MudIcon Icon="@Icons.Material.Filled.HistoryToggleOff"
                                     Style="font-size:48px;opacity:0.2;color:#9CA3AF;" />
                            <MudText Style="color:#9CA3AF;font-size:14px;margin-top:8px;">
                                Nema audit zapisa za odabrane filtere.
                            </MudText>
                        </div>
                    </NoRecordsContent>
                </MudTable>

                <!-- Paginacija -->
                <div class="d-flex justify-space-between align-center mt-4 pt-4"
                     style="border-top:1px solid #F1EDE6;">
                    <MudText Typo="Typo.caption" Style="color:#9CA3AF;">
                        Stranica @_auditPage / @_auditTotalPages
                    </MudText>
                    <div class="d-flex gap-1">
                        <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft"
                                       Disabled="@(_auditPage <= 1)" Size="Size.Small"
                                       OnClick="@(async () => { _auditPage--; await LoadAuditAsync(); })" />
                        <MudText Style="padding:0 8px;align-self:center;">@_auditPage</MudText>
                        <MudIconButton Icon="@Icons.Material.Filled.ChevronRight"
                                       Disabled="@(_auditPage >= _auditTotalPages)" Size="Size.Small"
                                       OnClick="@(async () => { _auditPage++; await LoadAuditAsync(); })" />
                    </div>
                </div>
            </div>
        }
    </MudTabPanel>
</MudTabs>

<!-- ── Audit Detail Dialog ────────────────────────────────────────────────── -->
<MudDialog Visible="_auditDetailOpen"
           VisibleChanged="@(v => _auditDetailOpen = v)"
           Options="@(new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true, CloseOnEscapeKey = true, Position = DialogPosition.Center })">
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Outlined.ManageSearch" Style="font-size:20px;" />
            <MudText Typo="Typo.h6" Style="font-weight:700;">Detalji audit zapisa</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        @if (_auditDetail is not null)
        {
            <div style="display:grid;gap:12px;">

                <!-- Ko / Kada -->
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
                    <div class="audit-detail-card">
                        <div class="audit-detail-label">Korisnik</div>
                        <div style="font-weight:700;">@(_auditDetail.ActorFullName ?? _auditDetail.ActorUsername ?? "sistem")</div>
                        @if (!string.IsNullOrWhiteSpace(_auditDetail.ActorFullName) && !string.IsNullOrWhiteSpace(_auditDetail.ActorUsername))
                        {
                            <div style="font-size:12px;color:#6B7280;">@_auditDetail.ActorUsername</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(_auditDetail.ActorEmail))
                        {
                            <div style="font-size:12px;color:#6B7280;">@_auditDetail.ActorEmail</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(_auditDetail.ActiveRole ?? _auditDetail.ActorRole))
                        {
                            <div style="font-size:11px;color:#9CA3AF;">
                                Aktivna rola: @(_auditDetail.ActiveRole ?? _auditDetail.ActorRole)
                            </div>
                        }
                    </div>
                    <div class="audit-detail-card">
                        <div class="audit-detail-label">Datum i vrijeme (UTC)</div>
                        <div style="font-family:monospace;font-size:13px;">
                            @_auditDetail.TimestampUtc.ToString("yyyy-MM-dd HH:mm:ss") UTC
                        </div>
                        <div style="font-size:12px;color:#6B7280;">
                            @_auditDetail.TimestampUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss") lok.
                        </div>
                    </div>
                </div>

                <!-- Akcija / Status / Ozbiljnost -->
                <div style="display:grid;grid-template-columns:2fr 1fr 1fr;gap:12px;">
                    <div class="audit-detail-card">
                        <div class="audit-detail-label">Akcija</div>
                        <span style="font-family:monospace;background:#F8F6F2;padding:3px 8px;border-radius:4px;font-size:12px;">
                            @_auditDetail.Action
                        </span>
                        <div style="font-size:12px;color:#6B7280;margin-top:4px;">@_auditDetail.OperationType</div>
                    </div>
                    <div class="audit-detail-card">
                        <div class="audit-detail-label">Status</div>
                        @{ var (scl, slb) = GetStatusBadge(_auditDetail.Status); }
                        <span class="@scl" style="font-size:12px;">@slb</span>
                    </div>
                    <div class="audit-detail-card">
                        <div class="audit-detail-label">Ozbiljnost</div>
                        @{ var (svl, svb) = GetSeverityBadge(_auditDetail.Severity); }
                        <span class="@svl" style="font-size:12px;">@svb</span>
                    </div>
                </div>

                <!-- Entitet / Modul -->
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
                    <div class="audit-detail-card">
                        <div class="audit-detail-label">Entitet</div>
                        <div style="font-weight:600;">@(_auditDetail.EntityDisplayName ?? _auditDetail.EntityKey ?? "-")</div>
                        <div style="font-size:12px;color:#6B7280;">@_auditDetail.EntityType / @_auditDetail.EntityKey</div>
                    </div>
                    <div class="audit-detail-card">
                        <div class="audit-detail-label">Modul</div>
                        <div>@_auditDetail.Module</div>
                        @if (!string.IsNullOrWhiteSpace(_auditDetail.CorrelationId))
                        {
                            <div style="font-size:10px;font-family:monospace;color:#9CA3AF;margin-top:4px;">
                                CID: @_auditDetail.CorrelationId
                            </div>
                        }
                    </div>
                </div>

                <!-- Razlog -->
                @if (!string.IsNullOrWhiteSpace(_auditDetail.Reason))
                {
                    <div class="audit-detail-card">
                        <div class="audit-detail-label">Razlog / Poruka</div>
                        <div style="font-size:13px;">@_auditDetail.Reason</div>
                    </div>
                }

                <!-- Stare vrijednosti -->
                @if (!string.IsNullOrWhiteSpace(_auditDetail.OldValuesJson))
                {
                    <div class="audit-detail-card">
                        <div class="audit-detail-label" style="color:var(--rbi-coral-deep);">Stare vrijednosti (prije promjene)</div>
                        <pre style="font-size:11px;font-family:monospace;background:#FFF0EC;padding:8px;border-radius:6px;overflow-x:auto;margin:0;">@_auditDetail.OldValuesJson</pre>
                    </div>
                }

                <!-- Nove vrijednosti -->
                @if (!string.IsNullOrWhiteSpace(_auditDetail.NewValuesJson))
                {
                    <div class="audit-detail-card">
                        <div class="audit-detail-label" style="color:var(--rbi-off-black);">Nove vrijednosti (nakon promjene)</div>
                        <pre style="font-size:11px;font-family:monospace;background:#ECFDF5;padding:8px;border-radius:6px;overflow-x:auto;margin:0;">@_auditDetail.NewValuesJson</pre>
                    </div>
                }

                <!-- Promijenjena polja -->
                @if (!string.IsNullOrWhiteSpace(_auditDetail.ChangedFieldsJson))
                {
                    <div class="audit-detail-card">
                        <div class="audit-detail-label">Promijenjena polja</div>
                        <div style="font-family:monospace;font-size:12px;">@_auditDetail.ChangedFieldsJson</div>
                    </div>
                }

                <!-- HTTP kontekst -->
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
                    @if (!string.IsNullOrWhiteSpace(_auditDetail.IpAddress))
                    {
                        <div class="audit-detail-card">
                            <div class="audit-detail-label">IP adresa</div>
                            <div style="font-family:monospace;font-size:12px;">@_auditDetail.IpAddress</div>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(_auditDetail.RequestPath))
                    {
                        <div class="audit-detail-card">
                            <div class="audit-detail-label">HTTP zahtjev</div>
                            <div style="font-family:monospace;font-size:12px;">@_auditDetail.RequestPath</div>
                        </div>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(_auditDetail.UserAgent))
                {
                    <div class="audit-detail-card">
                        <div class="audit-detail-label">User Agent</div>
                        <div style="font-size:11px;color:#6B7280;word-break:break-all;">@_auditDetail.UserAgent</div>
                    </div>
                }
            </div>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _auditDetailOpen = false)"
                   Variant="Variant.Filled" Class="btn-primary-rbi">
            Zatvori
        </MudButton>
    </DialogActions>
</MudDialog>

<!-- ── Create/Edit Role Dialog ────────────────────────────────────────────── -->
<MudDialog Visible="_roleDialogOpen"
           VisibleChanged="@(v => _roleDialogOpen = v)"
           Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true, CloseOnEscapeKey = true, Position = DialogPosition.Center })">
    <TitleContent>
        <MudText Typo="Typo.h6" Style="font-weight:700;">
            @(_editingRole == null ? "Nova rola" : "Uredi rolu")
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (_editingRole == null)
        {
            <MudTextField @bind-Value="_roleName" Label="Naziv (PascalCase, bez razmaka)"
                          Placeholder="NprMojaRola" Variant="Variant.Outlined" Class="mb-3"
                          HelperText="Mora odgovarati imenu u Keycloak-u. PascalCase, bez razmaka."
                          Immediate="true" />
        }
        <MudTextField @bind-Value="_roleDisplayName" Label="Prikazni naziv"
                      Variant="Variant.Outlined" Class="mb-3" Required="true" Immediate="true" />
        <MudTextField @bind-Value="_roleDescription" Label="Opis (opcionalno)"
                      Variant="Variant.Outlined" Lines="2" />
        @if (!string.IsNullOrWhiteSpace(_roleDialogError))
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mt-3" Style="font-size:13px;">
                @_roleDialogError
            </MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _roleDialogOpen = false)" Variant="Variant.Text" Style="color:#6B7280;">
            Odustani
        </MudButton>
        <MudButton OnClick="SaveRoleAsync" Disabled="_roleSaving"
                   Variant="Variant.Filled" Class="btn-primary-rbi">
            @(_roleSaving ? "Snimanje..." : (_editingRole == null ? "Kreiraj" : "Spremi"))
        </MudButton>
    </DialogActions>
</MudDialog>

<!-- ── Permissions Dialog ─────────────────────────────────────────────────── -->
<MudDialog Visible="_permDialogOpen"
           VisibleChanged="@(v => _permDialogOpen = v)"
           Options="@(new DialogOptions {
               MaxWidth       = MaxWidth.Medium,
               FullWidth      = true,
               CloseButton    = true,
               CloseOnEscapeKey = true,
               Position       = DialogPosition.Center
           })">
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.Key" Style="font-size:20px;color:var(--rbi-off-black);" />
            <MudText Typo="Typo.h6" Style="font-weight:700;">
                Dozvole: @_permDialogRole?.DisplayName
            </MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <div style="max-height:55vh; overflow-y:auto; padding-right:4px;">
            @if (_permDialogRole is not null)
            {
                @foreach (var module in _permissions.GroupBy(p => p.Module).OrderBy(g => g.Key))
                {
                    <div style="margin-bottom:16px;">
                        <div class="nav-section-header" style="padding:0;margin-bottom:6px;">@module.Key</div>
                        @foreach (var perm in module.OrderBy(p => p.DisplayName))
                        {
                            var hasIt = _permDialogRole.Permissions.Any(rp => rp.Id == perm.Id);
                            <div class="d-flex align-center justify-space-between py-1"
                                 style="border-bottom:1px solid var(--rbi-warm-grey-50);">
                                <div>
                                    <span style="font-family:monospace;font-size:11px;background:#F8F6F2;padding:1px 6px;border-radius:3px;">
                                        @perm.Code
                                    </span>
                                    <span style="margin-left:8px;font-size:13px;">@perm.DisplayName</span>
                                </div>
                                @if (!_permDialogRole.IsSystem)
                                {
                                    <MudSwitch T="bool" Value="hasIt"
                                               ValueChanged="@(v => TogglePermissionAsync(_permDialogRole.Id, perm.Id, v))"
                                               Color="Color.Warning"
                                               Disabled="@(_savingPerms.Contains(perm.Id))" />
                                }
                                else
                                {
                                    <MudIcon Icon="@(hasIt ? Icons.Material.Filled.Check : Icons.Material.Filled.Remove)"
                                             Style="@($"color:{(hasIt ? "#065F46" : "#D1D5DB")};font-size:18px;")" />
                                }
                            </div>
                        }
                    </div>
                }
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _permDialogOpen = false)" Variant="Variant.Filled"
                   Class="btn-primary-rbi">Zatvori</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private static readonly System.Globalization.CultureInfo _bsCulture =
        new("bs-Latn-BA");

    // ── Tab state ─────────────────────────────────────────────────────────────
    private int _activeTab;

    // ── Users tab ─────────────────────────────────────────────────────────────
    private bool _loadingUsers = true;
    private List<UserRoleListItemDto> _users = [];
    private string _userSearch = string.Empty;
    private int _userPage = 1, _userTotalCount, _userTotalPages = 1;
    private const int UserPageSize = 20;

    // ── Roles tab ─────────────────────────────────────────────────────────────
    private bool _loadingRoles = true;
    private List<RoleDefinitionListItemDto> _roles = [];

    // ── Permissions tab ───────────────────────────────────────────────────────
    private bool _loadingPerms = true;
    private List<PermissionDto> _permissions = [];

    // ── Audit tab ─────────────────────────────────────────────────────────────
    private bool _loadingAudit = true;
    private List<AuditLogItemDto> _auditItems = [];
    private string? _auditModule, _auditStatus, _auditSeverity, _auditSearch;
    private string? _auditActorUsername, _auditActorRole;
    private DateTime? _auditFrom, _auditTo;
    private int _auditPage = 1, _auditTotalCount, _auditTotalPages = 1;
    private const int AuditPageSize = 50;

    // ── Audit detail dialog ───────────────────────────────────────────────────
    private bool _auditDetailOpen;
    private AuditLogItemDto? _auditDetail;

    // ── Export state ──────────────────────────────────────────────────────────
    private bool _exportingAudit;
    private bool _exportingRoles;

    // ── Role dialog ───────────────────────────────────────────────────────────
    private bool _roleDialogOpen;
    private bool _roleSaving;
    private string? _roleDialogError;
    private RoleDefinitionListItemDto? _editingRole;
    private string _roleName = string.Empty;
    private string _roleDisplayName = string.Empty;
    private string? _roleDescription;

    // ── Permissions dialog ────────────────────────────────────────────────────
    private bool _permDialogOpen;
    private RoleDefinitionDto? _permDialogRole;
    private HashSet<int> _savingPerms = [];

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(
            LoadUsersAsync(),
            LoadRolesAsync(),
            LoadPermissionsAsync(),
            LoadAuditAsync());
    }

    // ── Users ─────────────────────────────────────────────────────────────────

    private async Task OnUserSearchChangedAsync(string? value)
    {
        _userSearch = value ?? string.Empty;
        _userPage = 1;
        await LoadUsersAsync(silent: true);
    }

    private async Task LoadUsersAsync(bool silent = false)
    {
        if (!silent) { _loadingUsers = true; _users = []; }
        var search = string.IsNullOrWhiteSpace(_userSearch) ? null : _userSearch.Trim();
        var result = await UserRoleService.GetUsersAsync(search: search, page: _userPage, pageSize: UserPageSize);
        if (result.IsSuccess && result.Data is not null)
        {
            _users          = result.Data.Items.ToList();
            _userTotalCount = result.Data.TotalCount;
            _userTotalPages = Math.Max(1, result.Data.TotalPages);
            if (_userPage > _userTotalPages) _userPage = _userTotalPages;
        }
        if (!silent) _loadingUsers = false;
    }

    private async Task ConfirmSuspendAsync(UserRoleListItemDto user)
    {
        var parameters = new DialogParameters
        {
            ["ContentText"] = $"Da li ste sigurni da želite <b>suspendovati</b> korisnika <b>{user.DisplayName ?? user.Username}</b>? " +
                              "Korisnik se neće moći prijaviti dok se nalog ne reaktivira.",
            ["ConfirmText"] = "Suspenduj",
            ["IsDanger"]    = true
        };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Potvrda suspenzije", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small });
        var result = await dialog.Result;
        if (result is null || result.Canceled) return;

        var reason  = "Suspendovano od administratora.";
        var apiResult = await AccessSvc.SuspendUserAsync(user.UserId, reason);
        if (apiResult.IsSuccess)
        {
            Snackbar.Add($"Korisnik {user.DisplayName ?? user.Username} je suspendovan.", Severity.Warning);
            await LoadUsersAsync();
        }
        else
            Snackbar.Add(apiResult.ErrorMessage ?? "Greška pri suspenziji.", Severity.Error);
    }

    private async Task ReactivateUserAsync(string userId)
    {
        var result = await AccessSvc.ReactivateUserAsync(userId);
        if (result.IsSuccess)
        {
            Snackbar.Add("Korisnik je reaktiviran.", Severity.Success);
            await LoadUsersAsync();
        }
        else
            Snackbar.Add(result.ErrorMessage ?? "Greška pri reaktivaciji.", Severity.Error);
    }

    // ── Roles ─────────────────────────────────────────────────────────────────

    private async Task LoadRolesAsync()
    {
        _loadingRoles = true;
        var result = await AccessSvc.GetRolesAsync(pageSize: 100);
        if (result.IsSuccess && result.Data is not null)
            _roles = result.Data.Items.ToList();
        _loadingRoles = false;
    }

    private void OpenCreateRoleDialog()
    {
        _editingRole      = null;
        _roleName         = string.Empty;
        _roleDisplayName  = string.Empty;
        _roleDescription  = null;
        _roleDialogError  = null;
        _roleDialogOpen   = true;
    }

    private void OpenEditRoleDialog(RoleDefinitionListItemDto role)
    {
        _editingRole     = role;
        _roleName        = role.Name;
        _roleDisplayName = role.DisplayName;
        _roleDescription = role.Description;
        _roleDialogError = null;
        _roleDialogOpen  = true;
    }

    private async Task SaveRoleAsync()
    {
        // Fail-fast validation
        if (string.IsNullOrWhiteSpace(_roleName) && _editingRole is null)
        { _roleDialogError = "Naziv role je obavezan."; return; }
        if (string.IsNullOrWhiteSpace(_roleDisplayName))
        { _roleDialogError = "Prikazni naziv je obavezan."; return; }

        _roleSaving = true;
        _roleDialogError = null;

        Result<RoleDefinitionDto> result;

        if (_editingRole is null)
        {
            result = await AccessSvc.CreateRoleAsync(
                new CreateRoleRequest(_roleName, _roleDisplayName, _roleDescription));
        }
        else
        {
            result = await AccessSvc.UpdateRoleAsync(
                _editingRole.Id, new UpdateRoleRequest(_roleDisplayName, _roleDescription));
        }

        if (result.IsSuccess)
        {
            Snackbar.Add(
                _editingRole is null ? "Rola je kreirana." : "Rola je ažurirana.",
                Severity.Success);
            _roleDialogOpen = false;
            await LoadRolesAsync();
        }
        else
            _roleDialogError = result.ErrorMessage ?? "Greška pri snimanju.";

        _roleSaving = false;
    }

    private async Task DeactivateRoleAsync(RoleDefinitionListItemDto role)
    {
        var result = await AccessSvc.DeactivateRoleAsync(role.Id);
        if (result.IsSuccess)
        {
            Snackbar.Add($"Rola '{role.DisplayName}' je deaktivirana.", Severity.Warning);
            await LoadRolesAsync();
        }
        else
            Snackbar.Add(result.ErrorMessage ?? "Greška pri deaktivaciji.", Severity.Error);
    }

    private async Task ActivateRoleAsync(RoleDefinitionListItemDto role)
    {
        var result = await AccessSvc.ActivateRoleAsync(role.Id);
        if (result.IsSuccess)
        {
            Snackbar.Add($"Rola '{role.DisplayName}' je aktivirana.", Severity.Success);
            await LoadRolesAsync();
        }
        else
            Snackbar.Add(result.ErrorMessage ?? "Greška pri aktivaciji.", Severity.Error);
    }

    private async Task ConfirmDeleteRoleAsync(RoleDefinitionListItemDto role)
    {
        var parameters = new DialogParameters
        {
            ["ContentText"] = $"Da li ste sigurni da želite <b>obrisati</b> rolu <b>{role.DisplayName}</b>?<br/><br/>" +
                              "Brisanje nije moguće ako rola ima aktivne korisnike. U tom slučaju možete je deaktivirati.",
            ["ConfirmText"] = "Obriši",
            ["IsDanger"]    = true
        };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Potvrda brisanja", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small });
        var r = await dialog.Result;
        if (r is null || r.Canceled) return;

        var result = await AccessSvc.DeleteRoleAsync(role.Id);
        if (result.IsSuccess)
        {
            Snackbar.Add($"Rola '{role.DisplayName}' je obrisana.", Severity.Success);
            await LoadRolesAsync();
        }
        else
            Snackbar.Add(result.ErrorMessage ?? "Greška pri brisanju.", Severity.Error);
    }

    // ── Permissions ───────────────────────────────────────────────────────────

    private async Task LoadPermissionsAsync()
    {
        _loadingPerms = true;
        var result = await AccessSvc.GetPermissionsAsync();
        if (result.IsSuccess && result.Data is not null)
            _permissions = result.Data.ToList();
        _loadingPerms = false;
    }

    private async Task OpenPermissionsDialog(RoleDefinitionListItemDto role)
    {
        var result = await AccessSvc.GetRoleByIdAsync(role.Id);
        if (result.IsSuccess && result.Data is not null)
        {
            _permDialogRole = result.Data;
            _savingPerms.Clear();
            _permDialogOpen = true;
        }
        else
            Snackbar.Add("Greška pri učitavanju dozvola.", Severity.Error);
    }

    private async Task TogglePermissionAsync(int roleId, int permId, bool add)
    {
        if (_savingPerms.Contains(permId)) return;
        _savingPerms.Add(permId);
        StateHasChanged();

        Result<RoleDefinitionDto> result;
        if (add)
            result = await AccessSvc.AddPermissionToRoleAsync(roleId, permId);
        else
            result = await AccessSvc.RemovePermissionFromRoleAsync(roleId, permId);

        _savingPerms.Remove(permId);

        if (result.IsSuccess && result.Data is not null)
            _permDialogRole = result.Data;
        else
            Snackbar.Add(result.ErrorMessage ?? "Greška.", Severity.Error);

        StateHasChanged();
    }

    // ── Audit ─────────────────────────────────────────────────────────────────

    private async Task OnAuditSearchChangedAsync(string? value)
    {
        _auditSearch = value;
        _auditPage = 1;
        await LoadAuditAsync(silent: true);
    }

    private async Task LoadAuditAsync(bool silent = false)
    {
        if (!silent) _loadingAudit = true;
        var result = await AccessSvc.GetAuditAsync(
            module:        _auditModule,
            status:        _auditStatus,
            severity:      _auditSeverity,
            search:        _auditSearch,
            actorUsername: _auditActorUsername,
            actorRole:     _auditActorRole,
            from:          _auditFrom,
            to:            _auditTo.HasValue ? _auditTo.Value.AddDays(1).AddSeconds(-1) : null,
            page:          _auditPage,
            pageSize:      AuditPageSize);

        if (result.IsSuccess && result.Data is not null)
        {
            _auditItems      = result.Data.Items.ToList();
            _auditTotalCount = result.Data.TotalCount;
            _auditTotalPages = Math.Max(1, result.Data.TotalPages);
        }
        if (!silent) _loadingAudit = false;
    }

    private async Task OnAuditFromChanged(DateTime? value)
    {
        _auditFrom = value.HasValue ? DateTime.SpecifyKind(value.Value, DateTimeKind.Utc) : null;
        if (_auditFrom.HasValue && _auditTo.HasValue && _auditTo < _auditFrom)
            _auditTo = null;
        if (_auditFrom.HasValue && !_auditTo.HasValue)
            _auditTo = _auditFrom;
        _auditPage = 1;
        await LoadAuditAsync(silent: true);
    }

    private async Task OnAuditToChanged(DateTime? value)
    {
        if (value.HasValue && _auditFrom.HasValue && value < _auditFrom)
            return;
        _auditTo = value.HasValue ? DateTime.SpecifyKind(value.Value, DateTimeKind.Utc) : null;
        _auditPage = 1;
        await LoadAuditAsync(silent: true);
    }

    private async Task ClearAuditFiltersAsync()
    {
        _auditModule        = null;
        _auditStatus        = null;
        _auditSeverity      = null;
        _auditSearch        = null;
        _auditActorUsername = null;
        _auditActorRole     = null;
        _auditFrom          = null;
        _auditTo            = null;
        _auditPage          = 1;
        await LoadAuditAsync();
    }

    private void OpenAuditDetail(AuditLogItemDto item)
    {
        _auditDetail     = item;
        _auditDetailOpen = true;
    }

    private async Task ExportAuditToCsvAsync()
    {
        _exportingAudit = true;
        try
        {
            // Dohvatamo max 5000 zapisa sa istim filterima kao trenutni prikaz
            var result = await AccessSvc.GetAuditAsync(
                module:        _auditModule,
                status:        _auditStatus,
                severity:      _auditSeverity,
                search:        _auditSearch,
                actorUsername: _auditActorUsername,
                actorRole:     _auditActorRole,
                from:          _auditFrom,
                to:            _auditTo.HasValue ? _auditTo.Value.AddDays(1).AddSeconds(-1) : null,
                page:          1,
                pageSize:      5000);

            if (!result.IsSuccess || result.Data is null)
            {
                Snackbar.Add(result.ErrorMessage ?? "Greška pri dohvatu podataka za export.", Severity.Error);
                return;
            }

            var sb = new StringBuilder();
            sb.AppendLine("Datum/Vrijeme (lok.),Datum/Vrijeme (UTC),Korisnik,Ime,Email,Rola,Aktivna rola,Akcija,Modul,Tip entiteta,Entitet,Status,Ozbiljnost,Razlog,IP adresa");

            foreach (var item in result.Data.Items)
            {
                sb.AppendLine(string.Join(",",
                    CsvCell(item.TimestampUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")),
                    CsvCell(item.TimestampUtc.ToString("yyyy-MM-dd HH:mm:ss")),
                    CsvCell(item.ActorUsername ?? "sistem"),
                    CsvCell(item.ActorFullName),
                    CsvCell(item.ActorEmail),
                    CsvCell(item.ActorRole),
                    CsvCell(item.ActiveRole),
                    CsvCell(item.Action),
                    CsvCell(item.Module),
                    CsvCell(item.EntityType),
                    CsvCell(item.EntityDisplayName ?? item.EntityKey),
                    CsvCell(item.Status),
                    CsvCell(item.Severity),
                    CsvCell(item.Reason),
                    CsvCell(item.IpAddress)));
            }

            var filename = $"audit-log-{DateTime.Now:yyyyMMdd-HHmm}.csv";
            await JS.InvokeVoidAsync("downloadTextFile", filename, sb.ToString(), "text/csv");
            var exportCnt = result.Data.Items.Count;
            Snackbar.Add($"Izvezeno {exportCnt} {BsPlural.Zapis(exportCnt)}.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Greška pri exportu: {ex.Message}", Severity.Error);
        }
        finally
        {
            _exportingAudit = false;
        }
    }

    private async Task ExportRolesToCsvAsync()
    {
        _exportingRoles = true;
        try
        {
            var result = await AccessSvc.GetRolesAsync(pageSize: 200);
            if (!result.IsSuccess || result.Data is null)
            {
                Snackbar.Add(result.ErrorMessage ?? "Greška pri dohvatu rola za export.", Severity.Error);
                return;
            }

            var sb = new StringBuilder();
            sb.AppendLine("Naziv (Code),Prikazni naziv,Opis,Tip,Status,Broj dozvola,Broj korisnika");

            foreach (var role in result.Data.Items)
            {
                sb.AppendLine(string.Join(",",
                    CsvCell(role.Name),
                    CsvCell(role.DisplayName),
                    CsvCell(role.Description),
                    CsvCell(role.IsSystem ? "Sistemska" : "Custom"),
                    CsvCell(role.IsActive ? "Aktivna" : "Neaktivna"),
                    role.PermissionCount.ToString(),
                    role.UserCount.ToString()));
            }

            var filename = $"role-{DateTime.Now:yyyyMMdd-HHmm}.csv";
            await JS.InvokeVoidAsync("downloadTextFile", filename, sb.ToString(), "text/csv");
            Snackbar.Add($"Exportovano {result.Data.Items.Count} rola.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Greška pri exportu: {ex.Message}", Severity.Error);
        }
        finally
        {
            _exportingRoles = false;
        }
    }

    private static string CsvCell(string? value)
    {
        if (string.IsNullOrEmpty(value)) return "\"\"";
        return $"\"{value.Replace("\"", "\"\"")}\"";
    }

    private static (string cssClass, string label) GetStatusBadge(string status) => status switch
    {
        "Success"          => ("badge badge-active",  "Uspješno"),
        "Failed"           => ("badge badge-error",   "Neuspješno"),
        "Forbidden"        => ("badge badge-warning", "Zabranjeno"),
        "Conflict"         => ("badge badge-warning", "Konflikt"),
        "ValidationFailed" => ("badge badge-neutral", "Validacija"),
        "SystemError"      => ("badge badge-error",   "Sistemska greška"),
        _                  => ("badge badge-neutral", status)
    };

    private static (string cssClass, string label) GetSeverityBadge(string severity) => severity switch
    {
        "Info"     => ("badge badge-info",    "Info"),
        "Warning"  => ("badge badge-warning", "Upozorenje"),
        "Security" => ("badge badge-info",    "Sigurnost"),
        "Critical" => ("badge badge-error",   "Kritično"),
        _          => ("badge badge-neutral", severity)
    };

    // ── Helpers ───────────────────────────────────────────────────────────────

    private static string GetRoleChipClass(string role) => role switch
    {
        AppRoles.Administrator => "role-chip-administrator",
        AppRoles.Unosnik       => "role-chip-unosnik",
        AppRoles.Verifikator   => "role-chip-verifikator",
        _                      => ""
    };

    private static readonly string[] _avatarColors =
        ["#1D4ED8", "#225B45", "var(--rbi-off-black)", "#92400E", "#C65C4A", "#0369A1", "#065F46"];

    private static string GetAvatarBg(string? u)
    {
        if (string.IsNullOrEmpty(u)) return "#9B9590";
        return _avatarColors[Math.Abs(u.GetHashCode()) % _avatarColors.Length];
    }
}

