@page "/obavjestenja"
@rendermode InteractiveServer
@attribute [Authorize]
@inject NotificationApiService NotifSvc
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>Obavještenja — Digitalizacija procjene nekretnina</PageTitle>

<AppPageHeader Title="Obavještenja"
               Subtitle="Vaš in-app inbox — narudžbe, zadaci, workflow promjene." />

@if (_loading)
{
    <AppLoadingState />
}
else if (_error is not null)
{
    <AppErrorBanner Message="@_error" OnRetry="LoadAsync" />
}
else
{
    <div style="max-width:800px;">

        @* ── Filter traka ─────────────────────────────────────────────── *@
        <div style="display:flex; gap:12px; align-items:center; margin-bottom:16px;">
            <MudToggleGroup T="string" @bind-Value="_filter" Color="Color.Primary"
                            Style="border-radius:8px; overflow:hidden;">
                <MudToggleItem Value="@("sve")" Text="Sve" />
                <MudToggleItem Value="@("neprocitane")" Text='@($"Nepročitane ({_inbox?.UnreadCount ?? 0})")' />
            </MudToggleGroup>

            @if (_inbox?.UnreadCount > 0)
            {
                <MudButton Variant="Variant.Outlined" Size="Size.Small"
                           StartIcon="@Icons.Material.Outlined.DoneAll"
                           OnClick="MarkAllReadAsync"
                           Disabled="_markingAll"
                           Style="text-transform:none; font-weight:600; margin-left:auto;">
                    @(_markingAll ? "Označavam..." : "Označi sve kao pročitane")
                </MudButton>
            }
        </div>

        @* ── Lista notifikacija ──────────────────────────────────────── *@
        @if (_visibleItems.Count == 0)
        {
            <div style="text-align:center; padding:48px 24px; color:var(--text-muted);">
                <MudIcon Icon="@Icons.Material.Outlined.NotificationsNone"
                         Style="font-size:48px; margin-bottom:12px; display:block;" />
                <div style="font-size:15px;">
                    @(_filter == "neprocitane" ? "Nema nepročitanih obavještenja." : "Nema obavještenja.")
                </div>
            </div>
        }
        else
        {
            <div style="display:flex; flex-direction:column; gap:8px;">
                @foreach (var item in _visibleItems)
                {
                    <div class="card @(item.IsRead ? "" : "notif-unread")"
                         style="cursor:pointer; transition: background .15s;"
                         @onclick="() => OpenNotificationAsync(item)">
                        <div style="display:flex; gap:12px; align-items:flex-start; padding:4px 0;">
                            <div style="flex-shrink:0; margin-top:3px;">
                                <MudIcon Icon="@NotifIcon(item)"
                                         Style="@($"font-size:20px; color:{(item.IsRead ? "var(--text-muted)" : "var(--accent)")}")" />
                            </div>
                            <div style="flex:1; min-width:0;">
                                <div style="font-weight:@(item.IsRead ? "400" : "700"); font-size:14px;
                                            color:var(--rbi-off-black); margin-bottom:2px;">
                                    @item.Subject
                                </div>
                                <div style="font-size:13px; color:var(--text-secondary); line-height:1.5;
                                            overflow:hidden; text-overflow:ellipsis; white-space:nowrap; max-width:600px;">
                                    @item.Message
                                </div>
                                <div style="font-size:11px; color:var(--text-muted); margin-top:4px;">
                                    @item.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                </div>
                            </div>
                            @if (!item.IsRead)
                            {
                                <div style="flex-shrink:0; width:8px; height:8px; border-radius:50%;
                                            background:var(--accent); margin-top:6px;"></div>
                            }
                        </div>
                    </div>
                }
            </div>

            @* ── Paginacija ─────────────────────────────────────────── *@
            @if (_inbox is not null && _inbox.TotalCount > _pageSize)
            {
                <div style="display:flex; justify-content:center; margin-top:20px; gap:8px;">
                    <MudButton Variant="Variant.Outlined" Size="Size.Small"
                               Disabled="@(_page <= 1)"
                               OnClick="() => ChangePage(_page - 1)"
                               StartIcon="@Icons.Material.Outlined.ArrowBack">
                        Prethodna
                    </MudButton>
                    <span style="line-height:36px; font-size:13px; color:var(--text-muted); padding:0 8px;">
                        Stranica @_page od @TotalPages
                    </span>
                    <MudButton Variant="Variant.Outlined" Size="Size.Small"
                               Disabled="@(_page >= TotalPages)"
                               OnClick="() => ChangePage(_page + 1)"
                               EndIcon="@Icons.Material.Outlined.ArrowForward">
                        Sljedeća
                    </MudButton>
                </div>
            }
        }
    </div>
}

<style>
    .notif-unread {
        border-left: 3px solid var(--accent, #1B3F6E) !important;
        background: var(--accent-light, #EAF0F8) !important;
    }
</style>

@code {
    private NotificationInboxResultDto? _inbox;
    private string   _filter    = "sve";
    private bool     _loading   = true;
    private bool     _markingAll;
    private string?  _error;
    private int      _page      = 1;
    private const int _pageSize = 15;

    private IReadOnlyList<NotificationDto> _visibleItems =>
        _inbox?.Items ?? Array.Empty<NotificationDto>();

    private int TotalPages =>
        _inbox is null ? 1 : (int)Math.Ceiling((double)_inbox.TotalCount / _pageSize);

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error   = null;

        var unreadOnly = _filter == "neprocitane";
        var result = await NotifSvc.GetInboxAsync(_page, _pageSize, unreadOnly);

        if (result.IsSuccess)
            _inbox = result.Data;
        else
            _error = result.ErrorMessage ?? "Greška pri učitavanju obavještenja.";

        _loading = false;
    }

    private async Task ChangePage(int page)
    {
        _page = page;
        await LoadAsync();
    }

    private async Task OpenNotificationAsync(NotificationDto item)
    {
        if (!item.IsRead)
        {
            await NotifSvc.MarkReadAsync(item.Id);
            await LoadAsync();
        }

        if (!string.IsNullOrWhiteSpace(item.RelatedEntityType) &&
            !string.IsNullOrWhiteSpace(item.RelatedEntityId) &&
            item.RelatedEntityType == "AppraisalOrder" &&
            int.TryParse(item.RelatedEntityId, out var orderId))
        {
            Nav.NavigateTo($"/narudzbe/{orderId}");
        }
    }

    private async Task MarkAllReadAsync()
    {
        if (_inbox is null) return;
        _markingAll = true;
        StateHasChanged();

        var tasks = _inbox.Items
            .Where(i => !i.IsRead)
            .Select(i => NotifSvc.MarkReadAsync(i.Id));
        await Task.WhenAll(tasks);

        _markingAll = false;
        await LoadAsync();
        Snackbar.Add("Sve notifikacije označene kao pročitane.", Severity.Success);
    }

    private static string NotifIcon(NotificationDto item) =>
        item.RelatedEntityType switch
        {
            "AppraisalOrder" => Icons.Material.Outlined.Assignment,
            "TaskItem"       => Icons.Material.Outlined.TaskAlt,
            _                => Icons.Material.Outlined.Notifications
        };

    // Reload kada se promijeni filter
    private string _prevFilter = "sve";
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender && _filter != _prevFilter)
        {
            _prevFilter = _filter;
            _page = 1;
            await LoadAsync();
            StateHasChanged();
        }
    }
}
