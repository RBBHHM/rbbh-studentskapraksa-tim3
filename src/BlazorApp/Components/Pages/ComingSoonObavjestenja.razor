@* Stranica premještena u Obavjestenja.razor — implementovana Jul 2026 *@
@* Alias ruta za backward compatibility *@
@page "/sprint2/obavjestenja"
@rendermode InteractiveServer
@attribute [Authorize]
@inject NotificationApiService NotificationApi
@inject NavigationManager Nav
@inject MeService MeSvc

<PageTitle>Obavještenja — Digitalizacija procjene nekretnina</PageTitle>

@if (_accessDenied)
{
    <AppAccessDenied />
    return;
}

<AppPageHeader Title="Obavještenja"
               Subtitle="Vaš inbox in-app obavještenja o narudžbama i aktivnostima u sistemu." />

@if (_loading)
{
    <AppLoadingState />
}
else
{
    @* ── Filter traka ────────────────────────────────────────────────────── *@
    <div style="display:flex; align-items:center; gap:12px; margin-bottom:16px; flex-wrap:wrap;">
        <MudButton Variant="@(_unreadOnly ? Variant.Filled : Variant.Outlined)"
                   Color="Color.Warning"
                   Size="Size.Small"
                   StartIcon="@Icons.Material.Outlined.MarkEmailUnread"
                   OnClick="OnFilterToggle"
                   Style="text-transform:none;">
            Samo nepročitana
        </MudButton>
        @if (_totalUnread > 0)
        {
            <MudChip T="string" Color="Color.Warning" Size="Size.Small">@_totalUnread nepročitana</MudChip>
        }
        @if (_items.Any(n => !n.IsRead))
        {
            <MudButton Size="Size.Small" Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Outlined.DoneAll"
                       OnClick="MarkAllVisibleRead"
                       Disabled="_acting"
                       Style="margin-left:auto; color:#6B6560; border-color:#E5DDD2; text-transform:none; font-size:12.5px;">
                Označi sve kao pročitano
            </MudButton>
        }
    </div>

    @if (_loadError is not null)
    {
        <AppErrorBanner Message="@_loadError" OnRetry="LoadAsync" />
    }
    else if (_items.Count == 0)
    {
        <AppEmptyState Title="@(_unreadOnly ? "Nema nepročitanih obavještenja" : "Nema obavještenja")">
            <div style="font-size:13.5px; color:#9B9590;">
                @if (_unreadOnly)
                {
                    <span>Sve ste pročitali. Kliknite na toggle iznad da vidite sva obavještenja.</span>
                }
                else
                {
                    <span>Obavještenja se generišu automatski tokom obrade narudžbi.</span>
                }
            </div>
        </AppEmptyState>
    }
    else
    {
        <MudPaper Elevation="1" Class="rounded-lg overflow-hidden">
            @foreach (var (n, idx) in _items.Select((n, i) => (n, i)))
            {
                <div @onclick="@(() => OnClickNotification(n))"
                     style="padding:14px 18px; cursor:pointer; border-bottom:1px solid #F1EDE6;
                            background:@(n.IsRead ? "transparent" : "#FFF9D6");
                            transition: background 0.15s;"
                     onmouseover="this.style.background='#F8F6F2'"
                     onmouseout="this.style.background='@(n.IsRead ? "transparent" : "#FFF9D6")'">
                    <div style="display:flex; align-items:flex-start; gap:12px;">
                        <div style="margin-top:2px; flex-shrink:0;">
                            @if (!n.IsRead)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Circle"
                                         Style="font-size:10px; color:var(--mud-palette-warning);" />
                            }
                            else
                            {
                                <MudIcon Icon="@Icons.Material.Outlined.Circle"
                                         Style="font-size:10px; color:#D4CEC8;" />
                            }
                        </div>
                        <div style="flex:1; min-width:0;">
                            <div style="font-size:13.5px; font-weight:@(n.IsRead ? "500" : "700"); color:#2B2D33; margin-bottom:3px;">
                                @n.Subject
                            </div>
                            <div style="font-size:12.5px; color:#6B6560; line-height:1.5;">
                                @n.Message
                            </div>
                            <div style="display:flex; align-items:center; gap:10px; margin-top:6px;">
                                <span style="font-size:11.5px; color:#9B9590;">
                                    @n.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy. HH:mm")
                                </span>
                                @if (n.RelatedEntityType is "Order" or "AppraisalOrder" && !string.IsNullOrEmpty(n.RelatedEntityId))
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Default"
                                             Icon="@Icons.Material.Outlined.OpenInNew"
                                             Style="font-size:11px; height:20px;">
                                        Otvori narudžbu
                                    </MudChip>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </MudPaper>

        <AppPagination Page="_page" TotalPages="_totalPages" TotalCount="_totalCount" OnPageChange="ChangePage" />
    }
}

@code {
    private bool _loading     = true;
    private bool _accessDenied;
    private bool _acting;
    private bool _unreadOnly;
    private string? _loadError;

    private List<NotificationDto> _items = [];
    private int _totalCount;
    private int _totalPages;
    private int _totalUnread;
    private int _page = 1;
    private const int PageSize = 15;

    protected override async Task OnInitializedAsync()
    {
        var me = await MeSvc.GetMeAsync();
        if (!me.IsSuccess || me.Data is null)
        {
            Nav.NavigateTo("/login", replace: true);
            return;
        }

        if (!me.Data.Permissions.Contains(AppPermissions.NotificationsView, StringComparer.OrdinalIgnoreCase))
        {
            _accessDenied = true;
            _loading = false;
            return;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading   = true;
        _loadError = null;

        var result = await NotificationApi.GetInboxAsync(_page, PageSize, _unreadOnly);
        _loading = false;

        if (result.IsSuccess && result.Data is not null)
        {
            _items       = result.Data.Items.ToList();
            _totalCount  = result.Data.TotalCount;
            _totalUnread = result.Data.UnreadCount;
            _totalPages  = (int)Math.Ceiling(_totalCount / (double)PageSize);
        }
        else
        {
            _loadError = result.ErrorMessage ?? "Greška pri učitavanju obavještenja.";
        }
    }

    private async Task OnFilterToggle()
    {
        _unreadOnly = !_unreadOnly;
        _page = 1;
        await LoadAsync();
    }

    private async Task OnClickNotification(NotificationDto n)
    {
        if (!n.IsRead)
            await NotificationApi.MarkReadAsync(n.Id);

        if (n.RelatedEntityType is "Order" or "AppraisalOrder" && !string.IsNullOrEmpty(n.RelatedEntityId))
            Nav.NavigateTo($"/narudzbe/{n.RelatedEntityId}");
        else
            await LoadAsync();
    }

    private async Task MarkAllVisibleRead()
    {
        _acting = true;
        var unread = _items.Where(n => !n.IsRead).ToList();
        foreach (var n in unread)
            await NotificationApi.MarkReadAsync(n.Id);
        _acting = false;
        await LoadAsync();
    }

    private async Task ChangePage(int newPage)
    {
        _page = newPage;
        await LoadAsync();
    }
}
