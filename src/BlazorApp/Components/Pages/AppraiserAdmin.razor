@page "/sifarnici/vjestaci"
@rendermode InteractiveServer
@attribute [Authorize]
@inject AppraiserApiService AppraiserApi
@inject OrderService OrderSvc
@inject MeService MeSvc
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Vještaci — Digitalizacija procjene nekretnine</PageTitle>

@if (_initializing)
{
    <AppLoadingState />
}
else if (!_hasViewAccess)
{
    <AppAccessDenied Message="Šifarnik vještaka je dostupan kolateral administratoru i kolateral oficiru." />
}
else
{
    <!-- ═══════════════════ BREADCRUMB ═══════════════════ -->
    <AppBreadcrumb Items="@(new List<AppBreadcrumb.BreadcrumbItem> { new("Početna", "/"), new("Šifarnici", "/admin/sifarnici"), new("Vještaci", "") })" />

    <!-- ═══════════════════ PAGE HEADER ═══════════════════ -->
    <div class="page-header">
        <div class="page-header-left">
            <div class="page-title">Vještaci</div>
            <div class="page-subtitle">
                Master-data lista vještaka za procjenu nekretnina — koristi se za automatski i ručni odabir prilikom narudžbe.
            </div>
        </div>
    </div>

    <!-- ═══════════════════ TOOLBAR ═══════════════════ -->
    <div class="filter-bar">
        <AppSearchInput Value="@_search"
                        Placeholder="Pretraži po nazivu..."
                        ContainerStyle="flex:1; min-width:200px; max-width:300px;"
                        OnDebounced="OnSearchDebounced" />

        <MudSelect T="string?" Value="@(string.IsNullOrWhiteSpace(_filterCity) ? null : _filterCity)"
                   ValueChanged="OnCityFilterChanged"
                   Variant="Variant.Outlined" Margin="Margin.Dense"
                   Placeholder="Grad: Svi" Style="min-width:160px;" Clearable="true">
            @foreach (var city in _cityOptions)
            {
                <MudSelectItem T="string?" Value="@city.Label">@city.Label</MudSelectItem>
            }
        </MudSelect>

        <MudSelect T="bool?" Value="_filterOnLeave" ValueChanged="OnOnLeaveFilterChanged"
                   Variant="Variant.Outlined" Margin="Margin.Dense"
                   Placeholder="GO: Svi" Style="min-width:140px;">
            <MudSelectItem Value="@((bool?)null)">GO: Svi</MudSelectItem>
            <MudSelectItem Value="@((bool?)true)">Na GO</MudSelectItem>
            <MudSelectItem Value="@((bool?)false)">Dostupni</MudSelectItem>
        </MudSelect>

        <MudSelect T="bool?" Value="_filterBlacklisted" ValueChanged="OnBlacklistedFilterChanged"
                   Variant="Variant.Outlined" Margin="Margin.Dense"
                   Placeholder="Blacklist: Svi" Style="min-width:160px;">
            <MudSelectItem Value="@((bool?)null)">Blacklist: Svi</MudSelectItem>
            <MudSelectItem Value="@((bool?)true)">Na blacklisti</MudSelectItem>
            <MudSelectItem Value="@((bool?)false)">Nisu na blacklisti</MudSelectItem>
        </MudSelect>

        <MudSelect T="bool?" Value="_filterActive" ValueChanged="OnActiveFilterChanged"
                   Variant="Variant.Outlined" Margin="Margin.Dense"
                   Placeholder="Status: Svi" Style="min-width:140px;">
            <MudSelectItem Value="@((bool?)null)">Status: Svi</MudSelectItem>
            <MudSelectItem Value="@((bool?)true)">Aktivni</MudSelectItem>
            <MudSelectItem Value="@((bool?)false)">Neaktivni</MudSelectItem>
        </MudSelect>

        <div style="flex:1;"></div>

        @if (_canManage)
        {
            <MudButton Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Outlined.SwapVert"
                       OnClick="@(() => _showImportExport = true)"
                       Style="height:40px; text-transform:none; font-weight:600;">
                Import / Export
            </MudButton>
            <MudButton Variant="Variant.Filled" Class="btn-primary-rbi"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="OpenCreateDialog"
                       Style="height:40px;">
                Novi vještak
            </MudButton>
        }
    </div>

    @if (!_canManage)
    {
        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-4" Style="font-size:13px;">
            Imate pregled vještaka. Za izmjene kontaktirajte kolateral administratora.
        </MudAlert>
    }
    else
    {
        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-4" Style="font-size:13px;">
            Vještak na godišnjem odmoru (GO) ili na blacklisti neće biti predložen kod automatskog odabira.
            Sve izmjene se evidentiraju u audit log sistem.
        </MudAlert>
    }

    <!-- ═══════════════════ TABLE ═══════════════════ -->
    <div class="app-table-wrap">
        @if (_loading)
        {
            <AppLoadingState />
        }
        else if (_appraisers.Count == 0)
        {
            <AppEmptyState Icon="@Icons.Material.Outlined.Engineering" Title="Nema vještaka">
                <div style="font-size:13px; color:#aaa; margin-top:6px;">
                    Nema vještaka koji odgovaraju odabranim filterima.
                </div>
            </AppEmptyState>
        }
        else
        {
            <table class="app-table">
                <thead>
                    <tr class="app-thead-row">
                        <th class="app-th">Naziv</th>
                        <th class="app-th">Grad</th>
                        <th class="app-th">Tip</th>
                        <th class="app-th">Tip nekretnine</th>
                        <th class="app-th center">Aktivnih procjena</th>
                        <th class="app-th center">GO</th>
                        <th class="app-th center">Blacklist</th>
                        <th class="app-th center">Aktivan</th>
                        <th class="app-th right">Akcije</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in _appraisers)
                    {
                        <tr class="app-tr">
                            <td class="app-td">
                                <div class="app-td bold">@a.Name</div>
                                @if (!string.IsNullOrWhiteSpace(a.ContactEmail) || !string.IsNullOrWhiteSpace(a.ContactPhone))
                                {
                                    <div class="app-td secondary" style="padding:0; margin-top:2px;">
                                        @(a.ContactEmail ?? "—")@(string.IsNullOrWhiteSpace(a.ContactPhone) ? "" : $" · {a.ContactPhone}")
                                    </div>
                                }
                            </td>
                            <td class="app-td muted">@(a.City ?? "—")</td>
                            <td class="app-td">
                                <span class="badge badge-info" style="font-size:11px;">@a.LegalFormLabel</span>
                            </td>
                            <td class="app-td muted" style="font-size:12px;">@a.SupportedPropertyTypesLabel</td>
                            <td class="app-td center">
                                <div class="app-td bold" style="padding:0;">@a.ActiveAssignmentCount</div>
                                <div class="app-td secondary" style="padding:0;">limit @(a.LegalForm == "Firm" ? 5 : 2)</div>
                            </td>
                            <td class="app-td center">
                                @if (_canManage)
                                {
                                    <button title="@(a.IsOnLeave ? "Skini sa GO" : "Stavi na GO")"
                                            @onclick="@(() => ToggleOnLeaveAsync(a))"
                                            class="tbl-action" style="color:@(a.IsOnLeave ? "#8A6500" : "#ccc");">
                                        <MudIcon Icon="@(a.IsOnLeave ? Icons.Material.Filled.BeachAccess : Icons.Material.Outlined.BeachAccess)" Style="font-size:18px;" />
                                    </button>
                                }
                                else
                                {
                                    <span class="badge @(a.IsOnLeave ? "badge-warning" : "badge-inactive")" style="font-size:10px;">
                                        @(a.IsOnLeave ? "Da" : "Ne")
                                    </span>
                                }
                            </td>
                            <td class="app-td center">
                                @if (_canManage)
                                {
                                    <button title="@(a.IsBlacklisted ? "Ukloni sa blacklist-e" : "Dodaj na blacklist-u")"
                                            @onclick="@(() => ToggleBlacklistedAsync(a))"
                                            class="tbl-action" style="color:@(a.IsBlacklisted ? "#C65C4A" : "#ccc");">
                                        <MudIcon Icon="@(a.IsBlacklisted ? Icons.Material.Filled.Block : Icons.Material.Outlined.Block)" Style="font-size:18px;" />
                                    </button>
                                }
                                else
                                {
                                    <span class="badge @(a.IsBlacklisted ? "badge-error" : "badge-inactive")" style="font-size:10px;">
                                        @(a.IsBlacklisted ? "Da" : "Ne")
                                    </span>
                                }
                            </td>
                            <td class="app-td center">
                                <span class="badge @(a.IsActive ? "badge-active" : "badge-inactive")">
                                    @(a.IsActive ? "Aktivan" : "Neaktivan")
                                </span>
                            </td>
                            <td class="app-td right">
                                @if (_canManage)
                                {
                                    <div style="display:flex; align-items:center; justify-content:flex-end; gap:2px;">
                                        <button title="Uredi" @onclick="@(() => OpenEditDialog(a))" class="tbl-action">
                                            <MudIcon Icon="@Icons.Material.Outlined.Edit" Style="font-size:16px;" />
                                        </button>
                                        @if (a.IsActive)
                                        {
                                            <button title="Deaktiviraj" @onclick="@(() => ConfirmDeactivate(a))"
                                                    class="tbl-action" style="color:var(--rbi-coral-deep);">
                                                <MudIcon Icon="@Icons.Material.Outlined.ToggleOff" Style="font-size:16px;" />
                                            </button>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="app-td secondary" style="padding:0;">—</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <div style="padding:0 16px;">
                <AppPagination Page="_page" TotalPages="_totalPages" TotalCount="_total" OnPageChange="ChangePage" />
            </div>
        }
    </div>
}

@if (_showImportExport)
{
    <ImportExportDialog OnClose="@(() => { _showImportExport = false; _ = LoadAsync(); })" />
}

<!-- ═══ CREATE / EDIT DIALOG ═══ -->
@if (_dialogOpen)
{
    <div style="position:fixed; inset:0; background:rgba(43,45,51,0.4); z-index:1000;
                display:flex; align-items:center; justify-content:center; padding:24px;"
         @onkeydown="@(async (KeyboardEventArgs e) => { if (e.Key == "Escape") _dialogOpen = false; else if (e.Key == "Enter" && !_dialogSaving) await SaveAsync(); })"
         tabindex="-1">
        <div style="background:#fff; border-radius:12px; padding:32px; max-width:500px; width:100%;
                    max-height:calc(100vh - 48px); overflow-y:auto;
                    box-shadow:0 8px 40px rgba(43,45,51,0.18);">
            <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:24px;">
                <div style="font-size:17px; font-weight:700; color:var(--rbi-off-black);">
                    @(_dialogIsEdit ? $"Uredi vještaka — {_editTarget?.Name}" : "Novi vještak")
                </div>
                <button @onclick="@(() => _dialogOpen = false)"
                        style="width:30px; height:30px; border:none; background:none; cursor:pointer;
                               border-radius:6px; font-size:18px; color:#777;">✕</button>
            </div>

            <AppFormField Label="Naziv" Required="true">
                <MudTextField @bind-Value="_name"
                              Placeholder="npr. Marko Marković ili Procjena d.o.o."
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              Style="width:100%;" />
            </AppFormField>

            <AppFormField Label="Grad">
                <MudSelect @bind-Value="_city" T="string"
                           Variant="Variant.Outlined" Margin="Margin.Dense" Style="width:100%;"
                           Clearable="true" Placeholder="Odaberi grad">
                    @foreach (var city in _cityOptions)
                    {
                        <MudSelectItem T="string" Value="@city.Label">@city.Label</MudSelectItem>
                    }
                </MudSelect>
            </AppFormField>

            <AppFormField Label="Tip vještaka" Required="true">
                <MudSelect @bind-Value="_legalForm" T="string"
                           Variant="Variant.Outlined" Margin="Margin.Dense" Style="width:100%;">
                    <MudSelectItem T="string" Value="@("Individual")">Individualni (limit 2 aktivne procjene)</MudSelectItem>
                    <MudSelectItem T="string" Value="@("Firm")">Firma (limit 5 aktivnih procjena)</MudSelectItem>
                </MudSelect>
            </AppFormField>

            <AppFormField Label="Tipovi nekretnina">
                <MudSelect T="string" MultiSelection="true" SelectedValues="_selectedPropertyTypes"
                           SelectedValuesChanged="OnPropertyTypesChanged"
                           Variant="Variant.Outlined" Margin="Margin.Dense" Style="width:100%;"
                           Placeholder="Svi tipovi (bez ograničenja)">
                    @foreach (var pt in _propertyTypeOptions)
                    {
                        <MudSelectItem T="string" Value="@pt.Code">@pt.Label</MudSelectItem>
                    }
                </MudSelect>
            </AppFormField>

            <AppFormField Label="Opseg klijenata">
                <MudSelect @bind-Value="_clientScope" T="string"
                           Variant="Variant.Outlined" Margin="Margin.Dense" Style="width:100%;">
                    <MudSelectItem T="string" Value="@("Sve")">Svi klijenti (FL + PL)</MudSelectItem>
                    <MudSelectItem T="string" Value="@("FizickaLica")">Samo fizička lica</MudSelectItem>
                    <MudSelectItem T="string" Value="@("PravnaLica")">Samo pravna lica</MudSelectItem>
                </MudSelect>
            </AppFormField>

            <AppFormField Label="Podržani gradovi">
                <MudSelect T="string" MultiSelection="true" SelectedValues="_selectedCities"
                           SelectedValuesChanged="OnCitiesChanged"
                           Variant="Variant.Outlined" Margin="Margin.Dense" Style="width:100%;"
                           Placeholder="Svi gradovi (bez ograničenja)">
                    @foreach (var city in _cityOptions)
                    {
                        <MudSelectItem T="string" Value="@city.Label">@city.Label</MudSelectItem>
                    }
                </MudSelect>
            </AppFormField>

            <AppFormField Label="Kontakt e-mail">
                <MudTextField @bind-Value="_contactEmail"
                              Placeholder="npr. vjestak@primjer.com"
                              InputType="InputType.Email"
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              Style="width:100%;" />
            </AppFormField>

            <AppFormField Label="Kontakt telefon">
                <MudTextField @bind-Value="_contactPhone"
                              Placeholder="npr. 033 123 456"
                              InputType="InputType.Telephone"
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              Style="width:100%;" />
            </AppFormField>

            <AppFormField Label="Napomena">
                <MudTextField @bind-Value="_notes"
                              Placeholder="Interna napomena (opcionalno)"
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              Lines="2" Style="width:100%;" />
            </AppFormField>

            @if (!string.IsNullOrWhiteSpace(_dialogError))
            {
                <AppErrorBanner Message="@_dialogError" />
            }

            <div style="display:flex; gap:10px; justify-content:flex-end; margin-top:8px;">
                <button @onclick="@(() => _dialogOpen = false)"
                        style="padding:10px 20px; border:1px solid #E5DDD2; border-radius:8px;
                               background:#fff; font-size:14px; color:#555; cursor:pointer; font-weight:600;">
                    Odustani
                </button>
                <button @onclick="SaveAsync"
                        disabled="@(_dialogSaving)"
                        style="padding:10px 20px; border:none; border-radius:8px; background:#FEE600;
                               font-size:14px; color:var(--rbi-off-black); cursor:pointer; font-weight:700;">
                    @(_dialogSaving ? "Snimanje..." : (_dialogIsEdit ? "Spremi izmjene" : "Kreiraj vještaka"))
                </button>
            </div>
        </div>
    </div>
}

@code {
    private bool _initializing = true;
    private bool _hasViewAccess;
    private bool _canManage;

    private bool _loading = true;
    private string _search = "";
    private string _filterCity = "";
    private List<CodebookValueItem> _cityOptions = [];
    private List<CodebookValueItem> _propertyTypeOptions = [];
    private bool? _filterOnLeave;
    private bool? _filterBlacklisted;
    private bool? _filterActive;
    private int _page = 1, _pageSize = 20, _total, _totalPages = 1;
    private List<AppraiserDto> _appraisers = [];

    private bool _showImportExport;
    private bool _dialogOpen, _dialogIsEdit, _dialogSaving;
    private string? _dialogError;
    private AppraiserDto? _editTarget;
    private string _name = "", _city = "", _legalForm = "Individual", _contactEmail = "", _contactPhone = "", _notes = "";
    private string _clientScope = "Sve";
    private IEnumerable<string> _selectedPropertyTypes = [];
    private IEnumerable<string> _selectedCities = [];

    protected override async Task OnInitializedAsync()
    {
        var me = await MeSvc.GetMeAsync();
        var permissions = me.IsSuccess ? me.Data?.Permissions ?? [] : [];

        _hasViewAccess = permissions.Contains(AppPermissions.AppraisersView, StringComparer.OrdinalIgnoreCase);
        _canManage     = permissions.Contains(AppPermissions.AppraisersManage, StringComparer.OrdinalIgnoreCase);

        if (_hasViewAccess)
        {
            var citiesResult = await OrderSvc.GetCitiesAsync();
            if (citiesResult.IsSuccess && citiesResult.Data is not null)
                _cityOptions = citiesResult.Data;

            var ptResult = await OrderSvc.GetPropertyTypesAsync();
            if (ptResult.IsSuccess && ptResult.Data is not null)
                _propertyTypeOptions = ptResult.Data;

            await LoadAsync();
        }

        _initializing = false;
    }

    private async Task OnSearchDebounced(string value)
    {
        _search = value;
        _page   = 1;
        await LoadAsync(silent: true);
    }

    private async Task OnCityFilterChanged(string? v)
    {
        _filterCity = v ?? "";
        _page = 1;
        await LoadAsync(silent: true);
    }

    private async Task OnOnLeaveFilterChanged(bool? v)     { _filterOnLeave = v;     _page = 1; await LoadAsync(silent: true); }
    private async Task OnBlacklistedFilterChanged(bool? v) { _filterBlacklisted = v; _page = 1; await LoadAsync(silent: true); }
    private async Task OnActiveFilterChanged(bool? v)      { _filterActive = v;      _page = 1; await LoadAsync(silent: true); }

    private async Task LoadAsync(bool silent = false)
    {
        if (!silent) _loading = true;

        var r = await AppraiserApi.GetListAsync(
            search: string.IsNullOrWhiteSpace(_search) ? null : _search,
            city: string.IsNullOrWhiteSpace(_filterCity) ? null : _filterCity,
            onLeave: _filterOnLeave,
            blacklisted: _filterBlacklisted,
            active: _filterActive,
            page: _page,
            pageSize: _pageSize);

        if (r.IsSuccess && r.Data is not null)
        {
            _appraisers = r.Data.Items.ToList();
            _total      = r.Data.TotalCount;
            _totalPages = r.Data.TotalPages > 0 ? r.Data.TotalPages : 1;
            if (_page > _totalPages) _page = _totalPages;
        }
        else if (!silent)
        {
            Snackbar.Add(r.ErrorMessage ?? "Greška pri učitavanju vještaka.", Severity.Error);
        }

        if (!silent) _loading = false;
    }

    private async Task ChangePage(int newPage)
    {
        _page = newPage;
        await LoadAsync();
    }

    private void OpenCreateDialog()
    {
        _dialogIsEdit           = false;
        _editTarget             = null;
        _name                   = "";
        _city                   = "";
        _legalForm              = "Individual";
        _contactEmail           = "";
        _contactPhone           = "";
        _notes                  = "";
        _clientScope            = "Sve";
        _selectedPropertyTypes  = [];
        _selectedCities         = [];
        _dialogError            = null;
        _dialogOpen             = true;
    }

    private void OpenEditDialog(AppraiserDto a)
    {
        _dialogIsEdit           = true;
        _editTarget             = a;
        _name                   = a.Name;
        _city                   = a.City ?? "";
        _legalForm              = a.LegalForm;
        _contactEmail           = a.ContactEmail ?? "";
        _contactPhone           = a.ContactPhone ?? "";
        _notes                  = a.Notes ?? "";
        _clientScope            = a.ClientScope;
        _selectedPropertyTypes  = string.IsNullOrWhiteSpace(a.SupportedPropertyTypes)
            ? []
            : a.SupportedPropertyTypes.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        _selectedCities         = string.IsNullOrWhiteSpace(a.SupportedCities)
            ? []
            : a.SupportedCities.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        _dialogError            = null;
        _dialogOpen             = true;
    }

    private void OnPropertyTypesChanged(IEnumerable<string> values)
    {
        _selectedPropertyTypes = values;
    }

    private void OnCitiesChanged(IEnumerable<string> values)
    {
        _selectedCities = values;
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_name))
        {
            _dialogError = "Naziv vještaka je obavezan.";
            return;
        }

        if (!string.IsNullOrWhiteSpace(_contactEmail) &&
            !System.Text.RegularExpressions.Regex.IsMatch(_contactEmail.Trim(),
                @"^[^@\s]+@[^@\s]+\.[^@\s]+$"))
        {
            _dialogError = "Kontakt e-mail nije ispravnog formata (npr. vjestak@primjer.com).";
            return;
        }

        if (!string.IsNullOrWhiteSpace(_contactPhone) &&
            !System.Text.RegularExpressions.Regex.IsMatch(_contactPhone.Trim(),
                @"^[\d\s\+\-\(\)\.\/]{6,30}$"))
        {
            _dialogError = "Kontakt telefon može sadržavati samo cifre i znakove: + - ( ) . /";
            return;
        }

        _dialogSaving = true;
        _dialogError  = null;

        var city  = string.IsNullOrWhiteSpace(_city) ? null : _city.Trim();
        var email = string.IsNullOrWhiteSpace(_contactEmail) ? null : _contactEmail.Trim();
        var phone = string.IsNullOrWhiteSpace(_contactPhone) ? null : _contactPhone.Trim();
        var notes = string.IsNullOrWhiteSpace(_notes) ? null : _notes.Trim();
        var propTypes = _selectedPropertyTypes.Any() ? string.Join(",", _selectedPropertyTypes) : null;
        var cities = _selectedCities.Any() ? string.Join(",", _selectedCities) : null;

        var result = _dialogIsEdit
            ? await AppraiserApi.UpdateAsync(_editTarget!.Id, new UpdateAppraiserRequest
              {
                  Name = _name.Trim(),
                  City = city,
                  LegalForm = _legalForm,
                  ContactEmail = email,
                  ContactPhone = phone,
                  Notes = notes,
                  SupportedPropertyTypes = propTypes,
                  SupportedCities = cities,
                  ClientScope = _clientScope
              })
            : await AppraiserApi.CreateAsync(new CreateAppraiserRequest
              {
                  Name = _name.Trim(),
                  City = city,
                  LegalForm = _legalForm,
                  ContactEmail = email,
                  ContactPhone = phone,
                  Notes = notes,
                  SupportedPropertyTypes = propTypes,
                  SupportedCities = cities,
                  ClientScope = _clientScope
              });

        if (result.IsSuccess)
        {
            Snackbar.Add(_dialogIsEdit ? "Vještak ažuriran." : "Vještak kreiran.", Severity.Success);
            _dialogOpen = false;
            await LoadAsync();
        }
        else
        {
            _dialogError = result.ErrorMessage ?? "Greška pri snimanju.";
        }

        _dialogSaving = false;
    }

    private async Task ToggleOnLeaveAsync(AppraiserDto a)
    {
        // AC9.3 — potvrda pri postavljanju vještaka na GO
        if (!a.IsOnLeave)
        {
            var dialog = await DialogService.ShowAsync<ConfirmDialog>(
                "Postavi vještaka na godišnji odmor",
                new MudBlazor.DialogParameters
                {
                    ["ContentText"] = $"Da li ste sigurni da želite postaviti vještaka \"{a.Name}\" na godišnji odmor (GO)? " +
                                      "Vještak neće biti predlagán za nove narudžbe dok je na GO.",
                    ["ConfirmText"] = "Postavi na GO"
                });

            if (await dialog.Result is { Canceled: true }) return;
        }

        var r = await AppraiserApi.SetOnLeaveAsync(a.Id, !a.IsOnLeave);
        if (r.IsSuccess)
        {
            Snackbar.Add(r.Data!.IsOnLeave
                ? $"Vještak \"{a.Name}\" je postavljen na GO."
                : $"Vještak \"{a.Name}\" je skinut sa GO.", Severity.Success);
            await LoadAsync(silent: true);
        }
        else
        {
            Snackbar.Add(r.ErrorMessage ?? "Greška pri izmjeni.", Severity.Error);
        }
    }

    private async Task ToggleBlacklistedAsync(AppraiserDto a)
    {
        var r = await AppraiserApi.SetBlacklistedAsync(a.Id, !a.IsBlacklisted);
        if (r.IsSuccess)
        {
            Snackbar.Add(r.Data!.IsBlacklisted
                ? $"Vještak \"{a.Name}\" je dodan na blacklist-u."
                : $"Vještak \"{a.Name}\" je uklonjen sa blacklist-e.", Severity.Warning);
            await LoadAsync(silent: true);
        }
        else
        {
            Snackbar.Add(r.ErrorMessage ?? "Greška pri izmjeni.", Severity.Error);
        }
    }

    private void ConfirmDeactivate(AppraiserDto a)
    {
        _ = ConfirmDeactivateDialog(a);
    }

    private async Task ConfirmDeactivateDialog(AppraiserDto a)
    {
        var dialog = await DialogService.ShowAsync<ConfirmDialog>(
            "Deaktivacija vještaka",
            new MudBlazor.DialogParameters
            {
                ["ContentText"] = $"Da li ste sigurni da želite deaktivirati vještaka \"{a.Name}\"? " +
                                  "Neaktivan vještak se neće predlagati kod odabira.",
                ["ConfirmText"] = "Deaktiviraj",
                ["IsDanger"]    = true
            });

        if (await dialog.Result is { Canceled: false })
        {
            var r = await AppraiserApi.DeactivateAsync(a.Id);
            if (r.IsSuccess)
            {
                Snackbar.Add($"Vještak \"{a.Name}\" deaktiviran.", Severity.Warning);
                await LoadAsync();
            }
            else
            {
                Snackbar.Add(r.ErrorMessage ?? "Greška pri deaktivaciji.", Severity.Error);
            }
        }
    }
}
