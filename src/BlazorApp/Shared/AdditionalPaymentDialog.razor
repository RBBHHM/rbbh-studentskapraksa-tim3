@* 
    AdditionalPaymentDialog.razor
    Lokacija: src/BlazorApp/Shared/AdditionalPaymentDialog.razor
    AC3 — Dijalog za unos iznosa doplata koji vještak šalje CA-u.
    Vraća decimal iznos kroz MudDialog.Close().
*@

@using MudBlazor

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-4" Style="color:var(--text-secondary);">
            @ContentText
        </MudText>
        <MudNumericField
            @bind-Value="_amount"
            Label="@AmountLabel"
            Variant="Variant.Outlined"
            Min="0.01m"
            Format="N2"
            Adornment="Adornment.End"
            AdornmentText="KM"
            Immediate="true"
            Error="@(_showError && _amount <= 0)"
            ErrorText="Iznos mora biti veći od nule."
            Style="width:100%;" />
        @if (_amount > 0)
        {
            <div style="margin-top:8px;font-size:12px;color:var(--text-muted);">
                Task koji će biti kreiran: 
                <strong>"Doplata za procjenu u iznosu @_amount.ToString("N2") KM"</strong>
            </div>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Style="text-transform:none;">
            Odustani
        </MudButton>
        <MudButton
            Color="Color.Warning"
            Variant="Variant.Filled"
            OnClick="Confirm"
            Disabled="_amount <= 0"
            Style="font-weight:700;text-transform:none;color:var(--rbi-off-black);">
            @ConfirmText
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public string ContentText  { get; set; } = "";
    [Parameter] public string ConfirmText  { get; set; } = "Zatraži doplatu";
    [Parameter] public string AmountLabel  { get; set; } = "Iznos doplata (KM)";

    private decimal _amount;
    private bool    _showError;

    private void Cancel() => MudDialog.Cancel();

    private void Confirm()
    {
        _showError = true;
        if (_amount <= 0) return;
        MudDialog.Close(DialogResult.Ok(_amount));
    }
}
