# Direct URL avoids TanStack Start/Nitro handling API paths as frontend routes in development.
VITE_API_BASE_URL=http://127.0.0.1:5000
VITE_KEYCLOAK_URL=http://localhost:8183
VITE_KEYCLOAK_REALM=praksa
VITE_KEYCLOAK_CLIENT_ID=praksa-web

# Localization bundles are served by the React application itself by default.
# VITE_LOCALIZATION_MANIFEST_URL=/localization/manifests/latest.json
