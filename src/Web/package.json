{
  "name": "collateral-appraisal-web",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "dev:api": "dotnet watch --project ../Api run",
    "dev:legacy-web": "dotnet watch --project ../BlazorApp run",
    "build": "vite build",
    "build:all": "vite build && dotnet build ../../studentskapraksa.slnx --no-restore",
    "openapi:generate": "openapi-typescript http://127.0.0.1:5000/openapi/v1.json -o src/lib/api/generated/api.ts",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "localization:build": "node scripts/localization/build-release.mjs",
    "localization:validate": "node scripts/localization/validate-keys.mjs",
    "test": "vitest run",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json && node scripts/library/rewrite-declaration-aliases.mjs",
    "test:visual": "playwright test tests/visual",
    "test:visual:update": "playwright test tests/visual --update-snapshots",
    "test:a11y": "playwright test tests/a11y",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "tokens:build": "node scripts/tokens/build-tokens.mjs"
  },
